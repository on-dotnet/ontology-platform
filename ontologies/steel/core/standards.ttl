# Bibliographic records of public standards cited by the steel ontology (spec 006 §8).
# Only identifier, titles, edition year, status, catalogue link and replacement relations; no normative text.
# Every record was checked against the official catalogue on 2026-11-26; status reflects that snapshot.
# English titles are copied verbatim from official catalogues, original typos included.
# For non-Chinese standards the @zh title is a working translation; the @en title is authoritative.
# issued is the year at the end of the identifier; for ASTM that is the latest revision or reapproval year.
@base <https://w3id.org/ontology-platform/steel/> .
@prefix stl: <https://w3id.org/ontology-platform/steel/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<ontology/core/standards> a owl:Ontology ;
    owl:versionIRI <ontology/core/standards/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    rdfs:label "钢铁本体：标准书目"@zh, "Steel ontology: standards bibliography"@en ;
    rdfs:comment "钢铁本体引用的公开标准书目，每个版次一条，只记编号、名称、版次、状态、官方目录链接和代替关系。"@zh,
        "Public standards cited by the steel ontology, one record per edition, holding only identifier, titles, edition, status, catalogue link and replacement relations."@en ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> .

<source/industry-practice> a dcterms:BibliographicResource ;
    rdfs:label "行业通用"@zh, "Industry practice"@en ;
    skos:definition "没有可引用的公开标准、按钢铁行业通行做法定义的来源。"@zh,
        "Source for terms defined from common steel industry practice where no public standard can be cited."@en ;
    rdfs:isDefinedBy <ontology/core/standards> .

