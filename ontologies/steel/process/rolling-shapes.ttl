@base <https://w3id.org/ontology-platform/steel/> .
@prefix stl: <https://w3id.org/ontology-platform/steel/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<ontology/process/rolling-shapes> a owl:Ontology ;
    owl:versionIRI <ontology/process/rolling-shapes/0.1.0> ; owl:versionInfo "0.1.0" ;
    rdfs:label "轧制数据约束"@zh, "Rolling data constraints"@en ;
    rdfs:comment "校验钢卷的坯料来源、母卷区段与涂镀层代码归属。"@zh, "Checks source stock, intervals along parent coils and membership of coating type codes."@en ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> .

stl:CoilSourceStockShape a sh:NodeShape ; sh:targetClass stl:Coil ;
    sh:severity sh:Violation ; rdfs:comment "每卷应沿一步或多步直接来源关系追到至少一件坯料或钢锭。分卷、合卷可经过中间卷；坯锭可由实物类或坯形代码识别。"@zh ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:message "沿钢卷的来源链未找到属于坯料或钢锭的实物类或坯形代码。"@zh ; sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX form: <https://w3id.org/ontology-platform/steel/code/product-form/>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT $this WHERE {
          FILTER NOT EXISTS {
            $this stl:derivedFrom+/a/rdfs:subClassOf* ?class .
            FILTER (?class IN (stl:ContinuouslyCastPiece, stl:BreakdownRolledStock, stl:Slab,
                               stl:Bloom, stl:Billet, stl:BeamBlank, stl:Ingot))
          }
          FILTER NOT EXISTS {
            $this stl:derivedFrom+/stl:productForm/skos:broader* ?form .
            FILTER (?form IN (form:SLAB, form:BLOOM, form:SQBILLET, form:RECTBILLET,
                              form:ROUNDBIL, form:BEAMBLANK, form:INGOT))
          }
        }
    """ ] .

stl:CoilSourceIntervalShape a sh:PropertyShape ; sh:targetSubjectsOf stl:startLength, stl:endLength ;
    sh:path stl:startLength ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:lessThanOrEquals stl:endLength ;
    sh:severity sh:Violation ; rdfs:comment "登记母卷区段时须给出起点，以非负十进制米数记录，起点可以与终点重合。"@zh .

stl:CoilSourceIntervalEndShape a sh:PropertyShape ; sh:targetSubjectsOf stl:startLength, stl:endLength ;
    sh:path stl:endLength ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ;
    sh:severity sh:Violation ; rdfs:comment "登记母卷区段时须给出终点，并使用与起点相同的非负十进制米数口径。"@zh .

stl:CoatingTypeSchemeShape a sh:PropertyShape ; sh:targetObjectsOf stl:coatingType ;
    sh:path skos:inScheme ; sh:hasValue <code/coating-type> ;
    sh:severity sh:Violation ; rdfs:comment "规格或实物所引用的涂镀层类型应属于涂镀层类型方案。"@zh .
