PREFIX stl: <https://w3id.org/ontology-platform/steel/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX move: <https://w3id.org/ontology-platform/steel/code/movement-event-type/>

SELECT ?pieceId ?eventId ?action ?at ?eventLocationId ?carrierId WHERE {
  VALUES ?piece { <urn:synthetic:steel:materialpiece/P31> <urn:synthetic:steel:materialpiece/P32>
                  <urn:synthetic:steel:materialpiece/P40> }
  ?piece dcterms:identifier ?pieceId .
  ?event stl:movedPiece ?piece ; stl:isConfirmed true ; stl:occurredAt ?at ;
         dcterms:identifier ?eventId ; stl:movementType/skos:notation ?action .
  FILTER NOT EXISTS {
    ?later stl:movedPiece ?piece ; stl:isConfirmed true ; stl:occurredAt ?laterAt .
    FILTER(?laterAt > ?at)
  }
  OPTIONAL { ?event stl:eventLocation/dcterms:identifier ?eventLocationId }
  OPTIONAL {
    { ?event stl:movementType move:LIFT ; stl:performedOn/dcterms:identifier ?carrierId }
    UNION { ?event stl:movementType move:LOAD ; stl:triggeredBy/stl:loadedOn/dcterms:identifier ?carrierId }
  }
}
ORDER BY ?at ?eventId ?eventLocationId ?carrierId
