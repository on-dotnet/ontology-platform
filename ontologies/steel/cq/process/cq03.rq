PREFIX stl: <https://w3id.org/ontology-platform/steel/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# The sequence and the mould-cast piece are independent subjects.
SELECT ?sequenceId ?position ?heatId ?ingotId ?method ?mouldId WHERE {
  {
    VALUES ?sequence { <urn:synthetic:steel:castsequence/Q1260003> }
    ?sequence dcterms:identifier ?sequenceId .
    ?heat stl:castIn ?sequence ; stl:heatPositionInSequence ?position ; dcterms:identifier ?heatId .
    BIND(1 AS ?branch)
  } UNION {
    VALUES ?ingot { <urn:synthetic:steel:ingot/G01> }
    ?ingot dcterms:identifier ?ingotId ; stl:producedBy ?pour ; stl:teemedInMould/dcterms:identifier ?mouldId .
    ?pour a/rdfs:subClassOf* stl:IngotCasting ; stl:teemingMethod/skos:notation ?method .
    BIND(2 AS ?branch)
  }
}
ORDER BY ?branch ?position ?heatId ?mouldId
