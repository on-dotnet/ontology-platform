PREFIX stl: <https://w3id.org/ontology-platform/steel/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>

# Each result row is one recorded edge. Count upstream steps from the bar to order both routes.
SELECT ?barId ?route ?outputId ?outputKind ?sourceId ?remeltNumber ?pass ?heatId WHERE {
  {
    SELECT ?bar ?output (COUNT(DISTINCT ?step) AS ?depth) WHERE {
      VALUES ?bar { <urn:synthetic:steel:bar/B71> <urn:synthetic:steel:bar/B73> }
      ?bar stl:derivedFrom* ?step . ?step stl:derivedFrom* ?output .
    }
    GROUP BY ?bar ?output
  }
  ?bar dcterms:identifier ?barId ; stl:meltingRoute/skos:notation ?route .
  ?output dcterms:identifier ?outputId ; (stl:derivedFrom|stl:sourceHeat) ?source .
  ?source dcterms:identifier ?sourceId ; (stl:derivedFrom*/stl:sourceHeat)? ?heat .
  {
    SELECT ?output (MIN(?label) AS ?outputKind) WHERE {
      ?output rdf:type/rdfs:label ?label . FILTER (LANG(?label) = "zh")
    } GROUP BY ?output
  }
  ?heat rdf:type/rdfs:subClassOf* stl:Heat ; dcterms:identifier ?heatId .
  OPTIONAL {
    ?output (stl:producedBy|^stl:outputPiece) ?remelt .
    ?remelt rdf:type/rdfs:subClassOf* stl:Remelting ; stl:remeltNumber ?remeltNumber ; stl:remeltSequence ?pass .
  }
}
ORDER BY ?barId ?depth ?outputId ?sourceId ?heatId
