@base <https://w3id.org/ontology-platform/steel/> .
@prefix stl: <https://w3id.org/ontology-platform/steel/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<ontology/special/remelting> a owl:Ontology ;
    owl:versionIRI <ontology/special/remelting/0.1.0> ; owl:versionInfo "0.1.0" ;
    rdfs:label "特冶与重熔"@zh, "Special melting and remelting"@en ;
    rdfs:comment "描述特钢一次真空感应熔炼、各道自耗电极重熔，以及由锭和电极逐件组成的物料来源链。"@zh, "Describes primary vacuum induction melting of special steels, consumable electrode remelting passes and the material lineage of individual ingots and electrodes."@en ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> .

stl:VacuumInductionMelting a owl:Class ; rdfs:subClassOf stl:Steelmaking ;
    rdfs:label "真空感应熔炼"@zh, "Vacuum induction melting"@en ; skos:prefLabel "真空感应熔炼"@zh, "Vacuum induction melting"@en ;
    skos:altLabel "VIM"@en ;
    rdfs:seeAlso <code/process-type/VIM> ;
    skos:definition "在真空感应炉中用感应加热熔化炉料并调成所需成分的一次冶炼作业。"@zh, "A primary steelmaking operation in which induction heating melts the charge in a vacuum furnace and its composition is adjusted."@en ;
    rdfs:comment "下沉理由：特冶路线需区分生成一次炉次的真空感应熔炼和随后按道次记录的自耗重熔。"@zh ;
    dcterms:source <source/industry-practice> ; rdfs:isDefinedBy <ontology/special/remelting> .

stl:Remelting a owl:Class ; rdfs:subClassOf stl:Operation ;
    rdfs:label "重熔作业"@zh, "Remelting operation"@en ; skos:prefLabel "重熔作业"@zh, "Remelting operation"@en ;
    rdfs:seeAlso <code/process-type/REMELT> ;
    skos:definition "将一件或多件自耗电极重新熔化并凝固成新锭的一次作业，在冶炼链中占一个重熔道次。"@zh, "One pass in a melting route in which metal from one or more consumable electrodes is melted and solidified into a new ingot."@en ;
    rdfs:comment "下沉理由：特冶的多次熔炼须逐次标识重熔炉号和道次，并追溯该次产出的新锭。"@zh ;
    dcterms:source <source/industry-practice> ; rdfs:isDefinedBy <ontology/special/remelting> .

stl:ElectroslagRemelting a owl:Class ; rdfs:subClassOf stl:Remelting ;
    rdfs:label "电渣重熔"@zh, "Electroslag remelting"@en ; skos:prefLabel "电渣重熔"@zh, "Electroslag remelting"@en ;
    skos:altLabel "ESR"@en ;
    rdfs:seeAlso <code/process-type/ESR> ;
    skos:definition "利用电流流经熔渣产生的热量熔化自耗电极，金属熔滴穿过渣层后汇集并凝固成锭的作业。"@zh, "A remelting pass in which heat generated by current flowing through molten slag melts the electrode. Metal droplets pass through the slag and solidify into an ingot."@en ;
    rdfs:comment "下沉理由：特冶追溯须能将采用熔渣的重熔道次与真空电弧重熔道次分别标识。"@zh ;
    dcterms:source <source/industry-practice> ; rdfs:isDefinedBy <ontology/special/remelting> .

stl:ProtectiveAtmosphereElectroslagRemelting a owl:Class ; rdfs:subClassOf stl:ElectroslagRemelting ;
    rdfs:label "保护气氛电渣重熔"@zh, "Protective atmosphere electroslag remelting"@en ; skos:prefLabel "保护气氛电渣重熔"@zh, "Protective atmosphere electroslag remelting"@en ;
    skos:altLabel "PESR"@en ;
    rdfs:seeAlso <code/process-type/PESR> ;
    skos:definition "在受控保护气氛下进行的电渣重熔作业，保护气体隔离周围空气与重熔区。"@zh, "An electroslag remelting pass using a controlled protective atmosphere to isolate the remelting zone from ambient air."@en ;
    rdfs:comment "下沉理由：特冶电渣重熔记录须能区分带保护气氛的工艺变体。"@zh ;
    dcterms:source <source/industry-practice> ; rdfs:isDefinedBy <ontology/special/remelting> .

stl:VacuumArcRemelting a owl:Class ; rdfs:subClassOf stl:Remelting ;
    rdfs:label "真空自耗电弧重熔"@zh, "Vacuum arc remelting"@en ; skos:prefLabel "真空自耗电弧重熔"@zh, "Vacuum arc remelting"@en ;
    skos:altLabel "真空自耗重熔"@zh, "VAR"@en ;
    rdfs:seeAlso <code/process-type/VAR> ;
    skos:definition "在真空下以电弧熔化自耗电极，使落入熔池的金属在结晶器内凝固成新锭的作业。"@zh, "A remelting pass in which an arc melts a consumable electrode under vacuum and metal entering the pool solidifies in a mould as a new ingot."@en ;
    rdfs:comment "下沉理由：特冶路线按道次追踪真空自耗作业，同一条路线可在电渣重熔后继续真空自耗重熔。"@zh ;
    dcterms:source <source/industry-practice> ; rdfs:isDefinedBy <ontology/special/remelting> .

stl:Electrode a owl:Class ; rdfs:subClassOf stl:MaterialPiece ;
    rdfs:label "重熔自耗电极"@zh, "Consumable remelting electrode"@en ; skos:prefLabel "重熔自耗电极"@zh, "Consumable remelting electrode"@en ;
    skos:altLabel "自耗电极"@zh ;
    skos:definition "由来源锭制备、以独立件号投入重熔作业并向新锭供应金属的电极。"@zh, "An individually tracked electrode prepared from ingot stock and consumed as metal feed for a new ingot during remelting."@en ;
    rdfs:comment "下沉理由：特冶须在来源锭和本次重熔锭之间保留实际投入电极的实物身份。"@zh ;
    dcterms:source <source/industry-practice> ; rdfs:isDefinedBy <ontology/special/remelting> .

stl:RemeltedIngot a owl:Class ; rdfs:subClassOf stl:Ingot ;
    rdfs:label "重熔锭"@zh, "Remelted ingot"@en ; skos:prefLabel "重熔锭"@zh, "Remelted ingot"@en ;
    skos:definition "自耗电极经一道重熔后凝固形成、有独立件号并可继续加工为下一道电极或锻坯的锭。"@zh, "An individually identified ingot solidified in one consumable electrode remelting pass, available as stock for another electrode or for forging."@en ;
    rdfs:comment "下沉理由：特冶须逐锭注明所走的冶炼路线，并把锭关联至直接供料的电极。"@zh ;
    dcterms:source <source/industry-practice> ; rdfs:isDefinedBy <ontology/special/remelting> .

stl:remeltNumber a owl:DatatypeProperty ; rdfs:domain stl:Remelting ; rdfs:range xsd:string ;
    rdfs:label "重熔炉号"@zh, "Remelt number"@en ; skos:prefLabel "重熔炉号"@zh, "Remelt number"@en ;
    skos:definition "生产记录分配给一次重熔作业的业务编号，用于从产出锭回查该次炉作业。"@zh, "The business identifier assigned to a remelting run so the run can be retrieved from its output ingots."@en ;
    rdfs:comment "下沉理由：特冶需分别检索一次冶炼炉次、各道重熔的炉号以及逐锭件号。"@zh ;
    dcterms:source <source/industry-practice> ; rdfs:isDefinedBy <ontology/special/remelting> .

stl:remeltSequence a owl:DatatypeProperty ; rdfs:domain stl:Remelting ; rdfs:range xsd:positiveInteger ;
    rdfs:label "重熔道次"@zh, "Remelt sequence number"@en ; skos:prefLabel "重熔道次"@zh, "Remelt sequence number"@en ;
    skos:definition "沿该件物料的冶炼链，自一次冶炼之后按先后为重熔作业编排的序号，第一次重熔记为一。"@zh, "The ordinal of this remelting operation in the material lineage, counted from one at the first remelt after primary melting."@en ;
    rdfs:comment "下沉理由：特冶材料可能先后经历多次重熔，须能按冶金顺序区分各道作业。"@zh ;
    dcterms:source <source/industry-practice> ; rdfs:isDefinedBy <ontology/special/remelting> .

stl:meltingRoute a owl:ObjectProperty ; rdfs:domain stl:MaterialPiece ; rdfs:range skos:Concept ;
    rdfs:label "冶炼路线"@zh, "Melting route"@en ; skos:prefLabel "冶炼路线"@zh, "Melting route"@en ;
    rdfs:seeAlso <code/melting-route> ;
    skos:definition "关联描述该件物料冶炼历程的具体路线代码，可在重熔锭、后续加工件或直接成材的特钢实物件上记录。"@zh, "Identifies the coded sequence of melting and refining stages for a piece, including remelted ingots, their downstream products and pieces made by a direct route."@en ;
    rdfs:comment "下沉理由：特钢追溯需按实物件区分含重熔和直接成材路线，以判断应追查的来源环节。"@zh ;
    dcterms:source <source/industry-practice> ; rdfs:isDefinedBy <ontology/special/remelting> .
