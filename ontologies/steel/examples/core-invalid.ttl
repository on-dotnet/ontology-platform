@base <https://w3id.org/ontology-platform/steel/> .
@prefix stl: <https://w3id.org/ontology-platform/steel/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Each EXPECT identifies the focus node, the named source shape and the SHACL component.

# EXPECT <urn:synthetic:steel:operation/M90> <https://w3id.org/ontology-platform/steel/CoreEventPlanTimesShape> MaxCountConstraintComponent
# EXPECT <urn:synthetic:steel:operation/M90> <https://w3id.org/ontology-platform/steel/CoreEventPlannedEndShape> MaxCountConstraintComponent
<urn:synthetic:steel:operation/M90> a stl:Operation ;
    stl:plannedStartAt "2026-11-19T08:00:00+08:00"^^xsd:dateTime ;
    stl:plannedEndAt "2026-11-19T09:00:00+08:00"^^xsd:dateTime .

# EXPECT <urn:synthetic:steel:productionorder/W90> <https://w3id.org/ontology-platform/steel/CorePlanActualTimesShape> MaxCountConstraintComponent
# EXPECT <urn:synthetic:steel:productionorder/W90> <https://w3id.org/ontology-platform/steel/CorePlanActualStartShape> MaxCountConstraintComponent
# EXPECT <urn:synthetic:steel:productionorder/W90> <https://w3id.org/ontology-platform/steel/CorePlanOccurredAtShape> MaxCountConstraintComponent
<urn:synthetic:steel:productionorder/W90> a stl:ProductionOrder ;
    stl:actualStartAt "2026-11-19T08:00:00+08:00"^^xsd:dateTime ;
    stl:actualEndAt "2026-11-19T09:00:00+08:00"^^xsd:dateTime ;
    stl:occurredAt "2026-11-19T08:30:00+08:00"^^xsd:dateTime .

# EXPECT <urn:synthetic:steel:event/V90> <https://w3id.org/ontology-platform/steel/CoreInstantShape> DatatypeConstraintComponent
# EXPECT <urn:synthetic:steel:event/V90> <https://w3id.org/ontology-platform/steel/CoreOccurredAtShape> PatternConstraintComponent
<urn:synthetic:steel:event/V90> a stl:Event ;
    stl:recordedAt "2026-11-19T09:00:00+08:00" ; stl:occurredAt "2026-11-19T09:00:00"^^xsd:dateTime .

# EXPECT <urn:synthetic:steel:compositionlimit/K90> <https://w3id.org/ontology-platform/steel/CoreCompositionBoundsShape> LessThanOrEqualsConstraintComponent
<urn:synthetic:steel:compositionlimit/K90> a stl:CompositionLimit ;
    stl:lowerLimit 0.8 ; stl:upperLimit 0.3 .

# EXPECT <urn:synthetic:steel:materialpiece/P90> <https://w3id.org/ontology-platform/steel/CoreMassShape> DatatypeConstraintComponent
# EXPECT <urn:synthetic:steel:materialpiece/P90> <https://w3id.org/ontology-platform/steel/CoreMassShape> MinInclusiveConstraintComponent
# EXPECT <urn:synthetic:steel:materialpiece/P90> <https://w3id.org/ontology-platform/steel/CoreGrossMassShape> MinInclusiveConstraintComponent
# EXPECT <urn:synthetic:steel:materialpiece/P90> <https://w3id.org/ontology-platform/steel/CoreTheoreticalMassShape> MinInclusiveConstraintComponent
# EXPECT <urn:synthetic:steel:materialpiece/P90> <https://w3id.org/ontology-platform/steel/CoreSourceHeatShape> ClassConstraintComponent
<urn:synthetic:steel:materialpiece/P90> a stl:MaterialPiece ;
    stl:netMass -1 ; stl:grossMass -2.0 ; stl:theoreticalMass -3.0 ;
    stl:sourceHeat <urn:synthetic:steel:equipment/E90> .

# EXPECT <urn:synthetic:steel:sourcecontribution/C90> <https://w3id.org/ontology-platform/steel/CoreContributionInputShape> MaxCountConstraintComponent
# EXPECT <urn:synthetic:steel:sourcecontribution/C90> <https://w3id.org/ontology-platform/steel/CoreContributionInputShape> ClassConstraintComponent
# EXPECT <urn:synthetic:steel:sourcecontribution/C90> <https://w3id.org/ontology-platform/steel/CoreContributionOutputShape> MaxCountConstraintComponent
# EXPECT <urn:synthetic:steel:sourcecontribution/C90> <https://w3id.org/ontology-platform/steel/CoreContributionOutputShape> ClassConstraintComponent
# EXPECT <urn:synthetic:steel:sourcecontribution/C90> <https://w3id.org/ontology-platform/steel/CoreShareShape> MinInclusiveConstraintComponent
# EXPECT <urn:synthetic:steel:sourcecontribution/C90> <https://w3id.org/ontology-platform/steel/CoreFractionBasisShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:sourcecontribution/C90> <https://w3id.org/ontology-platform/steel/CoreContributionEvidenceShape> MinCountConstraintComponent
<urn:synthetic:steel:sourcecontribution/C90> a stl:SourceContribution ;
    stl:contributionInput <urn:synthetic:steel:equipment/E90>, <urn:synthetic:steel:materialpiece/P90> ;
    stl:contributionOutput <urn:synthetic:steel:equipment/E90>, <urn:synthetic:steel:materialpiece/P90> ;
    stl:share -0.5 .

# EXPECT <urn:synthetic:steel:sourcecontribution/C91> <https://w3id.org/ontology-platform/steel/CoreShareShape> DatatypeConstraintComponent
# EXPECT <urn:synthetic:steel:sourcecontribution/C91> <https://w3id.org/ontology-platform/steel/CoreShareShape> MaxInclusiveConstraintComponent
# EXPECT <urn:synthetic:steel:sourcecontribution/C91> <https://w3id.org/ontology-platform/steel/CoreFractionBasisShape> MaxCountConstraintComponent
# EXPECT <urn:synthetic:steel:sourcecontribution/C91> <https://w3id.org/ontology-platform/steel/CoreContributionEvidenceShape> MaxCountConstraintComponent
<urn:synthetic:steel:sourcecontribution/C91> a stl:SourceContribution ;
    stl:share 101 ; stl:shareBasis <code/share-basis/MASS>, <code/share-basis/LENGTH> ;
    stl:evidenceLevel <code/contribution-evidence/ESTIMATED>, <code/contribution-evidence/MEASURED> .

# EXPECT <urn:synthetic:steel:sample/S90> <https://w3id.org/ontology-platform/steel/CoreSampleSourceShape> MinCountConstraintComponent
<urn:synthetic:steel:sample/S90> a stl:Sample ;
    stl:sampleType <code/judgement-result/PENDING> .

# EXPECT <urn:synthetic:steel:observation/O90> <https://w3id.org/ontology-platform/steel/CoreObservedObjectShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:observation/O90> <https://w3id.org/ontology-platform/steel/CoreObservationItemShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:observation/O90> <https://w3id.org/ontology-platform/steel/CoreObservationPointShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:observation/O90> <https://w3id.org/ontology-platform/steel/CoreObservationSampleTimeShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:observation/O90> <https://w3id.org/ontology-platform/steel/CoreObservationResultTimeShape> MinCountConstraintComponent
<urn:synthetic:steel:observation/O90> a stl:Observation ;
    stl:measurementMethod <code/judgement-result/PENDING> .

# EXPECT <urn:synthetic:steel:observation/O91> <https://w3id.org/ontology-platform/steel/CoreObservationMethodShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:observation/O91> <https://w3id.org/ontology-platform/steel/CoreObservationItemShape> MaxCountConstraintComponent
# EXPECT <urn:synthetic:steel:observation/O91> <https://w3id.org/ontology-platform/steel/CoreObservationPointShape> ClassConstraintComponent
# EXPECT <urn:synthetic:steel:observation/O91> <https://w3id.org/ontology-platform/steel/CoreReadingShape> SPARQLConstraintComponent
<urn:synthetic:steel:observation/O91> a stl:Observation ;
    stl:measurementItem <code/measurement-item/TEMP>, <code/judgement-result/PENDING> ;
    stl:measuredObject <urn:synthetic:steel:materialpiece/P90> ; stl:measuredAtPoint <urn:synthetic:steel:equipment/E90> ;
    stl:width 5.0 ; stl:sampledAt "2026-11-19T08:00:00Z"^^xsd:dateTime ;
    stl:resultAt "2026-11-19T08:01:00Z"^^xsd:dateTime .

# EXPECT <urn:synthetic:steel:qualitydecision/Q90> <https://w3id.org/ontology-platform/steel/CoreDecisionObjectShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:qualitydecision/Q90> <https://w3id.org/ontology-platform/steel/CoreDecisionResultShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:qualitydecision/Q90> <https://w3id.org/ontology-platform/steel/CoreDecisionBasisShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:qualitydecision/Q90> <https://w3id.org/ontology-platform/steel/CoreDecisionTimeShape> MinCountConstraintComponent
<urn:synthetic:steel:qualitydecision/Q90> a stl:QualityDecision .

# EXPECT <urn:synthetic:steel:movementevent/V91> <https://w3id.org/ontology-platform/steel/CoreMovementPieceShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:movementevent/V91> <https://w3id.org/ontology-platform/steel/CoreMovementActionShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:movementevent/V91> <https://w3id.org/ontology-platform/steel/CoreMovementTimeShape> MinCountConstraintComponent
# EXPECT <urn:synthetic:steel:movementevent/V91> <https://w3id.org/ontology-platform/steel/CoreConfirmationShape> DatatypeConstraintComponent
<urn:synthetic:steel:movementevent/V91> a stl:MovementEvent ;
    stl:isConfirmed "yes" .

# EXPECT <urn:synthetic:steel:millcertificate/Z90> <https://w3id.org/ontology-platform/steel/CoreCertificatePieceShape> ClassConstraintComponent
<urn:synthetic:steel:millcertificate/Z90> a stl:MillCertificate ;
    stl:coversPiece <urn:synthetic:steel:equipment/E90> .

# EXPECT <urn:synthetic:steel:tensiletest/T90> <https://w3id.org/ontology-platform/steel/CoreTestMethodShape> MinCountConstraintComponent
<urn:synthetic:steel:tensiletest/T90> a stl:TensileTest ;
    stl:testType <code/judgement-result/PENDING> .

# EXPECT <urn:synthetic:steel:productionorder/TZ01> <https://w3id.org/ontology-platform/steel/CorePlannedStartAtShape> PatternConstraintComponent
<urn:synthetic:steel:productionorder/TZ01> a stl:ProductionOrder ; stl:plannedStartAt "2026-11-19T10:00:00"^^xsd:dateTime .
