# EXPECT <urn:synthetic:steel:operation/TZ04> <https://w3id.org/ontology-platform/steel/CoreActualEndAtShape> PatternConstraintComponent
<urn:synthetic:steel:operation/TZ04> a stl:Operation ; stl:actualEndAt "2026-11-19T10:00:00"^^xsd:dateTime .
# EXPECT <urn:synthetic:steel:materialpiece/TZ05> <https://w3id.org/ontology-platform/steel/CoreCreatedAtShape> PatternConstraintComponent
<urn:synthetic:steel:materialpiece/TZ05> a stl:MaterialPiece ; stl:createdAt "2026-11-19T10:00:00"^^xsd:dateTime .
# EXPECT <urn:synthetic:steel:event/TZ06> <https://w3id.org/ontology-platform/steel/CoreInstantShape> PatternConstraintComponent
<urn:synthetic:steel:event/TZ06> a stl:Event ; stl:recordedAt "2026-11-19T10:00:00"^^xsd:dateTime .
# EXPECT <urn:synthetic:steel:sample/TZ07> <https://w3id.org/ontology-platform/steel/CoreSampledAtShape> PatternConstraintComponent
<urn:synthetic:steel:sample/TZ07> a stl:Sample ; stl:sampledAt "2026-11-19T10:00:00"^^xsd:dateTime ; stl:sampleOf <urn:synthetic:steel:materialpiece/P90> .
# EXPECT <urn:synthetic:steel:tensiletest/TZ08> <https://w3id.org/ontology-platform/steel/CoreResultAtShape> PatternConstraintComponent
<urn:synthetic:steel:tensiletest/TZ08> a stl:TensileTest ; stl:resultAt "2026-11-19T10:00:00"^^xsd:dateTime ; stl:methodStandard <std/gbt-228-1-2021> .

