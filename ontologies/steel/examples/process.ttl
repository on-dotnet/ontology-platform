    stl:finishRollingTemperature 890.0 ; stl:coilingTemperature 610.0 .
hc:R126000001 a stl:HotRolledCoil ; dcterms:identifier "R126000001" ; stl:productForm <code/product-form/HRC> ;
    stl:derivedFrom slab:S12600017101 ; stl:producedBy hr:R40 ; stl:thickness 10.0 ; stl:width 1500.0 .
<urn:synthetic:steel:shearing/S41> a stl:Shearing ; stl:inputPiece hc:R126000001 ; stl:outputPiece plate:P41 .
plate:P41 a stl:Plate ; dcterms:identifier "P41" ; stl:productForm <code/product-form/PLATE> ;
    stl:derivedFrom hc:R126000001 ; stl:producedBy <urn:synthetic:steel:shearing/S41> ; stl:thickness 10.0 ; stl:width 1500.0 .

# After the plate is cut, the remaining length is rewound under a new identity.
