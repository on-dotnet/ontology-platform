    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "A route segment for removing selected impurities from hot metal before charging it to a steelmaking furnace."@en,
        "在炼钢装料前处理铁水，以脱除指定杂质的工序段类别。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "HMPT"^^stl:ProcessTypeCode ;
    skos:prefLabel "Hot metal pretreatment"@en,
        "铁水预处理"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/code/process-type/INGOTCAST> a skos:Concept ;
    rdfs:label "Ingot casting"@en,
        "模铸"@zh ;
