stl:InclusionRatingResult a owl:Class ;
    rdfs:label "Inclusion rating by category"@en,
        "分项夹杂物评级结果"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> ;
    rdfs:comment "下沉理由：逐项记录使轴承钢等产品能按订货要求分别核对各类夹杂物的最不利评级。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:subClassOf stl:RatingResult ;
    skos:definition "A reported level for one morphological category and, where applicable, one thickness series in an inclusion examination."@en,
        "在一次显微评级中针对一种夹杂物形态类别、在适用时针对一个粗细系列报告的级别。"@zh ;
    skos:prefLabel "Inclusion rating by category"@en,
        "分项夹杂物评级结果"@zh .

stl:PropertyRequirement a owl:Class ;
    rdfs:label "Property requirement"@en,
        "性能要求"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:Requirement ;
    skos:definition "An acceptance requirement setting bounds for a material property under an identified test method and test conditions."@en,
        "针对一项材料性能规定验收界限、试验方法及试验条件的要求。"@zh ;
    skos:prefLabel "Property requirement"@en,
        "性能要求"@zh .

stl:Rebar a owl:Class ;
    rdfs:label "Reinforcing bar"@en,
        "钢筋"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-1-2024>,
        <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:comment "下沉理由：混凝土配筋用普钢棒材按光圆或带肋及钢筋公称直径交验，需要在棒材上细分。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products> ;
    rdfs:subClassOf stl:Bar ;
    skos:definition "A commodity steel bar supplied for reinforcement of concrete and designated by nominal diameter."@en,
        "普钢产品标准中供钢筋混凝土配筋使用的条状钢材，以公称直径标示规格。"@zh ;
    skos:prefLabel "Reinforcing bar"@en,
        "钢筋"@zh .

stl:Shipment a owl:Class ;
    rdfs:label "Shipment"@en,
        "发运单"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1091-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A document identifying an outbound consignment and the packages handed over within it."@en,
        "以发运单号归集一次对外交货及其所含包装件的凭证。"@zh ;
    skos:prefLabel "Shipment"@en,
        "发运单"@zh .

stl:SourceInterval a owl:Class ;
    rdfs:label "Source interval"@en,
        "来源区段"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A record locating the material of one output along a specified immediate source piece."@en,
        "在一个产出与一个来源件之间按来源件坐标界定材料取自何处的记录。"@zh ;
    skos:prefLabel "Source interval"@en,
        "来源区段"@zh .

<https://w3id.org/ontology-platform/steel/code/plain-product-family/SECTION> a skos:Concept ;
    rdfs:label "Rolled structural sections"@en,
        "型钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-11263-2024>,
        <https://w3id.org/ontology-platform/steel/std/gbt-706-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Commodity steel ordered by structural section profile, grade and delivery length."@en,
        "按型钢截面规格、材质和交货长度订货的普钢系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/plain-product-family> ;
    skos:notation "SECTION"^^stl:PlainProductFamilyCode ;
    skos:prefLabel "Rolled structural sections"@en,
        "型钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/plain-product-family> .

<https://w3id.org/ontology-platform/steel/code/process-type/HOTROLL> a skos:Concept ;
    rdfs:label "Hot rolling"@en,
        "热轧"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:definition "Rolling steel in its hot-working range to alter thickness or section."@en,
        "在热加工温区用轧辊改变钢料厚度或断面。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "HOTROLL"^^stl:ProcessTypeCode ;
    skos:prefLabel "Hot rolling"@en,
        "热轧"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

stl:occurredAt a owl:DatatypeProperty ;
    rdfs:label "Occurred at"@en,
        "发生时刻"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Event ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives the instant at which a recorded point event took place."@en,
        "标识可按单一时点登记的动作发生时刻。"@zh ;
    skos:prefLabel "Occurred at"@en,
        "发生时刻"@zh .

