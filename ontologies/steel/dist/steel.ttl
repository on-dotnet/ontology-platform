    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that checks dimensions, surface condition or internal soundness as steel passes along the line and can group several inspection records for that pass."@en,
        "在钢材通过生产线时检查其尺寸、表面或内部质量的作业，可关联该次过线取得的多项检验记录。"@zh ;
    skos:prefLabel "In-line inspection"@en,
        "在线检验"@zh .

