    skos:notation "TI"^^stl:ChemicalElementCode ;
    skos:prefLabel "Titanium"@en,
        "钛"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/V> a skos:Concept ;
    rdfs:label "Vanadium"@en,
