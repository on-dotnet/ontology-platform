    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:resultOfInspection ;
    sh:severity sh:Violation ;
    sh:targetClass stl:MacroDefectRating .

stl:Marking a owl:Class ;
    rdfs:label "Marking"@en,
