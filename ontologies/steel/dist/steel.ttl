    skos:definition "Datatype of primary notations in the inclusion morphology category scheme."@en,
        "标记夹杂物形态类别方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Inclusion morphology category code"@en,
        "夹杂物形态类别代码"@zh .

stl:InclusionTypeSchemeShape a sh:PropertyShape ;
    rdfs:comment "夹杂物形态类别应属于显微评级的类别方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/inclusion-type> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:inclusionType .

stl:IngotPositionCode a rdfs:Datatype ;
    rdfs:label "Axial position on an ingot code"@en,
        "钢锭轴向部位代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Datatype of primary notations in the axial position on an ingot scheme."@en,
        "标记钢锭轴向部位方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Axial position on an ingot code"@en,
        "钢锭轴向部位代码"@zh .

stl:IngotPositionSchemeShape a sh:PropertyShape ;
    rdfs:comment "钢锭及其来源区段涉及的部位应取自钢锭轴向部位方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/ingot-position> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:ingotPosition,
        stl:intervalIngotPosition .

stl:IngotTeemingMethodShape a sh:PropertyShape ;
    rdfs:comment "每次模铸作业应给出本次实际采用的浇注方式。"@zh ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:teemingMethod ;
    sh:severity sh:Violation ;
    sh:targetClass stl:IngotCasting .

stl:InitialCrossSectionAreaShape a sh:PropertyShape ;
    rdfs:comment "填写锻前截面积时应给出一个大于零的十进制数，单位为平方毫米。"@zh ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minExclusive 0.0 ;
    sh:path stl:initialCrossSectionArea ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:initialCrossSectionArea .

stl:InlineInspection a owl:Class ;
    rdfs:label "In-line inspection"@en,
        "在线检验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
