        "弯曲试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-232-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Bends a specimen to the specified extent and examines the tensile surface for cracking."@en,
        "把试样弯至约定程度，检查受拉表面是否出现规定的开裂。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/test-type> ;
    skos:notation "BEND"^^stl:TestTypeCode ;
    skos:prefLabel "Bend test"@en,
        "弯曲试验"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/test-type> .

<https://w3id.org/ontology-platform/steel/code/test-type/BRINELL> a skos:Concept ;
    rdfs:label "Brinell hardness test"@en,
        "布氏硬度试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-231-1-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/test-type/HARDNESS> ;
    skos:definition "Indents the specimen with a carbide ball and derives hardness from the residual impression diameter."@en,
        "将硬质合金球压入试样，以卸载后压痕直径求取硬度。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/test-type> ;
    skos:notation "BRINELL"^^stl:TestTypeCode ;
    skos:prefLabel "Brinell hardness test"@en,
        "布氏硬度试验"@zh .

<https://w3id.org/ontology-platform/steel/code/test-type/FLARE> a skos:Concept ;
    rdfs:label "Tube drift-expanding test"@en,
        "钢管扩口试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Expands a tube end over a tapered tool and checks the flared region for cracking."@en,
        "用锥形工具扩大管端并检查扩口区的开裂情况。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/test-type> ;
    skos:notation "FLARE"^^stl:TestTypeCode ;
    skos:prefLabel "Tube drift-expanding test"@en,
        "钢管扩口试验"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/test-type> .

<https://w3id.org/ontology-platform/steel/code/test-type/FLATTEN> a skos:Concept ;
    rdfs:label "Tube flattening test"@en,
        "钢管压扁试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Flattens a tube section between platens to a specified separation and examines the wall or seam."@en,
        "将管段夹在压板间压扁至规定间距，检查管壁或焊缝的响应。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/test-type> ;
    skos:notation "FLATTEN"^^stl:TestTypeCode ;
    skos:prefLabel "Tube flattening test"@en,
        "钢管压扁试验"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/test-type> .

<https://w3id.org/ontology-platform/steel/code/test-type/HYDRO> a skos:Concept ;
    rdfs:label "Hydrostatic pressure test"@en,
        "液压试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Holds a tube under specified internal liquid pressure to check pressure integrity."@en,
        "在管内施加规定液体压力并保压，检查承压完整性。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/test-type> ;
    skos:notation "HYDRO"^^stl:TestTypeCode ;
    skos:prefLabel "Hydrostatic pressure test"@en,
        "液压试验"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/test-type> .

<https://w3id.org/ontology-platform/steel/code/test-type/IMPACT> a skos:Concept ;
    rdfs:label "Impact test"@en,
        "冲击试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-229-2020> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Subjects a specimen to an impact and measures the energy absorbed in fracture."@en,
        "使规定试样承受快速冲击，以断裂过程吸收的能量评价其响应。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/test-type> ;
    skos:notation "IMPACT"^^stl:TestTypeCode ;
    skos:prefLabel "Impact test"@en,
        "冲击试验"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/test-type> .

<https://w3id.org/ontology-platform/steel/code/test-type/ROCKWELL> a skos:Concept ;
    rdfs:label "Rockwell hardness test"@en,
        "洛氏硬度试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-230-1-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/test-type/HARDNESS> ;
    skos:definition "Determines hardness from the change in indentation depth over a specified loading cycle."@en,
        "按规定初、主试验力循环中压头的压入深度变化读出硬度。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/test-type> ;
    skos:notation "ROCKWELL"^^stl:TestTypeCode ;
    skos:prefLabel "Rockwell hardness test"@en,
        "洛氏硬度试验"@zh .

<https://w3id.org/ontology-platform/steel/code/test-type/TENSILE> a skos:Concept ;
    rdfs:label "Tensile test"@en,
        "拉伸试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-228-1-2021> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Applies increasing axial tension to determine strength and ductility."@en,
        "沿试样轴向逐步加载，在拉伸过程中测定强度和延性。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/test-type> ;
    skos:notation "TENSILE"^^stl:TestTypeCode ;
    skos:prefLabel "Tensile test"@en,
        "拉伸试验"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/test-type> .

<https://w3id.org/ontology-platform/steel/code/test-type/VICKERS> a skos:Concept ;
    rdfs:label "Vickers hardness test"@en,
        "维氏硬度试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-4340-1-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/test-type/HARDNESS> ;
    skos:definition "Measures the diagonals of an impression made by a square-based diamond pyramid."@en,
        "用金刚石正四棱锥压出印痕并按对角线测定硬度。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/test-type> ;
    skos:notation "VICKERS"^^stl:TestTypeCode ;
    skos:prefLabel "Vickers hardness test"@en,
        "维氏硬度试验"@zh .

<https://w3id.org/ontology-platform/steel/code/transport-mode/RAIL> a skos:Concept ;
    rdfs:label "Rail transport"@en,
        "铁路运输"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Rail wagons carry the stock over the specified transport leg."@en,
        "货物装入铁路车辆后经轨道列车运送。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/transport-mode> ;
    skos:notation "RAIL"^^stl:TransportModeCode ;
    skos:prefLabel "Rail transport"@en,
        "铁路运输"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/transport-mode> .

<https://w3id.org/ontology-platform/steel/code/transport-mode/ROAD> a skos:Concept ;
    rdfs:label "Road transport"@en,
        "公路运输"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "The shipment leg is carried on a road vehicle."@en,
        "货物装载于公路车辆并经道路完成本运输段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/transport-mode> ;
    skos:notation "ROAD"^^stl:TransportModeCode ;
    skos:prefLabel "Road transport"@en,
        "公路运输"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/transport-mode> .

<https://w3id.org/ontology-platform/steel/code/transport-mode/WATER> a skos:Concept ;
    rdfs:label "Water transport"@en,
        "水路运输"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "A vessel or barge carries the cargo on a sea or inland waterway leg."@en,
        "货物在船舶或驳船上经海运或内河航运承运。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/transport-mode> ;
    skos:notation "WATER"^^stl:TransportModeCode ;
    skos:prefLabel "Water transport"@en,
        "水路运输"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/transport-mode> .

<https://w3id.org/ontology-platform/steel/code/weld-method/HFW> a skos:Concept ;
    rdfs:label "High-frequency welding"@en,
        "高频焊"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/weld-method/ERW> ;
    skos:definition "A resistance welding method using high-frequency current to concentrate heat at the edges before they are squeezed together."@en,
        "以高频电流集中加热待接合的管边，随后挤压焊合的电阻焊方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/weld-method> ;
    skos:notation "HFW"^^stl:WeldMethodCode ;
    skos:prefLabel "High-frequency welding"@en,
        "高频焊"@zh .

<https://w3id.org/ontology-platform/steel/code/weld-method/LSAW> a skos:Concept ;
    rdfs:label "Longitudinal submerged arc welding"@en,
        "直缝埋弧焊"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking-codes> ;
    skos:altLabel "SAWL"@en ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/weld-method/SAW> ;
    skos:definition "Applies submerged arc welding along a seam parallel to the pipe axis."@en,
        "沿管体轴向对已成形的管边进行埋弧焊接。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/weld-method> ;
    skos:notation "LSAW"^^stl:WeldMethodCode ;
    skos:prefLabel "Longitudinal submerged arc welding"@en,
        "直缝埋弧焊"@zh .

<https://w3id.org/ontology-platform/steel/code/weld-method/SSAW> a skos:Concept ;
    rdfs:label "Helical submerged arc welding"@en,
        "螺旋缝埋弧焊"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking-codes> ;
    skos:altLabel "SAWH"@en ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/weld-method/SAW> ;
    skos:definition "Applies submerged arc welding along the helical seam of spiral-formed strip."@en,
        "对带钢螺旋成形后形成的螺旋接缝进行埋弧焊接。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/weld-method> ;
    skos:notation "SSAW"^^stl:WeldMethodCode ;
    skos:prefLabel "Helical submerged arc welding"@en,
        "螺旋缝埋弧焊"@zh .

stl:coilingTemperature a owl:DatatypeProperty ;
    rdfs:label "Hot strip coiling temperature"@en,
        "热轧卷取温度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:HotRolling ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:range xsd:decimal ;
    skos:definition "The temperature of hot-rolled strip as it reaches the coiler after runout cooling."@en,
        "热轧带钢经轧后冷却、进入卷取机时记录的带钢温度。"@zh ;
    skos:prefLabel "Hot strip coiling temperature"@en,
        "热轧卷取温度"@zh ;
    stl:quantityKind quantitykind:CelsiusTemperature ;
    stl:unit unit:DEG_C .

stl:cokeReactivityIndex a owl:DatatypeProperty ;
    rdfs:label "Coke reactivity index"@en,
        "焦炭反应性指数"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-4000-2017> ;
    rdfs:domain stl:Coke ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:range xsd:decimal ;
    skos:altLabel "CRI"@en,
        "CRI"@zh ;
    skos:definition "The mass lost by a coke sample in the carbon dioxide reaction test as a percentage of its pre-reaction mass, reported for the lot."@en,
        "焦样在二氧化碳反应试验中的质量损失占反应前质量的百分数，用于表征该批焦炭的反应性。"@zh ;
    skos:prefLabel "Coke reactivity index"@en,
        "焦炭反应性指数"@zh ;
    stl:quantityKind quantitykind:MassFraction ;
    stl:unit unit:PERCENT .

stl:cokeStrengthAfterReaction a owl:DatatypeProperty ;
    rdfs:label "Coke strength after reaction"@en,
        "焦炭反应后强度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-4000-2017> ;
    rdfs:domain stl:Coke ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:range xsd:decimal ;
    skos:altLabel "CSR"@en,
        "CSR"@zh ;
    skos:definition "The percentage by mass of the reacted coke charged to the drum that remains above the test sieve after tumbling."@en,
        "反应后的焦样经转鼓处理，留在规定筛孔以上的质量占入鼓焦样质量的百分数。"@zh ;
    skos:prefLabel "Coke strength after reaction"@en,
        "焦炭反应后强度"@zh ;
    stl:quantityKind quantitykind:MassFraction ;
    stl:unit unit:PERCENT .

stl:column a owl:DatatypeProperty ;
    rdfs:label "Storage column"@en,
        "库位列"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:StorageLocation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Gives the column ordinal of the position within its storage area."@en,
        "记录库位在所属库区坐标系中的列序号。"@zh ;
    skos:prefLabel "Storage column"@en,
        "库位列"@zh .

stl:consumedLot a owl:ObjectProperty ;
    rdfs:label "Consumed lot"@en,
        "耗用批次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:domain stl:Operation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:MaterialLot ;
    rdfs:subPropertyOf prov:used ;
    skos:definition "Identifies a lot drawn upon in an operation, including a lot from which only part of the material was used."@en,
        "指向本次工序实际取料或加工的一个物料批，一批只耗用部分物料时仍引用原批。"@zh ;
    skos:prefLabel "Consumed lot"@en,
        "耗用批次"@zh .

stl:consumedQuantity a owl:DatatypeProperty ;
    rdfs:label "Consumed quantity"@en,
        "批次耗用量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:LotAllocation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:decimal ;
    skos:definition "Mass in tonnes actually drawn from one lot for the operation identified on a consumption entry."@en,
        "一条投料明细中从指定物料批实际耗用于指定工序的质量，以吨计。"@zh ;
    skos:prefLabel "Consumed quantity"@en,
        "批次耗用量"@zh ;
    stl:quantityKind quantitykind:Mass ;
    stl:unit unit:TONNE .

stl:contributedHeat a owl:ObjectProperty ;
    rdfs:label "Contributing heat"@en,
        "贡献炉次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:HeatContribution ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:Heat ;
    rdfs:subPropertyOf stl:contributionInput ;
    skos:definition "Identifies the heat whose contribution the individual entry describes."@en,
        "指出本条炉源份额明细所描述的实际供钢炉次。"@zh ;
    skos:prefLabel "Contributing heat"@en,
        "贡献炉次"@zh .

stl:contribution a owl:ObjectProperty ;
    rdfs:label "Source contribution entry"@en,
        "来源份额明细"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Material ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:SourceContribution ;
    owl:inverseOf stl:contributionOutput ;
    skos:definition "Links an output lot or piece to the entry explaining one direct source and the basis for its share."@en,
        "从产出批或件指向说明其中一个直接来源及其份额依据的明细。"@zh ;
    skos:prefLabel "Source contribution entry"@en,
        "来源份额明细"@zh .

stl:countedMass a owl:DatatypeProperty ;
    rdfs:label "Counted stock mass"@en,
        "实盘质量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:StocktakeLine ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the physical stock mass established at the indicated location in a stocktake."@en,
        "记录盘点时在所述位置实点确认的物料质量。"@zh ;
    skos:prefLabel "Counted stock mass"@en,
        "实盘质量"@zh ;
    stl:quantityKind quantitykind:Mass ;
    stl:unit unit:TONNE .

stl:coverageDescription a owl:DatatypeProperty ;
    rdfs:label "Coverage description"@en,
        "覆盖部位说明"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:ExaminationCoverage ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:string ;
    skos:definition "Locates the examined regions and any excluded portions relative to a defined reference."@en,
        "说明本次检测覆盖的区域、基准位置及排除段。"@zh ;
    skos:prefLabel "Coverage description"@en,
        "覆盖部位说明"@zh .

stl:cuttingSequence a owl:DatatypeProperty ;
    rdfs:label "Planned cut sequence"@en,
        "计划切序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:CuttingPlan ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Gives the scheduled position of an intended cut for comparison with the cuts performed."@en,
        "给出拟实施的切割在计划中的顺位，供对照实际切分记录。"@zh ;
    skos:prefLabel "Planned cut sequence"@en,
        "计划切序"@zh .

stl:defect a owl:ObjectProperty ;
    rdfs:label "Referenced defect"@en,
        "涉及缺陷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:Defect ;
    skos:definition "Identifies an individual defect cited in support of the disposition."@en,
        "把一项处置与有实物证据的具体缺陷关联。"@zh ;
    skos:prefLabel "Referenced defect"@en,
        "涉及缺陷"@zh .

stl:definedMaterial a owl:ObjectProperty ;
    rdfs:label "Governing material specification"@en,
        "采用的物料规格"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:domain stl:Material ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:MaterialSpecification ;
    skos:definition "Identifies the reusable specification under which a physical lot or piece is identified."@en,
        "指明实际物料归属的规格，该规格可供多个批次或实物件共同引用。"@zh ;
    skos:prefLabel "Governing material specification"@en,
        "采用的物料规格"@zh .

stl:deliveryCondition a owl:ObjectProperty ;
    rdfs:label "Required delivery condition"@en,
        "要求交货状态"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:MaterialSpecification stl:DeliveryCondition ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/delivery-condition> ;
    skos:definition "Identifies the processing or treatment condition called for by the specification or delivery provision."@en,
        "以交货状态代码标明规格或交货条款要求材料具备的加工或热处理状态。"@zh ;
    skos:prefLabel "Required delivery condition"@en,
        "要求交货状态"@zh .

stl:deliveryOrderLine a owl:ObjectProperty ;
    rdfs:label "Delivered order item"@en,
        "交货对应订单行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:ShipmentLine ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:SalesOrderLine ;
    skos:definition "Identifies the order item fulfilled by a particular shipment line."@en,
        "把一次发运明细对应到所履行的订货项目。"@zh ;
    skos:prefLabel "Delivered order item"@en,
        "交货对应订单行"@zh .

stl:destination a owl:ObjectProperty ;
    rdfs:label "Planned destination"@en,
        "计划目的地"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:MovementOrder ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:Location ;
    skos:definition "Identifies the intended destination under the movement instruction."@en,
        "给出移库指令拟将物料送达的计划位置。"@zh ;
    skos:prefLabel "Planned destination"@en,
        "计划目的地"@zh .

stl:dimensionItem a owl:ObjectProperty ;
    rdfs:label "Specified dimension item"@en,
        "受控尺寸项"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:DimensionRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    skos:definition "Identifies the dimensional characteristic, such as width or thickness, to which the tolerance applies."@en,
        "标明该尺寸条款所限制的几何量，例如宽度或厚度。"@zh ;
    skos:prefLabel "Specified dimension item"@en,
        "受控尺寸项"@zh .

stl:dispatchedMass a owl:DatatypeProperty ;
    rdfs:label "Dispatched mass"@en,
        "发运质量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:ShipmentLine ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the actual net mass credited to the shipment line at handover."@en,
        "记录该发运明细在交接时计入的实际净质量。"@zh ;
    skos:prefLabel "Dispatched mass"@en,
        "发运质量"@zh ;
    stl:quantityKind quantitykind:Mass ;
    stl:unit unit:TONNE .

stl:editionEffectiveOn a owl:DatatypeProperty ;
    rdfs:label "Edition effective date"@en,
        "版次实施日期"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:StandardEdition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:date ;
    skos:definition "Gives the calendar date from which the cited edition takes effect."@en,
        "记录该标准版次开始实施的日历日期以核对订货依据。"@zh ;
    skos:prefLabel "Edition effective date"@en,
        "版次实施日期"@zh .

stl:elongationAfterFracture a owl:DatatypeProperty ;
    rdfs:label "Elongation after fracture"@en,
        "断后伸长率"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-228-1-2021> ;
    rdfs:domain stl:MechanicalTest ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:decimal ;
    skos:definition "Expresses permanent gauge extension after fracture as a percentage of initial gauge length."@en,
        "给出拉断后永久标距增量相对原始标距的百分比。"@zh ;
    skos:prefLabel "Elongation after fracture"@en,
        "断后伸长率"@zh ;
    stl:quantityKind quantitykind:DimensionlessRatio ;
    stl:unit unit:PERCENT .

stl:eventLocation a owl:ObjectProperty ;
    rdfs:label "Movement event location"@en,
        "移动发生位置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:MovementEvent ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:Location ;
    skos:definition "Identifies where the action occurred, giving the pick-up position for a lift or the actual destination for a set-down."@en,
        "指向该次动作实际发生处，吊起时为起吊位置，落位时为到达位置。"@zh ;
    skos:prefLabel "Movement event location"@en,
        "移动发生位置"@zh .

stl:evidenceCriterion a owl:ObjectProperty ;
    rdfs:label "Evidence criterion"@en,
        "所据验收判据"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:DecisionEvidence ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    skos:definition "Identifies the acceptance provision or specification requirement used to interpret the cited result."@en,
        "指向该条判定明细实际用来解释检验结果的验收条款或规格要求。"@zh ;
    skos:prefLabel "Evidence criterion"@en,
        "所据验收判据"@zh .

stl:evidenceResult a owl:ObjectProperty ;
    rdfs:label "Inspection evidence result"@en,
        "所据检验结果"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:DecisionEvidence ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:InspectionResult ;
    skos:definition "Identifies the individual inspection result cited as decision evidence."@en,
        "给出判定明细引用的那条检验结果。"@zh ;
    skos:prefLabel "Inspection evidence result"@en,
        "所据检验结果"@zh .

stl:executesSegment a owl:ObjectProperty ;
    rdfs:label "Implements segment"@en,
        "执行工序段"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:domain stl:Operation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:ProcessSegment ;
    skos:definition "Identifies the reusable segment definition followed by an execution."@en,
        "指出本次实际作业采用的可复用工序段定义。"@zh ;
    skos:prefLabel "Implements segment"@en,
        "执行工序段"@zh .

stl:fedWireLength a owl:DatatypeProperty ;
    rdfs:label "Wire length fed"@en,
        "实际喂线长度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:CoredWireFeeding ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:range xsd:decimal ;
    skos:definition "Length of cored wire actually delivered into the steel during the feeding operation, in metres."@en,
        "本次喂线实际送入钢液的包芯线长度，以米计。"@zh ;
    skos:prefLabel "Wire length fed"@en,
        "实际喂线长度"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:M .

stl:fieldMagnification a owl:DatatypeProperty ;
    rdfs:label "Field magnification"@en,
        "视场放大倍数"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-13298-2015> ;
    rdfs:domain stl:MetallographicField ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the linear magnification used to image the field."@en,
        "记录制取该观察视场图像时使用的线性放大倍数。"@zh ;
    skos:prefLabel "Field magnification"@en,
        "视场放大倍数"@zh ;
    stl:quantityKind quantitykind:DimensionlessRatio ;
    stl:unit unit:UNITLESS .

stl:finishRollingTemperature a owl:DatatypeProperty ;
    rdfs:label "Finish rolling temperature"@en,
        "终轧温度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:HotRolling ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:range xsd:decimal ;
    skos:definition "The temperature of the rolled steel at the exit of its final hot rolling pass."@en,
        "轧件通过热轧最后一道变形道次时在出口记录的料温。"@zh ;
    skos:prefLabel "Finish rolling temperature"@en,
        "终轧温度"@zh ;
    stl:quantityKind quantitykind:CelsiusTemperature ;
    stl:unit unit:DEG_C .

stl:forOrderLine a owl:ObjectProperty ;
    rdfs:label "For order line"@en,
        "服务订单行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:ProductionOrder ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:SalesOrderLine ;
    skos:definition "Identifies the demand item for which the production order was issued."@en,
        "说明该生产订单是为履行哪一订货项目而下达。"@zh ;
    skos:prefLabel "For order line"@en,
        "服务订单行"@zh .

stl:forProductionOrder a owl:ObjectProperty ;
    rdfs:label "For production order"@en,
        "切割计划服务的生产订单"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:CuttingPlan ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range stl:ProductionOrder ;
    skos:definition "Identifies the production order whose required pieces are scheduled in the cutting plan."@en,
        "从切割计划指向提出所需坯件的生产订单。"@zh ;
    skos:prefLabel "For production order"@en,
        "切割计划服务的生产订单"@zh .

stl:formationRule a owl:ObjectProperty ;
    rdfs:label "Applied lot formation rule"@en,
        "采用的组批规则"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:domain stl:InspectionLot ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:LotFormationRule ;
    skos:definition "Identifies the rule used to group the material in this inspection lot."@en,
        "指出建立这个检验批时实际采用的组批规则。"@zh ;
    skos:prefLabel "Applied lot formation rule"@en,
        "采用的组批规则"@zh .

stl:fulfills a owl:ObjectProperty ;
    rdfs:label "Fulfils plan"@en,
        "落实计划"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Event ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:Plan ;
    skos:definition "Relates an actual occurrence to the plan it implements."@en,
        "把一项已发生的作业或事件与其完成的计划相连。"@zh ;
    skos:prefLabel "Fulfils plan"@en,
        "落实计划"@zh .

stl:governedByCriterion a owl:ObjectProperty ;
    rdfs:label "Governing acceptance criterion"@en,
        "采用验收判据"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:InspectionRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range stl:AcceptanceCriterion ;
    skos:definition "Identifies the rule used to interpret evidence for an inspection requirement."@en,
        "指定某项检验要求用来判读证据的验收规则。"@zh ;
    skos:prefLabel "Governing acceptance criterion"@en,
        "采用验收判据"@zh .

stl:hardnessRecordValue a owl:DatatypeProperty ;
    rdfs:label "Reported hardness notation"@en,
        "硬度报告记号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-230-1-2018> ;
    rdfs:domain stl:HardnessTest ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:string ;
    skos:definition "Preserves the reported hardness designation with its number, scale and any stated test conditions."@en,
        "保存试验报告中的完整硬度表示，含硬度数、标尺及原报告给出的条件。"@zh ;
    skos:prefLabel "Reported hardness notation"@en,
        "硬度报告记号"@zh .

stl:heatTreatmentTemperature a owl:DatatypeProperty ;
    rdfs:label "Heat treatment temperature"@en,
        "热处理温度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:HeatTreatment stl:HeatTreatmentHold ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment> ;
    rdfs:range xsd:decimal ;
    skos:definition "The holding temperature of the workpiece reported for a treatment run, in degrees Celsius. For a cycle with several holds the value is recorded on the corresponding hold."@en,
        "热处理实绩中记录的工件保温温度，以摄氏度计，多段保温可按阶段分别记录。"@zh ;
    skos:prefLabel "Heat treatment temperature"@en,
        "热处理温度"@zh ;
    stl:quantityKind quantitykind:CelsiusTemperature ;
    stl:unit unit:DEG_C .

stl:impactEnergy a owl:DatatypeProperty ;
    rdfs:label "Impact energy"@en,
        "冲击吸收功"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-229-2020> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:MechanicalTest stl:Observation ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the energy absorbed when the specimen breaks under the specified impact conditions."@en,
        "给出试样在规定冲击条件下一次冲断所吸收的能量。"@zh ;
    skos:prefLabel "Impact energy"@en,
        "冲击吸收功"@zh ;
    stl:quantityKind quantitykind:Energy ;
    stl:unit unit:J .

stl:indicationPosition a owl:DatatypeProperty ;
    rdfs:label "Indication position"@en,
        "显示位置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:TestIndication ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:string ;
    skos:definition "Locates the detected response relative to an identified reference on the examined piece."@en,
        "以受检件基准表述检测响应所在的位置。"@zh ;
    skos:prefLabel "Indication position"@en,
        "显示位置"@zh .

stl:inspectedPiece a owl:ObjectProperty ;
    rdfs:label "Examined piece"@en,
        "受检实物件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:InspectionActivityRecord ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:MaterialPiece ;
    skos:definition "Identifies the piece examined in whole or in part under this inspection record."@en,
        "指向按本记录接受整件或局部检验的实物。"@zh ;
    skos:prefLabel "Examined piece"@en,
        "受检实物件"@zh .

stl:inspectionEvidence a owl:ObjectProperty ;
    rdfs:label "Inspection evidence for decision"@en,
        "判定所据记录"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDecision ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:ManufacturingRecord ;
    skos:definition "Identifies a test record, result or evidence entry actually used in reaching this decision."@en,
        "指向该次判定实际采信的试验、结果或判定依据明细。"@zh ;
    skos:prefLabel "Inspection evidence for decision"@en,
        "判定所据记录"@zh .

stl:installedAtUnit a owl:ObjectProperty ;
    rdfs:label "Serving work unit"@en,
        "服役工作单元"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Equipment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:WorkUnit ;
    skos:definition "Relates a physical asset to the functional work unit it serves."@en,
        "把物理设备关联到它所服务的功能工作单元。"@zh ;
    skos:prefLabel "Serving work unit"@en,
        "服役工作单元"@zh .

stl:installedTool a owl:ObjectProperty ;
    rdfs:label "Tool fitted"@en,
        "装入工装"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:ToolInstallation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:ProductionTool ;
    skos:definition "Identifies the traceable tool fitted during an installation."@en,
        "指明装配作业实际装入设备的有标识工装。"@zh ;
    skos:prefLabel "Tool fitted"@en,
        "装入工装"@zh .

stl:intervalOutput a owl:ObjectProperty ;
    rdfs:label "Output of source interval"@en,
        "区段产出件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SourceInterval ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:MaterialPiece ;
    skos:definition "Identifies the immediate output piece made using the specified source interval."@en,
        "指明利用该来源区段生成的直接下游件。"@zh ;
    skos:prefLabel "Output of source interval"@en,
        "区段产出件"@zh .

stl:intervalSource a owl:ObjectProperty ;
    rdfs:label "Source of interval"@en,
        "区段来源件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SourceInterval ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:MaterialPiece ;
    skos:definition "Identifies the immediate source piece on which the interval coordinates are defined."@en,
        "给出定义区段坐标的直接来源件。"@zh ;
    skos:prefLabel "Source of interval"@en,
        "区段来源件"@zh .

stl:isTransitionSlab a owl:DatatypeProperty ;
    rdfs:label "Marked as heat-transition piece"@en,
        "明确标为交接坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:Slab stl:ContinuouslyCastPiece ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range xsd:boolean ;
    skos:definition "Records an explicit designation of a piece as a heat-transition piece independently of its position at either end of a heat."@en,
        "记录生产资料是否将该坯件明确标为前后炉次交接处的坯件，首尾顺位本身不作此标记。"@zh ;
    skos:prefLabel "Marked as heat-transition piece"@en,
        "明确标为交接坯"@zh .

stl:issuedOn a owl:DatatypeProperty ;
    rdfs:label "Issue date"@en,
        "签发日期"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:date ;
    skos:definition "Gives the calendar date of formal document issue."@en,
        "记载凭证经正式签发的日历日期。"@zh ;
    skos:prefLabel "Issue date"@en,
        "签发日期"@zh .

stl:lineNumber a owl:DatatypeProperty ;
    rdfs:label "Order line number"@en,
        "订单行号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SalesOrderLine ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Gives the assigned line ordinal within a particular sales order."@en,
        "给出订货项目在所属销售订单中的行序号。"@zh ;
    skos:prefLabel "Order line number"@en,
        "订单行号"@zh .

stl:loadedOn a owl:ObjectProperty ;
    rdfs:label "Loaded carrier"@en,
        "装运载具"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Shipment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:TransportUnit ;
    skos:definition "Identifies a carrier physically loaded with goods for the shipment."@en,
        "给出承载本次发运货物的实际载具。"@zh ;
    skos:prefLabel "Loaded carrier"@en,
        "装运载具"@zh .

stl:locatedIn a owl:ObjectProperty ;
    rdfs:label "Located in"@en,
        "所属区域"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:Location ;
    skos:definition "Identifies the containing place for a storage position or an assigned asset."@en,
        "给出设备或库位归属的库区等空间位置。"@zh ;
    skos:prefLabel "Located in"@en,
        "所属区域"@zh .

stl:lotMember a owl:ObjectProperty ;
    rdfs:label "Inspection lot member"@en,
        "检验批成员"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:domain stl:InspectionLot ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:MaterialPiece ;
    skos:definition "Identifies a piece grouped with other members for lot inspection or assessment."@en,
        "列出与同批成员共同接受规定检验或判定的一件实物。"@zh ;
    skos:prefLabel "Inspection lot member"@en,
        "检验批成员"@zh .

stl:lowerDeviation a owl:DatatypeProperty ;
    rdfs:label "Lower dimensional deviation"@en,
        "尺寸下偏差"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-709-2019> ;
    rdfs:domain stl:DimensionRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the signed difference between the smallest permitted dimension and its nominal value."@en,
        "给出允许最小尺寸减去公称尺寸所得的有符号差值。"@zh ;
    skos:prefLabel "Lower dimensional deviation"@en,
        "尺寸下偏差"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:MilliM .

stl:lowerYieldStrength a owl:DatatypeProperty ;
    rdfs:label "Lower yield strength"@en,
        "下屈服强度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-228-1-2021> ;
    rdfs:domain stl:MechanicalTest ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the lowest engineering stress during yielding once initial transient effects are excluded."@en,
        "给出剔除初始瞬态影响后屈服阶段测得的最低工程应力。"@zh ;
    skos:prefLabel "Lower yield strength"@en,
        "下屈服强度"@zh ;
    stl:quantityKind quantitykind:Stress ;
    stl:unit unit:MegaPA .

stl:massFraction a owl:DatatypeProperty ;
    rdfs:label "Elemental mass percentage"@en,
        "元素质量百分数"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-3102-8-1993> ;
    rdfs:domain stl:ElementResult ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the analyte mass as a percentage of sample mass on the stated analytical basis."@en,
        "给出某元素按所述分析口径占样品质量的百分数。"@zh ;
    skos:prefLabel "Elemental mass percentage"@en,
        "元素质量百分数"@zh ;
    stl:quantityKind quantitykind:MassFraction ;
    stl:unit unit:PERCENT .

stl:maximumImpactEnergy a owl:DatatypeProperty ;
    rdfs:label "Maximum absorbed impact energy"@en,
        "最高冲击吸收能量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:ImpactRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the upper bound in joules for absorbed impact energy when the applicable provision specifies one."@en,
        "给出条款明确规定时同一试验条件下允许的冲击吸收能量上界，以焦耳计。"@zh ;
    skos:prefLabel "Maximum absorbed impact energy"@en,
        "最高冲击吸收能量"@zh ;
    stl:quantityKind quantitykind:Energy ;
    stl:unit unit:J .

stl:maximumTensileStrength a owl:DatatypeProperty ;
    rdfs:label "Maximum tensile strength"@en,
        "最高抗拉强度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-700-2006> ;
    rdfs:domain stl:TensileRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the upper bound in megapascals accepted for tensile strength under the specified test conditions."@en,
        "给出在规定试验条件下订货条款允许的抗拉强度上界，以兆帕计。"@zh ;
    skos:prefLabel "Maximum tensile strength"@en,
        "最高抗拉强度"@zh ;
    stl:quantityKind quantitykind:Stress ;
    stl:unit unit:MegaPA .

stl:minimumCoatingMass a owl:DatatypeProperty ;
    rdfs:label "Minimum coating mass per area"@en,
        "最低单位面积镀层质量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-2518-2019> ;
    rdfs:domain stl:MaterialSpecification ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the minimum coating mass per area accepted by the material specification."@en,
        "记录订货规格允许的单位面积镀层质量下界。"@zh ;
    skos:prefLabel "Minimum coating mass per area"@en,
        "最低单位面积镀层质量"@zh ;
    stl:quantityKind quantitykind:MassPerArea ;
    stl:unit unit:GM-PER-M2 .

stl:minimumImpactEnergy a owl:DatatypeProperty ;
    rdfs:label "Minimum absorbed impact energy"@en,
        "最低冲击吸收能量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1591-2018> ;
    rdfs:domain stl:ImpactRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the specified lower bound for absorbed impact energy under the referenced provision."@en,
        "记录所引条款要求达到的冲击吸收能量下界。"@zh ;
    skos:prefLabel "Minimum absorbed impact energy"@en,
        "最低冲击吸收能量"@zh ;
    stl:quantityKind quantitykind:Energy ;
    stl:unit unit:J .

stl:minimumTensileStrength a owl:DatatypeProperty ;
    rdfs:label "Minimum tensile strength"@en,
        "最低抗拉强度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-700-2006> ;
    rdfs:domain stl:TensileRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the lower tensile strength limit for the applicable thickness and orientation."@en,
        "给出适用厚度和取向条件下规定的抗拉强度下限。"@zh ;
    skos:prefLabel "Minimum tensile strength"@en,
        "最低抗拉强度"@zh ;
    stl:quantityKind quantitykind:Stress ;
    stl:unit unit:MegaPA .

stl:nextGrade a owl:ObjectProperty ;
    rdfs:label "Following steel grade"@en,
        "过渡后钢种"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:Slab stl:ContinuouslyCastPiece ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range stl:SteelGrade ;
    skos:definition "Identifies the internal grade of the incoming heat at a transition between steel grades."@en,
        "标识换钢种的过渡区后继供钢炉次的内部钢种。"@zh ;
    skos:prefLabel "Following steel grade"@en,
        "过渡后钢种"@zh .

stl:nextOrderLine a owl:ObjectProperty ;
    rdfs:label "Resulting order line"@en,
        "处置后订单行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:SalesOrderLine ;
    skos:definition "Identifies the order item assigned the material after disposition."@en,
        "给出处置生效后应承接该实物的订单行。"@zh ;
    skos:prefLabel "Resulting order line"@en,
        "处置后订单行"@zh .

stl:nextSpecification a owl:ObjectProperty ;
    rdfs:label "Resulting specification"@en,
        "处置后规格"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:MaterialSpecification ;
    skos:definition "Identifies the specification assigned to the material after the action took effect."@en,
        "说明此次处置生效后实物将按哪份规格管理。"@zh ;
    skos:prefLabel "Resulting specification"@en,
        "处置后规格"@zh .

stl:nextStep a owl:ObjectProperty ;
    rdfs:label "Next route step"@en,
        "后续路线步骤"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:RouteStep ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:RouteStep ;
    skos:definition "Identifies a route step permitted to follow the current step directly."@en,
        "给出同一路线允许直接接续的下一步骤。"@zh ;
    skos:prefLabel "Next route step"@en,
        "后续路线步骤"@zh .

stl:nominalDimension a owl:DatatypeProperty ;
    rdfs:label "Nominal dimension"@en,
        "公称尺寸"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-709-2019> ;
    rdfs:domain stl:DimensionRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the reference dimension to which upper and lower deviations are applied."@en,
        "记录一项尺寸要求在施加上、下偏差前的基准值。"@zh ;
    skos:prefLabel "Nominal dimension"@en,
        "公称尺寸"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:MilliM .

stl:numericDesignation a owl:DatatypeProperty ;
    rdfs:label "Unified numerical designation"@en,
        "统一数字代号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17616-2025> ;
    rdfs:domain stl:StandardGrade ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:string ;
    skos:definition "Records the unified numerical designation assigned to a grade under the iron, steel and alloy designation system, preserving leading zeros."@en,
        "给出标准牌号在钢铁及合金统一数字代号体系中的代号，按原写法保留前导零。"@zh ;
    skos:prefLabel "Unified numerical designation"@en,
        "统一数字代号"@zh .

<https://w3id.org/ontology-platform/steel/ontology/steel> a owl:Ontology ;
    rdfs:label "Steel manufacturing ontology"@en,
        "钢铁冶金通用本体"@zh ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    owl:versionIRI <https://w3id.org/ontology-platform/steel/ontology/steel/0.1.0> ;
    owl:versionInfo "0.1.0" .

stl:oreTumbleIndex a owl:DatatypeProperty ;
    rdfs:label "Iron ore tumble index"@en,
        "铁矿料转鼓指数"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-3271-2015> ;
    rdfs:domain stl:IronOre ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:range xsd:decimal ;
    skos:definition "The percentage of a lump ore, sinter or pellet sample retained above the designated sieve after a tumble test, relative to the initial sample mass."@en,
        "块矿、烧结矿或球团矿试样经转鼓试验后保留在指定筛上的质量占原试样质量的百分数。"@zh ;
    skos:prefLabel "Iron ore tumble index"@en,
        "铁矿料转鼓指数"@zh ;
    stl:quantityKind quantitykind:MassFraction ;
    stl:unit unit:PERCENT .

stl:outputLot a owl:ObjectProperty ;
    rdfs:label "Output lot"@en,
        "产出料批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:domain stl:Operation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:MaterialLot ;
    skos:definition "Identifies a material lot established as an output of an execution."@en,
        "指向一次工序执行形成并取得独立批身份的输出。"@zh ;
    skos:prefLabel "Output lot"@en,
        "产出料批"@zh .

stl:parentLot a owl:ObjectProperty ;
    rdfs:label "Parent lot"@en,
        "母批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:MaterialSublot ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:MaterialLot ;
    skos:definition "Identifies the immediate lot from which a sublot was set apart."@en,
        "指出本子批按量划出的直接母批。"@zh ;
    skos:prefLabel "Parent lot"@en,
        "母批"@zh .

stl:partOfEquipment a owl:ObjectProperty ;
    rdfs:label "Parent equipment"@en,
        "所属上级设备"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-1-2013> ;
    rdfs:domain stl:Equipment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:Equipment ;
    rdfs:subPropertyOf stl:partOf ;
    skos:definition "Links an equipment resource or functional unit to its immediate parent in the equipment hierarchy."@en,
        "从设备或功能单元指向设备层级中直接包含它的上一级资源。"@zh ;
    skos:prefLabel "Parent equipment"@en,
        "所属上级设备"@zh .

stl:plannedLength a owl:DatatypeProperty ;
    rdfs:label "Planned cut length"@en,
        "计划切割长度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:CuttingPlan ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the target length in metres specified for the piece in a planned cut."@en,
        "给出切割计划为拟产出件安排的目标长度，以米记录。"@zh ;
    skos:prefLabel "Planned cut length"@en,
        "计划切割长度"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:M .

stl:plannedLoadPosition a owl:ObjectProperty ;
    rdfs:label "Planned load position"@en,
        "计划装载位置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:LoadingPlan ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:LoadPosition ;
    skos:definition "Identifies a position on the carrier assigned to goods by the loading plan."@en,
        "指明装载计划为待运货物安排的载具内位置。"@zh ;
    skos:prefLabel "Planned load position"@en,
        "计划装载位置"@zh .

stl:positionInHeat a owl:DatatypeProperty ;
    rdfs:label "Piece position within heat"@en,
        "炉内出坯次序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:Slab stl:ContinuouslyCastPiece ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Records the original casting position on a strand within a heat, retained by pieces recut from the original piece."@en,
        "标明坯件在同炉同流中的实际出坯次序，再次分切所得坯沿用原坯的次序。"@zh ;
    skos:prefLabel "Piece position within heat"@en,
        "炉内出坯次序"@zh .

stl:positionInSequence a owl:DatatypeProperty ;
    rdfs:label "Piece position within casting sequence"@en,
        "浇次内出坯次序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:Slab stl:ContinuouslyCastPiece ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Records the casting position of a piece on one strand counted across the full casting sequence."@en,
        "标明坯件在同一流的整个浇次内按实际出坯先后所处的位置。"@zh ;
    skos:prefLabel "Piece position within casting sequence"@en,
        "浇次内出坯次序"@zh .

stl:positionOnUnit a owl:ObjectProperty ;
    rdfs:label "Carrier of load position"@en,
        "装载位置所属载具"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:LoadPosition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:TransportUnit ;
    skos:definition "Identifies the particular carrier on which this loading position is located."@en,
        "标识提供这个装载位置的具体运输载具。"@zh ;
    skos:prefLabel "Carrier of load position"@en,
        "装载位置所属载具"@zh .

stl:preparedFromSample a owl:ObjectProperty ;
    rdfs:label "Parent sample"@en,
        "制样来源样品"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-2975-2018> ;
    rdfs:domain stl:TestPiece ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:Sample ;
    skos:definition "Identifies the immediate sample from which the specimen was prepared."@en,
        "指出制取试样所用的直接来源样品。"@zh ;
    skos:prefLabel "Parent sample"@en,
        "制样来源样品"@zh .

stl:previousGrade a owl:ObjectProperty ;
    rdfs:label "Preceding steel grade"@en,
        "过渡前钢种"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:Slab stl:ContinuouslyCastPiece ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range stl:SteelGrade ;
    skos:definition "Identifies the internal grade of the outgoing heat at a transition between steel grades."@en,
        "标识换钢种的过渡区开始前供钢炉次的内部钢种。"@zh ;
    skos:prefLabel "Preceding steel grade"@en,
        "过渡前钢种"@zh .

stl:previousOrderLine a owl:ObjectProperty ;
    rdfs:label "Previous order line"@en,
        "处置前订单行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:SalesOrderLine ;
    skos:definition "Identifies the order item allocated to the material before disposition."@en,
        "保留处置生效之前该实物所分配的订单行。"@zh ;
    skos:prefLabel "Previous order line"@en,
        "处置前订单行"@zh .

stl:previousSpecification a owl:ObjectProperty ;
    rdfs:label "Previous specification"@en,
        "处置前规格"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:MaterialSpecification ;
    skos:definition "Identifies the specification assigned to the material before the action took effect."@en,
        "说明此次处置发生前实物按哪份物料规格管理。"@zh ;
    skos:prefLabel "Previous specification"@en,
        "处置前规格"@zh .

stl:producedOnFurnace a owl:ObjectProperty ;
    rdfs:label "Producing furnace"@en,
        "冶炼炉座"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Heat ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:range stl:Equipment ;
    skos:definition "Links a heat to the furnace that made and tapped it, identifying the physical source of the steel."@en,
        "从炉次指向冶炼并出钢形成该炉次的炉座，用于按设备追溯钢水的来源。"@zh ;
    skos:prefLabel "Producing furnace"@en,
        "冶炼炉座"@zh .

stl:quantityKind a owl:AnnotationProperty ;
    rdfs:label "Quantity kind"@en,
        "量的种类"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-80000-1-2022> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    skos:definition "Identifies what the values of a numeric property quantify, such as mass, mass fraction or count."@en,
        "标明数值属性所表达的量，例如质量、质量分数或件数。"@zh ;
    skos:prefLabel "Quantity kind"@en,
        "量的种类"@zh .

stl:ratingDesignation a owl:DatatypeProperty ;
    rdfs:label "Reported rating designation"@en,
        "评定级别原记号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:RatingResult ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:string ;
    skos:definition "Preserves the reported grade notation on the cited scale including alphanumeric grades."@en,
        "保存所用标尺上的原始等级记号以支持数字与字母分级。"@zh ;
    skos:prefLabel "Reported rating designation"@en,
        "评定级别原记号"@zh .

stl:ratingScale a owl:ObjectProperty ;
    rdfs:label "Rating scale used"@en,
        "采用评级标尺"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:RatingResult ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:RatingScale ;
    skos:definition "Identifies the scale on which a particular rating can be interpreted."@en,
        "把具体评级结果与解释其等级所需的标尺关联。"@zh ;
    skos:prefLabel "Rating scale used"@en,
        "采用评级标尺"@zh .

stl:reason a owl:DatatypeProperty ;
    rdfs:label "Disposition reason"@en,
        "处置原因"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:string ;
    skos:definition "Records the facts or deviations motivating the authorized action."@en,
        "说明授权本次处置所基于的异常、偏差或业务事实。"@zh ;
    skos:prefLabel "Disposition reason"@en,
        "处置原因"@zh .

stl:rebarGradeSuffix a owl:DatatypeProperty ;
    rdfs:label "Rebar grade suffix"@en,
        "钢筋牌号后缀"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:comment "下沉理由：带肋钢筋交验时需识别牌号中的抗震标识，其含义由钢筋产品标准约定。"@zh ;
    rdfs:domain stl:Rebar ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products> ;
    rdfs:range xsd:string ;
    skos:definition "Records the suffix of the grade used for this bar, such as E for seismic performance in HRB400E."@en,
        "记录该支钢筋所用牌号的附加字母，例如 HRB400E 的 E 表示有抗震性能要求。"@zh ;
    skos:prefLabel "Rebar grade suffix"@en,
        "钢筋牌号后缀"@zh .

stl:receivedOn a owl:DatatypeProperty ;
    rdfs:label "Receipt date"@en,
        "签收日期"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:DeliveryReceipt ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range xsd:date ;
    skos:definition "Gives the date on which the recipient acknowledged the delivery."@en,
        "记录收货方确认接收本次交付的日期。"@zh ;
    skos:prefLabel "Receipt date"@en,
        "签收日期"@zh .

stl:receivedShipment a owl:ObjectProperty ;
    rdfs:label "Shipment acknowledged"@en,
        "签收发运单"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:DeliveryReceipt ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:Shipment ;
    skos:definition "Identifies the shipment acknowledged by a delivery receipt."@en,
        "指明收货凭证确认收到的发运单。"@zh ;
    skos:prefLabel "Shipment acknowledged"@en,
        "签收发运单"@zh .

stl:reductionRatio a owl:DatatypeProperty ;
    rdfs:label "Thickness reduction ratio"@en,
        "压下率"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Rolling ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:range xsd:decimal ;
    skos:definition "The difference between entry and exit thickness for a pass or group of passes, expressed as a percentage of entry thickness."@en,
        "一道或一组轧制道次中，入口厚度减去出口厚度所得差值占该段入口厚度的百分比。"@zh ;
    skos:prefLabel "Thickness reduction ratio"@en,
        "压下率"@zh ;
    stl:quantityKind quantitykind:DimensionlessRatio ;
    stl:unit unit:PERCENT .

stl:reheatingDischargeTemperature a owl:DatatypeProperty ;
    rdfs:label "Reheating furnace discharge temperature"@en,
        "加热炉出炉温度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Reheating ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:range xsd:decimal ;
    skos:definition "The temperature of the stock as it leaves the reheating furnace."@en,
        "坯料离开加热炉时的实际料温，炉膛气氛温度另行记录。"@zh ;
    skos:prefLabel "Reheating furnace discharge temperature"@en,
        "加热炉出炉温度"@zh ;
    stl:quantityKind quantitykind:CelsiusTemperature ;
    stl:unit unit:DEG_C .

stl:requiredProperty a owl:ObjectProperty ;
    rdfs:label "Required property"@en,
        "要求的性能项"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:PropertyRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    skos:definition "Identifies the measured property, such as tensile strength or absorbed impact energy, governed by the requirement."@en,
        "标明性能要求所约束的测量项，例如抗拉强度或冲击吸收能量。"@zh ;
    skos:prefLabel "Required property"@en,
        "要求的性能项"@zh .

stl:requiredSampleCount a owl:DatatypeProperty ;
    rdfs:label "Required sample count"@en,
        "要求样品数"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SamplingRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Gives the number of samples required from a sampling unit under the applicable provision."@en,
        "记录在该抽样单元内按条款应取的样品件数。"@zh ;
    skos:prefLabel "Required sample count"@en,
        "要求样品数"@zh ;
    stl:quantityKind quantitykind:Count ;
    stl:unit unit:NUM .

stl:requirementClause a owl:DatatypeProperty ;
    rdfs:label "Requirement clause reference"@en,
        "要求条款定位符"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Requirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:string ;
    skos:definition "Preserves the clause reference locating a requirement within its edition or agreement."@en,
        "保留标准版次或技术协议内定位一项要求的条款标识。"@zh ;
    skos:prefLabel "Requirement clause reference"@en,
        "要求条款定位符"@zh .

stl:requiresGrade a owl:ObjectProperty ;
    rdfs:label "Required grade"@en,
        "要求牌号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:domain stl:MaterialSpecification ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range stl:StandardGrade ;
    skos:definition "Identifies a standard grade required to fulfil the material specification."@en,
        "指出履行一份物料规格所需采用的标准牌号条目。"@zh ;
    skos:prefLabel "Required grade"@en,
        "要求牌号"@zh .

stl:requiresSpecification a owl:ObjectProperty ;
    rdfs:label "Required material specification"@en,
        "订货规格"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:domain stl:SalesOrderLine ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range stl:MaterialSpecification ;
    skos:definition "Identifies the material specification ordered on this line."@en,
        "标明该订单行明确订购的物料规格。"@zh ;
    skos:prefLabel "Required material specification"@en,
        "订货规格"@zh .

stl:respondsTo a owl:ObjectProperty ;
    rdfs:label "Responds to decision"@en,
        "处置依据的判定"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:QualityDecision ;
    skos:definition "Identifies the particular quality decision prompting the disposition."@en,
        "指明本项处置所响应的那一次质量判定。"@zh ;
    skos:prefLabel "Responds to decision"@en,
        "处置依据的判定"@zh .

stl:resultForField a owl:ObjectProperty ;
    rdfs:label "Field evaluated"@en,
        "评级所据视场"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> ;
    rdfs:domain stl:RatingResult ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:MetallographicField ;
    skos:definition "Identifies the observed field assessed by a field-level rating."@en,
        "指向视场级评级实际评定的那一观察区域。"@zh ;
    skos:prefLabel "Field evaluated"@en,
        "评级所据视场"@zh .

stl:retainedUntilOn a owl:DatatypeProperty ;
    rdfs:label "Retention end date"@en,
        "留样截至日期"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:RetainedSample ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:date ;
    skos:definition "Gives the date through which the retained sample is to be kept."@en,
        "给出该留样按约定至少应保存到的日期。"@zh ;
    skos:prefLabel "Retention end date"@en,
        "留样截至日期"@zh .

stl:rockwellCHardness a owl:DatatypeProperty ;
    rdfs:label "Rockwell C hardness number"@en,
        "洛氏 C 标尺硬度数"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-230-1-2018> ;
    rdfs:domain stl:HardnessTest ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the numerical result on the Rockwell C scale for comparison with requirements on that scale."@en,
        "记录在洛氏 C 标尺上报告的硬度数以便与同标尺要求比较。"@zh ;
    skos:prefLabel "Rockwell C hardness number"@en,
        "洛氏 C 标尺硬度数"@zh ;
    stl:quantityKind quantitykind:Dimensionless ;
    stl:unit unit:UNITLESS .

stl:roleType a owl:ObjectProperty ;
    rdfs:label "Personnel role type"@en,
        "人员角色类别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:domain stl:PersonnelRole ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/personnel-role> ;
    skos:definition "Classifies a manufacturing responsibility by the personnel role used for dispatch or approval."@en,
        "用人员角色代码归类一项制造职责，以便按职能汇总派工或审批记录。"@zh ;
    skos:prefLabel "Personnel role type"@en,
        "人员角色类别"@zh .

stl:row a owl:DatatypeProperty ;
    rdfs:label "Storage row"@en,
        "库位行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:StorageLocation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Gives the row ordinal of the position within its storage area."@en,
        "记录库位在所属库区坐标系中的行序号。"@zh ;
    skos:prefLabel "Storage row"@en,
        "库位行"@zh .

stl:sampleCollectedBy a owl:ObjectProperty ;
    rdfs:label "Collecting sampling operation"@en,
        "取样作业来源"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-14284-2022> ;
    rdfs:domain stl:Sample ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:Sampling ;
    rdfs:subPropertyOf sosa:isResultOf ;
    skos:definition "Identifies the sampling operation that physically obtained this sample."@en,
        "指向实际取得该样品的一次取样作业。"@zh ;
    skos:prefLabel "Collecting sampling operation"@en,
        "取样作业来源"@zh .

stl:samplePosition a owl:DatatypeProperty ;
    rdfs:label "Sampling position"@en,
        "取样位置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-2975-2018> ;
    rdfs:domain stl:Sample ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:string ;
    skos:definition "Locates the sample on its source material using the stated position and orientation."@en,
        "以被取样物料为参照说明样品取自哪个部位及方位。"@zh ;
    skos:prefLabel "Sampling position"@en,
        "取样位置"@zh .

stl:satisfies a owl:ObjectProperty ;
    rdfs:label "Satisfies grade"@en,
        "满足牌号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SteelGrade ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range stl:StandardGrade ;
    skos:definition "Relates an internal grade to a designation whose edition-specific requirements it can meet."@en,
        "从内部钢种指向其能够满足要求的版次化标准牌号。"@zh ;
    skos:prefLabel "Satisfies grade"@en,
        "满足牌号"@zh .

stl:scaleEdition a owl:ObjectProperty ;
    rdfs:label "Edition defining scale"@en,
        "标尺依据版次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:RatingScale ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:StandardEdition ;
    skos:definition "Identifies the edition defining the scale and the interpretation of its grades."@en,
        "指明给出这把评级标尺及其等级解释的具体文件版次。"@zh ;
    skos:prefLabel "Edition defining scale"@en,
        "标尺依据版次"@zh .

stl:scaleRank a owl:DatatypeProperty ;
    rdfs:label "Rank within rating scale"@en,
        "标尺内序位"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:ReferenceRatingLevel ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Records the one-based position of a level within its own scale when the governing document defines an order."@en,
        "在方法文件明确给出顺序时，记录某个级别在该标尺内从一开始的序位。"@zh ;
    skos:prefLabel "Rank within rating scale"@en,
        "标尺内序位"@zh .

stl:scheduledOrder a owl:ObjectProperty ;
    rdfs:label "Scheduled production order"@en,
        "计划内生产订单"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:domain stl:ProductionSchedule ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:ProductionOrder ;
    skos:definition "Identifies a production order included in the schedule."@en,
        "列明一份排产计划实际纳入的生产订单。"@zh ;
    skos:prefLabel "Scheduled production order"@en,
        "计划内生产订单"@zh .

stl:serialNumber a owl:DatatypeProperty ;
    rdfs:label "Serial number"@en,
        "流水号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Preserves the object's ordinal in the applicable serial numbering series."@en,
        "保留所属编号序列中分配给本对象的顺序号。"@zh ;
    skos:prefLabel "Serial number"@en,
        "流水号"@zh .

stl:shippedPackage a owl:ObjectProperty ;
    rdfs:label "Shipped package"@en,
        "发运包装件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1091-2018> ;
    rdfs:domain stl:Shipment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:Package ;
    skos:definition "Identifies a numbered package dispatched under the shipment document."@en,
        "列明在该发运单下实际交运的有编号包装件。"@zh ;
    skos:prefLabel "Shipped package"@en,
        "发运包装件"@zh .

stl:sinterBasicity a owl:DatatypeProperty ;
    rdfs:label "Sinter binary basicity"@en,
        "烧结矿二元碱度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-421-2014> ;
    rdfs:domain stl:Sinter ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:range xsd:decimal ;
    skos:definition "The ratio of calcium oxide to silicon dioxide mass fractions for a sinter lot, with both reported on the same analytical basis."@en,
        "以同一分析基准的氧化钙质量分数除以二氧化硅质量分数得到的烧结矿批次指标。"@zh ;
    skos:prefLabel "Sinter binary basicity"@en,
        "烧结矿二元碱度"@zh ;
    stl:quantityKind quantitykind:DimensionlessRatio ;
    stl:unit unit:UNITLESS .

stl:sourceEnd a owl:DatatypeProperty ;
    rdfs:label "Source interval end"@en,
        "来源区段终点"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SourceInterval ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the end distance along the source piece from the same origin as the start."@en,
        "给出同一区段终点距来源件同一零点的纵向距离。"@zh ;
    skos:prefLabel "Source interval end"@en,
        "来源区段终点"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:M .

stl:sourceStart a owl:DatatypeProperty ;
    rdfs:label "Source interval start"@en,
        "来源区段起点"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SourceInterval ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the start distance along the source piece from its designated origin."@en,
        "给出区段起点距所指来源件约定起端的纵向距离。"@zh ;
    skos:prefLabel "Source interval start"@en,
        "来源区段起点"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:M .

stl:specifiedForm a owl:ObjectProperty ;
    rdfs:label "Required product form"@en,
        "要求产品形态"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-15574-2016> ;
    rdfs:domain stl:MaterialSpecification ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/product-form> ;
