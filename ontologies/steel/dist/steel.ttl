stl:tappedHotMetalMass a owl:DatatypeProperty ;
    rdfs:label "Tapped hot metal mass"@en,
        "铁次出铁量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:BlastFurnaceTapping ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:range xsd:decimal ;
    skos:definition "The net mass of liquid iron discharged over one tap, excluding entrained slag and including the portions delivered to all receiving vessels."@en,
        "整个铁次排出的铁水净质量，扣除随流炉渣，分罐接收时合计本铁次送入各罐的铁水。"@zh ;
    skos:prefLabel "Tapped hot metal mass"@en,
        "铁次出铁量"@zh ;
    stl:quantityKind quantitykind:Mass ;
    stl:unit unit:TONNE .

stl:teemingMethod a owl:ObjectProperty ;
    rdfs:label "Ingot teeming method"@en,
        "模铸浇注方式"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:IngotCasting ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/teeming-method> ;
    skos:definition "Classifies an ingot casting operation by the route through which liquid steel enters the mould."@en,
        "按钢液进入锭模的路径标明一次模铸所用的浇注方式。"@zh ;
    skos:prefLabel "Ingot teeming method"@en,
        "模铸浇注方式"@zh .

stl:theoreticalMass a owl:DatatypeProperty ;
    rdfs:label "Theoretical mass"@en,
        "理论重量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-709-2019> ;
    rdfs:domain stl:MaterialPiece ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the calculated piece mass using the applicable dimensional and density basis."@en,
        "给出按规定几何尺寸与密度等依据计算的计重值。"@zh ;
    skos:prefLabel "Theoretical mass"@en,
        "理论重量"@zh ;
    stl:quantityKind quantitykind:Mass ;
    stl:unit unit:TONNE .

stl:tubeOutsideDiameter a owl:DatatypeProperty ;
    rdfs:label "Tube outside diameter"@en,
        "管外径"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17395-2024> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:SteelTube stl:HollowShell ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:range xsd:decimal ;
    skos:definition "The distance across the outside surfaces of a round tube or shell on a diameter of a given section, in millimetres."@en,
        "圆形钢管或毛管在给定截面上沿直径方向两外表面间的距离，以毫米计。"@zh ;
    skos:prefLabel "Tube outside diameter"@en,
        "管外径"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:MilliM .

stl:tubeWallThickness a owl:DatatypeProperty ;
    rdfs:label "Tube wall thickness"@en,
        "管壁厚度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17395-2024> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:SteelTube stl:HollowShell ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf stl:thickness ;
    skos:definition "The distance through the wall of a tube or shell from the inside surface to the outside at a given position, in millimetres."@en,
        "钢管或毛管在给定位置沿壁厚方向从内表面到外表面的距离，以毫米计。"@zh ;
    skos:prefLabel "Tube wall thickness"@en,
        "管壁厚度"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:MilliM .

stl:weldMethod a owl:ObjectProperty ;
    rdfs:label "Tube seam welding method"@en,
        "制管焊接方法"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:TubeWelding ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/weld-method> ;
    skos:definition "Identifies the method actually used to join the tube edges in a seam welding operation."@en,
        "从一次管体焊接作业指向实际用于接合管边的焊接方法代码。"@zh ;
    skos:prefLabel "Tube seam welding method"@en,
        "制管焊接方法"@zh .

stl:CastSequence a owl:Class ;
    rdfs:label "Casting sequence"@en,
        "浇次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:altLabel "cast sequence"@en,
        "连浇炉数组"@zh ;
    skos:definition "A record of one or more heats fed to a caster in one uninterrupted sequence, preserving the order of the heats."@en,
        "记录一台连铸机连续接浇的一炉或多炉钢水及各炉的接浇顺序。"@zh ;
    skos:prefLabel "Casting sequence"@en,
        "浇次"@zh .

stl:ChargeComponent a owl:Class ;
    rdfs:label "Furnace charge line"@en,
        "装料明细"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:subClassOf stl:LotAllocation ;
    skos:definition "A line recording one source lot's contribution to an actual furnace charge. Separate additions from the same lot can have their own lines."@en,
        "登记一次炼钢装料中某一来源批实际投用情况的明细，分次投入同一批时可分别记项。"@zh ;
    skos:prefLabel "Furnace charge line"@en,
        "装料明细"@zh ;
    skos:scopeNote "用 allocatedLot、allocationOperation 和 consumedQuantity 对应取料批次、执行和实投质量。工序的 consumedLot 直接指向物料批。"@zh .

stl:ChemicalAnalysis a owl:Class ;
    rdfs:label "Chemical analysis"@en,
        "化学分析"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/isots-6084-2022> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:InspectionActivityRecord ;
    skos:definition "An analysis grouping element determinations for a sample under one stated analytical purpose."@en,
        "按同一用途对所取样品报告一组元素测定值的分析记录。"@zh ;
    skos:prefLabel "Chemical analysis"@en,
        "化学分析"@zh .

stl:CuttingPlan a owl:Class ;
    rdfs:label "Cutting plan"@en,
        "切割计划"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:Plan ;
    skos:definition "A plan assigning an order and target lengths to intended cuts that can be referenced by their execution."@en,
        "在开切前指定拟切件的切序和目标长度的计划，实际完成的切割可引用它。"@zh ;
    skos:prefLabel "Cutting plan"@en,
        "切割计划"@zh .

stl:Electrode a owl:Class ;
    rdfs:label "Consumable remelting electrode"@en,
        "重熔自耗电极"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特冶须在来源锭和本次重熔锭之间保留实际投入电极的实物身份。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:altLabel "自耗电极"@zh ;
    skos:definition "An individually tracked electrode prepared from ingot stock and consumed as metal feed for a new ingot during remelting."@en,
        "由来源锭制备、以独立件号投入重熔作业并向新锭供应金属的电极。"@zh ;
    skos:prefLabel "Consumable remelting electrode"@en,
        "重熔自耗电极"@zh .

stl:HollowShell a owl:Class ;
    rdfs:label "Hollow shell"@en,
        "毛管"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:subClassOf stl:SemiFinishedProduct ;
    skos:altLabel "pierced shell"@en,
        "穿孔毛管"@zh ;
    skos:definition "An individually tracked hollow intermediate produced by piercing a solid billet and supplied for elongation, rolling or sizing."@en,
        "实心管坯穿孔后得到的空心中间件，保留单件身份供后续延伸、轧管或定径作业引用。"@zh ;
    skos:prefLabel "Hollow shell"@en,
        "毛管"@zh .

stl:HotRolling a owl:Class ;
    rdfs:label "Hot rolling"@en,
        "热轧"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:Rolling ;
    skos:altLabel "热轧执行"@zh ;
    skos:definition "Rolling performed in the hot-working range of the steel to produce flat or long products."@en,
        "在钢的热加工温度范围内轧制坯料，可产出板带、棒线材或型钢。"@zh ;
    skos:prefLabel "Hot rolling"@en,
        "热轧"@zh .

stl:InspectionLot a owl:Class ;
    rdfs:label "Inspection lot"@en,
        "检验批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A lot record grouping material under a formation rule for shared inspection results or a lot-level decision."@en,
        "按组批规则将物料归在一起、据以共用检验结果或作出批次判定的批记录。"@zh ;
    skos:prefLabel "Inspection lot"@en,
        "检验批"@zh .

stl:InspectionRequirement a owl:Class ;
    rdfs:label "Inspection requirement"@en,
        "检验要求"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:Requirement ;
    skos:definition "A requirement defining an examination, its scope, its method and the criterion to apply."@en,
        "规定检验项目、方法、覆盖对象和适用判据的一项验收要求。"@zh ;
    skos:prefLabel "Inspection requirement"@en,
        "检验要求"@zh .

stl:IronOre a owl:Class ;
    rdfs:label "Iron ore lot"@en,
        "铁矿料批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20565-2022> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A lot supplying iron in reducible mineral form as natural ore, beneficiated ore or agglomerates made from ore fines."@en,
        "以可还原铁矿物供铁的物料批，可为天然矿、选矿产物，或以矿粉为主料制成的人造块矿。"@zh ;
    skos:prefLabel "Iron ore lot"@en,
        "铁矿料批"@zh .

stl:MacroDefectRating a owl:Class ;
    rdfs:label "Ingot product macrodefect rating"@en,
        "锭材低倍缺陷评级结果"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1979-2025> ;
    rdfs:comment "下沉理由：锭材验收须将分项评级与取自特定锭的截面配对，普钢坯样的评级方案独立。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:subClassOf stl:RatingResult ;
    skos:definition "A level assigned to one defect category on a section in an ingot product macroexamination."@en,
        "在一项锭材低倍交验中对一个缺陷类别给出的级别，同一截面可分别报告多类缺陷。"@zh ;
    skos:prefLabel "Ingot product macrodefect rating"@en,
        "锭材低倍缺陷评级结果"@zh .

stl:MillCertificate a owl:Class ;
    rdfs:label "Mill certificate"@en,
        "质量证明书"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/en-10204-2004> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:altLabel "mill test certificate"@en,
        "质保书"@zh ;
    skos:definition "A delivery document supplying inspection evidence or results for the material within its stated coverage."@en,
        "明确列出所覆盖的交货材料并为其提供检验依据或结果的质量文件。"@zh ;
    skos:prefLabel "Mill certificate"@en,
        "质量证明书"@zh .

stl:ProcessSegment a owl:Class ;
    rdfs:label "Process segment"@en,
        "工序段"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:ManufacturingObject ;
    skos:altLabel "工艺段"@zh ;
    skos:definition "A schedulable process step that may be referenced in multiple routes and executions."@en,
        "可以被多条路线和多次执行引用的一段可排程工艺定义。"@zh ;
    skos:prefLabel "Process segment"@en,
        "工序段"@zh .

stl:ProductionOrder a owl:Class ;
    rdfs:label "Production order"@en,
        "生产订单"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:Plan ;
    skos:definition "A plan authorizing production against demand through one or more actual operations."@en,
        "为了履行制造需求而下达、可由多次现场作业共同履行的计划。"@zh ;
    skos:prefLabel "Production order"@en,
        "生产订单"@zh .

stl:ReferenceRatingLevel a owl:Class ;
    rdfs:label "Reference rating level"@en,
        "评级标尺级别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A designated level within one identified scale that a reported result or acceptance clause can cite independently."@en,
        "在一把确定标尺内有明确标记、可被报告结果或验收条款独立引用的级别。"@zh ;
    skos:prefLabel "Reference rating level"@en,
        "评级标尺级别"@zh ;
    skos:scopeNote "Use skos:inScheme to identify the rating scale to which the level belongs."@en,
        "用 skos:inScheme 指明本级别所属的评级标尺。"@zh .

stl:Refining a owl:Class ;
    rdfs:label "Secondary refining"@en,
        "炉外精炼"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-4529-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "A treatment of a tapped heat in a ladle or separate vessel to adjust steel chemistry, temperature, dissolved gases or inclusions."@en,
        "出钢后在钢包或专用容器中对炉次钢水实施的处理，可调整其成分、温度、溶解气体或夹杂物状态。"@zh ;
    skos:prefLabel "Secondary refining"@en,
        "炉外精炼"@zh .

stl:RemeltedIngot a owl:Class ;
    rdfs:label "Remelted ingot"@en,
        "重熔锭"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特冶须逐锭注明所走的冶炼路线，并把锭关联至直接供料的电极。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting> ;
    rdfs:subClassOf stl:Ingot ;
    skos:definition "An individually identified ingot solidified in one consumable electrode remelting pass, available as stock for another electrode or for forging."@en,
        "自耗电极经一道重熔后凝固形成、有独立件号并可继续加工为下一道电极或锻坯的锭。"@zh ;
    skos:prefLabel "Remelted ingot"@en,
        "重熔锭"@zh .

stl:Rolling a owl:Class ;
    rdfs:label "Rolling"@en,
        "轧制"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that passes steel through rotating rolls to change its thickness or cross-sectional profile."@en,
        "使钢料通过旋转轧辊的辊缝，在轧辊压力下改变厚度或断面轮廓的作业。"@zh ;
    skos:prefLabel "Rolling"@en,
        "轧制"@zh .

stl:StorageLocation a owl:Class ;
    rdfs:label "Storage location"@en,
        "库位"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-4878-2020> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:Location ;
    skos:definition "An addressable place to deposit material in a storage area, identifiable by row, column and tier in a stack."@en,
        "库区内可单独寻址并落放实物的位置，堆垛时可用行、列和层定位。"@zh ;
    skos:prefLabel "Storage location"@en,
        "库位"@zh .

stl:Tapping a owl:Class ;
    rdfs:label "Steel tapping"@en,
        "出钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "The discharge of molten steel from the steelmaking furnace into a receiving ladle or ladles, measured by the steel that leaves the furnace."@en,
        "将炉内炼成的钢水排入接收钢包的作业，以实际流出的钢水计量该次出钢量。"@zh ;
    skos:prefLabel "Steel tapping"@en,
        "出钢"@zh .

<https://w3id.org/ontology-platform/steel/code/defect-type/FLAT> a skos:Concept ;
    rdfs:label "Flat product defects"@en,
        "板带缺陷"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Groups flaws identified by flat-stock features such as edges, coating coverage or flatness."@en,
        "归集以板面、带边、镀层或板形为识别依据的缺陷。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/defect-type> ;
    skos:notation "FLAT"^^stl:DefectTypeCode ;
    skos:prefLabel "Flat product defects"@en,
        "板带缺陷"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/defect-type> .

<https://w3id.org/ontology-platform/steel/code/plain-product-family/COLDLC> a skos:Concept ;
    rdfs:label "Cold-rolled low-carbon sheet and strip"@en,
        "冷轧低碳钢板带"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-5213-2019> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Cold-rolled low-carbon flat products ordered by grade for the intended forming operation."@en,
        "按冷轧低碳板带的成形用途选取牌号的产品系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/plain-product-family> ;
    skos:notation "COLDLC"^^stl:PlainProductFamilyCode ;
    skos:prefLabel "Cold-rolled low-carbon sheet and strip"@en,
        "冷轧低碳钢板带"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/plain-product-family> .

<https://w3id.org/ontology-platform/steel/code/plain-product-family/HOTDIP> a skos:Concept ;
    rdfs:label "Hot-dip coated sheet and strip"@en,
        "热镀层板带"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-2518-2019> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Flat products supplied with a designation identifying the substrate and hot-dip coating."@en,
        "以板带基材与热浸镀层的组合标明交货品种的产品系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/plain-product-family> ;
    skos:notation "HOTDIP"^^stl:PlainProductFamilyCode ;
    skos:prefLabel "Hot-dip coated sheet and strip"@en,
        "热镀层板带"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/plain-product-family> .

<https://w3id.org/ontology-platform/steel/code/plain-product-family/HSLA> a skos:Concept ;
    rdfs:label "High-strength low-alloy structural steel"@en,
        "低合金高强度结构钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1591-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Structural products ordered by high-strength low-alloy grade and its delivery conditions."@en,
        "按低合金高强度结构钢牌号和相应交货条件订货的产品系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/plain-product-family> ;
    skos:notation "HSLA"^^stl:PlainProductFamilyCode ;
    skos:prefLabel "High-strength low-alloy structural steel"@en,
        "低合金高强度结构钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/plain-product-family> .

<https://w3id.org/ontology-platform/steel/code/process-type/REMELT> a skos:Concept ;
    rdfs:label "Remelting segment"@en,
        "重熔工序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/TRANSFORM> ;
    skos:definition "A route segment producing a new ingot by melting and resolidifying a consumable electrode."@en,
        "以自耗电极为金属来源、经再熔凝形成新锭的工艺路线段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "REMELT"^^stl:ProcessTypeCode ;
    skos:prefLabel "Remelting segment"@en,
        "重熔工序"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/STEELMAKE> a skos:Concept ;
    rdfs:label "Primary steelmaking"@en,
        "炼钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/TRANSFORM> ;
    skos:definition "A route segment in which metallic feed is made into a heat of molten steel."@en,
        "将金属炉料冶炼为一炉钢水的路线工序段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "STEELMAKE"^^stl:ProcessTypeCode ;
    skos:prefLabel "Primary steelmaking"@en,
        "炼钢"@zh .

<https://w3id.org/ontology-platform/steel/code/product-form/COIL> a skos:Concept ;
    rdfs:label "Steel coil"@en,
        "钢卷"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Flat steel wound along its length into a single handling piece."@en,
        "将连续扁平钢材沿长度方向缠绕成可整体吊运的一卷。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "COIL"^^stl:ProductFormCode ;
    skos:prefLabel "Steel coil"@en,
        "钢卷"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/special-product-family/BEARING> a skos:Concept ;
    rdfs:label "Bearing steel"@en,
        "轴承钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-18254-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-codes> ;
    skos:definition "Steels for bearing rings, rolling elements and other components subject to cyclic contact stress."@en,
        "用于制造滚动轴承套圈、滚动体等承受循环接触应力零件的钢材系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/special-product-family> ;
    skos:notation "BEARING"^^stl:SpecialProductFamilyCode ;
    skos:prefLabel "Bearing steel"@en,
        "轴承钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/special-product-family> .

<https://w3id.org/ontology-platform/steel/code/special-product-family/SPRING> a skos:Concept ;
    rdfs:label "Spring steel"@en,
        "弹簧钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1222-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-codes> ;
    skos:definition "Steels for spring elements that undergo repeated elastic deformation under load."@en,
        "用于制造在反复载荷下依靠弹性变形工作的弹簧元件的钢材系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/special-product-family> ;
    skos:notation "SPRING"^^stl:SpecialProductFamilyCode ;
    skos:prefLabel "Spring steel"@en,
        "弹簧钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/special-product-family> .

<https://w3id.org/ontology-platform/steel/code/special-product-family/SUPERALLOY> a skos:Concept ;
    rdfs:label "Superalloy"@en,
        "高温合金"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-14992-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-codes> ;
    skos:definition "Alloys selected for strength and environmental resistance in load-bearing hot components, including nickel-base superalloys."@en,
        "供高温承载部件按高温强度和环境耐受能力选用的合金系列，包括镍基高温合金。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/special-product-family> ;
    skos:notation "SUPERALLOY"^^stl:SpecialProductFamilyCode ;
    skos:prefLabel "Superalloy"@en,
        "高温合金"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/special-product-family> .

<https://w3id.org/ontology-platform/steel/code/special-product-family/TOOLDIE> a skos:Concept ;
    rdfs:label "Tool and die steel"@en,
        "工模具钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1299-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-codes> ;
    skos:definition "Steels for cutting tools, gauges or forming dies, selected for the performance of the cutting edge or working surface."@en,
        "供刃具、量具或成形模具选材的钢材系列，使用时关注刃口或工作面的性能。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/special-product-family> ;
    skos:notation "TOOLDIE"^^stl:SpecialProductFamilyCode ;
    skos:prefLabel "Tool and die steel"@en,
        "工模具钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/special-product-family> .

<https://w3id.org/ontology-platform/steel/code/test-type/HARDNESS> a skos:Concept ;
    rdfs:label "Hardness test"@en,
        "硬度试验"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Determines resistance to localized deformation using a stated hardness method and scale."@en,
        "以规定方式评价材料抵抗局部压入等变形的能力并记录标尺。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/test-type> ;
    skos:notation "HARDNESS"^^stl:TestTypeCode ;
    skos:prefLabel "Hardness test"@en,
        "硬度试验"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/test-type> .

stl:contributionInput a owl:ObjectProperty ;
    rdfs:label "Contributing input"@en,
        "贡献对应来源"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SourceContribution ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:Material ;
    skos:definition "Identifies the input lot or piece whose share in the specified output is being described."@en,
        "指明某项份额证据涉及的一个直接投入批或投入件。"@zh ;
    skos:prefLabel "Contributing input"@en,
        "贡献对应来源"@zh .

stl:contributionOutput a owl:ObjectProperty ;
    rdfs:label "Output receiving contribution"@en,
        "贡献对应产出"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SourceContribution ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:Material ;
    skos:definition "Identifies the output piece or lot whose origins the contribution describes."@en,
        "标识一条来源份额明细所解释的产出件或产出批。"@zh ;
    skos:prefLabel "Output receiving contribution"@en,
        "贡献对应产出"@zh .

stl:meltingRoute a owl:ObjectProperty ;
    rdfs:label "Melting route"@en,
        "冶炼路线"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特钢追溯需按实物件区分含重熔和直接成材路线，以判断应追查的来源环节。"@zh ;
    rdfs:domain stl:MaterialPiece ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/melting-route> ;
    skos:definition "Identifies the coded sequence of melting and refining stages for a piece, including remelted ingots, their downstream products and pieces made by a direct route."@en,
        "关联描述该件物料冶炼历程的具体路线代码，可在重熔锭、后续加工件或直接成材的特钢实物件上记录。"@zh ;
    skos:prefLabel "Melting route"@en,
        "冶炼路线"@zh .

stl:partOf a owl:ObjectProperty ;
    rdfs:label "Part of"@en,
        "所属整体"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    skos:definition "Identifies the immediate whole containing a component, entry or suboperation, such as a package, order or parent operation."@en,
        "指出物件、条目或子执行所直接隶属的整体，例如包装件、订单或上一级作业。"@zh ;
    skos:prefLabel "Part of"@en,
        "所属整体"@zh .

stl:plannedEndAt a owl:DatatypeProperty ;
    rdfs:label "Planned end"@en,
        "计划结束时刻"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Plan ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives the completion instant intended by a plan."@en,
        "给出计划要求或预期完成工作的时间点。"@zh ;
    skos:prefLabel "Planned end"@en,
        "计划结束时刻"@zh .

stl:plannedStartAt a owl:DatatypeProperty ;
    rdfs:label "Planned start"@en,
        "计划开始时刻"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Plan ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives the start instant intended by a plan."@en,
        "给出计划中预期开始作业的时间点。"@zh ;
    skos:prefLabel "Planned start"@en,
        "计划开始时刻"@zh .

stl:productForm a owl:ObjectProperty ;
    rdfs:label "Physical product form"@en,
        "实物产品形态"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-15574-2016> ;
    rdfs:domain stl:MaterialPiece ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:definition "Identifies the physical product form associated with the current piece identity."@en,
        "标识实物件在当前身份下的几何或交货形态。"@zh ;
    skos:prefLabel "Physical product form"@en,
        "实物产品形态"@zh .

stl:resultAt a owl:DatatypeProperty ;
    rdfs:label "Result available at"@en,
        "出结果时间"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives the instant at which the measurement or inspection result became available."@en,
        "给出该批检验信息或读数成为可用结果的时点。"@zh ;
    skos:prefLabel "Result available at"@en,
        "出结果时间"@zh .

stl:sampledAt a owl:DatatypeProperty ;
    rdfs:label "Sampled at"@en,
        "取样时间"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives the instant of physical sampling or acquisition of the sensor reading."@en,
        "样品从物料中取出或现场测点采得该读数的时刻。"@zh ;
    skos:prefLabel "Sampled at"@en,
        "取样时间"@zh .

stl:share a owl:DatatypeProperty ;
    rdfs:label "Contribution share"@en,
        "来源份额"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SourceContribution ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the percentage of an output attributed to one immediate source on the specified mass or length basis."@en,
        "将按长度或质量计量的单个直接来源占产出的比例表示为百分数。"@zh ;
    skos:prefLabel "Contribution share"@en,
        "来源份额"@zh ;
    stl:quantityKind quantitykind:DimensionlessRatio ;
    stl:unit unit:PERCENT .

stl:sourceHeat a owl:ObjectProperty ;
    rdfs:label "Source heat"@en,
        "来源炉次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:MaterialPiece ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:Heat ;
    skos:definition "Identifies a steelmaking heat that supplied liquid steel to the piece, including each contributing heat at a heat transition."@en,
        "指明向这件实物供应钢水的炼钢炉次，换炉时可有多个来源。"@zh ;
    skos:prefLabel "Source heat"@en,
        "来源炉次"@zh .

stl:startLength a owl:DatatypeProperty ;
    rdfs:label "Start along source coil"@en,
        "母卷区段起点"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Coil ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:range xsd:decimal ;
    skos:definition "Distance along the strip from the reference end of its single direct parent coil to the start of the interval taken for this coil."@en,
        "以单一直接母卷约定的起算端为零，沿带钢量到子卷所取区段起点的距离。"@zh ;
    skos:prefLabel "Start along source coil"@en,
        "母卷区段起点"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:M .

