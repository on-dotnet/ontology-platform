        "从包装或装载单元取出一件或多件成员，并在取出后继续沿用各成员原有身份的作业。"@zh ;
    skos:prefLabel "Material disaggregation"@en,
        "实物拆包作业"@zh .

stl:MeasurementItemCode a rdfs:Datatype ;
