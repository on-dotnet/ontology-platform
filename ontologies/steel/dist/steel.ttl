    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/TRANSFORM> ;
    skos:definition "A route segment for carbonizing a coal charge into coke."@en,
        "路线中由装炉煤经炭化得到焦炭的工序段类别。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "COKING"^^stl:ProcessTypeCode ;
    skos:prefLabel "Coking"@en,
        "炼焦"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/CUT> a skos:Concept ;
    rdfs:label "Cutting"@en,
        "切割"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting-codes> ;
