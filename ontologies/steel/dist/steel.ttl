    skos:prefLabel "Ultrasonic acceptance class for wrought bars code"@en,
        "锻轧棒材超声验收等级代码"@zh .

stl:NdtAcceptanceSchemeShape a sh:PropertyShape ;
    rdfs:comment "探伤验收等级应取自锻轧棒材超声等级方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/ndt-acceptance-class> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:ndtAcceptanceClass .

stl:NdtMethodCode a rdfs:Datatype ;
    rdfs:label "Nondestructive testing method code"@en,
        "无损检测方法代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
