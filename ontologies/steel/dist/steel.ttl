    skos:notation "ALS"^^stl:ChemicalElementCode ;
    skos:prefLabel "acid-soluble aluminium"@en,
        "酸溶铝"@zh ;
    skos:scopeNote "酸溶铝和全铝分别记为 ALS 和 AL。"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/AS> a skos:Concept ;
    rdfs:label "Arsenic"@en,
        "砷"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "As"@en,
        "As"@zh ;
    skos:definition "Quantifies arsenic where the residual content of a charge or steel sample is controlled."@en,
        "按元素计量炉料或钢样中需单独监控的残余砷。"@zh ;
