    skos:notation "BOF"^^stl:ProcessTypeCode ;
    skos:prefLabel "Basic oxygen steelmaking"@en,
        "氧气转炉炼钢"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/BREAKDOWN> a skos:Concept ;
