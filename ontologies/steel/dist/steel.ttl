    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/TRANSFORM> ;
    skos:definition "Distributes liquid steel into discrete moulds for solidification as individual ingots."@en,
        "向独立锭模分浇钢水，使各模内的钢分别凝固成锭。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "INGOTCAST"^^stl:ProcessTypeCode ;
    skos:prefLabel "Ingot casting"@en,
        "模铸"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/INLINETEST> a skos:Concept ;
    rdfs:label "In-line inspection"@en,
        "在线检验"@zh ;
