    skos:notation "CC"^^stl:ProcessTypeCode ;
    skos:prefLabel "Continuous casting"@en,
        "连续铸钢"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/CHARGE> a skos:Concept ;
