    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:Plan ;
    skos:definition "A plan assigning a required examination and its subject to an inspection station."@en,
        "把指定检验要求派给检验岗位并给出待检对象的指令。"@zh ;
    skos:prefLabel "Inspection instruction"@en,
