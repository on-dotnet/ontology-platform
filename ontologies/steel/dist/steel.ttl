    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/steel-class-composition> ;
    skos:definition "Classifies an internal steel grade or standard designation on the chemical composition axis."@en,
        "按化学成分将内部钢种或标准牌号归入钢分类体系中的类别。"@zh ;
