stl:steelGrade a owl:ObjectProperty ;
    rdfs:label "Internal grade of material"@en,
        "所属内部钢种"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Material ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:SteelGrade ;
    skos:definition "Identifies the internal steel grade assigned in production to a material such as a heat or a product piece."@en,
        "指明生产中用于识别该物料的内部钢种，适用于炉次及其后续产品。"@zh ;
    skos:prefLabel "Internal grade of material"@en,
        "所属内部钢种"@zh .

stl:stepNumber a owl:DatatypeProperty ;
    rdfs:label "Route step number"@en,
        "路线步序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:RouteStep ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Gives the ordinal by which a step is cited within its route."@en,
        "标识同一路线内步骤的展示或引用顺序。"@zh ;
    skos:prefLabel "Route step number"@en,
        "路线步序"@zh .

stl:stepSegment a owl:ObjectProperty ;
    rdfs:label "Segment of route step"@en,
        "步骤引用工序段"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:RouteStep ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:ProcessSegment ;
    skos:definition "Links one position in a route to the segment definition used there."@en,
        "将路线中的一个位置关联到该位置引用的工序段定义。"@zh ;
    skos:prefLabel "Segment of route step"@en,
        "步骤引用工序段"@zh .

stl:stockLocation a owl:ObjectProperty ;
    rdfs:label "Location in stock record"@en,
        "库存记录对应位置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:Location ;
    skos:definition "Identifies the stock location to which a receipt, issue or stocktake entry refers."@en,
        "指明一次收发交接或盘点明细以哪个库存位置为准。"@zh ;
    skos:prefLabel "Location in stock record"@en,
        "库存记录对应位置"@zh .

stl:stockMaterial a owl:ObjectProperty ;
    rdfs:label "Material in stock record"@en,
        "库存记录涉及物料"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:Material ;
    skos:definition "Identifies the actual lot or piece covered by a receipt, issue, reservation or stocktake entry."@en,
        "指明收发、预留或盘点记录所涉及的实际物料批或实物件。"@zh ;
    skos:prefLabel "Material in stock record"@en,
        "库存记录涉及物料"@zh .

stl:strandCount a owl:DatatypeProperty ;
    rdfs:label "Number of strands"@en,
        "流数"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Equipment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Counts the strand positions provided by a caster."@en,
        "给出一台连铸机配置的铸流条数。"@zh ;
    skos:prefLabel "Number of strands"@en,
        "流数"@zh ;
    stl:quantityKind quantitykind:Count ;
    stl:unit unit:NUM .

stl:strandNumber a owl:DatatypeProperty ;
    rdfs:label "Strand number"@en,
        "流号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:Slab stl:ContinuouslyCastPiece ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Identifies the numbered strand of the caster from which the piece originated."@en,
        "标识该坯件所属铸流在铸机各流中的编号。"@zh ;
    skos:prefLabel "Strand number"@en,
        "流号"@zh .

stl:surfaceCondition a owl:ObjectProperty ;
    rdfs:label "Required surface condition"@en,
        "要求表面状态"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SurfaceRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/surface-condition> ;
    skos:definition "Identifies the surface condition prescribed by the applicable delivery provision."@en,
        "标识所引条款规定的交付表面类别。"@zh ;
    skos:prefLabel "Required surface condition"@en,
        "要求表面状态"@zh .

stl:tapHoleLocation a owl:ObjectProperty ;
    rdfs:label "Taphole location"@en,
        "出铁口位置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:BlastFurnaceTapping ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:range stl:Location ;
    skos:definition "Identifies the outlet opened and closed for this tap, distinguishing the tapholes of a single furnace."@en,
        "标明该铁次启闭的出铁口在高炉上的位置，可区分同一座高炉的多个出铁口。"@zh ;
    skos:prefLabel "Taphole location"@en,
        "出铁口位置"@zh .

stl:tappedSteelMass a owl:DatatypeProperty ;
    rdfs:label "Tapped steel mass"@en,
        "出钢量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:Steelmaking stl:Tapping ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:range xsd:decimal ;
    skos:definition "Total mass of steel discharged to receiving ladles in this tap, in tonnes, with the retained heel accounted for separately."@en,
        "本次出钢实际排入接收钢包的钢水总质量，以吨计，炉内留钢单独核算。"@zh ;
    skos:prefLabel "Tapped steel mass"@en,
        "出钢量"@zh ;
    stl:quantityKind quantitykind:Mass ;
    stl:unit unit:TONNE .

stl:tappingTemperature a owl:DatatypeProperty ;
    rdfs:label "Steel tapping temperature"@en,
        "出钢温度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:Steelmaking stl:Tapping ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:range xsd:decimal ;
    skos:definition "The steel temperature reported for a tap in degrees Celsius. Individual readings at distinct times or points are recorded as observations."@en,
        "本次出钢实绩采用的钢水温度，以摄氏度表示。逐次测温的时刻和测点保存在观测记录中。"@zh ;
    skos:prefLabel "Steel tapping temperature"@en,
        "出钢温度"@zh ;
    stl:quantityKind quantitykind:CelsiusTemperature ;
    stl:unit unit:DEG_C .

stl:temperature a owl:DatatypeProperty ;
    rdfs:label "Temperature"@en,
        "温度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Observation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the Celsius temperature obtained at the point and instant of acquisition."@en,
        "给出该测点在现场采样时刻获得的摄氏温度。"@zh ;
    skos:prefLabel "Temperature"@en,
        "温度"@zh ;
    stl:quantityKind quantitykind:CelsiusTemperature ;
    stl:unit unit:DEG_C .

stl:tensileStrength a owl:DatatypeProperty ;
    rdfs:label "Tensile strength"@en,
        "抗拉强度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-228-1-2021> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:MechanicalTest stl:Observation ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the engineering stress corresponding to peak force in the tensile determination."@en,
        "记录试样在拉伸中承受最大力时按其原始截面折算的应力。"@zh ;
    skos:prefLabel "Tensile strength"@en,
        "抗拉强度"@zh ;
    stl:quantityKind quantitykind:Stress ;
    stl:unit unit:MegaPA .

stl:testCondition a owl:DatatypeProperty ;
    rdfs:label "Specified test condition"@en,
        "规定试验条件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:PropertyRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:string ;
    skos:definition "Describes a condition needed to interpret a property limit, such as specimen orientation or loading mode."@en,
        "记录解释性能界限所需的条件，例如试样取向或加载方式。"@zh ;
    skos:prefLabel "Specified test condition"@en,
        "规定试验条件"@zh .

stl:testedSample a owl:ObjectProperty ;
    rdfs:label "Tested sample"@en,
        "受检样品"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:Sample ;
    skos:definition "Identifies the sample actually used for the recorded analysis or test."@en,
        "指明本次分析或试验实际取用的样品。"@zh ;
    skos:prefLabel "Tested sample"@en,
        "受检样品"@zh .

stl:tier a owl:DatatypeProperty ;
    rdfs:label "Storage tier"@en,
        "库位层"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:StorageLocation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Gives the storage tier ordinal of the position."@en,
        "记录库位所在的堆放层序号。"@zh ;
    skos:prefLabel "Storage tier"@en,
        "库位层"@zh .

stl:treatedLoad a owl:ObjectProperty ;
    rdfs:label "Treated furnace load"@en,
        "实际处理的装炉批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:HeatTreatment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment> ;
    rdfs:range stl:HeatTreatmentLoad ;
    rdfs:subPropertyOf prov:used ;
    skos:definition "Identifies a furnace load actually processed in a heat treatment run so that the pieces in that charge can be retrieved."@en,
        "指明一次热处理作业实际加工了哪个装炉批，以便从作业查到各装炉实物件。"@zh ;
    skos:prefLabel "Treated furnace load"@en,
        "实际处理的装炉批"@zh .

stl:triggeredBy a owl:ObjectProperty ;
    rdfs:label "Triggered by shipment"@en,
        "触发移动的发运单"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:MovementEvent ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:Shipment ;
    skos:definition "Identifies the shipment document triggering the movement event."@en,
        "指明触发实际装车或出厂移动事件的发运单。"@zh ;
    skos:prefLabel "Triggered by shipment"@en,
        "触发移动的发运单"@zh .

stl:unit a owl:AnnotationProperty ;
    rdfs:label "Unit of measure"@en,
        "计量单位"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-80000-1-2022> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    skos:definition "Identifies the unit in which every value of the annotated numeric property is expressed."@en,
        "标明数值属性的所有读数或要求值共同使用的计量单位。"@zh ;
    skos:prefLabel "Unit of measure"@en,
        "计量单位"@zh .

stl:unitNumber a owl:DatatypeProperty ;
    rdfs:label "Equipment number"@en,
        "设备序号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Equipment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Ordinal assigned to an equipment resource within its designated numbering series."@en,
        "设备在指定编号序列中的序号，可用于区分同类设备。"@zh ;
    skos:prefLabel "Equipment number"@en,
        "设备序号"@zh .

stl:upperDeviation a owl:DatatypeProperty ;
    rdfs:label "Upper dimensional deviation"@en,
        "尺寸上偏差"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-709-2019> ;
    rdfs:domain stl:DimensionRequirement ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the signed difference between the largest permitted dimension and its nominal value."@en,
        "给出允许最大尺寸减去公称尺寸所得的有符号差值。"@zh ;
    skos:prefLabel "Upper dimensional deviation"@en,
        "尺寸上偏差"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:MilliM .

stl:upperYieldStrength a owl:DatatypeProperty ;
    rdfs:label "Upper yield strength"@en,
        "上屈服强度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-228-1-2021> ;
    rdfs:domain stl:MechanicalTest ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the highest engineering stress before the first force drop at discontinuous yielding."@en,
        "给出出现明显屈服时首次降力之前的最高工程应力。"@zh ;
    skos:prefLabel "Upper yield strength"@en,
        "上屈服强度"@zh ;
    stl:quantityKind quantitykind:Stress ;
    stl:unit unit:MegaPA .

stl:validUntilOn a owl:DatatypeProperty ;
    rdfs:label "Valid through"@en,
        "有效期至"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:date ;
    skos:definition "Gives the final calendar date covered by the authorization."@en,
        "给出许可处置条件仍然有效的最后日期。"@zh ;
    skos:prefLabel "Valid through"@en,
        "有效期至"@zh .

stl:width a owl:DatatypeProperty ;
    rdfs:label "Width"@en,
        "宽度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-709-2019> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range xsd:decimal ;
    skos:definition "The measured or specified transverse dimension of the material, expressed in millimetres."@en,
        "沿材料横向量得或规定的宽度，以毫米计。"@zh ;
    skos:prefLabel "Width"@en,
        "宽度"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:MilliM .

stl:AcceptanceCriterion a owl:Class ;
    rdfs:label "Acceptance criterion"@en,
        "验收判据"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:ManufacturingObject ;
    skos:definition "A reusable rule stating how inspection evidence determines satisfaction of a requirement."@en,
        "可被多个判定引用、说明如何用检验结果判断一项要求的规则。"@zh ;
    skos:prefLabel "Acceptance criterion"@en,
        "验收判据"@zh .

stl:Bar a owl:Class ;
    rdfs:label "Steel bar"@en,
        "棒材"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:definition "An individually tracked solid long product with a round, square, flat or other bar section."@en,
        "具有圆形、方形、扁形或其他棒材断面、可按件交接的实心长条钢材。"@zh ;
    skos:prefLabel "Steel bar"@en,
        "棒材"@zh .

stl:BeamBlank a owl:Class ;
    rdfs:label "Beam blank"@en,
        "异型坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/en-10079-2007> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:SemiFinishedProduct ;
    skos:altLabel "梁坯"@zh ;
    skos:definition "A steel semiproduct with a web and flange preform in its cross-section for subsequent rolling into a beam."@en,
        "截面已具梁腹和翼缘雏形、供进一步轧成梁材的钢坯。"@zh ;
    skos:prefLabel "Beam blank"@en,
        "异型坯"@zh .

stl:Bloom a owl:Class ;
    rdfs:label "Bloom"@en,
        "大方坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:SemiFinishedProduct ;
    skos:definition "A square or rectangular semiproduct supplied as large-section stock for breakdown or direct working into heavy sections."@en,
        "作为大断面坯料交接的方形或矩形钢坯，可供开坯或直接轧制重型断面产品。"@zh ;
    skos:prefLabel "Bloom"@en,
        "大方坯"@zh .

stl:BreakdownRolledStock a owl:Class ;
    rdfs:label "Breakdown-rolled stock"@en,
        "初轧坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:SemiFinishedProduct ;
    skos:definition "An individually identified piece of stock produced by breakdown rolling, which may also be classified by its section as a slab, bloom or billet."@en,
        "钢锭或大断面坯经过开坯轧制后单独编号的坯件，可按其实际断面同时标注为板坯、大方坯或小钢坯。"@zh ;
    skos:prefLabel "Breakdown-rolled stock"@en,
        "初轧坯"@zh .

stl:BulkBlend a owl:Class ;
    rdfs:label "Blended lot"@en,
        "混合料批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A lot formed by combining source lots while retaining their individual contributions."@en,
        "汇合多个来源批后取得独立身份并保留各来源贡献的物料批。"@zh ;
    skos:prefLabel "Blended lot"@en,
        "混合料批"@zh .

stl:Charging a owl:Class ;
    rdfs:label "Steel furnace charging"@en,
        "炼钢装料"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "The delivery of furnace feed into a steelmaking furnace in one discrete charge or a recorded interval of continuous feeding."@en,
        "将备好的炉料实际送入炼钢炉的作业，以一次投料或连续给料的一个区间为边界。"@zh ;
    skos:prefLabel "Steel furnace charging"@en,
        "炼钢装料"@zh .

stl:CoatedCoil a owl:Class ;
    rdfs:label "Coated coil"@en,
        "涂镀钢卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:Coil ;
    skos:definition "A coil of steel strip bearing a metallic coating, an organic coating or a combination of layers."@en,
        "带钢表面带有金属镀层、有机涂层或两者组合，并以卷形按件跟踪的钢材。"@zh ;
    skos:prefLabel "Coated coil"@en,
        "涂镀钢卷"@zh .

stl:Coating a owl:Class ;
    rdfs:label "Coating"@en,
        "涂镀"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that applies one or more metallic or organic layers to steel to provide the specified surface protection or function."@en,
        "在钢材表面施加一层或多层金属或有机材料，使表面获得规定的防护或使用性能。"@zh ;
    skos:prefLabel "Coating"@en,
        "涂镀"@zh .

stl:ColdRolling a owl:Class ;
    rdfs:label "Cold rolling"@en,
        "冷轧"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:Rolling ;
    skos:definition "Rolling that changes thickness or section in one or more passes below the recrystallization temperature of the steel."@en,
        "在钢的再结晶温度以下通过一个或多个轧制道次改变厚度或断面。"@zh ;
    skos:prefLabel "Cold rolling"@en,
        "冷轧"@zh .

stl:ContinuousCasting a owl:Class ;
    rdfs:label "Continuous casting"@en,
        "连铸执行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:MaterialTransformation ;
    skos:definition "An operation that forms a shell around liquid steel in a mould and continuously withdraws the resulting strand."@en,
        "使钢水在结晶器中形成坯壳并连续引出铸流的一次生产作业。"@zh ;
    skos:prefLabel "Continuous casting"@en,
        "连铸执行"@zh .

stl:CoredWireFeeding a owl:Class ;
    rdfs:label "Cored wire feeding"@en,
        "包芯线喂入"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that feeds cored wire into molten steel to release its contents in the bath, with wire use traceable by the length fed."@en,
        "将包芯线送入钢液，使线芯材料在熔池中释放的一次作业，可按实际送入长度核算用线。"@zh ;
    skos:prefLabel "Cored wire feeding"@en,
        "包芯线喂入"@zh .

stl:Cutting a owl:Class ;
    rdfs:label "Cutting"@en,
        "切割执行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that separates a strand or an existing piece into identifiable lengths, including a subsequent cut of an earlier piece."@en,
        "将铸流或既有坯件分切成可逐件识别的实物的实际作业，既可初切也可再次切分。"@zh ;
    skos:prefLabel "Cutting"@en,
        "切割执行"@zh .

stl:Defect a owl:Class ;
    rdfs:label "Defect"@en,
        "缺陷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A record of an identified imperfection on actual material that can be located and cited in a disposition."@en,
        "在实际物料上确认、可单独定位并被质量处置引用的一项缺陷记录。"@zh ;
    skos:prefLabel "Defect"@en,
        "缺陷"@zh .

stl:DeliveryCondition a owl:Class ;
    rdfs:label "Delivery condition"@en,
        "交货状态要求"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:Requirement ;
    skos:definition "A delivery requirement specifying the processing or heat treatment condition in which material is to be supplied."@en,
        "规定交付时材料应处于何种加工或热处理状态的一项交货要求。"@zh ;
    skos:prefLabel "Delivery condition"@en,
        "交货状态要求"@zh .

stl:ElectroslagRemelting a owl:Class ;
    rdfs:label "Electroslag remelting"@en,
        "电渣重熔"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10067-8-2016> ;
    rdfs:comment "下沉理由：特冶追溯须能将采用熔渣的重熔道次与真空电弧重熔道次分别标识。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/process-type/ESR> ;
    rdfs:subClassOf stl:Remelting ;
    skos:altLabel "ESR"@en ;
    skos:definition "A remelting pass in which heat generated by current flowing through molten slag melts the electrode. Metal droplets pass through the slag and solidify into an ingot."@en,
        "利用电流流经熔渣产生的热量熔化自耗电极，金属熔滴穿过渣层后汇集并凝固成锭的作业。"@zh ;
    skos:prefLabel "Electroslag remelting"@en,
        "电渣重熔"@zh .

stl:ExaminationCoverage a owl:Class ;
    rdfs:label "Examination coverage"@en,
        "检测覆盖范围"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A record identifying the regions of a piece covered or excluded by a particular examination."@en,
        "记载某次检测在工件哪些区域实施、哪些区域未覆盖的空间范围。"@zh ;
    skos:prefLabel "Examination coverage"@en,
        "检测覆盖范围"@zh .

stl:HeatContribution a owl:Class ;
    rdfs:label "Heat contribution"@en,
        "炉次来源记录"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:SourceContribution ;
    skos:definition "A source contribution identifying one heat that supplied liquid steel to an output and the evidence for its share."@en,
        "说明一个产出物料从某个供钢炉次取得钢水及其份额依据的来源明细。"@zh ;
    skos:prefLabel "Heat contribution"@en,
        "炉次来源记录"@zh .

stl:HotMetal a owl:Class ;
    rdfs:label "Hot metal lot"@en,
        "铁水批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:seeAlso prov:wasGeneratedBy,
        stl:ChemicalAnalysis,
        stl:ElementResult,
        stl:sampleOf ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A lot of liquid iron originating in one blast furnace tap and traceable to that tap even when divided among receiving vessels."@en,
        "一次高炉出铁形成、以该铁次标识来源的液态生铁批，分送到各接铁容器时仍可追到该铁次。"@zh ;
    skos:prefLabel "Hot metal lot"@en,
        "铁水批"@zh ;
    skos:scopeNote "Identify the tap with prov:wasGeneratedBy. Link a sample to the lot with sampleOf and an analysis to the sample with testedSample. Each ElementResult links to the analysis with partOf and reports element and massFraction."@en,
        "用 prov:wasGeneratedBy 记出铁作业。成分分析用 Sample.sampleOf 指回铁水批，ChemicalAnalysis.testedSample 指向样品，ElementResult 用 partOf、element 和 massFraction 记录各元素结果。"@zh .

stl:HotMetalPretreatment a owl:Class ;
    rdfs:label "Hot metal pretreatment"@en,
        "铁水预处理"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation on hot metal before it enters a steelmaking furnace to remove targeted impurities such as sulfur, phosphorus or silicon."@en,
        "铁水进入炼钢炉以前，为脱除硫、磷或硅等目标杂质而实施的处理作业。"@zh ;
    skos:prefLabel "Hot metal pretreatment"@en,
        "铁水预处理"@zh .

stl:InclusionRating a owl:Class ;
    rdfs:label "Micrographic inclusion rating"@en,
        "非金属夹杂物显微评级检验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> ;
    rdfs:comment "下沉理由：轴承等疲劳敏感用途要求保存类别与系列各自的评级，普钢常规验收无需这一组逐项纯净度证据。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:subClassOf stl:MicroExamination ;
    skos:definition "A specialty steel microexamination reporting inclusion ratings by morphological category and applicable thickness series."@en,
        "在特钢交验试样的观察面上按夹杂物形态类别及适用系列评级，可为同一次检验出具多个结果。"@zh ;
    skos:prefLabel "Micrographic inclusion rating"@en,
        "非金属夹杂物显微评级检验"@zh .

stl:LiquidSteel a owl:Class ;
    rdfs:label "Liquid steel lot"@en,
        "钢水批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/material-category/STEEL> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A quantity of molten steel tracked within a common treatment, containment or transfer boundary, comprising all or part of a heat."@en,
        "按共同的处理、盛装或交接边界追踪的一批液态钢，可对应整炉或其中一部分。"@zh ;
    skos:prefLabel "Liquid steel lot"@en,
        "钢水批"@zh .

stl:LoadingPlan a owl:Class ;
    rdfs:label "Loading plan"@en,
        "装载计划"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1091-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:Plan ;
    skos:definition "A plan assigning handling units to a transport vehicle and its load positions."@en,
        "将待运单元预分配到运输载具及其装载位置的计划。"@zh ;
    skos:prefLabel "Loading plan"@en,
        "装载计划"@zh .

stl:LocalGrinding a owl:Class ;
    rdfs:label "Local grinding"@en,
        "局部修磨"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/finishing> ;
    rdfs:subClassOf stl:SurfaceConditioning ;
    skos:definition "An operation that uses an abrasive tool to remove metal from a designated area of a steel piece, where removal depth can be checked."@en,
        "用磨具从钢材指定部位去除表层金属的作业，可按处理区域复核去除深度。"@zh ;
    skos:prefLabel "Local grinding"@en,
        "局部修磨"@zh .

stl:MacroExamination a owl:Class ;
    rdfs:label "Macroexamination for ingot product acceptance"@en,
        "锭材低倍交验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1979-2025>,
        <https://w3id.org/ontology-platform/steel/std/gbt-226-2015> ;
    rdfs:comment "下沉理由：锭材交验须把分项缺陷级别追溯到取料钢锭，普钢连铸坯的低倍检验另有坯样口径。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:subClassOf stl:MetallographicExamination ;
    skos:definition "Examination of a traceable specialty ingot product section for the individual macrostructural defects specified at acceptance."@en,
        "在保留锭源的特钢交验试料截面上显现宏观组织，按订货规格分别记录受评缺陷的检验。"@zh ;
    skos:prefLabel "Macroexamination for ingot product acceptance"@en,
        "锭材低倍交验"@zh .

stl:MaterialAggregation a owl:Class ;
    rdfs:label "Material aggregation"@en,
        "实物聚合作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that assembles pieces into a handling unit while preserving their identities."@en,
        "将成员装入可整体管理的物流单元且保留各成员身份的作业。"@zh ;
    skos:prefLabel "Material aggregation"@en,
        "实物聚合作业"@zh .

stl:MaterialSublot a owl:Class ;
    rdfs:label "Material sublot"@en,
        "物料子批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A separately handled portion of a lot that retains an explicit link to its parent lot."@en,
        "从母批划出、可单独搬运或称量且保留母批归属的物料份额。"@zh ;
    skos:prefLabel "Material sublot"@en,
        "物料子批"@zh .

stl:MovementOrder a owl:Class ;
    rdfs:label "Movement order"@en,
        "移库指令"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1091-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:Plan ;
    skos:definition "An instruction assigning a destination and planned window to a material move."@en,
        "为待移实物约定目的地和计划时段的指令。"@zh ;
    skos:prefLabel "Movement order"@en,
        "移库指令"@zh .

stl:PersonnelRole a owl:Class ;
    rdfs:label "Personnel role"@en,
        "人员角色"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:ManufacturingObject ;
    skos:definition "A manufacturing responsibility that can be assigned to different people across operations."@en,
        "按所承担的制造职责识别的人员职能，可由不同人员在不同作业中担任。"@zh ;
    skos:prefLabel "Personnel role"@en,
        "人员角色"@zh .

stl:ProductionSchedule a owl:Class ;
    rdfs:label "Production schedule"@en,
        "排产计划"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:Plan ;
    skos:definition "A plan assigning resources and sequence to a collection of production orders within a scheduling horizon."@en,
        "在给定排程区间内为一组生产订单安排资源与顺序的计划。"@zh ;
    skos:prefLabel "Production schedule"@en,
        "排产计划"@zh .

stl:ProductionTool a owl:Class ;
    rdfs:label "Production tool"@en,
        "生产工装"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:Equipment ;
    skos:definition "An interchangeable production tool whose service history is tracked separately from its host equipment."@en,
        "可装配、更换并按自身编号跟踪使用履历的生产用具。"@zh ;
    skos:prefLabel "Production tool"@en,
        "生产工装"@zh .

stl:RatingRequirement a owl:Class ;
    rdfs:label "Rating acceptance requirement"@en,
        "级别验收要求"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    skos:definition "An acceptance requirement expressed against a reference level and comparison condition on an identified rating scale."@en,
        "用指定标尺上的参照级别与比较条件表达的质量验收要求。"@zh ;
    skos:prefLabel "Rating acceptance requirement"@en,
        "级别验收要求"@zh .

stl:Reheating a owl:Class ;
    rdfs:label "Stock reheating"@en,
        "坯料加热"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that heats stock or ingots in preparation for the next forming step."@en,
        "在变形加工前将坯料或钢锭加热到可供下一道工序加工的温度。"@zh ;
    skos:prefLabel "Stock reheating"@en,
        "坯料加热"@zh .

stl:RetainedSample a owl:Class ;
    rdfs:label "Retained sample"@en,
        "留样"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:Sample ;
    skos:definition "A sample kept at an identifiable location until a specified retention date for review or dispute testing."@en,
        "为复核或争议检验保存至指定期限并可重新定位的样品。"@zh ;
    skos:prefLabel "Retained sample"@en,
        "留样"@zh .

stl:RoundBillet a owl:Class ;
    rdfs:label "Round billet"@en,
        "圆坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-15574-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:Billet ;
    skos:definition "A solid billet with a circular section specified by nominal diameter, suitable for piercing or other forming operations."@en,
        "用公称直径描述圆形截面的实心坯料，可供穿孔或其他成形作业。"@zh ;
    skos:prefLabel "Round billet"@en,
        "圆坯"@zh .

stl:Sampling a owl:Class ;
    rdfs:label "Sampling"@en,
        "取样作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20066-2006> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf sosa:Sampling,
        stl:Operation ;
    skos:definition "An operation obtaining representative sample material at an identifiable place and time."@en,
        "从实际物料取出代表性样品并留下取样位置和时点的执行。"@zh ;
    skos:prefLabel "Sampling"@en,
        "取样作业"@zh .

stl:SamplingRequirement a owl:Class ;
    rdfs:label "Sampling requirement"@en,
        "取样要求"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-2975-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:InspectionRequirement ;
    skos:definition "A requirement defining the sampling unit, position, orientation or number of samples."@en,
        "规定取样单元、位置、方向或份数的检验要求。"@zh ;
    skos:prefLabel "Sampling requirement"@en,
        "取样要求"@zh .

stl:SeamlessTube a owl:Class ;
    rdfs:label "Seamless steel tube"@en,
        "无缝钢管"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:subClassOf stl:SteelTube ;
    skos:definition "A steel tube made by forming a bore in stock and working the wall, with circumferential continuity and no seam joining edges to close the body."@en,
        "由钢坯开孔并加工管壁制得的钢管，管壁沿周向连续，无闭合管体的制造焊缝。"@zh ;
    skos:prefLabel "Seamless steel tube"@en,
        "无缝钢管"@zh .

stl:Sinter a owl:Class ;
    rdfs:label "Iron ore sinter lot"@en,
        "烧结矿批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-421-2014> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:IronOre ;
    skos:definition "A lot of irregular ore agglomerates obtained by crushing and screening the cake formed by sintering iron-bearing fines."@en,
        "含铁细料在料层中熔结后经破碎、筛分得到的矿料批，颗粒呈不规则块状。"@zh ;
    skos:prefLabel "Iron ore sinter lot"@en,
        "烧结矿批"@zh .

stl:SurfaceRequirement a owl:Class ;
    rdfs:label "Surface requirement"@en,
        "表面要求"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:Requirement ;
    skos:definition "An acceptance condition for surface finish, permissible imperfections or conditioning of a defined area."@en,
        "为指定表面区域规定状态、可接受缺陷或修整条件的条目。"@zh ;
    skos:prefLabel "Surface requirement"@en,
        "表面要求"@zh .

stl:TestIndication a owl:Class ;
    rdfs:label "Test indication"@en,
        "检测显示"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-15822-1-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:InspectionResult ;
    skos:definition "A localized response detected by an instrument or inspection medium and submitted for interpretation."@en,
        "仪器或检验介质在一个位置给出的可评定响应。"@zh ;
    skos:prefLabel "Test indication"@en,
        "检测显示"@zh .

stl:ToolInstallation a owl:Class ;
    rdfs:label "Tool installation"@en,
        "工装装配作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that fits an identifiable tool to equipment and establishes the start of its service there."@en,
        "将有标识的工装装到设备上并确定其使用起点的一次作业。"@zh ;
    skos:prefLabel "Tool installation"@en,
        "工装装配作业"@zh .

stl:TubeBillet a owl:Class ;
    rdfs:label "Solid tube billet"@en,
        "制管用实心管坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:subClassOf stl:SemiFinishedProduct ;
    skos:definition "An individual solid steel billet intended for opening a bore in seamless tube making, identifiable by that use regardless of section or billet production route."@en,
        "供无缝制管开孔的单件实心钢坯，按其制管用途识别，截面和制坯方式可另行记录。"@zh ;
    skos:prefLabel "Solid tube billet"@en,
        "制管用实心管坯"@zh .

stl:WorkAssignment a owl:Class ;
    rdfs:label "Work assignment"@en,
        "工序派工单"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-3-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:Plan ;
    skos:definition "A dispatch instruction allocating a planned segment to a work unit and time slot."@en,
        "把一段待执行作业落实到指定工作单元和作业时段的指令。"@zh ;
    skos:prefLabel "Work assignment"@en,
        "工序派工单"@zh .

stl:allocatedLot a owl:ObjectProperty ;
    rdfs:label "Allocated source lot"@en,
        "配入来源批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:LotAllocation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:MaterialLot ;
    skos:definition "Identifies the source lot drawn upon in a quantified charge allocation."@en,
        "标明某次定量投料明细实际取料的批次。"@zh ;
    skos:prefLabel "Allocated source lot"@en,
        "配入来源批"@zh .

stl:allocationOperation a owl:ObjectProperty ;
    rdfs:label "Allocation operation"@en,
        "投用执行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:LotAllocation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:Operation ;
    skos:definition "Identifies the execution receiving the material in this allocation."@en,
        "指定接收这笔定量投料的实际作业。"@zh ;
    skos:prefLabel "Allocation operation"@en,
        "投用执行"@zh .

stl:analysedRemelt a owl:ObjectProperty ;
    rdfs:label "Remelting stage analysed"@en,
        "气体分析所据重熔作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：逐次重熔气体复核须标明可独立追溯的重熔阶段。"@zh ;
    rdfs:domain stl:GasContentAnalysis ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:range stl:Remelting ;
    skos:definition "Identifies the remelting run represented by the analysed sample, distinguishing successive runs within one heat genealogy."@en,
        "指明供气体复核的试样所代表的那次重熔，使同一炉次多次重熔的结果可区分。"@zh ;
    skos:prefLabel "Remelting stage analysed"@en,
        "气体分析所据重熔作业"@zh .

stl:analysisType a owl:ObjectProperty ;
    rdfs:label "Analysis type"@en,
        "分析类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/isots-6084-2022> ;
    rdfs:domain stl:ChemicalAnalysis ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/analysis-type> ;
    skos:definition "Classifies an analysis by its use in heat assessment, process control or product testing."@en,
        "按用途区分供炉次判定、过程控制或成品检验的成分分析。"@zh ;
    skos:prefLabel "Analysis type"@en,
        "分析类型"@zh .

stl:assessedSpecification a owl:ObjectProperty ;
    rdfs:label "Specification for assessment"@en,
        "判定依据规格"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-404-2013> ;
    rdfs:domain stl:QualityDecision ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:MaterialSpecification ;
    skos:definition "Identifies the material specification used to assess the inspection evidence."@en,
        "指出质量判定实际用于对照检验结果的物料规格。"@zh ;
    skos:prefLabel "Specification for assessment"@en,
        "判定依据规格"@zh .

stl:bundleCutLength a owl:DatatypeProperty ;
    rdfs:label "Ordered length per bundled piece"@en,
        "捆内单支定尺"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024>,
        <https://w3id.org/ontology-platform/steel/std/gbt-11263-2024> ;
    rdfs:comment "下沉理由：普钢长材按捆交货时，以捆内单支的约定定尺配合支数核算整捆理论重量。"@zh ;
    rdfs:domain stl:Bundle ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products> ;
    rdfs:range xsd:decimal ;
    skos:definition "The ordered cut length in metres of each individual length in this delivery bundle."@en,
        "本交货捆内每支长材约定的定尺长度，以米计。"@zh ;
    skos:prefLabel "Ordered length per bundled piece"@en,
        "捆内单支定尺"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:M .

stl:bundlePieceCount a owl:DatatypeProperty ;
    rdfs:label "Delivered pieces per bundle"@en,
        "交货捆支数"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-2101-2017> ;
    rdfs:comment "下沉理由：普钢定尺捆的交货清点和理计以同一定尺下的实交支数为依据。"@zh ;
    rdfs:domain stl:Bundle ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The count of steel lengths delivered in a fixed-length bundle, as checked against the bundle tag and delivery quantity."@en,
        "给出定尺交货捆中实交长材的支数，用于对照捆牌和交货数量。"@zh ;
    skos:prefLabel "Delivered pieces per bundle"@en,
        "交货捆支数"@zh ;
    stl:quantityKind quantitykind:Count ;
    stl:unit unit:NUM .

stl:castOn a owl:ObjectProperty ;
    rdfs:label "Cast on"@en,
        "连浇铸机"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:CastSequence ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range stl:Equipment ;
    skos:definition "Identifies the caster on which the sequence of heats was poured."@en,
        "标识实际承接这一连续浇次的铸机。"@zh ;
    skos:prefLabel "Cast on"@en,
        "连浇铸机"@zh .

stl:cleanlinessEvidence a owl:ObjectProperty ;
    rdfs:label "Cleanliness assessment evidence"@en,
        "纯净度评价依据"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-18254-2016> ;
    rdfs:comment "下沉理由：特钢纯净度综合交验须能复查组成评价的各项检验结果。"@zh ;
    rdfs:domain stl:CleanlinessAssessment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:range stl:InspectionResult ;
    skos:definition "Identifies an inclusion rating or another measured indicator used as evidence in a cleanliness assessment."@en,
        "指出纯净度评价实际采用的一项夹杂物评级或其他受控指标的实测结果。"@zh ;
    skos:prefLabel "Cleanliness assessment evidence"@en,
        "纯净度评价依据"@zh .

stl:coatingType a owl:ObjectProperty ;
    rdfs:label "Coating type"@en,
        "涂镀层类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:MaterialPiece stl:MaterialSpecification ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/coating-type> ;
    skos:altLabel "镀层类型"@zh ;
    skos:definition "Identifies a coating present on a material piece or specified as a requirement for a material."@en,
        "给出实物件表面的实际涂镀层类别，或物料规格对涂镀层类别的要求。"@zh ;
    skos:prefLabel "Coating type"@en,
        "涂镀层类型"@zh .

<https://w3id.org/ontology-platform/steel/code/equipment-type/BF> a skos:Concept ;
    rdfs:label "Blast furnace"@en,
        "高炉"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:altLabel "BF"@en ;
    skos:definition "A shaft furnace in which a descending burden is reduced and melted with the aid of blast supplied through tuyeres near its base."@en,
        "炉料从炉顶下降、风从炉身下部鼓入，能连续还原并熔炼含铁炉料的竖炉。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "BF"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Blast furnace"@en,
        "高炉"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/COLDMILL> a skos:Concept ;
    rdfs:label "Cold rolling mill"@en,
        "冷轧机"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:definition "A mill that reduces or shapes steel through rolls under cold-working conditions."@en,
        "在冷加工条件下通过轧辊控制钢料减薄量或截面形状的设备。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "COLDMILL"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Cold rolling mill"@en,
        "冷轧机"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/ESR> a skos:Concept ;
    rdfs:label "Electroslag remelting furnace"@en,
        "电渣重熔炉"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10067-8-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:definition "A furnace using a heated slag bath to melt a consumable electrode and a mould to solidify the metal into an ingot."@en,
        "利用熔渣发热熔化自耗电极并在结晶器中凝固成锭的设备。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "ESR"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Electroslag remelting furnace"@en,
        "电渣重熔炉"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/material-category/DRI> a skos:Concept ;
    rdfs:label "Direct reduced iron"@en,
        "直接还原铁"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Metallized iron made by reducing iron oxides without melting the ore."@en,
        "矿石在固态被还原后得到、保有原料孔隙特征的金属化铁料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "DRI"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Direct reduced iron"@en,
        "直接还原铁"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/material-category/FERROALLOY> a skos:Concept ;
    rdfs:label "Ferroalloy"@en,
        "铁合金"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "An iron-based addition carrying an alloying or deoxidizing element into the bath."@en,
        "以铁为载体向熔池加入合金元素或脱氧元素的合金料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "FERROALLOY"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Ferroalloy"@en,
        "铁合金"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/material-category/SCRAP> a skos:Concept ;
    rdfs:label "Steel scrap"@en,
        "废钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-4223-2017> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Recovered steel pieces, offcuts or returns charged for their metallic content."@en,
        "回收并作为金属炉料重新熔炼的钢件、切边或返回料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "SCRAP"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Steel scrap"@en,
        "废钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/material-category/SLAG> a skos:Concept ;
    rdfs:label "Metallurgical slag"@en,
        "冶金渣"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Nonmetallic material formed in a metallurgical operation and separated from the metal phase."@en,
        "冶金过程中形成、与金属分相并可另行收集的非金属物料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "SLAG"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Metallurgical slag"@en,
        "冶金渣"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/material-category/STEEL> a skos:Concept ;
    rdfs:label "Steel"@en,
        "钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20566-2006> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Material identified as steel before a grade or product form is specified."@en,
        "以钢作为材质登记的物料，可再按钢种和产品形态细分。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "STEEL"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Steel"@en,
        "钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/melting-route/VIMESR> a skos:Concept ;
    rdfs:label "Vacuum induction melting followed by electroslag remelting"@en,
        "真空感应熔炼—电渣重熔"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:altLabel "VIM+ESR"@en ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/melting-route/REMELT> ;
    skos:definition "The primary vacuum induction melt supplies an electrode for one electroslag remelt."@en,
        "一次真空感应熔炼后，制备电极并进行一道电渣重熔。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/melting-route> ;
    skos:notation "VIMESR"^^stl:MeltingRouteCode ;
    skos:prefLabel "Vacuum induction melting followed by electroslag remelting"@en,
        "真空感应熔炼—电渣重熔"@zh .

<https://w3id.org/ontology-platform/steel/code/ndt-method/UT> a skos:Concept ;
    rdfs:label "Ultrasonic testing"@en,
        "超声检测"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-4162-2022> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "UT"@en,
        "UT"@zh ;
    skos:definition "Locates discontinuities from reflected or transmitted ultrasonic waves."@en,
        "以入射声波的回波或透射变化定位材料中的不连续。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ndt-method> ;
    skos:notation "UT"^^stl:NdtMethodCode ;
    skos:prefLabel "Ultrasonic testing"@en,
        "超声检测"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ndt-method> .

<https://w3id.org/ontology-platform/steel/code/packing-form/BUNDLE> a skos:Concept ;
    rdfs:label "Bundle"@en,
        "捆"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Several lengths secured together by strapping form one counted handling unit."@en,
        "若干条、根或支用带材捆扎成一个可计件的搬运单元。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/packing-form> ;
    skos:notation "BUNDLE"^^stl:PackingFormCode ;
    skos:prefLabel "Bundle"@en,
        "捆"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/packing-form> .

<https://w3id.org/ontology-platform/steel/code/process-type/COAT> a skos:Concept ;
    rdfs:label "Coating"@en,
        "涂镀"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:definition "Applying a metallic or organic layer to obtain the required surface properties."@en,
        "在钢材表面施加金属镀层或有机涂层以获得所需的表面性能。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "COAT"^^stl:ProcessTypeCode ;
    skos:prefLabel "Coating"@en,
        "涂镀"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/code/process-type/COG> a skos:Concept ;
    rdfs:label "Cogging segment"@en,
        "锻造开坯工序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/FORGE> ;
    skos:definition "A forging segment that progressively breaks down an ingot or large blank into stock for further forming."@en,
        "对锭或大断面坯料逐段锻压，为后续成形准备坯料的锻造段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "COG"^^stl:ProcessTypeCode ;
    skos:prefLabel "Cogging segment"@en,
        "锻造开坯工序"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/COLDROLL> a skos:Concept ;
    rdfs:label "Cold rolling"@en,
        "冷轧"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:definition "Rolling steel below its recrystallization temperature."@en,
        "在再结晶温度以下对钢料施加轧制变形。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "COLDROLL"^^stl:ProcessTypeCode ;
    skos:prefLabel "Cold rolling"@en,
        "冷轧"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/code/process-type/HEATTREAT> a skos:Concept ;
    rdfs:label "Heat treatment"@en,
        "热处理"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment-codes> ;
    skos:definition "A route segment specifying a thermal cycle to change the microstructure or properties of steel."@en,
        "安排钢材按给定温度历程改变组织或性能的路线工序段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "HEATTREAT"^^stl:ProcessTypeCode ;
    skos:prefLabel "Heat treatment"@en,
        "热处理"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/code/process-type/INSPECT> a skos:Concept ;
    rdfs:label "Inspection"@en,
        "检验"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Work that obtains evidence of material quality through examination or testing."@en,
        "通过检查或试验取得物料质量证据的工序类型。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "INSPECT"^^stl:ProcessTypeCode ;
    skos:prefLabel "Inspection"@en,
        "检验"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/code/process-type/PESR> a skos:Concept ;
    rdfs:label "Protective atmosphere electroslag remelting segment"@en,
        "保护气氛电渣重熔工序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/ESR> ;
    skos:definition "An electroslag remelting segment carried out under a controlled protective atmosphere."@en,
        "工艺路线中在受控气氛保护下完成电渣重熔的工序段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "PESR"^^stl:ProcessTypeCode ;
    skos:prefLabel "Protective atmosphere electroslag remelting segment"@en,
        "保护气氛电渣重熔工序"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/VAR> a skos:Concept ;
    rdfs:label "Vacuum arc remelting segment"@en,
        "真空自耗重熔工序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/REMELT> ;
    skos:definition "A remelting segment in which an arc melts the electrode under vacuum."@en,
        "工艺路线中在真空下以电弧熔化电极的重熔段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "VAR"^^stl:ProcessTypeCode ;
    skos:prefLabel "Vacuum arc remelting segment"@en,
        "真空自耗重熔工序"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/VIM> a skos:Concept ;
    rdfs:label "Vacuum induction melting segment"@en,
        "真空感应熔炼工序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/STEELMAKE> ;
    skos:definition "A route segment for primary melting in a vacuum induction furnace."@en,
        "以真空感应炉完成一次冶炼的工艺路线段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "VIM"^^stl:ProcessTypeCode ;
    skos:prefLabel "Vacuum induction melting segment"@en,
        "真空感应熔炼工序"@zh .

<https://w3id.org/ontology-platform/steel/code/product-form/BEAMBLANK> a skos:Concept ;
    rdfs:label "Beam blank"@en,
        "异型坯"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "A near-net structural blank with flange and web regions for subsequent section rolling."@en,
        "断面预先形成翼缘区和腹板区以供型钢轧制的坯料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "BEAMBLANK"^^stl:ProductFormCode ;
    skos:prefLabel "Beam blank"@en,
        "异型坯"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/product-form/BLOOM> a skos:Concept ;
    rdfs:label "Bloom"@en,
        "大方坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting-codes> ;
    skos:definition "A large square or rectangular semiproduct supplied for breakdown or rolling."@en,
        "以方形或矩形的大断面坯料形态交接，供后续开坯或轧制。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "BLOOM"^^stl:ProductFormCode ;
    skos:prefLabel "Bloom"@en,
        "大方坯"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/product-form/FORGING> a skos:Concept ;
    rdfs:label "Forging form"@en,
        "锻件形态"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-8541-2012> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging-codes> ;
    skos:definition "The form of a forged piece that can be transferred individually as a blank or finished product."@en,
        "以锻造取得可单件交接或继续加工的坯件或成品形状。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "FORGING"^^stl:ProductFormCode ;
    skos:prefLabel "Forging form"@en,
        "锻件形态"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/product-form/INGOT> a skos:Concept ;
    rdfs:label "Steel ingot"@en,
        "钢锭"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "A discrete solid mass cast in an ingot mould or remelting mould for subsequent working."@en,
        "在单个锭模或重熔结晶器内凝固成形、供后续加工的整块金属。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "INGOT"^^stl:ProductFormCode ;
    skos:prefLabel "Steel ingot"@en,
        "钢锭"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/product-form/RECTBILLET> a skos:Concept ;
    rdfs:label "Rectangular billet"@en,
        "矩形坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-2011-2014> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Semi-finished stock ordered as a rectangular billet with distinct broad and narrow faces."@en,
        "以长边和短边分别定尺且在产品规格中归作矩形坯的半成品。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "RECTBILLET"^^stl:ProductFormCode ;
    skos:prefLabel "Rectangular billet"@en,
        "矩形坯"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/product-form/SHELL> a skos:Concept ;
    rdfs:label "Pierced shell"@en,
        "毛管"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "A hollow intermediate after piercing and before elongation or sizing."@en,
        "实心坯穿孔后、尚待延伸或定径的空心中间件。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "SHELL"^^stl:ProductFormCode ;
    skos:prefLabel "Pierced shell"@en,
        "毛管"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/product-form/SLAB> a skos:Concept ;
    rdfs:label "Slab"@en,
        "板坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-2012-2014> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "A wide flat semi-finished section suitable for rolling into plate or strip."@en,
        "断面宽而扁、通常供轧板或轧带的半成品坯。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "SLAB"^^stl:ProductFormCode ;
    skos:prefLabel "Slab"@en,
        "板坯"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/product-form/SQBILLET> a skos:Concept ;
    rdfs:label "Square billet"@en,
        "方坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-2011-2014> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Solid semi-finished stock with nominally equal perpendicular sides."@en,
        "供后续成形的实心半成品，横截面的两边名义上相等且成直角。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "SQBILLET"^^stl:ProductFormCode ;
    skos:prefLabel "Square billet"@en,
        "方坯"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/weld-method/ERW> a skos:Concept ;
    rdfs:label "Electric resistance welding"@en,
        "电阻焊"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking-codes> ;
    skos:definition "Heats the mating edges by electrical resistance and applies pressure to join them."@en,
        "利用流经管边的电流所产生的电阻热加热接合面，再加压焊合。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/weld-method> ;
    skos:notation "ERW"^^stl:WeldMethodCode ;
    skos:prefLabel "Electric resistance welding"@en,
        "电阻焊"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/weld-method> .

stl:defectType a owl:ObjectProperty ;
    rdfs:label "Defect type"@en,
        "缺陷类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/defect-type> ;
    skos:definition "Identifies the controlled defect category applicable to an observed imperfection."@en,
        "标明实际观察到的异常属于哪类缺陷。"@zh ;
    skos:prefLabel "Defect type"@en,
        "缺陷类型"@zh .

stl:dispositionType a owl:ObjectProperty ;
    rdfs:label "Disposition type"@en,
        "处置类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/disposition-type> ;
    skos:definition "Identifies the category of action authorized by the disposition."@en,
        "用代码规定对本项质量问题获准采取的处置方式。"@zh ;
    skos:prefLabel "Disposition type"@en,
        "处置类型"@zh .

stl:element a owl:ObjectProperty ;
    rdfs:label "Element analyte"@en,
        "元素项目"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/isots-6084-2022> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:definition "Identifies the elemental constituent and reporting basis of a content result or limit."@en,
        "指定质量分数结果或限值涉及的元素及其分析口径。"@zh ;
    skos:prefLabel "Element analyte"@en,
        "元素项目"@zh .

stl:forgingRatio a owl:DatatypeProperty ;
    rdfs:label "Forging ratio"@en,
        "锻造比"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/jis-g-0701-1957> ;
    rdfs:comment "下沉理由：特钢锻件需保留作业实记的变形程度，以便按所用锻造方式核查。"@zh ;
    rdfs:domain stl:Forging ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging> ;
    rdfs:range xsd:decimal ;
    skos:definition "A recorded measure of deformation using the dimensional ratio applicable to the operation. For drawing out, the ratio may be expressed as initial area divided by final area."@en,
        "按本次锻造方式适用的尺寸比口径记录的变形程度，例如拔长可用锻前与锻后截面积之比表示。"@zh ;
    skos:prefLabel "Forging ratio"@en,
        "锻造比"@zh ;
    stl:quantityKind quantitykind:DimensionlessRatio ;
    stl:unit unit:UNITLESS .

stl:formationDimension a owl:ObjectProperty ;
    rdfs:label "Lot formation dimension"@en,
        "组批维度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:domain stl:LotFormationRule ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    skos:definition "Identifies a characteristic that members must share under the rule, such as heat identity, material specification or delivery condition."@en,
        "指明该规则要求批内成员一致的特征，例如炉号、物料规格或交货状态。"@zh ;
    skos:prefLabel "Lot formation dimension"@en,
        "组批维度"@zh .

stl:hasPart a owl:ObjectProperty ;
    rdfs:label "Has part"@en,
        "包含组成部分"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    owl:inverseOf stl:partOf ;
    skos:definition "Identifies a constituent belonging to the stated whole."@en,
        "列出在所述组成关系中属于当前整体的一个部分。"@zh ;
    skos:prefLabel "Has part"@en,
        "包含组成部分"@zh .

stl:heatPositionInSequence a owl:DatatypeProperty ;
    rdfs:label "Heat position within casting sequence"@en,
        "浇次内炉序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Heat ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Gives the one-based ordinal of the heat in the order in which the caster received the heats."@en,
        "给出一炉钢水在所属连续浇次中的接浇顺位，首炉记为一。"@zh ;
    skos:prefLabel "Heat position within casting sequence"@en,
        "浇次内炉序"@zh .

stl:inclusionSeries a owl:ObjectProperty ;
    rdfs:label "Rated inclusion series"@en,
        "受评夹杂物系列"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> ;
    rdfs:comment "下沉理由：同类夹杂物的粗、细系列在特钢交验中分别评定。"@zh ;
    rdfs:domain stl:InclusionRatingResult ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/inclusion-series> ;
    skos:definition "Identifies the thickness series for a rated morphology when the method distinguishes such series."@en,
        "在方法细分粗细的形态类别内，标明本结果对应的厚度系列。"@zh ;
    skos:prefLabel "Rated inclusion series"@en,
        "受评夹杂物系列"@zh .

stl:ingotPosition a owl:ObjectProperty ;
    rdfs:label "Tracked ingot position"@en,
        "追溯锭位"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特钢不合格件需定位到来源钢锭的头、中、尾段。"@zh ;
    rdfs:domain stl:Ingot ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/ingot-position> ;
    skos:definition "Identifies an axial zone tracked on an ingot. Source intervals distinguish outputs taken from different zones of the same ingot."@en,
        "登记钢锭上有来源追踪记录的轴向部位，一锭可涉及多个部位，具体产出由来源区段区分。"@zh ;
    skos:prefLabel "Tracked ingot position"@en,
        "追溯锭位"@zh .

stl:inputPiece a owl:ObjectProperty ;
    rdfs:label "Input piece"@en,
        "投入件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:domain stl:Operation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:MaterialPiece ;
    rdfs:subPropertyOf prov:used ;
    skos:definition "Identifies an actual input piece used by this execution."@en,
        "列出一次执行实际使用的一件源实物。"@zh ;
    skos:prefLabel "Input piece"@en,
        "投入件"@zh .

stl:inspectionDocumentType a owl:ObjectProperty ;
    rdfs:label "Inspection document type"@en,
        "检验文件类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/en-10204-2004> ;
    rdfs:domain stl:MillCertificate ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/inspection-document-type> ;
    skos:definition "Identifies the inspection document type used for the certificate delivered."@en,
        "给出交货时出具的证明文件所属的检验文件型式。"@zh ;
    skos:prefLabel "Inspection document type"@en,
        "检验文件类型"@zh .

stl:intervalIngotPosition a owl:ObjectProperty ;
    rdfs:label "Ingot position of source interval"@en,
        "来源区段锭位"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特钢探伤异议须落实到逐件取材的锭位，仅记录整锭涉及的部位无法区分同锭产出。"@zh ;
    rdfs:domain stl:SourceInterval ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/ingot-position> ;
    skos:definition "Identifies the ingot zone of the interval allocated to a particular output piece."@en,
        "标记某一产出实际占用的锭体区段，使多件同锭的交验记录仍可逐件回查。"@zh ;
    skos:prefLabel "Ingot position of source interval"@en,
        "来源区段锭位"@zh .

stl:materialCategory a owl:ObjectProperty ;
    rdfs:label "Material category"@en,
        "物料类别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:Material stl:MaterialSpecification ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:definition "Classifies a material or its specification by material category, such as coke or scrap."@en,
        "根据物料类别代码标明物料或其规格所代表的料种，例如焦炭或废钢。"@zh ;
    skos:prefLabel "Material category"@en,
        "物料类别"@zh .

stl:measuredAtPoint a owl:ObjectProperty ;
    rdfs:label "Measured at point"@en,
        "测量点位"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Observation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:MeasurementPoint ;
    skos:definition "Identifies the equipment measurement point from which the reading was acquired."@en,
        "指出读数实际采自机组上的哪个已标识测点。"@zh ;
    skos:prefLabel "Measured at point"@en,
        "测量点位"@zh .

stl:measuredObject a owl:ObjectProperty ;
    rdfs:label "Observed object"@en,
        "被测对象"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Observation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    skos:definition "Identifies the material lot, individual piece or operating asset whose condition the observation records."@en,
        "指出一次测量所针对的物料批、实物件或在工况测量中接受监测的设备。"@zh ;
    skos:prefLabel "Observed object"@en,
        "被测对象"@zh .

stl:methodStandard a owl:ObjectProperty ;
    rdfs:label "Method standard"@en,
        "方法标准"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:StandardEdition ;
    skos:definition "Identifies the edition of the method standard used or required for sampling, analysis or testing."@en,
        "指明取样、分析或试验所采用或所要求的方法标准版次。"@zh ;
    skos:prefLabel "Method standard"@en,
        "方法标准"@zh .

stl:movedPiece a owl:ObjectProperty ;
    rdfs:label "Moved piece"@en,
        "移动实物"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:MaterialPiece ;
    skos:definition "Identifies the piece designated for a move or involved in the actual event."@en,
        "指明指令所要搬运或事件中实际移动的实物件。"@zh ;
    skos:prefLabel "Moved piece"@en,
        "移动实物"@zh .

stl:ndtAcceptanceClass a owl:ObjectProperty ;
    rdfs:label "Bar inspection acceptance class"@en,
        "棒材探伤验收等级"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-4162-2022> ;
    rdfs:comment "下沉理由：特钢锻轧棒材按订单指定等级逐支探伤，普钢检验无须承担该棒材方法的分级口径。"@zh ;
    rdfs:domain stl:NondestructiveTest ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/ndt-acceptance-class> ;
    skos:definition "Identifies the acceptance class used to interpret indications in an ultrasonic examination of forged or rolled bars."@en,
        "指出本次锻轧棒材超声检验据以判读显示的验收级别，实际判定记在质量判定记录上。"@zh ;
    skos:prefLabel "Bar inspection acceptance class"@en,
        "棒材探伤验收等级"@zh .

stl:ndtMethod a owl:ObjectProperty ;
    rdfs:label "Nondestructive method"@en,
        "无损检测方法"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:NondestructiveTest ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/ndt-method> ;
    skos:definition "Identifies the nondestructive method used to examine the surface or interior of the item."@en,
        "标识检查工件内部或表面时采用的无损检测方法。"@zh ;
    skos:prefLabel "Nondestructive method"@en,
        "无损检测方法"@zh .

stl:performedOn a owl:ObjectProperty ;
    rdfs:label "Performed on"@en,
        "执行设备"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Event ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:Equipment ;
    skos:definition "Identifies the physical equipment on which the recorded work took place."@en,
        "指出实际承接本次现场作业或搬运事件的设备。"@zh ;
    skos:prefLabel "Performed on"@en,
        "执行设备"@zh .

stl:pretreatmentMethod a owl:ObjectProperty ;
    rdfs:label "Hot metal pretreatment method"@en,
        "铁水预处理方法"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:HotMetalPretreatment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/pretreatment-method> ;
    skos:definition "Identifies the treatment applied to remove a particular impurity from hot metal, allowing several methods for a combined treatment."@en,
        "标明本次预处理针对哪一种杂质进行脱除，联合处理可列出所用的多个方法。"@zh ;
    skos:prefLabel "Hot metal pretreatment method"@en,
        "铁水预处理方法"@zh .

stl:processType a owl:ObjectProperty ;
    rdfs:label "Process type"@en,
        "工序类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:ProcessSegment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:definition "Classifies a schedulable process segment by the manufacturing process it describes."@en,
        "为可排程的工序段指定工艺分类代码。"@zh ;
    skos:prefLabel "Process type"@en,
        "工序类型"@zh .

stl:processedHeat a owl:ObjectProperty ;
    rdfs:label "Processed heat"@en,
        "处理炉次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Operation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:range stl:Heat ;
    skos:definition "Identifies a heat actually processed by an operation so its steelmaking, refining and casting history can be followed."@en,
        "指明一次工序实际处理的炉次，使冶炼、精炼和浇注实绩可按钢水身份串联。"@zh ;
    skos:prefLabel "Processed heat"@en,
        "处理炉次"@zh .

stl:producedBy a owl:ObjectProperty ;
    rdfs:label "Produced by"@en,
        "产出工序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:MaterialPiece ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:Operation ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    owl:inverseOf stl:outputPiece ;
    skos:definition "Identifies the operation responsible for the birth of the piece under its current identifier."@en,
        "从新取得身份的件指向直接产出该件的实际作业。"@zh ;
    skos:prefLabel "Produced by"@en,
        "产出工序"@zh .

stl:rebarNominalDiameter a owl:DatatypeProperty ;
    rdfs:label "Nominal rebar diameter"@en,
        "钢筋公称直径"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-1-2024>,
        <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:comment "下沉理由：带肋钢筋按公称截面计算理论重量和归并规格，肋顶外径不能代表该尺寸。"@zh ;
    rdfs:domain stl:Rebar ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products> ;
    rdfs:range xsd:decimal ;
    skos:definition "The diameter in millimetres corresponding to the nominal section of a reinforcing bar, including ribbed bars."@en,
        "以毫米记录钢筋公称截面对应的直径，带肋钢筋也依此识别规格。"@zh ;
    skos:prefLabel "Nominal rebar diameter"@en,
        "钢筋公称直径"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:MilliM .

stl:sampleType a owl:ObjectProperty ;
    rdfs:label "Sample type"@en,
        "样品类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Sample ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/sample-type> ;
    skos:definition "Classifies a sample by its collection stage or the material taken."@en,
        "以取样所在环节或所取样材类别标记样品。"@zh ;
    skos:prefLabel "Sample type"@en,
        "样品类型"@zh .

stl:sequenceInStrand a owl:DatatypeProperty ;
    rdfs:label "Strand piece number"@en,
        "流内序号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:Slab stl:ContinuouslyCastPiece ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Records the piece number allocated within a numbering heat and strand, including a new number for each recut piece."@en,
        "标明在同一编号炉次和同一流下为该件分配的序号，二次切割时为新件分配新号。"@zh ;
    skos:prefLabel "Strand piece number"@en,
        "流内序号"@zh .

<https://w3id.org/ontology-platform/steel/std/astm-a941-26a> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "ASTM A941-26a" ;
    dcterms:issued "2026"^^xsd:gYear ;
    dcterms:title "Standard Terminology Relating to Steel, Stainless Steel, Related Alloys, and Ferroalloys"@en,
        "钢、不锈钢、相关合金及铁合金术语"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://store.astm.org/a0941-26a.html> .

<https://w3id.org/ontology-platform/steel/std/en-10079-2007> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "EN 10079:2007" ;
    dcterms:issued "2007"^^xsd:gYear ;
    dcterms:title "Definition of steel products"@en,
        "钢产品的定义"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://www.dinmedia.de/de/norm/din-en-10079/93163915> .

<https://w3id.org/ontology-platform/steel/std/gbt-1220-2007> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 1220-2007" ;
    dcterms:issued "2007"^^xsd:gYear ;
    dcterms:title "Stainless steel bars"@en,
        "不锈钢棒"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailedCNF?id=71F772D7F4DBD3A7E05397BE0A0AB82A> .

<https://w3id.org/ontology-platform/steel/std/gbt-1499-1-2017> a stl:StandardEdition ;
    dcterms:description "废止"@zh ;
    dcterms:identifier "GB/T 1499.1-2017" ;
    dcterms:issued "2017"^^xsd:gYear ;
    dcterms:title "Steel for the reinforcement of concrete—Part 1:Hot rolled plain bars"@en,
        "钢筋混凝土用钢 第1部分：热轧光圆钢筋"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailedCNF?id=71F772D828B7D3A7E05397BE0A0AB82A> .

<https://w3id.org/ontology-platform/steel/std/gbt-17616-2013> a stl:StandardEdition ;
    dcterms:description "废止"@zh ;
    dcterms:identifier "GB/T 17616-2013" ;
    dcterms:issued "2013"^^xsd:gYear ;
    dcterms:title "Unified numbering system for designation of iron,steel and alloy"@en,
        "钢铁及合金牌号统一数字代号体系"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=71F772D7EEB9D3A7E05397BE0A0AB82A> .

<https://w3id.org/ontology-platform/steel/std/gbt-17616-2025> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 17616-2025" ;
    dcterms:issued "2025"^^xsd:gYear ;
    dcterms:replaces <https://w3id.org/ontology-platform/steel/std/gbt-17616-2013> ;
    dcterms:title "Iron and steel coding system for irons, steels and alloys"@en,
        "钢铁及合金牌号统一数字代号体系"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=3DBA213286990D16E06397BE0A0A8119> .

<https://w3id.org/ontology-platform/steel/std/gbt-18254-2002> a stl:StandardEdition ;
    dcterms:description "废止"@zh ;
    dcterms:identifier "GB/T 18254-2002" ;
    dcterms:issued "2002"^^xsd:gYear ;
    dcterms:title "High-carbon chromium bearing steel"@en,
