stl:MeasuringInstrument a owl:Class ;
    rdfs:label "Measuring instrument"@en,
        "测量仪器"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf sosa:Sensor,
        stl:Equipment ;
    skos:definition "Equipment that responds to a measurand and provides a reading at a measurement point."@en,
        "按测量原理对被测量作出响应并提供读数的设备，可在不同测点使用。"@zh ;
    skos:prefLabel "Measuring instrument"@en,
        "测量仪器"@zh .

stl:MeltingRouteCode a rdfs:Datatype ;
    rdfs:label "Melting route code"@en,
        "冶炼路线代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:definition "Datatype of the primary notations in the melting route scheme."@en,
        "用于记录冶炼路线方案内主记号的字面量类型。"@zh ;
    skos:prefLabel "Melting route code"@en,
        "冶炼路线代码"@zh .

stl:MeltingRouteDetailShape a sh:PropertyShape ;
    rdfs:comment "实物件须引用能沿上位关系归入含重熔或不含重熔组的具体路线。"@zh ;
    sh:path [ sh:oneOrMorePath skos:broader ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:in ( <https://w3id.org/ontology-platform/steel/code/melting-route/REMELT> <https://w3id.org/ontology-platform/steel/code/melting-route/DIRECT> ) ] ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:meltingRoute .

stl:MeltingRouteSchemeShape a sh:PropertyShape ;
    rdfs:comment "实物件引用的冶炼路线代码须属于冶炼路线方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/melting-route> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:meltingRoute .

