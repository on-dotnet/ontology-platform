    rdfs:label "Steel quality class"@en,
        "质量等级类别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-13304-2-2008> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:SteelGrade stl:StandardGrade ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/steel-class-quality> ;
    skos:definition "Classifies an internal steel grade or standard designation by the main quality class applicable to it."@en,
        "按主要质量等级将内部钢种或标准牌号归类，用于区分不同层次的冶金质量要求。"@zh ;
    skos:prefLabel "Steel quality class"@en,
        "质量等级类别"@zh .

stl:steelUseClass a owl:ObjectProperty ;
    rdfs:label "Steel use class"@en,
        "用途类别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-13304-2-2008> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:SteelGrade stl:StandardGrade ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/steel-class-use> ;
    skos:definition "Classifies an internal steel grade or standard designation by its main application characteristics or intended use."@en,
        "按主要使用特性或用途将内部钢种或标准牌号归类。"@zh ;
    skos:prefLabel "Steel use class"@en,
        "用途类别"@zh .

stl:teemedInMould a owl:ObjectProperty ;
    rdfs:label "Teemed in mould"@en,
        "浇注所用锭模"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Ingot ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range stl:Equipment ;
    skos:definition "Identifies the individual mould filled for this ingot so that ingots from a shared teeming operation retain their own mould identities."@en,
        "标识浇成该锭时实际充型的那一只锭模，同一作业浇出的各锭分别关联各自的模具。"@zh ;
    skos:prefLabel "Teemed in mould"@en,
        "浇注所用锭模"@zh .

stl:testType a owl:ObjectProperty ;
    rdfs:label "Test type"@en,
        "试验类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:InspectionActivityRecord ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/test-type> ;
    skos:definition "Classifies the test documented by an inspection record for retrieval across products."@en,
        "标明检验记录执行的试验类别以便跨产品检索。"@zh ;
    skos:prefLabel "Test type"@en,
        "试验类型"@zh .

stl:thickness a owl:DatatypeProperty ;
    rdfs:label "Thickness"@en,
        "厚度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-709-2019> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range xsd:decimal ;
    skos:definition "The measured or specified distance between opposite faces in the thickness direction, expressed in millimetres."@en,
        "沿材料两相对表面之间的厚度方向量得或规定的距离，以毫米计。"@zh ;
    skos:prefLabel "Thickness"@en,
        "厚度"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:MilliM .

stl:upperLimit a owl:DatatypeProperty ;
    rdfs:label "Maximum elemental content"@en,
        "成分上限"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20878-2024> ;
    rdfs:domain stl:CompositionLimit ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the highest elemental mass percentage permitted by the composition requirement."@en,
        "给出一条成分要求允许的元素质量百分数上界。"@zh ;
    skos:prefLabel "Maximum elemental content"@en,
        "成分上限"@zh ;
    stl:quantityKind quantitykind:MassFraction ;
    stl:unit unit:PERCENT .

stl:Billet a owl:Class ;
    rdfs:label "Billet"@en,
        "小钢坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:SemiFinishedProduct ;
    skos:definition "A relatively small solid steel semiproduct supplied as feedstock for bars, rods or other wrought products, with its section identified separately."@en,
        "以较小实心断面交接、供轧棒线材或进一步成形的钢坯，断面形状另行记录。"@zh ;
    skos:prefLabel "Billet"@en,
        "小钢坯"@zh .

stl:CleanlinessAssessment a owl:Class ;
    rdfs:label "Specialty steel cleanliness assessment"@en,
        "特钢纯净度综合评价"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-18254-2016> ;
    rdfs:comment "下沉理由：轴承等疲劳敏感产品需要按规格把夹杂物评级与其他证据汇合出证，普钢常规化学分析仅逐项报告元素结果。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:subClassOf stl:InspectionResult ;
    skos:definition "An assessment combining the inclusion ratings of one acceptance subject with other inspection results required by its cleanliness specification."@en,
        "将一个交验对象的分项夹杂物评级与规格所需的其他检验结果汇集为可追溯的纯净度评价。"@zh ;
    skos:prefLabel "Specialty steel cleanliness assessment"@en,
        "特钢纯净度综合评价"@zh .

stl:Coal a owl:Class ;
    rdfs:label "Coal lot"@en,
        "煤批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A lot of coal received and charged as fuel, as a source of reductant or as coking feed, whether from one coal source or a blend."@en,
        "作为燃料、还原剂原料或炼焦原料按批验收和投用的煤，可由单种煤或配合煤组成。"@zh ;
    skos:prefLabel "Coal lot"@en,
        "煤批"@zh .

stl:Coke a owl:Class ;
    rdfs:label "Metallurgical coke lot"@en,
        "冶金焦炭批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1996-2017> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A lot of porous carbon-rich material produced by carbonizing coal, used in a blast furnace to supply heat, support the burden and participate in reduction."@en,
        "煤经炭化得到的多孔富碳物料批，入高炉后供热、参与还原并支撑料柱。"@zh ;
    skos:prefLabel "Metallurgical coke lot"@en,
        "冶金焦炭批"@zh .

stl:CompositionLimit a owl:Class ;
    rdfs:label "Composition limit"@en,
        "成分界限"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20878-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:Requirement ;
    skos:definition "A limit entry bounding the mass fraction of one element on the analytical basis specified."@en,
        "针对规格中的一个元素及分析口径约定质量分数边界的条目。"@zh ;
    skos:prefLabel "Composition limit"@en,
        "成分界限"@zh .

stl:DecisionEvidence a owl:Class ;
    rdfs:label "Decision evidence item"@en,
        "判定依据明细"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A decision entry linking the cited inspection result with the requirement against which it was evaluated."@en,
        "把判定采用的检验结果与所依据的规格要求对应起来的一条判定明细。"@zh ;
    skos:prefLabel "Decision evidence item"@en,
        "判定依据明细"@zh .

stl:DeliveryReceipt a owl:Class ;
    rdfs:label "Delivery receipt"@en,
        "收货凭证"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1091-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A document acknowledging the items and quantities handed over to the recipient on a stated date."@en,
        "由接收方确认本次交付内容、实收量和交接日期的凭证。"@zh ;
    skos:prefLabel "Delivery receipt"@en,
        "收货凭证"@zh .

stl:ElementResult a owl:Class ;
    rdfs:label "Element result"@en,
        "元素结果"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/isots-6084-2022> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:InspectionResult ;
    skos:definition "A single content determination for the specified element and reporting basis within an analysis."@en,
        "在一次成分分析中对应指定元素及其分析口径的单条含量结果。"@zh ;
    skos:prefLabel "Element result"@en,
        "元素结果"@zh ;
    skos:scopeNote "Use partOf to identify the analysis, and element and massFraction to record one analyte and its mass percentage."@en,
        "用 partOf 关联本次化学分析，用 element 和 massFraction 记录一项元素及其质量百分数。"@zh .

stl:GasContentAnalysis a owl:Class ;
    rdfs:label "Gas content analysis at a remelting stage"@en,
        "特冶重熔阶段气体分析"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-11261-2006>,
        <https://w3id.org/ontology-platform/steel/std/gbt-20124-2006>,
        <https://w3id.org/ontology-platform/steel/std/gbt-223-82-2018> ;
    rdfs:comment "下沉理由：特冶逐锭验收须区分同一初炼炉次在各次重熔后的气体分析结果。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:subClassOf stl:ChemicalAnalysis ;
    skos:definition "An analysis of oxygen, nitrogen or hydrogen in material sampled at an identified remelting stage, providing per-element results for ingot cleanliness review."@en,
        "测定指定重熔阶段试样的氧、氮或氢含量，保留重熔实绩与分元素结果，供逐锭纯净度复核。"@zh ;
    skos:prefLabel "Gas content analysis at a remelting stage"@en,
        "特冶重熔阶段气体分析"@zh .

stl:HardnessTest a owl:Class ;
    rdfs:label "Hardness test"@en,
        "硬度试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-230-1-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:MechanicalTest ;
    skos:definition "A test determining material hardness at a stated location under the conditions of a specified scale."@en,
        "以明确的标尺、载荷和测点取得材料硬度读数的试验。"@zh ;
    skos:prefLabel "Hardness test"@en,
        "硬度试验"@zh .

stl:HeatTreatmentHold a owl:Class ;
    rdfs:label "Heat treatment hold"@en,
        "热处理保温阶段"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "A stage of a heat treatment run during which the work is held within a temperature range. Each hold in a multistage cycle can be timed separately."@en,
        "一次热处理中使工件在某一温度范围内持续停留的一段实际作业，每次独立保温可分别计时。"@zh ;
    skos:prefLabel "Heat treatment hold"@en,
        "热处理保温阶段"@zh ;
    skos:scopeNote "用 partOf 指向热处理作业，保温时长由本阶段的 actualEndAt 与 actualStartAt 相减得到。"@zh .

stl:ImpactRequirement a owl:Class ;
    rdfs:label "Impact requirement"@en,
        "冲击性能要求"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-229-2020> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:PropertyRequirement ;
    skos:definition "A requirement for absorbed impact energy at a specified temperature, specimen size and orientation."@en,
        "为指定温度、试样尺寸和取向规定冲击吸收能量条件的条目。"@zh ;
    skos:prefLabel "Impact requirement"@en,
        "冲击性能要求"@zh .

stl:IngotCasting a owl:Class ;
    rdfs:label "Ingot casting"@en,
        "模铸作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:MaterialTransformation ;
    skos:definition "An operation that distributes liquid steel to one or more ingot moulds for solidification into individual ingots."@en,
        "将钢水分浇到一个或多个锭模内，待其在各模内凝固成锭的一次铸造作业。"@zh ;
    skos:prefLabel "Ingot casting"@en,
        "模铸作业"@zh .

stl:LoadPosition a owl:Class ;
    rdfs:label "Load position"@en,
        "装载位置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-42230-2022> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:Location ;
    skos:definition "An addressable position for a handling unit on an identified carrier."@en,
        "在特定运输载具内可定位某个交货单元的位置。"@zh ;
    skos:prefLabel "Load position"@en,
        "装载位置"@zh .

stl:LotFormationRule a owl:Class ;
    rdfs:label "Lot formation rule"@en,
        "组批规则"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    skos:definition "A rule specifying which characteristics pieces must share to be grouped in one inspection lot."@en,
        "规定哪些组批维度必须一致，才能将实物归入同一检验批的规则。"@zh ;
    skos:prefLabel "Lot formation rule"@en,
        "组批规则"@zh .

stl:MeasurementPoint a owl:Class ;
    rdfs:label "Measurement point"@en,
        "测点"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    skos:definition "An identifiable position on equipment at which a reading is taken."@en,
        "设备上可单独标识读数采集处的物理点位。"@zh ;
    skos:prefLabel "Measurement point"@en,
        "测点"@zh ;
    skos:scopeNote "Use partOf to identify the equipment on which the point is located."@en,
        "用 partOf 关联布设测点的设备。"@zh .

stl:MetallographicExamination a owl:Class ;
    rdfs:label "Metallographic examination"@en,
        "金相检验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-13298-2015> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:InspectionActivityRecord ;
    skos:definition "An examination documenting material structure on a prepared surface with traceable fields or ratings."@en,
        "通过观察制备表面，记录材料组织特征、相应视场或评级结果的检验。"@zh ;
    skos:prefLabel "Metallographic examination"@en,
        "金相检验"@zh .

stl:MetallographicField a owl:Class ;
    rdfs:label "Metallographic field"@en,
        "金相视场"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-13298-2015> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A record identifying a particular area on a prepared specimen surface by position and magnification."@en,
        "在试样观察面上按位置和放大倍数界定并单独登记的观察区域。"@zh ;
    skos:prefLabel "Metallographic field"@en,
        "金相视场"@zh .

stl:MicroExamination a owl:Class ;
    rdfs:label "Microexamination for specialty steel acceptance"@en,
        "特钢显微组织交验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-18254-2016> ;
    rdfs:comment "下沉理由：轴承钢等产品的显微交验按夹杂物系列或碳化物形态分项出证，普钢金相观察沿用通用金相检验类。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:subClassOf stl:MetallographicExamination ;
    skos:definition "Examination of a traceable specimen surface for the particular microscopic features specified for acceptance of a specialty steel product."@en,
        "依照特钢产品规格，在可追溯试料的观察面上对指定显微特征作分项交验的检验。"@zh ;
    skos:prefLabel "Microexamination for specialty steel acceptance"@en,
        "特钢显微组织交验"@zh .

stl:NondestructiveTest a owl:Class ;
    rdfs:label "Nondestructive test"@en,
        "无损检测"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:InspectionActivityRecord ;
    skos:definition "An examination record for locating surface or internal discontinuities while preserving the item's usability."@en,
        "在保留受检件使用能力的条件下查找表面或内部不连续的检测记录。"@zh ;
    skos:prefLabel "Nondestructive test"@en,
        "无损检测"@zh .

stl:Package a owl:Class ;
    rdfs:label "Package"@en,
        "包装件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1092-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:definition "An identified handling piece transferred as a unit while retaining the identity of its contents."@en,
        "按包装号整体移交且成员仍可追踪的物流实物件。"@zh ;
    skos:prefLabel "Package"@en,
        "包装件"@zh .

stl:RatingScale a owl:Class ;
    rdfs:label "Rating scale"@en,
        "评级标尺"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf skos:ConceptScheme ;
    skos:definition "An ordered scale whose grades and their interpretation are fixed by a particular method edition."@en,
        "在特定方法版次下规定级别顺序与含义的有序尺度。"@zh ;
    skos:prefLabel "Rating scale"@en,
        "评级标尺"@zh .

stl:ShipmentLine a owl:Class ;
    rdfs:label "Shipment line"@en,
        "发运明细"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A line associating a shipped item and delivered quantity with the corresponding order item."@en,
        "把发运单中的一项货物、交付数量与对应订单行相联系的明细。"@zh ;
    skos:prefLabel "Shipment line"@en,
        "发运明细"@zh ;
    skos:scopeNote "Use partOf to identify the shipment and deliveryOrderLine to identify the order item served."@en,
        "用 partOf 关联所属发运单，交货订单行由 deliveryOrderLine 指明。"@zh .

stl:StocktakeLine a owl:Class ;
    rdfs:label "Stocktake line"@en,
        "盘点明细"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-4878-2020> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A line comparing book and counted stock for one lot or piece within a stocktake."@en,
        "记录一个盘点范围内某件或某批的账面量与实点量的明细。"@zh ;
    skos:prefLabel "Stocktake line"@en,
        "盘点明细"@zh ;
    skos:scopeNote "Use partOf to identify the stocktake. Compare book and counted stock for the same material, location and cut-off."@en,
        "用 partOf 指向盘点作业，账面量与实盘量须对应同一物料、位置和截止时点。"@zh .

stl:SurfaceConditioning a owl:Class ;
    rdfs:label "Surface conditioning"@en,
        "表面修整"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/finishing> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that removes surface metal to clean the surface or eliminate local flaws, including grinding and peeling."@en,
        "从钢材表面去除材料以清理表层或消除局部缺陷的作业，包括修磨和扒皮。"@zh ;
    skos:prefLabel "Surface conditioning"@en,
        "表面修整"@zh .

stl:TensileRequirement a owl:Class ;
    rdfs:label "Tensile requirement"@en,
        "拉伸性能要求"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-228-1-2021> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:PropertyRequirement ;
    skos:definition "A specification item governing tensile properties for a stated orientation or temperature."@en,
        "限定规定方向或温度下材料拉伸响应的规格条目。"@zh ;
    skos:prefLabel "Tensile requirement"@en,
        "拉伸性能要求"@zh .

stl:TestPiece a owl:Class ;
    rdfs:label "Test piece"@en,
        "试样"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-2975-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:Sample ;
    skos:definition "An identifiable portion prepared with the geometry or surface required for direct testing."@en,
        "从样品制备、具有可识别几何或表面并直接接受试验的部分。"@zh ;
    skos:prefLabel "Test piece"@en,
        "试样"@zh .

stl:TransportUnit a owl:Class ;
    rdfs:label "Transport unit"@en,
        "运输载具"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1091-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:Equipment ;
    skos:definition "An identifiable carrier that holds goods during a shipment handover."@en,
        "承载装运货物并可作为一次装运交接对象的运输设备。"@zh ;
    skos:prefLabel "Transport unit"@en,
        "运输载具"@zh .

stl:TubeWelding a owl:Class ;
    rdfs:label "Tube seam welding"@en,
        "管体焊接"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:subClassOf stl:MaterialTransformation ;
    skos:definition "An operation that closes a tube body by welding the adjoining edges of formed plate or strip along a longitudinal or helical seam."@en,
        "将已成形板带的相邻边缘沿纵缝或螺旋缝焊合，使管体闭合的一次作业。"@zh ;
    skos:prefLabel "Tube seam welding"@en,
        "管体焊接"@zh .

stl:WorkUnit a owl:Class ;
    rdfs:label "Work unit"@en,
        "工作单元"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-1-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:EquipmentHierarchyNode ;
    skos:definition "A unit within a work center capable of carrying out an assigned segment of work."@en,
        "工作中心内能承担某段具体作业的资源单元。"@zh ;
    skos:prefLabel "Work unit"@en,
        "工作单元"@zh .

stl:assessedObject a owl:ObjectProperty ;
    rdfs:label "Assessed object"@en,
        "质量处理对象"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    skos:definition "Identifies the individual piece or inspection lot directly subject to the quality action."@en,
        "指出本次质量判定或处置直接适用的单件或检验批。"@zh ;
    skos:prefLabel "Assessed object"@en,
        "质量处理对象"@zh .

stl:bundleMassBasis a owl:ObjectProperty ;
    rdfs:label "Delivery bundle mass basis"@en,
        "交货捆计重方式"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:comment "下沉理由：定尺普钢长材可按尺寸和支数理计或按净重实计，交货捆需标明选用的口径。"@zh ;
    rdfs:domain stl:Bundle ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/bundle-mass-basis> ;
    skos:definition "Identifies the mass used for settlement of this bundle, either theoreticalMass or the weighed netMass after tare."@en,
        "标明结算本捆时采用的质量口径，理论值取 theoreticalMass，实际值取扣皮后的 netMass。"@zh ;
    skos:prefLabel "Delivery bundle mass basis"@en,
        "交货捆计重方式"@zh .

stl:castIn a owl:ObjectProperty ;
    rdfs:label "Cast in"@en,
        "所属浇次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Heat ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range stl:CastSequence ;
    skos:definition "Links a heat to the casting sequence that received its liquid steel."@en,
        "从一炉钢水指向实际接浇该炉钢水的连铸浇次。"@zh ;
    skos:prefLabel "Cast in"@en,
        "所属浇次"@zh .

stl:castingSpeed a owl:DatatypeProperty ;
    rdfs:label "Casting speed"@en,
        "拉速"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:ContinuousCasting stl:Cutting stl:Observation ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range xsd:decimal ;
    skos:altLabel "拉坯速度"@zh ;
    skos:definition "Strand withdrawal speed in metres per minute for the interval covered by a casting or cutting operation or by an observation."@en,
        "以米每分钟表示对应时段铸流沿出坯方向的引出速度，可记在作业实绩或测量记录上。"@zh ;
    skos:prefLabel "Casting speed"@en,
        "拉速"@zh ;
    stl:quantityKind quantitykind:LinearVelocity ;
    stl:unit unit:M-PER-MIN .

<https://w3id.org/ontology-platform/steel/code/defect-type/FORGED> a skos:Concept ;
    rdfs:label "Forging defects"@en,
        "锻件缺陷"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Groups flaws characterized by forging flow, forging geometry or internal integrity."@en,
        "归集与锻压流动、锻件轮廓或锻件内部完整性有关的缺陷。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/defect-type> ;
    skos:notation "FORGED"^^stl:DefectTypeCode ;
    skos:prefLabel "Forging defects"@en,
        "锻件缺陷"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/defect-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/PELLET> a skos:Concept ;
    rdfs:label "Pelletizing equipment"@en,
        "球团设备"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "Equipment for forming fine iron ore into green balls or hardening those balls into pellets."@en,
        "用于铁矿细料造球或使生球固结的设备总类。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "PELLET"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Pelletizing equipment"@en,
        "球团设备"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/WELDLINE> a skos:Concept ;
    rdfs:label "Welded pipe production line"@en,
        "焊管机组"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking-codes> ;
    skos:definition "A production line combining plate or strip forming equipment with seam welding equipment to make pipe."@en,
        "将板带成形和管体合缝焊接设备配套起来以生产焊管的机组。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "WELDLINE"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Welded pipe production line"@en,
        "焊管机组"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/melting-route/DIRECT> a skos:Concept ;
    rdfs:label "Routes without remelting"@en,
        "不含重熔路线"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:definition "Groups routes in which primary steel is cast with or without secondary refining and undergoes no consumable electrode remelt."@en,
        "归集一次冶炼后直接浇铸或经炉外精炼再浇铸、后续未进行自耗重熔的路线。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/melting-route> ;
    skos:notation "DIRECT"^^stl:MeltingRouteCode ;
    skos:prefLabel "Routes without remelting"@en,
        "不含重熔路线"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/melting-route> .

<https://w3id.org/ontology-platform/steel/code/process-type/ESR> a skos:Concept ;
    rdfs:label "Electroslag remelting segment"@en,
        "电渣重熔工序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/REMELT> ;
    skos:definition "A remelting segment using resistive heating in a slag bath to melt the electrode."@en,
        "工艺路线中利用熔渣电阻热熔化自耗电极的重熔段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "ESR"^^stl:ProcessTypeCode ;
    skos:prefLabel "Electroslag remelting segment"@en,
        "电渣重熔工序"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/FORGE> a skos:Concept ;
    rdfs:label "Forging segment"@en,
        "锻造工序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-8541-2012> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/TRANSFORM> ;
    skos:definition "A route segment that shapes steel stock by plastic deformation under forging loads."@en,
        "以锻压使钢料发生塑性变形的工艺路线段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "FORGE"^^stl:ProcessTypeCode ;
    skos:prefLabel "Forging segment"@en,
        "锻造工序"@zh .

<https://w3id.org/ontology-platform/steel/code/product-form/ROUNDBIL> a skos:Concept ;
    rdfs:label "Round billet"@en,
        "圆坯"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Solid round feedstock specified by diameter for processing such as piercing or forging."@en,
        "以公称直径描述断面的实心圆形半成品，可供轧管或锻造。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "ROUNDBIL"^^stl:ProductFormCode ;
    skos:prefLabel "Round billet"@en,
        "圆坯"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/product-form/TUBE> a skos:Concept ;
    rdfs:label "Tube or pipe"@en,
        "管材"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17395-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Steel stock with a closed hollow section specified by outside dimensions and wall thickness."@en,
        "沿长度具有封闭空腔并以外形和壁厚表征的钢材。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "TUBE"^^stl:ProductFormCode ;
    skos:prefLabel "Tube or pipe"@en,
        "管材"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/special-product-family/ALLOYSTR> a skos:Concept ;
    rdfs:label "Alloy structural steel"@en,
        "合金结构钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-3077-2015> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-codes> ;
    skos:definition "Alloy steels selected for the strength, toughness or hardenability required by structural components."@en,
        "通过合金化获得结构件所需强度、韧性或淬透性的钢材系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/special-product-family> ;
    skos:notation "ALLOYSTR"^^stl:SpecialProductFamilyCode ;
    skos:prefLabel "Alloy structural steel"@en,
        "合金结构钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/special-product-family> .

<https://w3id.org/ontology-platform/steel/code/special-product-family/GEAR> a skos:Concept ;
    rdfs:label "Gear steel"@en,
        "齿轮钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-codes> ;
    skos:definition "Steels selected for gears with regard to flank wear resistance and load capacity at the tooth root."@en,
        "按齿轮服役条件选用的钢材系列，选材时考虑齿面耐磨性与齿根承载能力。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/special-product-family> ;
    skos:notation "GEAR"^^stl:SpecialProductFamilyCode ;
    skos:prefLabel "Gear steel"@en,
        "齿轮钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/special-product-family> .

<https://w3id.org/ontology-platform/steel/code/special-product-family/HEATRES> a skos:Concept ;
    rdfs:label "Heat-resistant steel"@en,
        "耐热钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1221-2007> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-codes> ;
    skos:definition "Steels selected for elevated-temperature strength or oxidation resistance in hot-service components."@en,
        "供高温部件按高温强度或抗氧化性能选用的钢材系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/special-product-family> ;
    skos:notation "HEATRES"^^stl:SpecialProductFamilyCode ;
    skos:prefLabel "Heat-resistant steel"@en,
        "耐热钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/special-product-family> .

<https://w3id.org/ontology-platform/steel/code/special-product-family/QUALITYCS> a skos:Concept ;
    rdfs:label "Quality carbon structural steel"@en,
        "优质碳素结构钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-699-2015> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-codes> ;
    skos:definition "Carbon steels supplied by quality carbon structural steel grade for mechanical components."@en,
        "以优质碳素结构钢牌号供货、用于制造机械结构零件的碳钢系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/special-product-family> ;
    skos:notation "QUALITYCS"^^stl:SpecialProductFamilyCode ;
    skos:prefLabel "Quality carbon structural steel"@en,
        "优质碳素结构钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/special-product-family> .

<https://w3id.org/ontology-platform/steel/code/special-product-family/STAINLESS> a skos:Concept ;
    rdfs:label "Stainless steel"@en,
        "不锈钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1220-2007> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-codes> ;
    skos:definition "Stainless grades selected for resistance to corrosion in the intended environment."@en,
        "以在指定介质中耐腐蚀为主要选材依据的不锈钢系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/special-product-family> ;
    skos:notation "STAINLESS"^^stl:SpecialProductFamilyCode ;
    skos:prefLabel "Stainless steel"@en,
        "不锈钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/special-product-family> .

<https://w3id.org/ontology-platform/steel/code/weld-method/SAW> a skos:Concept ;
    rdfs:label "Submerged arc welding"@en,
        "埋弧焊"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking-codes> ;
    skos:definition "Fuses the pipe edges and electrode wire with an arc beneath a blanket of granular flux."@en,
        "在颗粒焊剂覆盖下以电弧熔合管边和焊丝，形成管体焊缝。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/weld-method> ;
    skos:notation "SAW"^^stl:WeldMethodCode ;
    skos:prefLabel "Submerged arc welding"@en,
        "埋弧焊"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/weld-method> .

stl:coversPiece a owl:ObjectProperty ;
    rdfs:label "Covered piece"@en,
        "覆盖实物"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-10474-2013> ;
    rdfs:domain stl:MillCertificate ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:MaterialPiece ;
    skos:definition "Identifies a piece explicitly included in the certificate's scope."@en,
        "列明一件由该质量证明书明确覆盖的实物。"@zh ;
    skos:prefLabel "Covered piece"@en,
        "覆盖实物"@zh .

stl:createdAt a owl:DatatypeProperty ;
    rdfs:label "Created at"@en,
        "创建时刻"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives the instant at which the identified item or document came into existence."@en,
        "给出实物或单据以此身份成立的时间点。"@zh ;
    skos:prefLabel "Created at"@en,
        "创建时刻"@zh .

stl:definedIn a owl:ObjectProperty ;
    rdfs:label "Defined in"@en,
        "定义版次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-221-2008> ;
    rdfs:domain stl:StandardGrade ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range stl:StandardEdition ;
    skos:definition "Identifies the edition within which the grade designation is defined."@en,
        "指出使该标准牌号名称及其解释有据可查的标准版次。"@zh ;
    skos:prefLabel "Defined in"@en,
        "定义版次"@zh .

stl:equipmentType a owl:ObjectProperty ;
    rdfs:label "Equipment type"@en,
        "设备类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:domain stl:Equipment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:definition "Identifies the equipment category describing the production function of an equipment resource."@en,
        "用设备类型代码标明一台设备按生产职能归入的类别。"@zh ;
    skos:prefLabel "Equipment type"@en,
        "设备类型"@zh .

stl:evidenceLevel a owl:ObjectProperty ;
    rdfs:label "Contribution evidence level"@en,
        "来源证据等级"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SourceContribution ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/contribution-evidence> ;
    skos:definition "Identifies the evidence supporting the share attributed to one immediate source."@en,
        "指明认定一个直接来源份额所采用的证据类别。"@zh ;
    skos:prefLabel "Contribution evidence level"@en,
        "来源证据等级"@zh .

stl:finalCrossSectionArea a owl:DatatypeProperty ;
    rdfs:label "Final cross-sectional area"@en,
        "锻后截面积"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/jis-g-0701-1957> ;
    rdfs:comment "下沉理由：特钢锻造履历可保留与锻前截面配对、用于核查变形程度的终了截面。"@zh ;
    rdfs:domain stl:Forging ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging> ;
    rdfs:range xsd:decimal ;
    skos:definition "The cross-sectional area after this forging operation, recorded in square millimetres on the same measurement basis as the initial section."@en,
        "作业结束时，与锻前截面采用相同核算口径的锻料截面积，以平方毫米记录。"@zh ;
    skos:prefLabel "Final cross-sectional area"@en,
        "锻后截面积"@zh ;
    stl:quantityKind quantitykind:Area ;
    stl:unit unit:MilliM2 .

stl:forgingMethod a owl:ObjectProperty ;
    rdfs:label "Forging method"@en,
        "锻造方法"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-8541-2012> ;
    rdfs:comment "下沉理由：特钢锻造履历需能区分自由锻、径锻和模锻等作业方法。"@zh ;
    rdfs:domain stl:Forging ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/forging-method> ;
    skos:definition "Identifies the principal forming method used in a forging operation for retrieval in the history of its output pieces."@en,
        "指明一次锻造作业采用的主要成形方法，供按作业查询锻件的加工履历。"@zh ;
    skos:prefLabel "Forging method"@en,
        "锻造方法"@zh .

stl:grossMass a owl:DatatypeProperty ;
    rdfs:label "Gross mass"@en,
        "毛重"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:MaterialPiece ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the mass weighed with the packaging or ancillary load included within the stated boundary."@en,
        "给出按规定称量边界连同包装或承载附属物一并称得的质量。"@zh ;
    skos:prefLabel "Gross mass"@en,
        "毛重"@zh ;
    stl:quantityKind quantitykind:Mass ;
    stl:unit unit:TONNE .

stl:heatTreatmentMethod a owl:ObjectProperty ;
    rdfs:label "Heat treatment method"@en,
        "热处理方法"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-12603-2005> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:HeatTreatment stl:HeatTreatmentLoad ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> ;
    skos:definition "Identifies by process code a method applied in a heat treatment run or undergone by a furnace load."@en,
        "用热处理工艺代码标明作业实际采用的方法，或装炉批所经历的方法。"@zh ;
    skos:prefLabel "Heat treatment method"@en,
        "热处理方法"@zh .

stl:inclusionType a owl:ObjectProperty ;
    rdfs:label "Rated inclusion category"@en,
        "受评夹杂物类别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> ;
    rdfs:comment "下沉理由：特钢纯净度验收分别核对各形态类别的评级。"@zh ;
    rdfs:domain stl:InclusionRatingResult ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/inclusion-type> ;
    skos:definition "Identifies the inclusion morphology for which this level was reported."@en,
        "标明本条评级观察到的夹杂物形态类别，决定应选用的分类标尺。"@zh ;
    skos:prefLabel "Rated inclusion category"@en,
        "受评夹杂物类别"@zh .

stl:initialCrossSectionArea a owl:DatatypeProperty ;
    rdfs:label "Initial cross-sectional area"@en,
        "锻前截面积"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/jis-g-0701-1957> ;
    rdfs:comment "下沉理由：特钢锻造履历可保留计算本次锻造比时采用的初始截面。"@zh ;
    rdfs:domain stl:Forging ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging> ;
    rdfs:range xsd:decimal ;
    skos:definition "The cross-sectional area of the stock before this forging operation, recorded in square millimetres for checking deformation."@en,
        "作业开始时用于核算本次锻造变形的坯料截面积，以平方毫米记录。"@zh ;
    skos:prefLabel "Initial cross-sectional area"@en,
        "锻前截面积"@zh ;
    stl:quantityKind quantitykind:Area ;
    stl:unit unit:MilliM2 .

stl:isConfirmed a owl:DatatypeProperty ;
    rdfs:label "Movement confirmed"@en,
        "移动已确认"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:MovementEvent ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether the actual movement has been confirmed."@en,
        "标明现场或业务记录是否已确认该次实际搬运。"@zh ;
    skos:prefLabel "Movement confirmed"@en,
        "移动已确认"@zh .

stl:judgementResult a owl:ObjectProperty ;
    rdfs:label "Judgement result"@en,
        "判定结果"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDecision ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/judgement-result> ;
    skos:definition "Encodes the current conformity conclusion for the assessed subject."@en,
        "记录本次判定对受检对象是否满足规格所作的结论。"@zh ;
    skos:prefLabel "Judgement result"@en,
        "判定结果"@zh .

stl:lowerLimit a owl:DatatypeProperty ;
    rdfs:label "Minimum elemental content"@en,
        "成分下限"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20878-2024> ;
    rdfs:domain stl:CompositionLimit ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the lowest elemental mass percentage permitted by the composition requirement."@en,
        "给出一条成分要求允许的元素质量百分数下界。"@zh ;
    skos:prefLabel "Minimum elemental content"@en,
        "成分下限"@zh ;
    stl:quantityKind quantitykind:MassFraction ;
    stl:unit unit:PERCENT .

stl:maximumGrindingDepth a owl:DatatypeProperty ;
    rdfs:label "Maximum grinding depth"@en,
        "最大修磨深度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:LocalGrinding ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/finishing> ;
    rdfs:range xsd:decimal ;
    skos:definition "The greatest depth removed within the area of a local grinding operation, measured in millimetres from the original surface."@en,
        "一次局部修磨在所处理区域内相对于原表面测得的最大去除深度，以毫米计。"@zh ;
    skos:prefLabel "Maximum grinding depth"@en,
        "最大修磨深度"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:MilliM .

stl:measurementMethod a owl:ObjectProperty ;
    rdfs:label "Measurement method"@en,
        "测量方式"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Observation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/measurement-method> ;
    skos:definition "Classifies the acquisition of a reading as manual or automatic."@en,
        "用采集方式代码说明读数由人工取得或自动采集。"@zh ;
    skos:prefLabel "Measurement method"@en,
        "测量方式"@zh .

stl:movementType a owl:ObjectProperty ;
    rdfs:label "Movement event type"@en,
        "移动事件类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:MovementEvent ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/movement-event-type> ;
    skos:definition "Identifies the type of physical movement documented by the event."@en,
        "说明本次已发生的搬运动作在移动代码表中的类别。"@zh ;
    skos:prefLabel "Movement event type"@en,
        "移动事件类型"@zh .

stl:netMass a owl:DatatypeProperty ;
    rdfs:label "Net mass"@en,
        "净重"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:MaterialPiece ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the mass of the material piece after the applicable tare has been excluded."@en,
        "给出扣除包装及相应皮重后属于实物本身的质量。"@zh ;
    skos:prefLabel "Net mass"@en,
        "净重"@zh ;
    stl:quantityKind quantitykind:Mass ;
    stl:unit unit:TONNE .

stl:numberingHeat a owl:ObjectProperty ;
    rdfs:label "Numbering heat"@en,
        "编号炉次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( stl:Slab stl:ContinuouslyCastPiece ) ] ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:range stl:Heat ;
    skos:definition "Identifies the heat used to assign the piece identifier independently of which heats supplied the steel."@en,
        "标识编制坯件编号所依据的炉次，实际供钢炉次由来源关系另记。"@zh ;
    skos:prefLabel "Numbering heat"@en,
        "编号炉次"@zh .

stl:outputPiece a owl:ObjectProperty ;
    rdfs:label "Output piece"@en,
        "产出件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:domain stl:Operation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:MaterialPiece ;
    skos:definition "Identifies a piece given its own output identity by this execution."@en,
        "列出因本次执行而获得独立身份的一件产出物。"@zh ;
    skos:prefLabel "Output piece"@en,
        "产出件"@zh .

stl:plainProductFamily a owl:ObjectProperty ;
    rdfs:label "Commodity steel ordering family"@en,
        "普钢订货产品族"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：碳素结构钢、型钢和通用焊管等普钢订货系列可交叉使用牌号，需从牌号查到适用系列。"@zh ;
    rdfs:domain stl:StandardGrade ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/plain-product-family> ;
    skos:definition "Identifies a commodity steel product family for which the edition-specific grade can be ordered. A structural grade may serve several families."@en,
        "指明该版次牌号可用于哪些普钢产品族，一种结构钢牌号可适用于多类交货产品。"@zh ;
    skos:prefLabel "Commodity steel ordering family"@en,
        "普钢订货产品族"@zh .

stl:ratedMacroDefect a owl:ObjectProperty ;
    rdfs:label "Rated macrodefect"@en,
        "受评低倍缺陷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1979-2025> ;
    rdfs:comment "下沉理由：锭材低倍交验按缺陷类别逐项对照特钢规格。"@zh ;
    rdfs:domain stl:MacroDefectRating ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/macro-defect-type> ;
    skos:definition "Identifies the discontinuity graded by a single macrostructural rating on an ingot product section."@en,
        "指出一条锭材低倍评级针对的组织缺陷，使同一试料上的不同评级可分别判读。"@zh ;
    skos:prefLabel "Rated macrodefect"@en,
        "受评低倍缺陷"@zh .

stl:rebarLotAssessmentBasis a owl:ObjectProperty ;
    rdfs:label "Rebar lot assessment basis"@en,
        "钢筋按批判定基准"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:comment "下沉理由：钢筋批验收须区分按公称米重核对的重量偏差和抗震钢筋的性能检验，以说明整批判定所据项目。"@zh ;
    rdfs:domain stl:QualityDecision ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/rebar-lot-basis> ;
    skos:definition "Identifies a product inspection basis used to assess a reinforcing bar lot. Several bases may support one decision."@en,
        "标明整批钢筋判定所采用的产品检验项目口径，可结合多个基准作出一次判定。"@zh ;
    skos:prefLabel "Rebar lot assessment basis"@en,
        "钢筋按批判定基准"@zh .

stl:rebarSurface a owl:ObjectProperty ;
    rdfs:label "Rebar surface pattern"@en,
        "钢筋表面形状"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-1-2024>,
        <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:comment "下沉理由：光圆和带肋是钢筋产品标准区分配筋用材的特征，验收时需单列。"@zh ;
    rdfs:domain stl:Rebar ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/rebar-surface> ;
    skos:definition "Identifies the surface pattern of a reinforcing bar by the geometry around its perimeter."@en,
        "标明钢筋按外周表面几何形状归入的产品类别。"@zh ;
    skos:prefLabel "Rebar surface pattern"@en,
        "钢筋表面形状"@zh .

stl:recordedAt a owl:DatatypeProperty ;
    rdfs:label "Recorded at"@en,
        "登记时刻"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives the instant at which the information was entered into the system of record."@en,
        "给出相关信息在业务系统中完成登记的时间。"@zh ;
    skos:prefLabel "Recorded at"@en,
        "登记时刻"@zh .

stl:refiningMethod a owl:ObjectProperty ;
    rdfs:label "Refining method"@en,
        "炉外精炼方法"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Refining ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/refining-method> ;
    skos:definition "Identifies the method applied in a secondary refining operation, such as ladle furnace treatment or vacuum circulation."@en,
        "标识一次炉外精炼对钢水实际采用的处理方法，例如钢包炉精炼或真空循环处理。"@zh ;
    skos:prefLabel "Refining method"@en,
        "炉外精炼方法"@zh .

stl:remeltNumber a owl:DatatypeProperty ;
    rdfs:label "Remelt number"@en,
        "重熔炉号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特冶需分别检索一次冶炼炉次、各道重熔的炉号以及逐锭件号。"@zh ;
    rdfs:domain stl:Remelting ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting> ;
    rdfs:range xsd:string ;
    skos:definition "The business identifier assigned to a remelting run so the run can be retrieved from its output ingots."@en,
        "生产记录分配给一次重熔作业的业务编号，用于从产出锭回查该次炉作业。"@zh ;
    skos:prefLabel "Remelt number"@en,
        "重熔炉号"@zh .

stl:remeltSequence a owl:DatatypeProperty ;
    rdfs:label "Remelt sequence number"@en,
        "重熔道次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特冶材料可能先后经历多次重熔，须能按冶金顺序区分各道作业。"@zh ;
    rdfs:domain stl:Remelting ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "The ordinal of this remelting operation in the material lineage, counted from one at the first remelt after primary melting."@en,
        "沿该件物料的冶炼链，自一次冶炼之后按先后为重熔作业编排的序号，第一次重熔记为一。"@zh ;
    skos:prefLabel "Remelt sequence number"@en,
        "重熔道次"@zh .

stl:resultOfInspection a owl:ObjectProperty ;
    rdfs:label "Originating inspection"@en,
        "结果所属检验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:InspectionResult ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:InspectionActivityRecord ;
    skos:definition "Identifies the specific inspection that yielded a separately identifiable result."@en,
        "指向产生某一独立结果的那一次检验记录。"@zh ;
    skos:prefLabel "Originating inspection"@en,
        "结果所属检验"@zh .

stl:sampleOf a owl:ObjectProperty ;
    rdfs:label "Sample of"@en,
        "取样对象"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-14284-2022> ;
    rdfs:domain stl:Sample ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    skos:definition "Identifies the individual piece or material lot from which the sample was taken, including a heat sampled as a lot."@en,
        "指出样品实际取自哪一件实物或哪一批物料，炉次是可取样的一种物料批。"@zh ;
    skos:prefLabel "Sample of"@en,
        "取样对象"@zh .

stl:shareBasis a owl:ObjectProperty ;
    rdfs:label "Share basis"@en,
        "份额基准"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:SourceContribution ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/share-basis> ;
    skos:definition "Identifies whether the output mass or length is the denominator for a direct source share."@en,
        "标明直接来源占比以产出质量还是产出长度为分母。"@zh ;
    skos:prefLabel "Share basis"@en,
        "份额基准"@zh .

stl:specialProductFamily a owl:ObjectProperty ;
    rdfs:label "Special steel product family"@en,
        "特钢产品族"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
