@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix stl: <https://w3id.org/ontology-platform/steel/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

stl:AlloyAddition a owl:Class ;
    rdfs:label "Alloy addition"@en,
        "合金加入"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An addition of alloying material to a bath or tapping stream to adjust the chemistry of the steel, traceable to the lots used."@en,
        "为调整钢液成分而向熔池或出钢钢流加入合金料的一次作业，可按投用批次追溯所加合金。"@zh ;
    skos:prefLabel "Alloy addition"@en,
        "合金加入"@zh .

stl:AnalysisTypeCode a rdfs:Datatype ;
    rdfs:label "chemical analysis type code"@en,
        "化学分析类型代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the chemical analysis type scheme."@en,
        "标识“化学分析类型”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "chemical analysis type code"@en,
        "化学分析类型代码"@zh .

stl:AnnealedCoil a owl:Class ;
    rdfs:label "Annealed coil"@en,
        "退火卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:ColdRolledCoil ;
    skos:definition "A coil of strip identified after an annealing cycle, whether the strip was annealed continuously or in a batch."@en,
        "以卷为实物件跟踪、带钢已完成退火热循环的钢卷，可由连续或成批退火取得。"@zh ;
    skos:prefLabel "Annealed coil"@en,
        "退火卷"@zh .

stl:Annealing a owl:Class ;
    rdfs:label "Annealing"@en,
        "退火"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:HeatTreatment ;
    skos:altLabel "退火执行"@zh ;
    skos:definition "A heat treatment with controlled heating, holding and cooling to soften steel, relieve internal stress or alter its microstructure."@en,
        "使钢材经历受控的加热、保温和冷却过程，以软化材料、消除内应力或调整组织的热处理作业。"@zh ;
    skos:prefLabel "Annealing"@en,
        "退火"@zh .

stl:Area a owl:Class ;
    rdfs:label "Area"@en,
        "生产区域"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-1-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:EquipmentHierarchyNode ;
    skos:definition "A functional subdivision of a site that groups work centers for production management."@en,
        "厂区内按生产职责划分、管理若干工作中心的区域。"@zh ;
    skos:prefLabel "Area"@en,
        "生产区域"@zh .

stl:BandedStructureRating a owl:Class ;
    rdfs:label "Bearing steel carbide banding examination"@en,
        "轴承钢碳化物带状评级检验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-18254-2016> ;
    rdfs:comment "下沉理由：高碳铬轴承钢按碳化物带状项目交验，其评级对象和标尺有别于普钢铁素体与珠光体的组织带。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:subClassOf stl:MicroExamination ;
    skos:definition "An examination grading the concentration of carbides in bands along the working direction on a longitudinal bearing steel specimen."@en,
        "在高碳铬轴承钢纵向观察面上评定碳化物沿加工方向聚集成带的程度并出具级别的检验。"@zh ;
    skos:prefLabel "Bearing steel carbide banding examination"@en,
        "轴承钢碳化物带状评级检验"@zh .

stl:BarPeeling a owl:Class ;
    rdfs:label "Bar peeling"@en,
        "棒材扒皮"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/finishing> ;
    rdfs:subClassOf stl:SurfaceConditioning ;
    skos:definition "A machining operation that cuts a continuous layer from the circumference of a bar to expose the underlying metal."@en,
        "用切削刀具沿棒材外周连续去除表层，使加工后的圆周表面露出基体金属的作业。"@zh ;
    skos:prefLabel "Bar peeling"@en,
        "棒材扒皮"@zh .

stl:BendTest a owl:Class ;
    rdfs:label "Bend test"@en,
        "弯曲试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-232-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:MechanicalTest ;
    skos:definition "A test bending a specimen under specified former conditions and assessing the integrity of its tensile surface."@en,
        "按规定弯心条件使试样弯曲并检查受拉面完整性的试验。"@zh ;
    skos:prefLabel "Bend test"@en,
        "弯曲试验"@zh .

stl:BlastFurnaceCharging a owl:Class ;
    rdfs:label "Blast furnace charging"@en,
        "高炉装料"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "One charging operation in which one or more identified burden lots enter a blast furnace through the furnace top."@en,
        "从炉顶把可识别的一批或多批炉料送入高炉的一次投料作业。"@zh ;
    skos:prefLabel "Blast furnace charging"@en,
        "高炉装料"@zh ;
    skos:scopeNote "Link to the enclosing furnace operation with partOf and to the lots charged on this occasion with consumedLot."@en,
        "用 partOf 归入高炉冶炼作业，用 consumedLot 列出这次实际投入的料批。"@zh .

stl:BlastFurnaceOperation a owl:Class ;
    rdfs:label "Blast furnace ironmaking operation"@en,
        "高炉冶炼作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An interval of operation on one blast furnace during which iron-bearing burden is reduced and melted and slag separates from the iron."@en,
        "一座高炉在可识别的运行时段内连续还原、熔化含铁炉料并使铁渣分离的作业。"@zh ;
    skos:prefLabel "Blast furnace ironmaking operation"@en,
        "高炉冶炼作业"@zh ;
    skos:scopeNote "Identify the furnace with performedOn and the burden lots with consumedLot. For charge-level timing, record the lots and actual times on the individual charging operations."@en,
        "用 performedOn 指定高炉，consumedLot 记本时段投入的炉料批。需逐次核对装料时间时，在所属装料作业上记实际时间和用料。"@zh .

stl:BlastFurnaceSlag a owl:Class ;
    rdfs:label "Blast furnace slag lot"@en,
        "高炉渣批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A by-product lot formed from gangue, fuel ash and fluxes during blast furnace smelting and collected separately from the molten iron."@en,
        "高炉冶炼中由脉石、燃料灰分与熔剂等形成并与铁水分离、可作为副产品追踪的渣批。"@zh ;
    skos:prefLabel "Blast furnace slag lot"@en,
        "高炉渣批"@zh .

stl:BreakdownRolling a owl:Class ;
    rdfs:label "Breakdown rolling"@en,
        "初轧开坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:HotRolling ;
    skos:definition "Hot rolling an ingot or large semiproduct into smaller stock for subsequent forming."@en,
        "把热钢锭或大断面坯初轧成供后续成形使用的较小断面坯料的作业。"@zh ;
    skos:prefLabel "Breakdown rolling"@en,
        "初轧开坯"@zh .

stl:BundleLengthShape a sh:PropertyShape ;
    rdfs:comment "定尺交货捆须标明一个正的单支定尺长度，以米计。"@zh ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minExclusive 0.0 ;
    sh:path stl:bundleCutLength ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Bundle .

stl:BundleMassBasisCode a rdfs:Datatype ;
    rdfs:label "Delivery bundle mass basis code"@en,
        "交货捆计重方式代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Datatype for the primary notations in the delivery bundle mass basis scheme."@en,
        "用于标记交货捆计重方式方案内主记号的字面量类型。"@zh ;
    skos:prefLabel "Delivery bundle mass basis code"@en,
        "交货捆计重方式代码"@zh .

stl:BundleMassBasisSchemeShape a sh:PropertyShape ;
    rdfs:comment "捆的计重依据须取自交货捆计重方式方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/bundle-mass-basis> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:bundleMassBasis .

stl:BundleMassBasisShape a sh:PropertyShape ;
    rdfs:comment "定尺交货捆须明确一个整捆结算所用的计重方式。"@zh ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:bundleMassBasis ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Bundle .

stl:BundlePieceCountShape a sh:PropertyShape ;
    rdfs:comment "交货捆的实交支数按整支清点，填写时须为非负整数。"@zh ;
    sh:datatype xsd:nonNegativeInteger ;
    sh:maxCount 1 ;
    sh:path stl:bundlePieceCount ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Bundle .

stl:CastHeatPositionShape a sh:PropertyShape ;
    rdfs:comment "已记入浇次的炉次应给出一个正整数炉序。"@zh ;
    sh:datatype xsd:positiveInteger ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:heatPositionInSequence ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:castIn .

stl:CastIngotMouldShape a sh:NodeShape ;
    rdfs:comment "已知由模铸作业产出的锭应逐锭关联实际充型的唯一锭模；已记锭模的锭也应能回到该模铸作业。"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "请核对该模铸锭的产出作业和逐锭记录的锭模设备。"@zh ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX eq: <https://w3id.org/ontology-platform/steel/code/equipment-type/>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT DISTINCT $this WHERE {
          { $this (stl:producedBy|^stl:outputPiece)/a/rdfs:subClassOf* stl:IngotCasting .
            FILTER NOT EXISTS {
              $this stl:teemedInMould ?mould .
              ?mould a/rdfs:subClassOf* stl:Equipment ; stl:equipmentType/skos:broader* eq:INGOTMOULD .
            }
          } UNION {
            $this stl:teemedInMould ?mould .
            FILTER NOT EXISTS { $this (stl:producedBy|^stl:outputPiece)/a/rdfs:subClassOf* stl:IngotCasting }
          } UNION {
            $this stl:teemedInMould ?first, ?second . FILTER (!sameTerm(?first, ?second))
          }
        }
    """ ] ;
    sh:targetClass stl:Ingot ;
    sh:targetSubjectsOf stl:teemedInMould .

stl:CastNumberingHeatShape a sh:PropertyShape ;
    rdfs:comment "使用按炉、按流编序的坯件应引用唯一的编号炉次；实际供钢的所有炉次由 sourceHeat 分别记录。"@zh ;
    sh:class stl:Heat ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:numberingHeat ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:numberingHeat,
        stl:sequenceInStrand .

stl:CastPieceSourceHeatShape a sh:PropertyShape ;
    rdfs:comment "连铸坯应至少记录一个实际供钢炉次；换炉过渡时可以列出多个炉次。"@zh ;
    sh:minCount 1 ;
    sh:path stl:sourceHeat ;
    sh:severity sh:Violation ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        SELECT DISTINCT ?this WHERE {
          ?this (stl:producedBy|^stl:outputPiece)/stl:partOf*/a/rdfs:subClassOf* stl:ContinuousCasting .
        }
    """ ] ;
    sh:targetClass stl:ContinuouslyCastPiece .

stl:CastSequenceCasterShape a sh:PropertyShape ;
    rdfs:comment "一条浇次记录应标识承接这组炉次的那一台铸机设备。"@zh ;
    sh:class stl:Equipment ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:castOn ;
    sh:severity sh:Violation ;
    sh:targetClass stl:CastSequence .

stl:CastSequenceUniquePositionShape a sh:NodeShape ;
    rdfs:comment "在同一连续浇次内，一个炉序只能分配给一个炉次。"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "同一浇次中有不同炉次占用了同一炉序。"@zh ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        SELECT DISTINCT $this WHERE {
          ?first stl:castIn $this ; stl:heatPositionInSequence ?a .
          ?second stl:castIn $this ; stl:heatPositionInSequence ?b .
          FILTER (!sameTerm(?first, ?second) && ?a = ?b)
        }
    """ ] ;
    sh:targetObjectsOf stl:castIn .

stl:CastingSpeedReadingShape a sh:NodeShape ;
    rdfs:comment "拉速测量项应有拉速读数，且不能混入其他测量项的读数；其他测量项的观测也不能混入拉速。"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "拉速读数与观测的测量项不一致。"@zh ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX item: <https://w3id.org/ontology-platform/steel/code/measurement-item/>
        SELECT DISTINCT $this WHERE {
          { $this stl:measurementItem item:CASTSPEED .
            FILTER (NOT EXISTS { $this stl:castingSpeed ?speed } ||
                    EXISTS { $this ?property ?other .
                             FILTER (?property IN (stl:temperature, stl:activeOxygen, stl:tensileStrength,
                                                   stl:impactEnergy, stl:coatingMass, stl:thickness, stl:width)) })
          } UNION {
            $this stl:castingSpeed ?speed .
            FILTER NOT EXISTS { $this stl:measurementItem item:CASTSPEED }
          }
        }
    """ ] ;
    sh:targetClass stl:Observation ;
    sh:targetSubjectsOf stl:measurementItem .

stl:CastingSpeedValueShape a sh:PropertyShape ;
    rdfs:comment "拉速记录铸流的引出速率，按非负十进制数填写，单位为米每分钟。"@zh ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:path stl:castingSpeed ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:castingSpeed .

stl:Changeover a owl:Class ;
    rdfs:label "Changeover"@en,
        "换型作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An execution between successive jobs that changes a setup or tool for the next specification."@en,
        "在前后两项生产任务之间为切换规格或工装而单独登记的执行。"@zh ;
    skos:prefLabel "Changeover"@en,
        "换型作业"@zh .

stl:ChemicalElementCode a rdfs:Datatype ;
    rdfs:label "chemical element analyte code"@en,
        "化学元素分析项代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the chemical element analyte scheme."@en,
        "标识“化学元素分析项”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "chemical element analyte code"@en,
        "化学元素分析项代码"@zh .

stl:CleanlinessEvidenceShape a sh:PropertyShape ;
    rdfs:comment "综合评价应指明用来作出纯净度结论的检验结果。"@zh ;
    sh:class stl:InspectionResult ;
    sh:minCount 1 ;
    sh:path stl:cleanlinessEvidence ;
    sh:severity sh:Violation ;
    sh:targetClass stl:CleanlinessAssessment .

stl:CoalBlend a owl:Class ;
    rdfs:label "Coal blend lot"@en,
        "配合煤批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:BulkBlend,
        stl:Coal ;
    skos:definition "A coal lot formed by physically combining source lots to a blending plan and retaining their identities as inputs."@en,
        "若干来源煤批按配煤方案实际混合后形成的新煤批，保留各投入煤批的来源关系。"@zh ;
    skos:prefLabel "Coal blend lot"@en,
        "配合煤批"@zh .

stl:CoatingTest a owl:Class ;
    rdfs:label "Coating test"@en,
        "镀层试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1839-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:InspectionActivityRecord ;
    skos:definition "A laboratory inspection record determining coating mass per unit area of a coated specimen."@en,
        "以镀层试样为对象检测单位面积覆层质量的实验室记录。"@zh ;
    skos:prefLabel "Coating test"@en,
        "镀层试验"@zh .

stl:CoatingTypeCode a rdfs:Datatype ;
    rdfs:label "Coating type code"@en,
        "涂镀层类型代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:altLabel "镀层类型代码"@zh ;
    skos:definition "Datatype for the primary notations in the coating type scheme."@en,
        "标记涂镀层类型方案中各项主记号的字面量类型。"@zh ;
    skos:prefLabel "Coating type code"@en,
        "涂镀层类型代码"@zh .

stl:CoatingTypeSchemeShape a sh:PropertyShape ;
    rdfs:comment "规格或实物所引用的涂镀层类型应属于涂镀层类型方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/coating-type> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:coatingType .

stl:Cogging a owl:Class ;
    rdfs:label "Cogging"@en,
        "锻造开坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-42602-2023> ;
    rdfs:comment "下沉理由：特钢锭的锻造开坯须在从铸态锭到后续加工用坯的履历中单列，并保留锻造比。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/process-type/COG> ;
    rdfs:subClassOf stl:Forging ;
    skos:altLabel "开坯"@zh,
        "开坯锻造"@zh ;
    skos:definition "A primary forging operation that works successive sections of an ingot or large blank to produce smaller-section stock for further processing."@en,
        "将锭或大断面坯料逐段锻压，制成供后续加工的较小断面坯料的初步锻造作业。"@zh ;
    skos:prefLabel "Cogging"@en,
        "锻造开坯"@zh .

stl:CoilJoining a owl:Class ;
    rdfs:label "Coil joining"@en,
        "合卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:MaterialTransformation ;
    skos:definition "An operation that joins strip from multiple input coils into one new coil whose genealogy includes the contributing coils."@en,
        "将两卷或多卷的带钢接续并卷成一个新卷，产出卷保留各投入卷的来源关系。"@zh ;
    skos:prefLabel "Coil joining"@en,
        "合卷"@zh .

stl:CoilSourceIntervalEndShape a sh:PropertyShape ;
    rdfs:comment "登记母卷区段时须给出终点，并使用与起点相同的非负十进制米数口径。"@zh ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:minInclusive 0.0 ;
    sh:path stl:endLength ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:endLength,
        stl:startLength .

stl:CoilSourceIntervalShape a sh:PropertyShape ;
    rdfs:comment "登记母卷区段时须给出起点，以非负十进制米数记录，起点可以与终点重合。"@zh ;
    sh:datatype xsd:decimal ;
    sh:lessThanOrEquals stl:endLength ;
    sh:minCount 1 ;
    sh:minInclusive 0.0 ;
    sh:path stl:startLength ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:endLength,
        stl:startLength .

stl:CoilSourceStockShape a sh:PropertyShape ;
    rdfs:comment "每卷应沿一步或多步直接来源关系追到至少一件坯料或钢锭。分卷、合卷可经过中间卷；坯锭可由实物类或坯形代码识别。"@zh ;
    sh:path [ sh:oneOrMorePath stl:derivedFrom ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:or ( [ sh:class stl:ContinuouslyCastPiece ] [ sh:class stl:BreakdownRolledStock ] [ sh:class stl:Slab ] [ sh:class stl:Bloom ] [ sh:class stl:Billet ] [ sh:class stl:BeamBlank ] [ sh:class stl:Ingot ] [ sh:property [ sh:path ( stl:productForm [ sh:zeroOrMorePath skos:broader ] ) ;
                                sh:qualifiedMinCount 1 ;
                                sh:qualifiedValueShape [ sh:in ( <https://w3id.org/ontology-platform/steel/code/product-form/SLAB> <https://w3id.org/ontology-platform/steel/code/product-form/BLOOM> <https://w3id.org/ontology-platform/steel/code/product-form/SQBILLET> <https://w3id.org/ontology-platform/steel/code/product-form/RECTBILLET> <https://w3id.org/ontology-platform/steel/code/product-form/ROUNDBIL> <https://w3id.org/ontology-platform/steel/code/product-form/BEAMBLANK> <https://w3id.org/ontology-platform/steel/code/product-form/INGOT> ) ] ] ] ) ] ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Coil .

stl:CoilSplitting a owl:Class ;
    rdfs:label "Coil splitting"@en,
        "分卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:MaterialTransformation ;
    skos:definition "An operation that divides strip from one parent coil into two or more output coils, each tracked separately against that parent."@en,
        "将同一母卷中的带钢分作两卷或多卷，各产出卷取得独立身份并记录其直接来源。"@zh ;
    skos:prefLabel "Coil splitting"@en,
        "分卷"@zh .

stl:Coking a owl:Class ;
    rdfs:label "Coking"@en,
        "炼焦"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that heats a coal charge in the absence of air to release volatile matter and form coke."@en,
        "将装炉煤隔绝空气加热，使挥发组分逸出并结成焦炭的一次生产作业。"@zh ;
    skos:prefLabel "Coking"@en,
        "炼焦"@zh .

stl:CompositeSample a owl:Class ;
    rdfs:label "Composite sample"@en,
        "组合样"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10322-1-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:Sample ;
    skos:definition "A sample formed by combining increments from a sampling plan for a joint determination."@en,
        "把来自同一取样计划的多份份样合并后用于一次测定的样品。"@zh ;
    skos:prefLabel "Composite sample"@en,
        "组合样"@zh .

stl:ContributionEvidenceCode a rdfs:Datatype ;
    rdfs:label "contribution evidence level code"@en,
        "来源证据等级代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the contribution evidence level scheme."@en,
        "标识“来源证据等级”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "contribution evidence level code"@en,
        "来源证据等级代码"@zh .

stl:ConverterSteelmaking a owl:Class ;
    rdfs:label "Converter steelmaking"@en,
        "转炉炼钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:subClassOf stl:Steelmaking ;
    skos:definition "A steelmaking operation in which gas is blown through or onto the converter bath to oxidize carbon and other constituents before tapping."@en,
        "在转炉内吹炼金属熔池，使碳等元素氧化并以出钢结束一个炉次的冶炼作业。"@zh ;
    skos:prefLabel "Converter steelmaking"@en,
        "转炉炼钢"@zh .

stl:CoreAnalysisTypeSchemeShape a sh:PropertyShape ;
    rdfs:comment "分析类型的取值应属于分析类型代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/analysis-type> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:analysisType .

stl:CoreCertificatePieceShape a sh:PropertyShape ;
    rdfs:comment "证明书逐件列出的交货对象应为实物件。"@zh ;
    sh:class stl:MaterialPiece ;
    sh:path stl:coversPiece ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:coversPiece .

stl:CoreCompositionBoundsShape a sh:PropertyShape ;
    rdfs:comment "同一成分限值同时给出上下界时，下界应小于或等于上界。"@zh ;
    sh:lessThanOrEquals stl:upperLimit ;
    sh:path stl:lowerLimit ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:lowerLimit .

stl:CoreConfirmationShape a sh:PropertyShape ;
    rdfs:comment "事件的确认状态应使用布尔值。"@zh ;
    sh:datatype xsd:boolean ;
    sh:path stl:isConfirmed ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:isConfirmed .

stl:CoreContributionEvidenceShape a sh:PropertyShape ;
    rdfs:comment "每条来源明细都应给出一个证据等级，份额未知时也可记录来源。"@zh ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:evidenceLevel ;
    sh:severity sh:Violation ;
    sh:targetClass stl:SourceContribution .

stl:CoreContributionInputShape a sh:PropertyShape ;
    rdfs:comment "一条份额明细的投入端至多指向一个来源物料。"@zh ;
    sh:class stl:Material ;
    sh:maxCount 1 ;
    sh:path stl:contributionInput ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:contributionInput .

stl:CoreContributionOutputShape a sh:PropertyShape ;
    rdfs:comment "同一条份额明细至多解释一个产出物料。"@zh ;
    sh:class stl:Material ;
    sh:maxCount 1 ;
    sh:path stl:contributionOutput ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:contributionOutput .

stl:CoreDecisionBasisShape a sh:PropertyShape ;
    rdfs:comment "判定应能追溯至所依据的规格。"@zh ;
    sh:minCount 1 ;
    sh:path stl:assessedSpecification ;
    sh:severity sh:Violation ;
    sh:targetClass stl:QualityDecision .

stl:CoreDecisionObjectShape a sh:PropertyShape ;
    rdfs:comment "判定应标明被评定的对象。"@zh ;
    sh:minCount 1 ;
    sh:path stl:assessedObject ;
    sh:severity sh:Violation ;
    sh:targetClass stl:QualityDecision .

stl:CoreDecisionResultShape a sh:PropertyShape ;
    rdfs:comment "判定应记载结论，待判也应有相应的结果代码。"@zh ;
    sh:minCount 1 ;
    sh:path stl:judgementResult ;
    sh:severity sh:Violation ;
    sh:targetClass stl:QualityDecision .

stl:CoreDecisionTimeShape a sh:PropertyShape ;
    rdfs:comment "判定应记录作出结论的时刻。"@zh ;
    sh:minCount 1 ;
    sh:path stl:occurredAt ;
    sh:severity sh:Violation ;
    sh:targetClass stl:QualityDecision .

stl:CoreDefectTypeSchemeShape a sh:PropertyShape ;
    rdfs:comment "缺陷类型的取值应属于缺陷类型代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/defect-type> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:defectType .

stl:CoreDispositionTypeSchemeShape a sh:PropertyShape ;
    rdfs:comment "处置类型的取值应属于处置类型代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/disposition-type> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:dispositionType .

stl:CoreElementSchemeShape a sh:PropertyShape ;
    rdfs:comment "元素项目的取值应属于元素项目代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:element .

stl:CoreEquipmentTypeSchemeShape a sh:PropertyShape ;
    rdfs:comment "设备类型的取值应属于设备类型代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:equipmentType .

stl:CoreEventPlanTimesShape a sh:PropertyShape ;
    rdfs:comment "执行和事件记录只记实绩，计划起止时间属于关联的计划。"@zh ;
    sh:maxCount 0 ;
    sh:path [ sh:alternativePath ( stl:plannedStartAt stl:plannedEndAt ) ] ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Event .

stl:CoreEvidenceLevelSchemeShape a sh:PropertyShape ;
    rdfs:comment "来源证据等级的取值应属于来源证据等级代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/contribution-evidence> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:evidenceLevel .

stl:CoreFormationDimensionSchemeShape a sh:PropertyShape ;
    rdfs:comment "组批规则引用的每个维度都应属于组批维度代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:formationDimension .

stl:CoreFractionBasisShape a sh:PropertyShape ;
    rdfs:comment "记录数值份额时应标明唯一的计算基准，供其他记录按相同口径比较。"@zh ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:shareBasis ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:share .

stl:CoreInspectionDocumentTypeSchemeShape a sh:PropertyShape ;
    rdfs:comment "检验文件类型的取值应属于检验文件类型代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/inspection-document-type> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:inspectionDocumentType .

stl:CoreInstantShape a sh:PropertyShape ;
    rdfs:comment "每个时间点都应使用带时区的日期时间，便于跨班次和跨地点比较。"@zh ;
    sh:datatype xsd:dateTime ;
    sh:path [ sh:alternativePath ( stl:plannedStartAt stl:plannedEndAt stl:actualStartAt stl:actualEndAt stl:occurredAt stl:createdAt stl:recordedAt stl:sampledAt stl:resultAt ) ] ;
    sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:actualEndAt,
        stl:actualStartAt,
        stl:createdAt,
        stl:occurredAt,
        stl:plannedEndAt,
        stl:plannedStartAt,
        stl:recordedAt,
        stl:resultAt,
        stl:sampledAt .

stl:CoreJudgementResultSchemeShape a sh:PropertyShape ;
    rdfs:comment "判定结果的取值应属于判定结果代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/judgement-result> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:judgementResult .

stl:CoreMassShape a sh:PropertyShape ;
    rdfs:comment "实物件的毛重、净重和理论重量均应为非负十进制数。"@zh ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:path [ sh:alternativePath ( stl:grossMass stl:netMass stl:theoreticalMass ) ] ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:grossMass,
        stl:netMass,
        stl:theoreticalMass .

stl:CoreMaterialCategorySchemeShape a sh:PropertyShape ;
    rdfs:comment "物料类别的取值应属于物料类别代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/material-category> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:materialCategory .

stl:CoreMeasurementItemSchemeShape a sh:PropertyShape ;
    rdfs:comment "测量项的取值应属于测量项代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:measurementItem .

stl:CoreMeasurementMethodSchemeShape a sh:PropertyShape ;
    rdfs:comment "测量方式的取值应属于测量方式代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/measurement-method> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:measurementMethod .

stl:CoreMovementActionShape a sh:PropertyShape ;
    rdfs:comment "移动事件应标明执行的动作。"@zh ;
    sh:minCount 1 ;
    sh:path stl:movementType ;
    sh:severity sh:Violation ;
    sh:targetClass stl:MovementEvent .

stl:CoreMovementPieceShape a sh:PropertyShape ;
    rdfs:comment "移动事件应指明搬运的实物件。"@zh ;
    sh:minCount 1 ;
    sh:path stl:movedPiece ;
    sh:severity sh:Violation ;
    sh:targetClass stl:MovementEvent .

stl:CoreMovementTimeShape a sh:PropertyShape ;
    rdfs:comment "移动事件应记录现场发生时刻，以便还原实物位置。"@zh ;
    sh:minCount 1 ;
    sh:path stl:occurredAt ;
    sh:severity sh:Violation ;
    sh:targetClass stl:MovementEvent .

stl:CoreMovementTypeSchemeShape a sh:PropertyShape ;
    rdfs:comment "移动事件类型的取值应属于移动事件类型代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/movement-event-type> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:movementType .

stl:CoreNdtMethodSchemeShape a sh:PropertyShape ;
    rdfs:comment "无损检测方法的取值应属于无损检测方法代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/ndt-method> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:ndtMethod .

stl:CoreObservationItemShape a sh:PropertyShape ;
    rdfs:comment "一次观测应标明一个测量项。"@zh ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:measurementItem ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Observation .

stl:CoreObservationMethodShape a sh:PropertyShape ;
    rdfs:comment "应记录读数的采集方式。"@zh ;
    sh:minCount 1 ;
    sh:path stl:measurementMethod ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Observation .

stl:CoreObservationPointShape a sh:PropertyShape ;
    rdfs:comment "现场观测应指向记录读数的测点。"@zh ;
    sh:class stl:MeasurementPoint ;
    sh:minCount 1 ;
    sh:path stl:measuredAtPoint ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Observation .

stl:CoreObservationResultTimeShape a sh:PropertyShape ;
    rdfs:comment "观测应记录可取得结果的时刻。"@zh ;
    sh:minCount 1 ;
    sh:path stl:resultAt ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Observation .

stl:CoreObservationSampleTimeShape a sh:PropertyShape ;
    rdfs:comment "观测应记录取得读数所代表样本或信号的时刻。"@zh ;
    sh:minCount 1 ;
    sh:path stl:sampledAt ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Observation .

stl:CoreObservedObjectShape a sh:PropertyShape ;
    rdfs:comment "测量记录应指出被测对象。"@zh ;
    sh:minCount 1 ;
    sh:path stl:measuredObject ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Observation .

stl:CorePlanActualTimesShape a sh:PropertyShape ;
    rdfs:comment "计划上的起止是安排时间，实际发生时刻应记录在执行或事件上。"@zh ;
    sh:maxCount 0 ;
    sh:path [ sh:alternativePath ( stl:actualStartAt stl:actualEndAt stl:occurredAt ) ] ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Plan .

stl:CoreProcessTypeSchemeShape a sh:PropertyShape ;
    rdfs:comment "工序类型的取值应属于工序类型代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/process-type> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:processType .

stl:CoreProductFormSchemeShape a sh:PropertyShape ;
    rdfs:comment "产品形态的取值应属于产品形态代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/product-form> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:productForm .

stl:CoreReadingShape a sh:NodeShape ;
    rdfs:comment "核心测量项应使用对应的读数属性，同一观测不能混入另一测量项的读数。"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "测量项与读数属性不一致。"@zh ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX item: <https://w3id.org/ontology-platform/steel/code/measurement-item/>
        SELECT DISTINCT $this WHERE {
          { $this stl:measurementItem item:TEMP . BIND(stl:temperature AS ?expected) }
          UNION { $this stl:measurementItem item:OXYACT . BIND(stl:activeOxygen AS ?expected) }
          UNION { $this stl:measurementItem item:TENSILE . BIND(stl:tensileStrength AS ?expected) }
          UNION { $this stl:measurementItem item:IMPACT . BIND(stl:impactEnergy AS ?expected) }
          UNION { $this stl:measurementItem item:COATMASS . BIND(stl:coatingMass AS ?expected) }
          UNION { $this stl:measurementItem item:THICKNESS . BIND(stl:thickness AS ?expected) }
          UNION { $this stl:measurementItem item:WIDTH . BIND(stl:width AS ?expected) }
          FILTER (NOT EXISTS { $this ?expected ?reading } ||
                  EXISTS { $this ?actual ?other .
                           FILTER (?actual IN (stl:temperature, stl:activeOxygen, stl:tensileStrength, stl:impactEnergy, stl:coatingMass, stl:thickness, stl:width) && ?actual != ?expected) })
        }
    """ ] ;
    sh:targetSubjectsOf stl:measurementItem .

stl:CoreSampleSourceShape a sh:PropertyShape ;
    rdfs:comment "样品应能指回取样对象，混合样可记录多个来源。"@zh ;
    sh:minCount 1 ;
    sh:path stl:sampleOf ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Sample .

stl:CoreSampleTypeSchemeShape a sh:PropertyShape ;
    rdfs:comment "样品类型的取值应属于样品类型代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/sample-type> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:sampleType .

stl:CoreShareBasisSchemeShape a sh:PropertyShape ;
    rdfs:comment "份额基准的取值应属于份额基准代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/share-basis> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:shareBasis .

stl:CoreShareShape a sh:PropertyShape ;
    rdfs:comment "来源份额按百分数记录，取值从零到一百。"@zh ;
    sh:datatype xsd:decimal ;
    sh:maxInclusive 100.0 ;
    sh:minInclusive 0.0 ;
    sh:path stl:share ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:share .

stl:CoreSourceHeatShape a sh:PropertyShape ;
    rdfs:comment "实物件记录的每个钢水来源都应指向炉次。"@zh ;
    sh:class stl:Heat ;
    sh:path stl:sourceHeat ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:sourceHeat .

stl:CoreSteelClassByCompositionSchemeShape a sh:PropertyShape ;
    rdfs:comment "钢的化学成分分类的取值应属于钢的化学成分分类代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/steel-class-composition> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:steelClassByComposition .

stl:CoreSteelQualityClassSchemeShape a sh:PropertyShape ;
    rdfs:comment "钢的质量分类的取值应属于钢的质量分类代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/steel-class-quality> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:steelQualityClass .

stl:CoreSteelUseClassSchemeShape a sh:PropertyShape ;
    rdfs:comment "钢的用途分类的取值应属于钢的用途分类代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/steel-class-use> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:steelUseClass .

stl:CoreTestMethodShape a sh:PropertyShape ;
    rdfs:comment "建议力学试验引用所用方法标准的版次，以便比较不同批次的结果。"@zh ;
    sh:minCount 1 ;
    sh:path stl:methodStandard ;
    sh:severity sh:Warning ;
    sh:targetClass stl:MechanicalTest .

stl:CoreTestTypeSchemeShape a sh:PropertyShape ;
    rdfs:comment "试验类型的取值应属于试验类型代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/test-type> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:testType .

stl:Crane a owl:Class ;
    rdfs:label "Overhead crane"@en,
        "天车"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1091-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:Equipment ;
    skos:altLabel "bridge crane"@en,
        "桥式起重机"@zh ;
    skos:definition "An overhead lifting asset carrying material between its pick-up and set-down events."@en,
        "在吊起和落位事件之间实际承载并搬运物料的桥式起重设备。"@zh ;
    skos:prefLabel "Overhead crane"@en,
        "天车"@zh .

stl:DefectTypeCode a rdfs:Datatype ;
    rdfs:label "defect type code"@en,
        "缺陷类型代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the defect type scheme."@en,
        "标识“缺陷类型”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "defect type code"@en,
        "缺陷类型代码"@zh .

stl:DeliveryConditionCode a rdfs:Datatype ;
    rdfs:label "Delivery condition code"@en,
        "交货状态代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the delivery condition scheme."@en,
        "标识“交货状态”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Delivery condition code"@en,
        "交货状态代码"@zh .

stl:DimensionalInspection a owl:Class ;
    rdfs:label "Dimensional inspection"@en,
        "尺寸检验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-709-2019> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:InspectionActivityRecord ;
    skos:definition "An inspection measuring length or cross-sectional dimensions at defined positions for comparison with dimensional requirements."@en,
        "在规定部位测量截面或长度并对照尺寸规格的检验记录。"@zh ;
    skos:prefLabel "Dimensional inspection"@en,
        "尺寸检验"@zh .

stl:DirectReducedIron a owl:Class ;
    rdfs:label "Direct reduced iron lot"@en,
        "直接还原铁批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20565-2022> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/material-category/DRI> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A lot of metallic furnace feed obtained by removing oxygen from iron ore in the solid state."@en,
        "由铁矿原料在固态脱氧得到、按批向炼钢工序供应金属铁的炉料。"@zh ;
    skos:prefLabel "Direct reduced iron lot"@en,
        "直接还原铁批"@zh .

stl:DispositionTypeCode a rdfs:Datatype ;
    rdfs:label "quality disposition type code"@en,
        "质量处置类型代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the quality disposition type scheme."@en,
        "标识“质量处置类型”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "quality disposition type code"@en,
        "质量处置类型代码"@zh .

stl:ElectricArcFurnaceSteelmaking a owl:Class ;
    rdfs:label "Electric arc furnace steelmaking"@en,
        "电弧炉炼钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-6339-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:subClassOf stl:Steelmaking ;
    skos:definition "An operation that uses heat from electrode arcs to melt and refine a metallic charge in an electric arc furnace and tap a heat of steel."@en,
        "以电极产生的电弧向金属炉料供热，在电弧炉中熔炼并产出一炉钢水的作业。"@zh ;
    skos:prefLabel "Electric arc furnace steelmaking"@en,
        "电弧炉炼钢"@zh .

stl:ElectrodeSourceIngotShape a sh:PropertyShape ;
    rdfs:comment "沿重熔链制备的自耗电极须记录其直接来源锭，可以是初锭或上一道次的重熔锭。"@zh ;
    sh:path stl:derivedFrom ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class stl:Ingot ] ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Electrode .

stl:EquipmentTypeCode a rdfs:Datatype ;
    rdfs:label "Equipment type code"@en,
        "设备类型代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the equipment type scheme."@en,
        "标识“设备类型”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Equipment type code"@en,
        "设备类型代码"@zh .

stl:Ferroalloy a owl:Class ;
    rdfs:label "Ferroalloy lot"@en,
        "铁合金批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/astm-a941-26a> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/material-category/FERROALLOY> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A lot of an alloy of iron with one or more other elements supplied as an addition for purposes such as alloying or deoxidation."@en,
        "以铁和一种或多种其他元素制成、作为合金化或脱氧等添加料管理的一批物料。"@zh ;
    skos:prefLabel "Ferroalloy lot"@en,
        "铁合金批"@zh .

stl:FinalCrossSectionAreaShape a sh:PropertyShape ;
    rdfs:comment "填写锻后截面积时应给出一个大于零的十进制数，单位为平方毫米。"@zh ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minExclusive 0.0 ;
    sh:path stl:finalCrossSectionArea ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:finalCrossSectionArea .

stl:FinishedProduct a owl:Class ;
    rdfs:label "Finished product"@en,
        "成品"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:definition "A product piece that has completed its specified manufacturing route and is available in that form for inspection or delivery."@en,
        "已完成规定制造路线、以当前形态供检验或交付的产品件。"@zh ;
    skos:prefLabel "Finished product"@en,
        "成品"@zh .

stl:Flux a owl:Class ;
    rdfs:label "Flux lot"@en,
        "熔剂批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A lot of material added to the burden to form slag with gangue or ash and adjust slag composition and flow."@en,
        "按批配入炉料以与脉石或灰分成渣、调节炉渣组成和流动性的材料。"@zh ;
    skos:prefLabel "Flux lot"@en,
        "熔剂批"@zh .

stl:ForgedProduct a owl:Class ;
    rdfs:label "Forged product"@en,
        "锻件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-8541-2012> ;
    rdfs:comment "下沉理由：特钢锻件的件号把来源锭、锻造作业及锻后加工件连接成逐件谱系。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/product-form/FORGING> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:definition "An individually traceable steel piece shaped by forging, whether it leaves the operation as a blank for further working or as a deliverable forging."@en,
        "经锻造取得其形状并可单件追踪的钢件，可作为后续加工的坯件或交货件。"@zh ;
    skos:prefLabel "Forged product"@en,
        "锻件"@zh ;
    skos:scopeNote "ForgedProduct identifies a piece by its forging process and stl:Bar by its bar cross section. A finished forged bar can belong to both classes. Each length subsequently cut from it is a new material piece."@en,
        "锻件按锻造成形工艺识别，棒材（stl:Bar）按棒状截面识别。同一支锻制成品棒可同时归入两类。后续切分所得的每一段都是新的实物件。"@zh .

stl:ForgingMethodCode a rdfs:Datatype ;
    rdfs:label "Forging method code"@en,
        "锻造方法代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging-codes> ;
    skos:definition "Datatype of the primary notations in the forging method scheme."@en,
        "用于记录锻造方法方案内主记号的字面量类型。"@zh ;
    skos:prefLabel "Forging method code"@en,
        "锻造方法代码"@zh .

stl:ForgingMethodSchemeShape a sh:PropertyShape ;
    rdfs:comment "作业的锻造方法代码应属于锻造方法方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/forging-method> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:forgingMethod .

stl:ForgingMethodShape a sh:PropertyShape ;
    rdfs:comment "每次锻造作业应给出一种实际采用的主要锻造方法。"@zh ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:forgingMethod ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Forging .

stl:ForgingRatioShape a sh:PropertyShape ;
    rdfs:comment "一次锻造作业应记录一个大于零的十进制锻造比。"@zh ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minExclusive 0.0 ;
    sh:path stl:forgingRatio ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Forging .

stl:FullHardCoil a owl:Class ;
    rdfs:label "Full-hard coil"@en,
        "冷硬卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:ColdRolledCoil ;
    skos:altLabel "轧硬卷"@zh ;
    skos:definition "A coil of cold-reduced strip that retains its work-hardened condition before annealing."@en,
        "冷轧减薄后保留加工硬化状态、尚未经退火的带钢卷。"@zh ;
    skos:prefLabel "Full-hard coil"@en,
        "冷硬卷"@zh .

stl:GalvanizedCoil a owl:Class ;
    rdfs:label "Galvanized coil"@en,
        "镀锌卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:CoatedCoil,
        stl:ColdRolledCoil ;
    skos:definition "A coil of strip leaving a galvanizing line in the cold-mill route, bearing a zinc or zinc-alloy coating whose particular coating type can be recorded for the piece; a hot-rolled-base galvanized coil is recorded as a coated coil instead."@en,
        "冷轧段镀锌线出口以卷为单元交接的镀锌带钢，镀层以锌或锌基合金为主要成分，具体类别可随卷记录；以热轧板为基板的热基镀锌卷直接记为涂镀钢卷。"@zh ;
    skos:prefLabel "Galvanized coil"@en,
        "镀锌卷"@zh .

stl:Galvanizing a owl:Class ;
    rdfs:label "Galvanizing"@en,
        "镀锌"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:Coating ;
    skos:altLabel "镀锌执行"@zh ;
    skos:definition "A coating operation that deposits zinc or a zinc-based alloy on steel, including continuous hot-dip galvanizing."@en,
        "在钢材表面施加锌或锌基合金镀层的作业，连续热镀锌是其中一种方式。"@zh ;
    skos:prefLabel "Galvanizing"@en,
        "镀锌"@zh .

stl:GasAnalysisRemeltShape a sh:PropertyShape ;
    rdfs:comment "每次逐锭气体分析应明确对应一项实际重熔作业。"@zh ;
    sh:class stl:Remelting ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:analysedRemelt ;
    sh:severity sh:Violation ;
    sh:targetClass stl:GasContentAnalysis .

stl:GrindingDepthShape a sh:PropertyShape ;
    rdfs:comment "最大修磨深度按去除量记录，应为非负的十进制毫米数。"@zh ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:path stl:maximumGrindingDepth ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:maximumGrindingDepth .

stl:HardenabilityTest a owl:Class ;
    rdfs:label "End-quench hardenability test"@en,
        "末端淬透性试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-225-2006> ;
    rdfs:comment "下沉理由：保证淬透性的齿轮钢等需按端距核对整条硬度带，普钢常规硬度验收无需端淬曲线。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection> ;
    rdfs:subClassOf stl:MechanicalTest ;
    skos:definition "A test measuring hardness at distances from the quenched end of a specimen to evaluate the response of a guaranteed-hardenability grade."@en,
        "从单端淬火试样上取得一系列规定端距处的硬度，用于评定保证淬透性钢的端淬响应。"@zh ;
    skos:prefLabel "End-quench hardenability test"@en,
        "末端淬透性试验"@zh .

stl:HeatTreatmentHoldOrderShape a sh:PropertyShape ;
    rdfs:comment "同一次保温同时记有实际开始和结束时刻时，结束不得早于开始。"@zh ;
    sh:lessThanOrEquals stl:actualEndAt ;
    sh:path stl:actualStartAt ;
    sh:severity sh:Violation ;
    sh:targetClass stl:HeatTreatmentHold .

stl:HeatTreatmentLoadMethodShape a sh:PropertyShape ;
    rdfs:comment "每个装炉批至少要记录一种实际采用的热处理工艺。"@zh ;
    sh:minCount 1 ;
    sh:path stl:heatTreatmentMethod ;
    sh:severity sh:Violation ;
    sh:targetClass stl:HeatTreatmentLoad .

stl:HeatTreatmentLoadPieceShape a sh:PropertyShape ;
    rdfs:comment "每个装炉批至少应包含一件实物件，可从批列出成员，也可由实物件指回装炉批。"@zh ;
    sh:path [ sh:alternativePath ( stl:hasPart [ sh:inversePath stl:partOf ] ) ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class stl:MaterialPiece ] ;
    sh:severity sh:Violation ;
    sh:targetClass stl:HeatTreatmentLoad .

stl:HeatTreatmentMethodSchemeShape a sh:PropertyShape ;
    rdfs:comment "装炉批或作业引用的每个热处理方法都应来自热处理工艺代码方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:heatTreatmentMethod .

stl:HeatTreatmentProcessCode a rdfs:Datatype ;
    rdfs:label "Heat treatment process code"@en,
        "热处理工艺代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment-codes> ;
    skos:definition "Datatype of the primary notations in the heat treatment process scheme."@en,
        "标识热处理工艺方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Heat treatment process code"@en,
        "热处理工艺代码"@zh .

stl:HotMetalTapShape a sh:PropertyShape ;
    rdfs:comment "按铁次建批的铁水应指向生成该批的唯一出铁作业；同一铁次可以分罐接收。"@zh ;
    sh:class stl:BlastFurnaceTapping ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path prov:wasGeneratedBy ;
    sh:severity sh:Violation ;
    sh:targetClass stl:HotMetal .

stl:HotRolledCoil a owl:Class ;
    rdfs:label "Hot-rolled coil"@en,
        "热轧卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:Coil ;
    skos:definition "A steel coil formed by winding strip at the output of hot rolling."@en,
        "由热轧出口的带钢卷取形成的钢卷，其直接来源可沿轧制路线逐步追溯。"@zh ;
    skos:prefLabel "Hot-rolled coil"@en,
        "热轧卷"@zh .

stl:ImpactTest a owl:Class ;
    rdfs:label "Impact test"@en,
        "冲击试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-229-2020> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:MechanicalTest ;
    skos:definition "A mechanical test that breaks a specimen under impact and records absorbed energy at a specified temperature."@en,
        "在规定温度下冲断试样并记录其吸收能量的力学试验。"@zh ;
    skos:prefLabel "Impact test"@en,
        "冲击试验"@zh .

stl:InclusionRatedTypeShape a sh:PropertyShape ;
    rdfs:comment "一条分项夹杂物评级结果应恰好对应一种形态类别。"@zh ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:inclusionType ;
    sh:severity sh:Violation ;
    sh:targetClass stl:InclusionRatingResult .

stl:InclusionRatingExaminationShape a sh:PropertyShape ;
    rdfs:comment "分项夹杂物评级应归属实际出具它的那次夹杂物显微检验。"@zh ;
    sh:class stl:InclusionRating ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:resultOfInspection ;
    sh:severity sh:Violation ;
    sh:targetClass stl:InclusionRatingResult .

stl:InclusionSeriesAssignmentShape a sh:NodeShape ;
    rdfs:comment "A 至 D 类每条分项评级须选定一个粗细系列，单颗粒 DS 类直接按粒径评级。"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "请核对本条评级的形态类别与系列。"@zh ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX t: <https://w3id.org/ontology-platform/steel/code/inclusion-type/>
        SELECT DISTINCT $this WHERE {
          $this stl:inclusionType ?type .
          FILTER ((?type IN (t:A, t:B, t:C, t:D) &&
                   (NOT EXISTS { $this stl:inclusionSeries ?s } ||
                    EXISTS { $this stl:inclusionSeries ?s, ?other . FILTER (?s != ?other) })) ||
                  (?type = t:DS && EXISTS { $this stl:inclusionSeries ?any }))
        }
    """ ] ;
    sh:targetClass stl:InclusionRatingResult .

stl:InclusionSeriesCode a rdfs:Datatype ;
    rdfs:label "Inclusion thickness series code"@en,
        "夹杂物粗细系列代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Datatype of primary notations in the inclusion thickness series scheme."@en,
        "标记夹杂物粗细系列方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Inclusion thickness series code"@en,
        "夹杂物粗细系列代码"@zh .

stl:InclusionSeriesSchemeShape a sh:PropertyShape ;
    rdfs:comment "评级的粗细系列应属于夹杂物系列方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/inclusion-series> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:inclusionSeries .

stl:InclusionTypeCode a rdfs:Datatype ;
    rdfs:label "Inclusion morphology category code"@en,
        "夹杂物形态类别代码"@zh ;
