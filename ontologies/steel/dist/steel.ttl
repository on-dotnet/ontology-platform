    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/TRANSFORM> ;
    skos:definition "A route segment for reducing and melting the burden in a blast furnace to produce hot metal."@en,
        "在高炉内还原和熔炼炉料以获得铁水的工序段类别。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "BFIRON"^^stl:ProcessTypeCode ;
    skos:prefLabel "Blast furnace ironmaking"@en,
        "高炉炼铁"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/BFTAP> a skos:Concept ;
    rdfs:label "Blast furnace tapping"@en,
        "高炉出铁"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "A route segment for opening a taphole and draining the hearth into receiving vessels."@en,
        "开启出铁口使炉缸内铁水流出并进入接铁容器的工序段类别。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "BFTAP"^^stl:ProcessTypeCode ;
    skos:prefLabel "Blast furnace tapping"@en,
        "高炉出铁"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/code/process-type/BOF> a skos:Concept ;
    rdfs:label "Basic oxygen steelmaking"@en,
