    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/product-form/TUBE> ;
    skos:definition "Tubular product form closed by welding the edges of formed plate or strip."@en,
        "由板带成形、边缘经焊接闭合的管材形态。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "WELDED"^^stl:ProductFormCode ;
    skos:prefLabel "Welded pipe"@en,
        "焊管"@zh .

<https://w3id.org/ontology-platform/steel/code/product-form/WIREROD> a skos:Concept ;
    rdfs:label "Wire rod"@en,
        "线材"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-701-2008> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "盘条"@zh ;
    skos:definition "A relatively small hot-rolled long product laid in coils, often for subsequent drawing."@en,
        "以较小断面热轧并成圈收集的实心长材，常供再拉拔。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/product-form> ;
    skos:notation "WIREROD"^^stl:ProductFormCode ;
    skos:prefLabel "Wire rod"@en,
        "线材"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/product-form> .

<https://w3id.org/ontology-platform/steel/code/rating-comparison/EQ> a skos:Concept ;
    rdfs:label "Equal to"@en,
        "等于"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "="@en,
        "="@zh ;
    skos:definition "Requires the observed rating to match the specified grade exactly."@en,
        "实测评级须与所列目标级别相同。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/rating-comparison> ;
    skos:notation "EQ"^^stl:RatingComparisonCode ;
    skos:prefLabel "Equal to"@en,
        "等于"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/rating-comparison> .

<https://w3id.org/ontology-platform/steel/code/rating-comparison/GE> a skos:Concept ;
    rdfs:label "Greater than or equal to"@en,
        "不小于"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "≥"@en,
        "≥"@zh ;
    skos:definition "Accepts values at or above the stated lower rating limit."@en,
        "实测评级数值允许等于下限或位于其上。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/rating-comparison> ;
    skos:notation "GE"^^stl:RatingComparisonCode ;
    skos:prefLabel "Greater than or equal to"@en,
        "不小于"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/rating-comparison> .

<https://w3id.org/ontology-platform/steel/code/rating-comparison/GT> a skos:Concept ;
    rdfs:label "Greater than"@en,
        "大于"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel ">"@en,
        ">"@zh ;
    skos:definition "Requires the observed rating to exceed the specified value."@en,
        "实测评级数值须严格超过所列界值。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/rating-comparison> ;
    skos:notation "GT"^^stl:RatingComparisonCode ;
    skos:prefLabel "Greater than"@en,
        "大于"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/rating-comparison> .

<https://w3id.org/ontology-platform/steel/code/rating-comparison/LE> a skos:Concept ;
    rdfs:label "Less than or equal to"@en,
        "不大于"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "≤"@en,
        "≤"@zh ;
    skos:definition "Accepts values up to and including the upper rating limit."@en,
        "实测评级数值允许等于上限或位于其下。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/rating-comparison> ;
    skos:notation "LE"^^stl:RatingComparisonCode ;
    skos:prefLabel "Less than or equal to"@en,
        "不大于"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/rating-comparison> .

<https://w3id.org/ontology-platform/steel/code/rating-comparison/LT> a skos:Concept ;
    rdfs:label "Less than"@en,
        "小于"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "<"@en,
        "<"@zh ;
    skos:definition "Requires the observed rating to lie strictly below the specified value."@en,
        "实测评级数值须严格低于所列界值。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/rating-comparison> ;
    skos:notation "LT"^^stl:RatingComparisonCode ;
    skos:prefLabel "Less than"@en,
        "小于"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/rating-comparison> .

<https://w3id.org/ontology-platform/steel/code/rebar-lot-basis/MASSDEV> a skos:Concept ;
    rdfs:label "Rebar mass deviation"@en,
        "钢筋重量偏差"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/quality-codes> ;
    skos:definition "Uses the difference between measured sample mass and the nominal mass for the sampled length as a basis for assessing the lot."@en,
        "以本批钢筋试样的实测质量相对其公称长度计重值的偏差作为判定依据。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/rebar-lot-basis> ;
    skos:notation "MASSDEV"^^stl:RebarLotBasisCode ;
    skos:prefLabel "Rebar mass deviation"@en,
        "钢筋重量偏差"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/rebar-lot-basis> .

<https://w3id.org/ontology-platform/steel/code/rebar-lot-basis/SEISMIC> a skos:Concept ;
    rdfs:label "Seismic performance of reinforcing bars"@en,
        "钢筋抗震性能"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/quality-codes> ;
    skos:definition "Uses strength relationship and ductility results from seismic reinforcing bar samples to assess their lot."@en,
        "以该批抗震钢筋试样的强度关系和延性检验结果作为批判定依据。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/rebar-lot-basis> ;
    skos:notation "SEISMIC"^^stl:RebarLotBasisCode ;
    skos:prefLabel "Seismic performance of reinforcing bars"@en,
        "钢筋抗震性能"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/rebar-lot-basis> .

<https://w3id.org/ontology-platform/steel/code/rebar-surface/PLAIN> a skos:Concept ;
    rdfs:label "Plain round"@en,
        "光圆"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-1-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "A smooth round bar surface in contact with concrete."@en,
        "以光滑圆周表面与混凝土接触的钢筋表面形状。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/rebar-surface> ;
    skos:notation "PLAIN"^^stl:RebarSurfaceCode ;
    skos:prefLabel "Plain round"@en,
        "光圆"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/rebar-surface> .

<https://w3id.org/ontology-platform/steel/code/rebar-surface/RIBBED> a skos:Concept ;
    rdfs:label "Ribbed"@en,
        "带肋"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "A bar surface with rolled ribs for bonding to concrete."@en,
        "外周带有轧制凸肋以增强混凝土黏结的钢筋表面形状。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/rebar-surface> ;
    skos:notation "RIBBED"^^stl:RebarSurfaceCode ;
    skos:prefLabel "Ribbed"@en,
        "带肋"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/rebar-surface> .

<https://w3id.org/ontology-platform/steel/code/refining-method/AOD> a skos:Concept ;
    rdfs:label "Argon oxygen decarburization"@en,
        "氩氧脱碳"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:definition "Decarburization by blowing oxygen with a diluting gas such as argon to lower the partial pressure of carbon monoxide."@en,
        "向钢液送氧并配用氩气等稀释气体，降低一氧化碳分压以促进脱碳的方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/refining-method> ;
    skos:notation "AOD"^^stl:RefiningMethodCode ;
    skos:prefLabel "Argon oxygen decarburization"@en,
        "氩氧脱碳"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/refining-method> .

<https://w3id.org/ontology-platform/steel/code/refining-method/CASOB> a skos:Concept ;
    rdfs:label "Composition adjustment by sealed argon bubbling with oxygen blowing"@en,
        "浸罩吹氩成分微调与吹氧加热"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:altLabel "CAS-OB"@en,
        "CAS-OB"@zh ;
    skos:definition "Composition trimming under an immersed bell using argon stirring to mix additions, with oxygen blowing available for chemical heating."@en,
        "在浸罩保护的钢面进行合金微调，以吹氩促进混匀，并可配合供氧实现化学升温的方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/refining-method> ;
    skos:notation "CASOB"^^stl:RefiningMethodCode ;
    skos:prefLabel "Composition adjustment by sealed argon bubbling with oxygen blowing"@en,
        "浸罩吹氩成分微调与吹氧加热"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/refining-method> .

<https://w3id.org/ontology-platform/steel/code/refining-method/LF> a skos:Concept ;
    rdfs:label "Ladle furnace refining"@en,
        "钢包炉精炼"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:definition "Ladle treatment using a furnace station with arc reheating and facilities for stirring, slag treatment or alloy additions."@en,
        "在钢包炉工位利用电弧补热能力，配合搅拌、造渣或加合金处理钢液的方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/refining-method> ;
    skos:notation "LF"^^stl:RefiningMethodCode ;
    skos:prefLabel "Ladle furnace refining"@en,
        "钢包炉精炼"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/refining-method> .

<https://w3id.org/ontology-platform/steel/code/refining-method/RH> a skos:Concept ;
    rdfs:label "Vacuum circulation refining"@en,
        "真空循环精炼"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:definition "Refining by circulating steel between the ladle and a vacuum chamber to expose successive portions to reduced pressure for degassing or decarburization."@en,
        "使钢水在钢包与真空室间循环，分批暴露于低压环境以脱气或脱碳的方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/refining-method> ;
    skos:notation "RH"^^stl:RefiningMethodCode ;
    skos:prefLabel "Vacuum circulation refining"@en,
        "真空循环精炼"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/refining-method> .

<https://w3id.org/ontology-platform/steel/code/refining-method/VD> a skos:Concept ;
    rdfs:label "Ladle vacuum degassing"@en,
        "钢包真空脱气"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:definition "Degassing by reducing the pressure above the bath while the steel remains in the ladle."@en,
        "将钢包内钢液暴露于减压环境，使溶解气体逸出的精炼方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/refining-method> ;
    skos:notation "VD"^^stl:RefiningMethodCode ;
    skos:prefLabel "Ladle vacuum degassing"@en,
        "钢包真空脱气"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/refining-method> .

<https://w3id.org/ontology-platform/steel/code/refining-method/VOD> a skos:Concept ;
    rdfs:label "Vacuum oxygen decarburization"@en,
        "真空吹氧脱碳"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:definition "A refining treatment that blows oxygen into molten steel under reduced pressure to remove carbon as carbon monoxide."@en,
        "在减压环境向钢液供氧，使熔池中的碳以一氧化碳逸出的精炼方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/refining-method> ;
    skos:notation "VOD"^^stl:RefiningMethodCode ;
    skos:prefLabel "Vacuum oxygen decarburization"@en,
        "真空吹氧脱碳"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/refining-method> .

<https://w3id.org/ontology-platform/steel/code/sample-orientation/C> a skos:Concept ;
    rdfs:label "Circumferential"@en,
        "周向"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "The specified specimen direction follows the tangent to a tube or ring circumference."@en,
        "试样规定方向沿圆筒或圆环的圆周切线。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/sample-orientation> ;
    skos:notation "C"^^stl:SampleOrientationCode ;
    skos:prefLabel "Circumferential"@en,
        "周向"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/sample-orientation> .

<https://w3id.org/ontology-platform/steel/code/sample-orientation/L> a skos:Concept ;
    rdfs:label "Longitudinal"@en,
        "纵向"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "The designated specimen axis is parallel to the principal working direction or declared longitudinal axis."@en,
        "试样规定轴线平行于材料主加工方向或约定纵轴。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/sample-orientation> ;
    skos:notation "L"^^stl:SampleOrientationCode ;
    skos:prefLabel "Longitudinal"@en,
        "纵向"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/sample-orientation> .

<https://w3id.org/ontology-platform/steel/code/sample-orientation/R> a skos:Concept ;
    rdfs:label "Radial"@en,
        "径向"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "The designated axis runs outward or inward along a radius of the circular product."@en,
        "圆形件试样的规定轴线朝向或背离工件中心轴。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/sample-orientation> ;
    skos:notation "R"^^stl:SampleOrientationCode ;
    skos:prefLabel "Radial"@en,
        "径向"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/sample-orientation> .

<https://w3id.org/ontology-platform/steel/code/sample-orientation/T> a skos:Concept ;
    rdfs:label "Transverse"@en,
        "横向"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "The specimen axis lies in the product plane across its designated longitudinal direction."@en,
        "试样规定轴线位于产品平面内并垂直于约定纵向。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/sample-orientation> ;
    skos:notation "T"^^stl:SampleOrientationCode ;
    skos:prefLabel "Transverse"@en,
        "横向"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/sample-orientation> .

<https://w3id.org/ontology-platform/steel/code/sample-orientation/Z> a skos:Concept ;
    rdfs:label "Through-thickness"@en,
        "厚度方向"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "The designated specimen axis follows the plate normal through its thickness."@en,
        "试样规定轴线沿板面法向贯穿厚度方向。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/sample-orientation> ;
    skos:notation "Z"^^stl:SampleOrientationCode ;
    skos:prefLabel "Through-thickness"@en,
        "厚度方向"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/sample-orientation> .

<https://w3id.org/ontology-platform/steel/code/sample-type/COATING> a skos:Concept ;
    rdfs:label "coating specimen"@en,
        "镀层试样"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1839-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "A coupon retaining the substrate and covering on the faces selected for coating tests."@en,
        "保留基板和相应表面覆盖层、供检验镀层的试片。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/sample-type> ;
    skos:notation "COATING"^^stl:SampleTypeCode ;
    skos:prefLabel "coating specimen"@en,
        "镀层试样"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/sample-type> .

<https://w3id.org/ontology-platform/steel/code/sample-type/ENDPOINT> a skos:Concept ;
    rdfs:label "converter endpoint sample"@en,
        "转炉终点样"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20066-2006> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Liquid steel sampled at the end of converter blowing to characterize that endpoint."@en,
        "在转炉吹炼终点取得、用于描述终点钢水的样品。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/sample-type> ;
    skos:notation "ENDPOINT"^^stl:SampleTypeCode ;
    skos:prefLabel "converter endpoint sample"@en,
        "转炉终点样"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/sample-type> .

<https://w3id.org/ontology-platform/steel/code/sample-type/HOTMETAL> a skos:Concept ;
    rdfs:label "Hot metal sample"@en,
        "铁水样"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20066-2006> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "A sample drawn from the tapping stream or a receiving vessel to characterize the hot metal lot sampled."@en,
        "从出铁流或接铁容器内铁水取得、用于表征所取铁水批的样品。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/sample-type> ;
    skos:notation "HOTMETAL"^^stl:SampleTypeCode ;
    skos:prefLabel "Hot metal sample"@en,
        "铁水样"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/sample-type> .

<https://w3id.org/ontology-platform/steel/code/sample-type/MECHANICAL> a skos:Concept ;
    rdfs:label "mechanical test sample"@en,
        "力学性能样"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-2975-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "A portion taken from the product for preparation of mechanical test specimens."@en,
        "从产品上取得、供制备力学性能试样的样料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/sample-type> ;
    skos:notation "MECHANICAL"^^stl:SampleTypeCode ;
    skos:prefLabel "mechanical test sample"@en,
        "力学性能样"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/sample-type> .

<https://w3id.org/ontology-platform/steel/code/sample-type/METALLOG> a skos:Concept ;
    rdfs:label "Metallographic specimen"@en,
        "金相样"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-13298-2015> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
