        "W"@zh ;
    skos:definition "Quantifies tungsten for composition checks on materials such as tool steels and heat-resistant alloys."@en,
        "按元素计量材料中的钨，常用于核对工具钢与耐热合金配比。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "W"^^stl:ChemicalElementCode ;
    skos:prefLabel "Tungsten"@en,
        "钨"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/ZR> a skos:Concept ;
