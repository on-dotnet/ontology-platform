    skos:altLabel "V"@en,
        "V"@zh ;
    skos:definition "Measures vanadium contributed by microalloying or by larger tool-steel additions."@en,
        "按钒元素报告微合金化或工具钢合金化带入的钒量。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "V"^^stl:ChemicalElementCode ;
    skos:prefLabel "Vanadium"@en,
        "钒"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/W> a skos:Concept ;
