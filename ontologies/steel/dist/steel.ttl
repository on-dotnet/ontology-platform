    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/HOTROLL> ;
    skos:definition "Hot rolling ingots or large semiproducts into stock for further forming."@en,
        "将钢锭或大断面钢坯热轧成后续成形工序所用的坯件。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "BREAKDOWN"^^stl:ProcessTypeCode ;
    skos:prefLabel "Breakdown rolling"@en,
        "初轧开坯"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/CC> a skos:Concept ;
    rdfs:label "Continuous casting"@en,
        "连续铸钢"@zh ;
