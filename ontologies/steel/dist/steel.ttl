    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/finishing-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/INSPECT> ;
    skos:definition "在材料通过产线期间采集和评定质量证据的工序段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "INLINETEST"^^stl:ProcessTypeCode ;
    skos:prefLabel "In-line inspection"@en,
        "在线检验"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/MARK> a skos:Concept ;
    rdfs:label "Marking"@en,
        "标记"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/finishing-codes> ;
    skos:definition "在实物或所附标签上施加身份或位置标记的工序段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "MARK"^^stl:ProcessTypeCode ;
    skos:prefLabel "Marking"@en,
        "标记"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/code/process-type/MOVE> a skos:Concept ;
    rdfs:label "Material handling"@en,
        "搬运"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Work that relocates identified material while preserving its identity."@en,
        "将已识别的物料从一处转移到另一处并保留其身份的作业类型。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "MOVE"^^stl:ProcessTypeCode ;
    skos:prefLabel "Material handling"@en,
        "搬运"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/code/process-type/PACK> a skos:Concept ;
    rdfs:label "Packing"@en,
        "包装"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Assembles identified pieces into a handling unit for shipment."@en,
        "把已识别的实物组成可独立搬运和交付的包装单元。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "PACK"^^stl:ProcessTypeCode ;
    skos:prefLabel "Packing"@en,
        "包装"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/code/process-type/PELLET> a skos:Concept ;
    rdfs:label "Pelletizing"@en,
        "球团生产"@zh ;
