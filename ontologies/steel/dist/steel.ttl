    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "A route segment for introducing a prepared charge through the top of a blast furnace."@en,
        "从炉顶向高炉送入配好的炉料的工序段类别。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "BFCHARGE"^^stl:ProcessTypeCode ;
    skos:prefLabel "Blast furnace charging"@en,
        "高炉装料"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/code/process-type/BFIRON> a skos:Concept ;
    rdfs:label "Blast furnace ironmaking"@en,
        "高炉炼铁"@zh ;
