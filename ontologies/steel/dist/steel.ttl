    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/TRANSFORM> ;
    skos:definition "A route segment for balling fine iron-bearing feed and hardening it into pellets."@en,
        "将含铁细料造球、固结为球团矿的工序段类别。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "PELLET"^^stl:ProcessTypeCode ;
    skos:prefLabel "Pelletizing"@en,
        "球团生产"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/PICKLECOLD> a skos:Concept ;
    rdfs:label "Coupled pickling and cold rolling"@en,
        "酸洗冷连轧"@zh ;
