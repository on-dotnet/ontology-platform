    skos:prefLabel "Antimony"@en,
        "锑"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/SI> a skos:Concept ;
    rdfs:label "silicon"@en,
        "硅"@zh ;
