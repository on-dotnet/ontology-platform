    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:definition "A mill that reduces or spreads individual pieces of stock to produce discrete plates."@en,
        "逐块轧制坯料，通过减薄或展宽轧出按张流转的中厚钢板。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "PLATE"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Plate mill"@en,
        "中厚板轧机"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/PLTCM> a skos:Concept ;
    rdfs:label "Pickling line and tandem cold mill"@en,
        "酸洗冷连轧机组"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:altLabel "PLTCM"@en,
        "PLTCM"@zh,
        "酸轧机组"@zh ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/equipment-type/COLDMILL> ;
    skos:definition "A coupled line feeding descaled strip from the pickling section directly into successive cold reduction stands."@en,
        "将酸洗线与多机架冷连轧机连接，使带钢除鳞后连续进入减薄机架。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "PLTCM"^^stl:EquipmentTypeCode,
        "PL"^^stl:LineSegmentCode ;
    skos:prefLabel "Pickling line and tandem cold mill"@en,
        "酸洗冷连轧机组"@zh .

<https://w3id.org/ontology-platform/steel/code/equipment-type/RCC> a skos:Concept ;
    rdfs:label "Round billet caster"@en,
        "圆坯连铸机"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/equipment-type/CASTER> ;
    skos:definition "A caster that withdraws a round strand formed in a circular mould."@en,
        "用圆形结晶器形成并引出圆截面铸流的连铸机。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "RCC"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Round billet caster"@en,
        "圆坯连铸机"@zh .

<https://w3id.org/ontology-platform/steel/code/equipment-type/RCL> a skos:Concept ;
    rdfs:label "Recoiling line"@en,
        "重卷机组"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:altLabel "RCL"@en,
        "RCL"@zh ;
    skos:definition "A line that unwinds existing coils and rewinds the strip for a subsequent process or delivery."@en,
        "将已有钢卷开卷并按后续加工或交货需要重新卷取的设备。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "RCL"^^stl:EquipmentTypeCode,
        "RC"^^stl:LineSegmentCode ;
    skos:prefLabel "Recoiling line"@en,
        "重卷机组"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/REHEATFURN> a skos:Concept ;
    rdfs:label "Stock reheating furnace"@en,
        "坯料加热炉"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:definition "A furnace that heats steel stock or ingots for delivery to a rolling mill."@en,
        "在轧制前加热钢坯或钢锭，使装入的钢料以所需热状态出炉。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "REHEATFURN"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Stock reheating furnace"@en,
        "坯料加热炉"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/RH> a skos:Concept ;
    rdfs:label "Vacuum circulation degasser"@en,
        "真空循环脱气装置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-4529-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:definition "A degasser with snorkels through which steel rises into a vacuum chamber and returns to the ladle."@en,
        "以浸渍管连接真空室与钢包，供钢液升入真空室并返回钢包的处理装置。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "RH"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Vacuum circulation degasser"@en,
        "真空循环脱气装置"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/SAW> a skos:Concept ;
    rdfs:label "Submerged arc welded pipe line"@en,
        "埋弧焊管机组"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/equipment-type/WELDLINE> ;
    skos:definition "A pipe line equipped to feed wire and flux for submerged arc welding of the pipe seam."@en,
        "配有焊丝送进和焊剂供给设备、以埋弧焊接合管缝的焊管机组。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "SAW"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Submerged arc welded pipe line"@en,
        "埋弧焊管机组"@zh .

<https://w3id.org/ontology-platform/steel/code/equipment-type/SCALE> a skos:Concept ;
    rdfs:label "Weighing instrument"@en,
        "衡器"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Equipment used to determine the mass of a piece or batch by weighing."@en,
        "通过称量取得实物或物料批质量的设备。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "SCALE"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Weighing instrument"@en,
        "衡器"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/SECT> a skos:Concept ;
    rdfs:label "Section mill"@en,
        "型钢轧机"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:definition "A mill that progressively develops a defined section profile using shaped rolls."@en,
        "利用成形轧辊将坯料逐道轧出型钢预定截面轮廓的设备。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "SECT"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Section mill"@en,
        "型钢轧机"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/SHR> a skos:Concept ;
    rdfs:label "Shear"@en,
        "剪切机"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/finishing-codes> ;
    skos:definition "利用剪刃的相对运动横断、分条或修剪钢材的设备。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "SHR"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Shear"@en,
        "剪切机"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/SINT> a skos:Concept ;
    rdfs:label "Sintering machine"@en,
        "烧结机"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "Equipment that supports the burden bed and draws gas through it as the sintering zone progresses."@en,
        "承托烧结料层并使气流穿过料层，使混合料逐层烧结的设备。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "SINT"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Sintering machine"@en,
        "烧结机"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/SIZER> a skos:Concept ;
    rdfs:label "Tube sizing mill"@en,
        "钢管定径机"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking-codes> ;
    skos:definition "A mill that controls the outside dimensions of a tube by passing it through sizing grooves."@en,
        "用定径孔型调整管体外部截面尺寸的轧机。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "SIZER"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Tube sizing mill"@en,
        "钢管定径机"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/STR> a skos:Concept ;
    rdfs:label "Straightening machine"@en,
        "矫直机"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/finishing-codes> ;
    skos:definition "用矫直辊或压力机构对钢材施加校正变形的设备。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "STR"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Straightening machine"@en,
        "矫直机"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/TUNDISH> a skos:Concept ;
    rdfs:label "Tundish"@en,
        "中间包"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting-codes> ;
    skos:definition "A vessel that receives steel from a ladle and regulates its distribution to one or more caster moulds."@en,
        "接收钢包来钢并向一个或多个连铸结晶器稳定分配钢流的容器。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "TUNDISH"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Tundish"@en,
        "中间包"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/VAR> a skos:Concept ;
    rdfs:label "Vacuum arc remelting furnace"@en,
        "真空自耗电弧炉"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:definition "A furnace that melts a consumable electrode by an arc in an evacuated chamber and forms an ingot in a mould."@en,
        "在抽真空的炉室内通过电弧熔化电极，在结晶器内形成新锭的设备。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "VAR"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Vacuum arc remelting furnace"@en,
        "真空自耗电弧炉"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/VD> a skos:Concept ;
    rdfs:label "Ladle vacuum degasser"@en,
        "钢包真空脱气装置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-4529-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:definition "A treatment unit that applies vacuum above the bath in a ladle to remove dissolved gases."@en,
        "在盛钢钢包上建立减压环境，使包内钢液脱气的处理装置。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "VD"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Ladle vacuum degasser"@en,
        "钢包真空脱气装置"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/VIM> a skos:Concept ;
    rdfs:label "Vacuum induction melting furnace"@en,
        "真空感应熔炼炉"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:definition "A furnace using induction heating to melt a metallic charge in an evacuable chamber."@en,
        "在可抽真空的炉室内用感应加热熔化金属炉料的炉子。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "VIM"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Vacuum induction melting furnace"@en,
        "真空感应熔炼炉"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/VOD> a skos:Concept ;
    rdfs:label "Vacuum oxygen decarburization unit"@en,
        "真空吹氧脱碳装置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-4529-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:definition "A station equipped to blow oxygen into molten steel under vacuum for decarburization."@en,
        "配置供氧和抽真空系统，可在减压条件下对钢液吹氧脱碳的工位。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "VOD"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Vacuum oxygen decarburization unit"@en,
        "真空吹氧脱碳装置"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/equipment-type/WRM> a skos:Concept ;
    rdfs:label "Wire rod mill"@en,
        "线材轧机"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:altLabel "WRM"@en,
        "WRM"@zh ;
    skos:definition "A mill that reduces stock in successive passes and delivers small-section wire rod for collection in coils."@en,
        "以连续道次将坯料轧成小断面线材，并向成圈收集设备送出线材。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "WRM"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Wire rod mill"@en,
        "线材轧机"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/forging-method/DIE> a skos:Concept ;
    rdfs:label "Impression-die forging"@en,
        "模锻"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging-codes> ;
    skos:definition "Forces stock to flow into a shaped die impression that defines the forged contour."@en,
        "将坯料置于有型腔的锻模中施力，使金属流动并取得型腔限定的轮廓。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/forging-method> ;
    skos:notation "DIE"^^stl:ForgingMethodCode ;
    skos:prefLabel "Impression-die forging"@en,
        "模锻"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/forging-method> .

<https://w3id.org/ontology-platform/steel/code/forging-method/OPEN> a skos:Concept ;
    rdfs:label "Open-die forging"@en,
        "自由锻"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging-codes> ;
    skos:definition "Deforms stock between anvils or general-purpose tools, allowing it to flow in directions unconstrained by the tooling."@en,
        "使用砧块或通用工具施力，使坯料能沿未受工具约束的方向流动成形。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/forging-method> ;
    skos:notation "OPEN"^^stl:ForgingMethodCode ;
    skos:prefLabel "Open-die forging"@en,
        "自由锻"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/forging-method> .

<https://w3id.org/ontology-platform/steel/code/forging-method/PRECISION> a skos:Concept ;
    rdfs:label "Precision forging"@en,
        "精密锻造"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging-codes> ;
    skos:altLabel "精锻"@zh ;
    skos:definition "Controls tooling and stock deformation to forge a piece close to the required final shape and dimensions."@en,
        "通过控制模具和坯料变形使锻件接近所需的最终形状与尺寸。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/forging-method> ;
    skos:notation "PRECISION"^^stl:ForgingMethodCode ;
    skos:prefLabel "Precision forging"@en,
        "精密锻造"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/forging-method> .

<https://w3id.org/ontology-platform/steel/code/forging-method/RADIAL> a skos:Concept ;
    rdfs:label "Radial forging"@en,
        "径向锻造"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging-codes> ;
    skos:altLabel "径锻"@zh ;
    skos:definition "Shapes successive sections of a workpiece by repeated radial blows from dies arranged around it."@en,
        "由坯料周围布置的锻模沿径向反复压下，使坯料断面逐段成形。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/forging-method> ;
    skos:notation "RADIAL"^^stl:ForgingMethodCode ;
    skos:prefLabel "Radial forging"@en,
        "径向锻造"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/forging-method> .

<https://w3id.org/ontology-platform/steel/code/forging-method/RAPID> a skos:Concept ;
    rdfs:label "Rapid forging"@en,
        "快锻"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging-codes> ;
    skos:definition "Uses repeated short press strokes with stock feed to deform successive portions of the workpiece."@en,
        "利用快锻机短行程连续压下，配合送进使坯料逐段变形。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/forging-method> ;
    skos:notation "RAPID"^^stl:ForgingMethodCode ;
    skos:prefLabel "Rapid forging"@en,
        "快锻"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/forging-method> .

<https://w3id.org/ontology-platform/steel/code/heat-treatment-process/AGE> a skos:Concept ;
    rdfs:label "Ageing treatment"@en,
        "时效处理"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment-codes> ;
    skos:definition "A treatment that allows time for solute redistribution or precipitation at ambient or elevated temperature to change the properties of the steel."@en,
        "使钢在室温或升高的温度下停留，利用随时间发生的溶质重新分布或析出调整性能的方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> ;
    skos:notation "AGE"^^stl:HeatTreatmentProcessCode ;
    skos:prefLabel "Ageing treatment"@en,
        "时效处理"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> .

<https://w3id.org/ontology-platform/steel/code/heat-treatment-process/ANNEAL> a skos:Concept ;
    rdfs:label "Annealing"@en,
        "退火"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment-codes> ;
    skos:definition "A thermal cycle of heating, holding and controlled cooling to soften steel, relieve residual stress or prepare its microstructure for further working."@en,
        "通过加热、保温和受控冷却使钢软化、降低残余应力或取得后续加工所需组织的方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> ;
    skos:notation "ANNEAL"^^stl:HeatTreatmentProcessCode ;
    skos:prefLabel "Annealing"@en,
        "退火"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> .

<https://w3id.org/ontology-platform/steel/code/heat-treatment-process/NORMALIZE> a skos:Concept ;
    rdfs:label "Normalizing"@en,
        "正火"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment-codes> ;
    skos:definition "A treatment in which austenitized steel cools in air and develops its microstructure as the austenite transforms."@en,
        "使钢奥氏体化后在空气中冷却，利用冷却时的转变调整组织。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> ;
    skos:notation "NORMALIZE"^^stl:HeatTreatmentProcessCode ;
    skos:prefLabel "Normalizing"@en,
        "正火"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> .

<https://w3id.org/ontology-platform/steel/code/heat-treatment-process/QT> a skos:Concept ;
    rdfs:label "Quenching and high-temperature tempering"@en,
        "调质"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment-codes> ;
    skos:altLabel "Q&T"@en ;
    skos:definition "A combined treatment in which high-temperature tempering follows quench hardening to obtain a balance of strength and toughness."@en,
        "先将钢淬硬，再作高温回火以获得所需强度和韧性配合的复合热处理。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> ;
    skos:notation "QT"^^stl:HeatTreatmentProcessCode ;
    skos:prefLabel "Quenching and high-temperature tempering"@en,
        "调质"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> .

<https://w3id.org/ontology-platform/steel/code/heat-treatment-process/QUENCH> a skos:Concept ;
    rdfs:label "Quench hardening"@en,
        "淬火"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment-codes> ;
    skos:definition "A treatment that cools austenitized steel fast enough to develop the intended hardened microstructure."@en,
        "在钢奥氏体化后，以足以形成所需硬化组织的速度使工件冷却的方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> ;
    skos:notation "QUENCH"^^stl:HeatTreatmentProcessCode ;
    skos:prefLabel "Quench hardening"@en,
        "淬火"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> .

<https://w3id.org/ontology-platform/steel/code/heat-treatment-process/SOLUTION> a skos:Concept ;
    rdfs:label "Solution treatment"@en,
        "固溶处理"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment-codes> ;
    skos:definition "A treatment that dissolves soluble phases into the matrix at temperature and cools the workpiece at a rate that retains the intended solid solution."@en,
        "通过加热使可溶相进入基体，再以能保留所需固溶状态的速度冷却工件的方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> ;
    skos:notation "SOLUTION"^^stl:HeatTreatmentProcessCode ;
    skos:prefLabel "Solution treatment"@en,
        "固溶处理"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> .

<https://w3id.org/ontology-platform/steel/code/heat-treatment-process/TEMPER> a skos:Concept ;
    rdfs:label "Tempering"@en,
        "回火"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment-codes> ;
    skos:definition "A treatment that reheats hardened steel below the onset of austenite formation to adjust its hardness, strength and toughness."@en,
        "在低于奥氏体开始形成的温度下重新加热淬硬钢，调整其硬度、强度和韧性的方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> ;
    skos:notation "TEMPER"^^stl:HeatTreatmentProcessCode ;
    skos:prefLabel "Tempering"@en,
        "回火"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/heat-treatment-process> .

<https://w3id.org/ontology-platform/steel/code/inclusion-series/THICK> a skos:Concept ;
    rdfs:label "Thick series"@en,
        "粗系"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Rating series for the larger transverse sizes within a given category."@en,
        "在一个夹杂物类别中用于较大横向尺寸组的评级系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/inclusion-series> ;
    skos:notation "THICK"^^stl:InclusionSeriesCode ;
    skos:prefLabel "Thick series"@en,
        "粗系"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/inclusion-series> .

<https://w3id.org/ontology-platform/steel/code/inclusion-series/THIN> a skos:Concept ;
    rdfs:label "Thin series"@en,
        "细系"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Rating series for the smaller transverse sizes within a given category."@en,
        "在一个夹杂物类别中用于较小横向尺寸组的评级系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/inclusion-series> ;
    skos:notation "THIN"^^stl:InclusionSeriesCode ;
    skos:prefLabel "Thin series"@en,
        "细系"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/inclusion-series> .

<https://w3id.org/ontology-platform/steel/code/inclusion-type/A> a skos:Concept ;
    rdfs:label "Type A, sulphide type"@en,
        "A 类硫化物型"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Sulphide-type morphology appearing as elongated streaks along the working direction."@en,
        "随加工方向伸长、呈条带的硫化物型夹杂物形态组。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/inclusion-type> ;
    skos:notation "A"^^stl:InclusionTypeCode ;
    skos:prefLabel "Type A, sulphide type"@en,
        "A 类硫化物型"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/inclusion-type> .

<https://w3id.org/ontology-platform/steel/code/inclusion-type/B> a skos:Concept ;
    rdfs:label "Type B, aluminate type"@en,
        "B 类氧化铝型"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Aluminate-type morphology with angular particles aligned in discontinuous strings."@en,
        "多个棱角状颗粒沿加工方向排成断续列的氧化铝型形态组。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/inclusion-type> ;
    skos:notation "B"^^stl:InclusionTypeCode ;
    skos:prefLabel "Type B, aluminate type"@en,
        "B 类氧化铝型"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/inclusion-type> .

<https://w3id.org/ontology-platform/steel/code/inclusion-type/C> a skos:Concept ;
    rdfs:label "Type C, silicate type"@en,
        "C 类硅酸盐型"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Silicate-type morphology with elongated inclusions drawn out along the working direction."@en,
        "沿加工方向延展成细长条的硅酸盐型夹杂物形态组。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/inclusion-type> ;
    skos:notation "C"^^stl:InclusionTypeCode ;
    skos:prefLabel "Type C, silicate type"@en,
        "C 类硅酸盐型"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/inclusion-type> .

<https://w3id.org/ontology-platform/steel/code/inclusion-type/D> a skos:Concept ;
    rdfs:label "Type D, globular oxide type"@en,
        "D 类球状氧化物型"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Oxide-type morphology appearing as dispersed round or nearly round sections."@en,
        "在观察面上分散分布、以圆形或近圆形截面出现的氧化物型形态组。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/inclusion-type> ;
    skos:notation "D"^^stl:InclusionTypeCode ;
    skos:prefLabel "Type D, globular oxide type"@en,
        "D 类球状氧化物型"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/inclusion-type> .

<https://w3id.org/ontology-platform/steel/code/inclusion-type/DS> a skos:Concept ;
    rdfs:label "Type DS, single globular inclusion"@en,
        "DS 类单颗粒球状型"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Category used to rate an individual large globular inclusion by its own size."@en,
        "对观察面上的单个较大球状颗粒按其自身尺寸单独评级的类别。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/inclusion-type> ;
    skos:notation "DS"^^stl:InclusionTypeCode ;
    skos:prefLabel "Type DS, single globular inclusion"@en,
        "DS 类单颗粒球状型"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/inclusion-type> .

<https://w3id.org/ontology-platform/steel/code/ingot-position/HEAD> a skos:Concept ;
    rdfs:label "Ingot head"@en,
        "锭头"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Upper end of the ingot in its solidification orientation, used to trace head material."@en,
        "原锭凝固时的上端区域，用于追踪头部材料去向。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ingot-position> ;
    skos:notation "HEAD"^^stl:IngotPositionCode ;
    skos:prefLabel "Ingot head"@en,
        "锭头"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ingot-position> .

<https://w3id.org/ontology-platform/steel/code/ingot-position/MIDDLE> a skos:Concept ;
    rdfs:label "Ingot middle"@en,
        "锭中"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Main body of the ingot between its head and foot."@en,
        "原锭头部与尾部之间的主体区域。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ingot-position> ;
    skos:notation "MIDDLE"^^stl:IngotPositionCode ;
    skos:prefLabel "Ingot middle"@en,
        "锭中"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ingot-position> .

<https://w3id.org/ontology-platform/steel/code/ingot-position/TAIL> a skos:Concept ;
    rdfs:label "Ingot foot"@en,
        "锭尾"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Lower end of the ingot in its solidification orientation, used to trace foot material."@en,
        "原锭凝固时的下端区域，用于追踪底部材料去向。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ingot-position> ;
    skos:notation "TAIL"^^stl:IngotPositionCode ;
    skos:prefLabel "Ingot foot"@en,
        "锭尾"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ingot-position> .

<https://w3id.org/ontology-platform/steel/code/inspection-document-type/T21> a skos:Concept ;
    rdfs:label "declaration of compliance with the order"@en,
        "符合订单声明"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "2.1"@en,
        "2.1"@zh ;
    skos:definition "The manufacturer states compliance with the order without supplying test results."@en,
        "供方确认交货符合订单，文件仅载明该项声明。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/inspection-document-type> ;
    skos:notation "T21"^^stl:InspectionDocumentTypeCode ;
    skos:prefLabel "declaration of compliance with the order"@en,
        "符合订单声明"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/inspection-document-type> .

<https://w3id.org/ontology-platform/steel/code/inspection-document-type/T22> a skos:Concept ;
    rdfs:label "test report"@en,
        "试验报告"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "2.2"@en,
        "2.2"@zh ;
    skos:definition "The manufacturer confirms order compliance and supplies results of non-specific inspection."@en,
        "制造方声明符合订单并随附非特定检验的结果。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/inspection-document-type> ;
    skos:notation "T22"^^stl:InspectionDocumentTypeCode ;
    skos:prefLabel "test report"@en,
        "试验报告"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/inspection-document-type> .

<https://w3id.org/ontology-platform/steel/code/inspection-document-type/T31> a skos:Concept ;
    rdfs:label "type 3.1 inspection certificate"@en,
        "3.1 检验证书"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "3.1"@en,
        "3.1"@zh ;
    skos:definition "The manufacturer's authorized representative independent of production validates results from specific inspection of the delivery unit."@en,
        "由独立于制造部门的制造方授权检验代表确认，并列出对本交货检验单元适用的结果。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/inspection-document-type> ;
    skos:notation "T31"^^stl:InspectionDocumentTypeCode ;
    skos:prefLabel "type 3.1 inspection certificate"@en,
        "3.1 检验证书"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/inspection-document-type> .

<https://w3id.org/ontology-platform/steel/code/inspection-document-type/T32> a skos:Concept ;
    rdfs:label "type 3.2 inspection certificate"@en,
        "3.2 检验证书"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "3.2"@en,
        "3.2"@zh ;
    skos:definition "Specific inspection results are validated by the manufacturer's independent representative together with the purchaser's authorized representative or an inspector designated by regulation."@en,
        "在制造方独立检验代表之外，由买方授权代表或法规指定的检验员共同确认特定检验结果。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/inspection-document-type> ;
    skos:notation "T32"^^stl:InspectionDocumentTypeCode ;
    skos:prefLabel "type 3.2 inspection certificate"@en,
        "3.2 检验证书"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/inspection-document-type> .

<https://w3id.org/ontology-platform/steel/code/judgement-result/CONFORM> a skos:Concept ;
    rdfs:label "conforming"@en,
        "合格"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "The examined subject meets the cited requirements within the scope of this decision."@en,
        "经判定，受检对象在本次判定范围内满足引用要求。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/judgement-result> ;
    skos:notation "CONFORM"^^stl:JudgementResultCode ;
    skos:prefLabel "conforming"@en,
        "合格"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/judgement-result> .

<https://w3id.org/ontology-platform/steel/code/judgement-result/NONCONFORM> a skos:Concept ;
    rdfs:label "nonconforming"@en,
        "不合格"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "At least one applicable requirement was found unmet in this decision."@en,
        "本次判定发现至少一项适用要求未满足。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/judgement-result> ;
    skos:notation "NONCONFORM"^^stl:JudgementResultCode ;
    skos:prefLabel "nonconforming"@en,
        "不合格"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/judgement-result> .

<https://w3id.org/ontology-platform/steel/code/judgement-result/PENDING> a skos:Concept ;
    rdfs:label "pending judgement"@en,
        "待判"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "The decision awaits required results or review before conformity can be established."@en,
        "判断所需结果或审核尚未齐备，当前保留待判状态。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/judgement-result> ;
    skos:notation "PENDING"^^stl:JudgementResultCode ;
    skos:prefLabel "pending judgement"@en,
        "待判"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/judgement-result> .

<https://w3id.org/ontology-platform/steel/code/lot-formation-dimension/DELIVERY> a skos:Concept ;
    rdfs:label "Delivery condition"@en,
        "交货状态"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Requires members of an inspection lot to share a processing or heat-treatment condition at delivery, such as the normalized condition."@en,
        "要求检验批成员具有相同的交货加工或热处理状态，例如均以正火态交付。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> ;
    skos:notation "DELIVERY"^^stl:LotFormationDimensionCode ;
    skos:prefLabel "Delivery condition"@en,
        "交货状态"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> .

<https://w3id.org/ontology-platform/steel/code/lot-formation-dimension/HEAT> a skos:Concept ;
    rdfs:label "Heat"@en,
        "炉次"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Requires members of an inspection lot to trace to the same steelmaking heat through their material records."@en,
        "要求检验批成员的钢水来源可追溯至同一炉次，以来源记录核实炉次身份。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> ;
    skos:notation "HEAT"^^stl:LotFormationDimensionCode ;
    skos:prefLabel "Heat"@en,
        "炉次"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> .

<https://w3id.org/ontology-platform/steel/code/lot-formation-dimension/REBARGRADE> a skos:Concept ;
    rdfs:label "Same reinforcing bar grade"@en,
        "同一钢筋牌号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/quality-codes> ;
    skos:definition "Members must share the same reinforcing grade in the same edition, including any seismic suffix."@en,
        "各成员须属同一产品标准版次下的同一钢筋牌号，牌号有抗震后缀时一并核对。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> ;
    skos:notation "REBARGRADE"^^stl:LotFormationDimensionCode ;
    skos:prefLabel "Same reinforcing bar grade"@en,
        "同一钢筋牌号"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> .

<https://w3id.org/ontology-platform/steel/code/lot-formation-dimension/REBARMASS> a skos:Concept ;
    rdfs:label "Mass-limited rebar lot"@en,
        "按钢筋批重上限组批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/quality-codes> ;
    skos:definition "Members share one lot allocation bounded by mass. The cumulative mass is checked as bundles are added."@en,
        "成员归属同一限重分批单元，追加交验捆时按适用规则核对累计重量。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> ;
    skos:notation "REBARMASS"^^stl:LotFormationDimensionCode ;
    skos:prefLabel "Mass-limited rebar lot"@en,
        "按钢筋批重上限组批"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> .

<https://w3id.org/ontology-platform/steel/code/lot-formation-dimension/SPEC> a skos:Concept ;
    rdfs:label "Material specification"@en,
        "规格"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Requires members of an inspection lot to be covered by the same material specification."@en,
        "要求检验批成员适用同一物料规格，以该规格的身份判断能否合批。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> ;
    skos:notation "SPEC"^^stl:LotFormationDimensionCode ;
    skos:prefLabel "Material specification"@en,
        "规格"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> .

<https://w3id.org/ontology-platform/steel/code/macro-defect-type/CENTPOR> a skos:Concept ;
    rdfs:label "Central porosity"@en,
        "中心疏松"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Macrostructural item concerning porosity concentrated in the central region of a section."@en,
        "疏松集中在截面中心区域的低倍评级项目。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/macro-defect-type> ;
    skos:notation "CENTPOR"^^stl:MacroDefectTypeCode ;
    skos:prefLabel "Central porosity"@en,
        "中心疏松"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/macro-defect-type> .

<https://w3id.org/ontology-platform/steel/code/macro-defect-type/GENPOR> a skos:Concept ;
    rdfs:label "General porosity"@en,
        "一般疏松"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Macrostructural item concerning dispersed porosity in multiple regions of a section."@en,
        "截面多处出现分散疏松的低倍评级项目。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/macro-defect-type> ;
    skos:notation "GENPOR"^^stl:MacroDefectTypeCode ;
    skos:prefLabel "General porosity"@en,
        "一般疏松"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/macro-defect-type> .

<https://w3id.org/ontology-platform/steel/code/material-category/COAL> a skos:Concept ;
    rdfs:label "Coal"@en,
        "煤"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "Solid feedstock or fuel handled as coal, including coal for coking or injection."@en,
        "按煤料接收、配混或投用的固体原燃料，可供炼焦或作为喷吹用煤。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "COAL"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Coal"@en,
        "煤"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/material-category/COKE> a skos:Concept ;
    rdfs:label "Metallurgical coke"@en,
        "冶金焦炭"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1996-2017> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Porous carbonaceous lumps from coal carbonization serving as fuel, reductant and burden support."@en,
        "煤经干馏所得的多孔碳质块料，可在高炉内供热、还原和支撑料柱。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "COKE"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Metallurgical coke"@en,
        "冶金焦炭"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/material-category/FLUX> a skos:Concept ;
    rdfs:label "Flux"@en,
        "熔剂"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "An addition that combines with gangue or oxidation products to adjust slag chemistry and behavior."@en,
        "加入炉内与脉石或氧化产物成渣并调节渣性的材料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "FLUX"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Flux"@en,
        "熔剂"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/material-category/HOTMETAL> a skos:Concept ;
    rdfs:label "Hot metal"@en,
        "铁水"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Carbon-bearing iron transferred in liquid form to pretreatment or steelmaking."@en,
        "以液态送往预处理或炼钢工位的含碳铁料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "HOTMETAL"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Hot metal"@en,
        "铁水"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/material-category/ORE> a skos:Concept ;
    rdfs:label "Iron ore"@en,
        "铁矿石"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10322-1-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Iron-bearing mineral feed that supplies reducible oxide, as lump ore or after beneficiation and agglomeration."@en,
        "以可还原铁氧化物供铁、可直接选作块矿或先选矿造块的矿料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "ORE"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Iron ore"@en,
        "铁矿石"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/material-category/PELLET> a skos:Concept ;
    rdfs:label "Iron ore pellets"@en,
        "球团矿"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-27692-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Hardened balls of iron-bearing fines charged as a sized furnace feed."@en,
        "由含铁细粉造球并固结形成、以球状颗粒入炉的矿料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "PELLET"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Iron ore pellets"@en,
        "球团矿"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/material-category/PIGIRON> a skos:Concept ;
    rdfs:label "Solid pig iron"@en,
        "固态生铁"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-5296-2011> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "pig iron"@en,
        "生铁块"@zh ;
    skos:definition "Carbon-bearing iron cast into solid pieces for subsequent remelting."@en,
        "铁水经铸块凝固形成、需再熔化使用的含碳铁料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "PIGIRON"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Solid pig iron"@en,
        "固态生铁"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/material-category/SINTER> a skos:Concept ;
    rdfs:label "Iron ore sinter"@en,
        "烧结矿"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-421-2014> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Porous irregular burden pieces screened from an iron ore sinter cake."@en,
        "经料层烧结破碎筛分后供高炉使用的不规则多孔块料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/material-category> ;
    skos:notation "SINTER"^^stl:MaterialCategoryCode ;
    skos:prefLabel "Iron ore sinter"@en,
        "烧结矿"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/material-category> .

<https://w3id.org/ontology-platform/steel/code/measurement-item/CASTSPEED> a skos:Concept ;
    rdfs:label "casting speed"@en,
        "拉速"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting-codes> ;
    skos:altLabel "拉坯速度"@zh ;
    skos:definition "Identifies a reading of the length of strand withdrawn in the casting direction per unit time."@en,
        "标识所测的量为单位时间内沿拉坯方向引出的铸流长度。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    skos:notation "CASTSPEED"^^stl:MeasurementItemCode ;
    skos:prefLabel "casting speed"@en,
        "拉速"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/measurement-item> .

<https://w3id.org/ontology-platform/steel/code/measurement-item/COATMASS> a skos:Concept ;
    rdfs:label "coating mass per unit area"@en,
        "单位面积镀层质量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1839-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Mass of coating on the specified face or faces divided by projected substrate area."@en,
        "指定单面或双面合计的镀层质量与板带投影面积之比。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    skos:notation "COATMASS"^^stl:MeasurementItemCode ;
    skos:prefLabel "coating mass per unit area"@en,
        "单位面积镀层质量"@zh ;
    skos:scopeNote "与要求值比较时须采用相同的单面或双面合计口径。"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/measurement-item> .

<https://w3id.org/ontology-platform/steel/code/measurement-item/IMPACT> a skos:Concept ;
    rdfs:label "absorbed impact energy"@en,
        "冲击吸收能量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-229-2020> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "冲击功"@zh ;
    skos:definition "Energy absorbed by the specimen as it fractures under the stated impact conditions."@en,
        "在规定冲击条件下使试样发生断裂所吸收的能量。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    skos:notation "IMPACT"^^stl:MeasurementItemCode ;
    skos:prefLabel "absorbed impact energy"@en,
        "冲击吸收能量"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/measurement-item> .

<https://w3id.org/ontology-platform/steel/code/measurement-item/OXYACT> a skos:Concept ;
    rdfs:label "active oxygen in liquid steel"@en,
        "钢水活性氧"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "An in-process probe reading of active oxygen in liquid steel expressed on the specified ppm basis."@en,
        "通过在线探头观测钢水中活性氧并按规定的百万分数口径表示。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    skos:notation "OXYACT"^^stl:MeasurementItemCode ;
    skos:prefLabel "active oxygen in liquid steel"@en,
        "钢水活性氧"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/measurement-item> .

<https://w3id.org/ontology-platform/steel/code/measurement-item/TEMP> a skos:Concept ;
    rdfs:label "temperature"@en,
        "温度"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Temperature of the material at the stated point and sampling time."@en,
        "在指定时刻和测点取得的材料温度。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    skos:notation "TEMP"^^stl:MeasurementItemCode ;
    skos:prefLabel "temperature"@en,
        "温度"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/measurement-item> .

<https://w3id.org/ontology-platform/steel/code/measurement-item/TENSILE> a skos:Concept ;
    rdfs:label "tensile strength"@en,
        "抗拉强度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-228-1-2021> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Strength calculated from the peak tensile force and the initial cross-sectional area."@en,
        "由拉伸过程的最大载荷相对于试样初始截面积确定的强度指标。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    skos:notation "TENSILE"^^stl:MeasurementItemCode ;
    skos:prefLabel "tensile strength"@en,
        "抗拉强度"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/measurement-item> .

<https://w3id.org/ontology-platform/steel/code/measurement-item/THICKNESS> a skos:Concept ;
    rdfs:label "thickness"@en,
        "厚度"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Separation of the two faces of flat stock measured through thickness at the stated point."@en,
        "在指定点沿板带厚度方向量得的两表面间距。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    skos:notation "THICKNESS"^^stl:MeasurementItemCode ;
    skos:prefLabel "thickness"@en,
        "厚度"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/measurement-item> .

<https://w3id.org/ontology-platform/steel/code/measurement-item/WIDTH> a skos:Concept ;
    rdfs:label "width"@en,
        "宽度"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Edge-to-edge transverse dimension measured at the nominated section."@en,
        "在给定断面上沿横向量得的产品两侧边缘间距。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    skos:notation "WIDTH"^^stl:MeasurementItemCode ;
    skos:prefLabel "width"@en,
        "宽度"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/measurement-item> .

<https://w3id.org/ontology-platform/steel/code/measurement-method/AUTOMATIC> a skos:Concept ;
    rdfs:label "automatic"@en,
        "自动"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "The instrument or control system acquires the reading directly for the observation record."@en,
        "仪器或控制系统取得读数并直接采集到观测记录中。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-method> ;
    skos:notation "AUTOMATIC"^^stl:MeasurementMethodCode ;
    skos:prefLabel "automatic"@en,
        "自动"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/measurement-method> .

<https://w3id.org/ontology-platform/steel/code/measurement-method/MANUAL> a skos:Concept ;
    rdfs:label "manual"@en,
        "手工"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "An operator reads the quantity and registers it for the observation."@en,
        "由操作者读数并将数值作为本次观测结果登记。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-method> ;
    skos:notation "MANUAL"^^stl:MeasurementMethodCode ;
    skos:prefLabel "manual"@en,
        "手工"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/measurement-method> .

<https://w3id.org/ontology-platform/steel/code/melting-route/EAFESR> a skos:Concept ;
    rdfs:label "Electric arc melting followed by electroslag remelting"@en,
        "电弧炉冶炼—电渣重熔"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:altLabel "EAF+ESR"@en ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/melting-route/REMELT> ;
    skos:definition "Steel from a primary electric arc furnace heat is cast into ingots that supply the consumable electrodes for one electroslag remelt."@en,
        "将电弧炉一次冶炼所得钢水浇成初锭，由初锭制备自耗电极，再经一道电渣重熔成锭。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/melting-route> ;
    skos:notation "EAFESR"^^stl:MeltingRouteCode ;
    skos:prefLabel "Electric arc melting followed by electroslag remelting"@en,
        "电弧炉冶炼—电渣重熔"@zh .

<https://w3id.org/ontology-platform/steel/code/melting-route/EAFLFVD> a skos:Concept ;
    rdfs:label "Electric arc melting followed by ladle furnace refining and vacuum degassing"@en,
        "电炉冶炼—钢包炉精炼—真空脱气"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:altLabel "EAF+LF+VD"@en ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/melting-route/DIRECT> ;
    skos:definition "Steel from an electric arc furnace is refined in a ladle furnace, vacuum degassed and cast into stock for further processing."@en,
        "电弧炉出钢后依次经钢包炉精炼和真空脱气，再浇成供加工的坯或锭。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/melting-route> ;
    skos:notation "EAFLFVD"^^stl:MeltingRouteCode ;
    skos:prefLabel "Electric arc melting followed by ladle furnace refining and vacuum degassing"@en,
        "电炉冶炼—钢包炉精炼—真空脱气"@zh .

<https://w3id.org/ontology-platform/steel/code/melting-route/VIMESRVAR> a skos:Concept ;
    rdfs:label "Vacuum induction melting followed by electroslag and vacuum arc remelting"@en,
        "真空感应熔炼—电渣重熔—真空自耗重熔"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:altLabel "VIM+ESR+VAR"@en ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/melting-route/REMELT> ;
    skos:definition "A primary vacuum induction melt undergoes electroslag remelting. The electroslag ingot then supplies the electrode for vacuum arc remelting."@en,
        "一次真空感应熔炼后依次进行电渣和真空自耗两道重熔，电渣锭成为制备下一道自耗电极的来源。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/melting-route> ;
    skos:notation "VIMESRVAR"^^stl:MeltingRouteCode ;
    skos:prefLabel "Vacuum induction melting followed by electroslag and vacuum arc remelting"@en,
        "真空感应熔炼—电渣重熔—真空自耗重熔"@zh .

<https://w3id.org/ontology-platform/steel/code/melting-route/VIMPESR> a skos:Concept ;
    rdfs:label "Vacuum induction melting followed by protective atmosphere electroslag remelting"@en,
        "真空感应熔炼—保护气氛电渣重熔"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:altLabel "VIM+PESR"@en ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/melting-route/VIMESR> ;
    skos:definition "An electrode prepared from a primary vacuum induction melt undergoes electroslag remelting under a protective atmosphere."@en,
        "真空感应熔炼后制备的电极，在保护气氛下进行电渣重熔。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/melting-route> ;
    skos:notation "VIMPESR"^^stl:MeltingRouteCode ;
    skos:prefLabel "Vacuum induction melting followed by protective atmosphere electroslag remelting"@en,
        "真空感应熔炼—保护气氛电渣重熔"@zh .

<https://w3id.org/ontology-platform/steel/code/melting-route/VIMVAR> a skos:Concept ;
    rdfs:label "Vacuum induction melting followed by vacuum arc remelting"@en,
        "真空感应熔炼—真空自耗重熔"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:altLabel "VIM+VAR"@en ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/melting-route/REMELT> ;
    skos:definition "The primary vacuum induction melt supplies an electrode for one vacuum arc remelt."@en,
        "一次真空感应熔炼后，制备电极并进行一道真空自耗电弧重熔。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/melting-route> ;
    skos:notation "VIMVAR"^^stl:MeltingRouteCode ;
    skos:prefLabel "Vacuum induction melting followed by vacuum arc remelting"@en,
        "真空感应熔炼—真空自耗重熔"@zh .

<https://w3id.org/ontology-platform/steel/code/movement-event-type/DISPATCH> a skos:Concept ;
    rdfs:label "dispatch"@en,
        "出厂"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Confirms that the loaded goods left the works on their outbound journey."@en,
        "已装载货件实际离开厂区进入对外交运环节。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/movement-event-type> ;
    skos:notation "DISPATCH"^^stl:MovementEventTypeCode ;
    skos:prefLabel "dispatch"@en,
        "出厂"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/movement-event-type> .

<https://w3id.org/ontology-platform/steel/code/movement-event-type/LIFT> a skos:Concept ;
    rdfs:label "lift"@en,
        "吊起"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "A crane takes the load off its former support and carries it on the lifting attachment."@en,
        "天车起吊实物使其脱离原支承并由吊具承载。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/movement-event-type> ;
    skos:notation "LIFT"^^stl:MovementEventTypeCode ;
    skos:prefLabel "lift"@en,
        "吊起"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/movement-event-type> .

<https://w3id.org/ontology-platform/steel/code/movement-event-type/LOAD> a skos:Concept ;
    rdfs:label "vehicle loading"@en,
        "装车"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Places an identified handling unit on its transport vehicle and records that load association."@en,
        "将已识别货件装到承运车辆并建立装载关系。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/movement-event-type> ;
    skos:notation "LOAD"^^stl:MovementEventTypeCode ;
    skos:prefLabel "vehicle loading"@en,
        "装车"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/movement-event-type> .

<https://w3id.org/ontology-platform/steel/code/movement-event-type/RELEASE> a skos:Concept ;
    rdfs:label "set-down"@en,
        "释放落位"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "The load is set down at its actual destination and released by the lifting attachment."@en,
        "受吊实物在目标位置获得支承，吊具随后解除承载。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/movement-event-type> ;
    skos:notation "RELEASE"^^stl:MovementEventTypeCode ;
    skos:prefLabel "set-down"@en,
        "释放落位"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/movement-event-type> .

<https://w3id.org/ontology-platform/steel/code/ndt-acceptance-class/A> a skos:Concept ;
    rdfs:label "Bar ultrasonic class A"@en,
        "棒材超声 A 级"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Designates the conditions identified as class A in the cited edition for bar ultrasonic inspection."@en,
        "表示该次棒材超声交验采用所引版次中标作 A 的判读条件。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ndt-acceptance-class> ;
    skos:notation "A"^^stl:NdtAcceptanceClassCode ;
    skos:prefLabel "Bar ultrasonic class A"@en,
        "棒材超声 A 级"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ndt-acceptance-class> .

<https://w3id.org/ontology-platform/steel/code/ndt-acceptance-class/B> a skos:Concept ;
    rdfs:label "Bar ultrasonic class B"@en,
        "棒材超声 B 级"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Designates the conditions identified as class B in the cited edition for bar ultrasonic inspection."@en,
        "表示该次棒材超声交验采用所引版次中标作 B 的判读条件。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ndt-acceptance-class> ;
    skos:notation "B"^^stl:NdtAcceptanceClassCode ;
    skos:prefLabel "Bar ultrasonic class B"@en,
        "棒材超声 B 级"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ndt-acceptance-class> .

<https://w3id.org/ontology-platform/steel/code/ndt-method/ET> a skos:Concept ;
    rdfs:label "Eddy current testing"@en,
        "涡流检测"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7735-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "ET"@en,
        "ET"@zh ;
    skos:definition "Detects anomalies in conducting material through changes in the response of induced eddy currents."@en,
        "通过线圈感应电流并监测其响应变化以识别导电材料异常。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ndt-method> ;
    skos:notation "ET"^^stl:NdtMethodCode ;
    skos:prefLabel "Eddy current testing"@en,
        "涡流检测"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ndt-method> .

<https://w3id.org/ontology-platform/steel/code/ndt-method/MFL> a skos:Concept ;
    rdfs:label "Magnetic flux leakage testing"@en,
        "漏磁检测"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "MFL"@en,
        "MFL"@zh ;
    skos:definition "Measures magnetic flux escaping near discontinuities in magnetized stock."@en,
        "用传感器拾取磁化材料缺陷附近逸出的磁通以定位异常。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ndt-method> ;
    skos:notation "MFL"^^stl:NdtMethodCode ;
    skos:prefLabel "Magnetic flux leakage testing"@en,
        "漏磁检测"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ndt-method> .

<https://w3id.org/ontology-platform/steel/code/ndt-method/MT> a skos:Concept ;
    rdfs:label "Magnetic particle testing"@en,
        "磁粉检测"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-15822-1-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "MT"@en,
        "MT"@zh ;
    skos:definition "Magnetizes a ferromagnetic part and observes particles attracted at leakage fields."@en,
        "磁化铁磁工件并观察漏磁场聚集磁粉所形成的指示。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ndt-method> ;
    skos:notation "MT"^^stl:NdtMethodCode ;
    skos:prefLabel "Magnetic particle testing"@en,
        "磁粉检测"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ndt-method> .

<https://w3id.org/ontology-platform/steel/code/ndt-method/PAUT> a skos:Concept ;
    rdfs:label "Phased array ultrasonic testing"@en,
        "相控阵超声检测"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "PAUT"@en,
        "PAUT"@zh ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/ndt-method/UT> ;
    skos:definition "Controls element timing in an array to steer or focus the ultrasonic beam."@en,
        "控制阵列各阵元的激励时序，使声束可电子偏转或聚焦。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ndt-method> ;
    skos:notation "PAUT"^^stl:NdtMethodCode ;
    skos:prefLabel "Phased array ultrasonic testing"@en,
        "相控阵超声检测"@zh .

<https://w3id.org/ontology-platform/steel/code/ndt-method/PT> a skos:Concept ;
    rdfs:label "Penetrant testing"@en,
        "渗透检测"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-18851-1-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "PT"@en,
        "PT"@zh ;
    skos:definition "Reveals surface-breaking discontinuities by drawing retained penetrant back out of their openings."@en,
        "使渗透液进入表面开口，在清除表面余液后显出指示。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ndt-method> ;
    skos:notation "PT"^^stl:NdtMethodCode ;
    skos:prefLabel "Penetrant testing"@en,
        "渗透检测"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ndt-method> .

<https://w3id.org/ontology-platform/steel/code/ndt-method/RT> a skos:Concept ;
    rdfs:label "Radiographic testing"@en,
        "射线检测"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "RT"@en,
        "RT"@zh ;
    skos:definition "Images internal discontinuities from spatial differences in radiation transmitted through a part."@en,
        "记录穿过工件后射线强度的空间差异以显示内部不连续。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ndt-method> ;
    skos:notation "RT"^^stl:NdtMethodCode ;
    skos:prefLabel "Radiographic testing"@en,
        "射线检测"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ndt-method> .

<https://w3id.org/ontology-platform/steel/code/ndt-method/VT> a skos:Concept ;
    rdfs:label "Visual testing"@en,
        "目视检测"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "VT"@en,
        "VT"@zh ;
    skos:definition "Examines accessible surfaces, profiles and welds directly or with optical aids."@en,
        "用直接观察或光学辅助方式检查可见表面、外形和焊缝状态。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/ndt-method> ;
    skos:notation "VT"^^stl:NdtMethodCode ;
    skos:prefLabel "Visual testing"@en,
        "目视检测"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/ndt-method> .

<https://w3id.org/ontology-platform/steel/code/packing-form/COILUNIT> a skos:Concept ;
    rdfs:label "Single-coil package"@en,
        "单卷包装"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-247-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "One coil is secured or wrapped as a package associated with its coil identifier."@en,
        "一卷钢材单独捆扎或包覆，保留其卷号对应的包装身份。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/packing-form> ;
    skos:notation "COILUNIT"^^stl:PackingFormCode ;
    skos:prefLabel "Single-coil package"@en,
        "单卷包装"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/packing-form> .

<https://w3id.org/ontology-platform/steel/code/packing-form/CRATE> a skos:Concept ;
    rdfs:label "Crated package"@en,
        "箱装"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Pieces or finished stock are secured inside a protective crate for delivery."@en,
        "将零件或精整材固定在防护箱内交付。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/packing-form> ;
    skos:notation "CRATE"^^stl:PackingFormCode ;
    skos:prefLabel "Crated package"@en,
        "箱装"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/packing-form> .

<https://w3id.org/ontology-platform/steel/code/packing-form/STACK> a skos:Concept ;
    rdfs:label "Sheet or plate pack"@en,
        "板垛包装"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-247-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "An aligned stack of sheets or plates is secured for handling as one pack."@en,
        "多张板材对齐堆叠并固定成一个包装单元。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/packing-form> ;
    skos:notation "STACK"^^stl:PackingFormCode ;
    skos:prefLabel "Sheet or plate pack"@en,
        "板垛包装"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/packing-form> .

<https://w3id.org/ontology-platform/steel/code/personnel-role/APPROVER> a skos:Concept ;
    rdfs:label "Approver"@en,
        "批准人员"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Role responsible for authorizing a disposition or release within a delegated scope."@en,
        "负责在授权范围内批准质量处置或放行决定的角色。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/personnel-role> ;
    skos:notation "APPROVER"^^stl:PersonnelRoleCode ;
    skos:prefLabel "Approver"@en,
        "批准人员"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/personnel-role> .

<https://w3id.org/ontology-platform/steel/code/personnel-role/INSPECTOR> a skos:Concept ;
    rdfs:label "Inspector"@en,
        "检验人员"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Role responsible for examining material, specimens or records and reporting the findings."@en,
        "负责检查实物、试样或记录并报告检验结果的角色。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/personnel-role> ;
    skos:notation "INSPECTOR"^^stl:PersonnelRoleCode ;
    skos:prefLabel "Inspector"@en,
        "检验人员"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/personnel-role> .

<https://w3id.org/ontology-platform/steel/code/personnel-role/OPERATOR> a skos:Concept ;
    rdfs:label "Operator"@en,
        "操作人员"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Role responsible for operating equipment or carrying out production steps."@en,
        "负责执行设备操作或生产步骤的角色。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/personnel-role> ;
    skos:notation "OPERATOR"^^stl:PersonnelRoleCode ;
    skos:prefLabel "Operator"@en,
        "操作人员"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/personnel-role> .

<https://w3id.org/ontology-platform/steel/code/personnel-role/PLANNER> a skos:Concept ;
    rdfs:label "Production planner"@en,
        "计划人员"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Role responsible for scheduling production requirements against time and available resources."@en,
        "负责把生产需求安排到作业时段和资源上的角色。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/personnel-role> ;
    skos:notation "PLANNER"^^stl:PersonnelRoleCode ;
    skos:prefLabel "Production planner"@en,
        "计划人员"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/personnel-role> .

<https://w3id.org/ontology-platform/steel/code/pretreatment-method/DEP> a skos:Concept ;
    rdfs:label "Hot metal dephosphorization"@en,
        "铁水脱磷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "A pretreatment that oxidizes phosphorus in hot metal and transfers it to slag before steelmaking."@en,
        "在炼钢前氧化铁水中的磷并使其进入炉渣的处理方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/pretreatment-method> ;
    skos:notation "DEP"^^stl:PretreatmentMethodCode ;
    skos:prefLabel "Hot metal dephosphorization"@en,
        "铁水脱磷"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/pretreatment-method> .

<https://w3id.org/ontology-platform/steel/code/pretreatment-method/DES> a skos:Concept ;
    rdfs:label "Hot metal desulfurization"@en,
        "铁水脱硫"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "A pretreatment in which sulfur reacts with an added reagent and separates from the liquid iron before steelmaking."@en,
        "在炼钢前使铁水中的硫与处理剂反应并从金属相中分离的处理方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/pretreatment-method> ;
    skos:notation "DES"^^stl:PretreatmentMethodCode ;
    skos:prefLabel "Hot metal desulfurization"@en,
        "铁水脱硫"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/pretreatment-method> .

<https://w3id.org/ontology-platform/steel/code/pretreatment-method/DESI> a skos:Concept ;
    rdfs:label "Hot metal desiliconization"@en,
        "铁水脱硅"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "A pretreatment that oxidizes and removes dissolved silicon from the hot metal ahead of dephosphorization or steelmaking."@en,
        "在铁水送入后续脱磷或炼钢作业前，氧化并除去部分溶解硅的处理方法。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/pretreatment-method> ;
    skos:notation "DESI"^^stl:PretreatmentMethodCode ;
    skos:prefLabel "Hot metal desiliconization"@en,
        "铁水脱硅"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/pretreatment-method> .

<https://w3id.org/ontology-platform/steel/code/process-type/ALLOYADD> a skos:Concept ;
    rdfs:label "Alloy addition"@en,
        "合金加入"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
