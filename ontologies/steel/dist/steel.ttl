    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the material category scheme."@en,
        "标识“物料类别”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Material category code"@en,
        "物料类别代码"@zh .

stl:MaterialDisaggregation a owl:Class ;
