        "标识“无损检测方法”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Nondestructive testing method code"@en,
        "无损检测方法代码"@zh .

stl:OrderAmendment a owl:Class ;
    rdfs:label "Order amendment"@en,
        "订单变更单"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A document recording an agreed alteration to quantity, specification or delivery terms of an existing order item."@en,
        "记录已订项目的数量、规格或交期经确认发生改变的单据。"@zh ;
    skos:prefLabel "Order amendment"@en,
        "订单变更单"@zh .

stl:Packing a owl:Class ;
    rdfs:label "Packing"@en,
        "包装"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:MaterialAggregation ;
    skos:altLabel "包装执行"@zh ;
