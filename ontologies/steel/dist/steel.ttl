    skos:prefLabel "sulfur"@en,
        "硫"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/SB> a skos:Concept ;
    rdfs:label "Antimony"@en,
        "锑"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "Sb"@en,
        "Sb"@zh ;
    skos:definition "Reports residual antimony against trace-element requirements on the sample."@en,
        "以质量分数记录钢样中的残余锑以核对痕量元素控制要求。"@zh ;
