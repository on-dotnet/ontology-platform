    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/TRANSFORM> ;
    skos:definition "A route segment introducing alloying material into molten steel to adjust its composition."@en,
        "向钢水加入合金料以调整钢液成分的工序段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "ALLOYADD"^^stl:ProcessTypeCode ;
    skos:prefLabel "Alloy addition"@en,
        "合金加入"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/ANNEAL> a skos:Concept ;
