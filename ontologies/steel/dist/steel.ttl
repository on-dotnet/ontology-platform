    skos:definition "Separates a strand or an existing piece into individually identifiable lengths."@en,
        "把一段铸流或已有实物件分切成可以各自识别的坯件。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "CUT"^^stl:ProcessTypeCode ;
    skos:prefLabel "Cutting"@en,
        "切割"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/EAF> a skos:Concept ;
