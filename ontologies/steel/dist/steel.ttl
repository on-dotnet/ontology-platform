    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "H"@en,
        "H"@zh ;
    skos:definition "Quantifies hydrogen in the composition sample on the analytical basis specified for that result."@en,
        "按成分样品及规定测定口径报告氢元素的质量分数。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "H"^^stl:ChemicalElementCode ;
    skos:prefLabel "hydrogen"@en,
        "氢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/MG> a skos:Concept ;
    rdfs:label "Magnesium"@en,
        "镁"@zh ;
