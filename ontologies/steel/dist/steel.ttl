    skos:definition "Datatype of primary notations in the inspection document type scheme."@en,
        "标识“检验文件类型”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "inspection document type code"@en,
        "检验文件类型代码"@zh .

stl:InspectionInstruction a owl:Class ;
    rdfs:label "Inspection instruction"@en,
        "检验指令"@zh ;
