    skos:prefLabel "Tin"@en,
        "锡"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/TI> a skos:Concept ;
    rdfs:label "Titanium"@en,
