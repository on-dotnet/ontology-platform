    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/TRANSFORM> ;
    skos:definition "Joining strip from several coils into one output with multiple sources."@en,
        "把多卷的带钢接续为一个具有多个来源的产出卷。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "COILJOIN"^^stl:ProcessTypeCode ;
    skos:prefLabel "Coil joining"@en,
        "合卷"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/COILSPLIT> a skos:Concept ;
    rdfs:label "Coil splitting"@en,
        "分卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/TRANSFORM> ;
    skos:definition "Producing multiple separately tracked coils from one parent coil."@en,
        "以一卷为母卷取得多个具有各自身份的产出卷。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "COILSPLIT"^^stl:ProcessTypeCode ;
    skos:prefLabel "Coil splitting"@en,
        "分卷"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/COKING> a skos:Concept ;
    rdfs:label "Coking"@en,
        "炼焦"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
