<https://w3id.org/ontology-platform/steel/std/iec-62264-1-2013> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "IEC 62264-1:2013" ;
    dcterms:issued "2013"^^xsd:gYear ;
    dcterms:title "Enterprise-control system integration - Part 1: Models and terminology"@en,
        "企业控制系统集成 第1部分：模型与术语"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://webstore.iec.ch/en/publication/6675> .

stl:QualityDecision a owl:Class ;
    rdfs:label "Quality decision"@en,
        "质量判定"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-404-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:Event ;
    skos:definition "An event determining whether a piece or inspection lot conforms to a cited material specification under the applicable standard edition."@en,
        "按指定规格及适用标准版次，对一件实物或一个检验批作出符合性结论的事件。"@zh ;
    skos:prefLabel "Quality decision"@en,
        "质量判定"@zh .

stl:SemiFinishedProduct a owl:Class ;
    rdfs:label "Semi-finished product"@en,
        "半成品"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:definition "An individually identified intermediate product intended for further processing along its production route."@en,
        "已具有独立件号、仍需按既定生产路线继续加工的中间产品。"@zh ;
    skos:prefLabel "Semi-finished product"@en,
        "半成品"@zh .

stl:Slab a owl:Class ;
    rdfs:label "Slab"@en,
        "板坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:SemiFinishedProduct ;
    skos:definition "A separately tracked, wide, flat rectangular semiproduct for working into plate or strip, obtained by cutting a strand or by primary working."@en,
        "具有宽扁矩形截面、通常供轧板或轧带的独立坯件，可来自铸流分切或开坯。"@zh ;
    skos:prefLabel "Slab"@en,
        "板坯"@zh .

<https://w3id.org/ontology-platform/steel/code/ingot-position> a skos:ConceptScheme ;
    rdfs:label "Axial position on an ingot"@en,
        "钢锭轴向部位"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：追查特钢锻材的探伤异常时，要区分来自同一锭体的不同轴向部位。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Locates material along the original ingot axis as established at casting or solidification, retaining that orientation after working."@en,
        "按浇注或凝固时确定的锭体轴向划分来源部位，后续翻转或锻造仍沿用原锭方向。"@zh ;
    skos:prefLabel "Axial position on an ingot"@en,
        "钢锭轴向部位"@zh .

<https://w3id.org/ontology-platform/steel/code/personnel-role> a skos:ConceptScheme ;
    rdfs:label "Personnel role"@en,
        "人员角色"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Groups people by the responsibility they exercise in an operation, independently of the individual assigned."@en,
        "按作业所承担的职责对人员分类，可由不同人员在不同执行记录中承担同一职责。"@zh ;
    skos:prefLabel "Personnel role"@en,
        "人员角色"@zh .

<https://w3id.org/ontology-platform/steel/code/weld-method> a skos:ConceptScheme ;
    rdfs:label "Tube seam welding methods"@en,
        "管体焊接方法"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking-codes> ;
    skos:definition "Classifies methods of joining tube edges by welding process, with seam orientation distinguishing variants of a process."@en,
        "按管边的接合工艺划分制管焊接方法，部分方法再按制造焊缝的走向细分。"@zh ;
    skos:prefLabel "Tube seam welding methods"@en,
        "管体焊接方法"@zh .

<https://w3id.org/ontology-platform/steel/std/gb-1499-1-2024> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB 1499.1-2024" ;
    dcterms:issued "2024"^^xsd:gYear ;
    dcterms:replaces <https://w3id.org/ontology-platform/steel/std/gbt-1499-1-2017> ;
    dcterms:title "Steel for the reinforcement of concrete—Part 1:Hot rolled plain bars"@en,
        "钢筋混凝土用钢 第1部分：热轧光圆钢筋"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=GJ733S1WRs0%3D&mode=p> .

stl:ContinuouslyCastPiece a owl:Class ;
    rdfs:label "Continuously cast piece"@en,
        "连铸坯"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:SemiFinishedProduct ;
    skos:definition "An individually tracked length cut from a continuously cast steel strand or recut from that length while it retains its as-cast form."@en,
        "从钢的连续铸流切下、或将这类坯再次切分取得的独立铸态坯件。"@zh ;
    skos:prefLabel "Continuously cast piece"@en,
        "连铸坯"@zh ;
    skos:scopeNote "连铸路线与坯形可同时标注，例如一件实物同时属于连铸坯与板坯。初轧所得坯件只按其坯形归类。"@zh .

<https://w3id.org/ontology-platform/steel/code/inspection-document-type> a skos:ConceptScheme ;
    rdfs:label "inspection document type"@en,
        "检验文件类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/en-10204-2004> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Distinguishes documents delivered to the purchaser by the inspection evidence and its validation."@en,
        "按交货检验结果的代表性和确认方区分采购方收到的文件。"@zh ;
    skos:prefLabel "inspection document type"@en,
        "检验文件类型"@zh .

<https://w3id.org/ontology-platform/steel/code/movement-event-type> a skos:ConceptScheme ;
    rdfs:label "movement event type"@en,
        "移动事件类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Classifies actual handling events that change support, establish placement or confirm dispatch."@en,
        "区分影响实物承载关系、落位或出厂事实的已发生动作。"@zh ;
    skos:prefLabel "movement event type"@en,
        "移动事件类型"@zh .

<https://w3id.org/ontology-platform/steel/code/rating-comparison> a skos:ConceptScheme ;
    rdfs:label "Rating comparison operator"@en,
        "评级比较关系"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Relates an observed rating to a specified value on the named rating scale."@en,
        "规定实测级别在所引用评级标尺上与要求值如何比较。"@zh ;
    skos:prefLabel "Rating comparison operator"@en,
        "评级比较关系"@zh ;
    skos:scopeNote "要求值与实测值应采用同一版次的有序评级标尺。"@zh .

<https://w3id.org/ontology-platform/steel/code/sample-orientation> a skos:ConceptScheme ;
    rdfs:label "Specimen orientation"@en,
        "试样取向"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-2975-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Relates the specimen axis to a working direction or a named axis of the product."@en,
        "记录试样轴线相对于材料加工方向或产品几何轴的取向。"@zh ;
    skos:prefLabel "Specimen orientation"@en,
        "试样取向"@zh .

<https://w3id.org/ontology-platform/steel/std/gbt-2518-2019> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 2518-2019" ;
    dcterms:issued "2019"^^xsd:gYear ;
    dcterms:title "Continuously hot-dip zinc and zinc alloy coated steel sheet and strip"@en,
        "连续热镀锌和锌合金镀层钢板及钢带"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=996A838ABFD28372E05397BE0A0AD949> .

<https://w3id.org/ontology-platform/steel/std/gbt-709-2019> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 709-2019" ;
    dcterms:issued "2019"^^xsd:gYear ;
    dcterms:title "Dimension,shape,weight and tolerance for hot-rolled steel strip,plate and sheet"@en,
        "热轧钢板和钢带的尺寸、外形、重量及允许偏差"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=8531C702DB296551E05397BE0A0ACD16> .

<https://w3id.org/ontology-platform/steel/std/wbt-1091-2018> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "WB/T 1091-2018" ;
    dcterms:issued "2018"^^xsd:gYear ;
    dcterms:title "钢铁物流作业规范"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/hb/search/stdHBDetailed?id=8B1827F24A2EBB19E05397BE0A0AB44A> .

stl:Heat a owl:Class ;
    rdfs:label "Heat"@en,
        "炉次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20566-2006> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:ManufacturingRecord,
        stl:MaterialLot ;
    skos:altLabel "炼钢炉次"@zh,
        "熔炼炉次"@zh ;
    skos:definition "A steel batch identity established at one furnace tapping and carried into refining and casting records."@en,
        "一座炼钢炉一次冶炼出钢所确立的钢水批身份，精炼和浇注可继续引用该身份。"@zh ;
    skos:prefLabel "Heat"@en,
        "炉次"@zh .

stl:InspectionActivityRecord a owl:Class ;
    rdfs:label "Inspection activity record"@en,
        "检验记录"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20720-3-2022> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A record for an individual inspection identifying its subject, method and resulting evidence."@en,
        "记录一次具体检验及其采用的方法、对象和所得证据的载体。"@zh ;
    skos:prefLabel "Inspection activity record"@en,
        "检验记录"@zh .

stl:ManufacturingObject a owl:Class ;
    rdfs:label "Manufacturing object"@en,
        "制造业务对象"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "An entity or activity that can be identified in a production, inspection or delivery record."@en,
        "在生产、检验或交付中可以被独立指称的实体或活动。"@zh ;
    skos:prefLabel "Manufacturing object"@en,
        "制造业务对象"@zh .

stl:MaterialSpecification a owl:Class ;
    rdfs:label "Material specification"@en,
        "物料规格"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:ManufacturingObject ;
    skos:definition "A reusable specification stating the characteristics required of material for ordering or use, such as grade, dimensions and acceptance conditions."@en,
        "说明一类可订购或领用物料应具备哪些特征的规格，可归集牌号、尺寸及验收要求。"@zh ;
    skos:prefLabel "Material specification"@en,
        "物料规格"@zh .

stl:MechanicalTest a owl:Class ;
    rdfs:label "Mechanical test"@en,
        "力学试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10623-2008> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:InspectionActivityRecord ;
    skos:definition "A record of a method-specific test of the mechanical response of a specimen."@en,
        "在指定试样上按确定方法取得力学响应的试验记录。"@zh ;
    skos:prefLabel "Mechanical test"@en,
        "力学试验"@zh .

stl:Sample a owl:Class ;
    rdfs:label "Sample"@en,
        "样品"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-20066-2006> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf sosa:Sample ;
    skos:definition "Material taken from a traceable piece or lot for subsequent examination."@en,
        "从可追溯物料件或物料批中取得、供后续检验使用的材料。"@zh ;
    skos:prefLabel "Sample"@en,
        "样品"@zh ;
    skos:scopeNote "A sample can represent an ore, coke, hot metal or steel lot, or an individual product."@en,
        "样品可以代表铁矿石、焦炭、铁水或钢水等物料批，也可以取自一件成材。"@zh .

<https://w3id.org/ontology-platform/steel/code/lot-formation-dimension> a skos:ConceptScheme ;
    rdfs:label "Lot formation dimension"@en,
        "组批维度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies characteristics that a lot formation rule can require members of an inspection lot to share."@en,
        "列出组建检验批时可要求成员相同的特征，每条组批规则选用其中适用的维度。"@zh ;
    skos:prefLabel "Lot formation dimension"@en,
        "组批维度"@zh .

<https://w3id.org/ontology-platform/steel/std/gbt-18254-2016> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 18254-2016" ;
    dcterms:issued "2016"^^xsd:gYear ;
    dcterms:replaces <https://w3id.org/ontology-platform/steel/std/gbt-18254-2002> ;
    dcterms:title "High-carbon chromium bearing steel"@en,
        "高碳铬轴承钢"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=71F772D8111ED3A7E05397BE0A0AB82A> .

<https://w3id.org/ontology-platform/steel/std/gbt-700-2006> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 700-2006" ;
    dcterms:issued "2006"^^xsd:gYear ;
    dcterms:title "Carbon structural steels"@en,
        "碳素结构钢"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailedCNF?id=71F772D7C7C2D3A7E05397BE0A0AB82A> .

stl:Plan a owl:Class ;
    rdfs:label "Plan"@en,
        "计划"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    owl:disjointWith stl:Event ;
    skos:definition "A record setting out intended work, resources or timing before execution."@en,
        "在执行前约定预期作业、资源或时间的记录。"@zh ;
    skos:prefLabel "Plan"@en,
        "计划"@zh .

stl:QualityDisposition a owl:Class ;
    rdfs:label "Quality disposition"@en,
        "质量处置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:Event ;
    skos:definition "An event authorizing how a particular piece or inspection lot may be handled under stated conditions following a quality decision."@en,
        "在判定后授权对特定实物或检验批采取处理措施，并记录适用条件的事件。"@zh ;
    skos:prefLabel "Quality disposition"@en,
        "质量处置"@zh ;
    skos:scopeNote "Downgrading, reassignment and concession retain their own conditions and refer to the same material identity before and after the action."@en,
        "降级、改判和让步接收各自保留适用条件，处置前后沿用同一实物身份。"@zh .

stl:Remelting a owl:Class ;
    rdfs:label "Remelting operation"@en,
        "重熔作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特冶的多次熔炼须逐次标识重熔炉号和道次，并追溯该次产出的新锭。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/process-type/REMELT> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "One pass in a melting route in which metal from one or more consumable electrodes is melted and solidified into a new ingot."@en,
        "将一件或多件自耗电极重新熔化并凝固成新锭的一次作业，在冶炼链中占一个重熔道次。"@zh ;
    skos:prefLabel "Remelting operation"@en,
        "重熔作业"@zh .

<https://w3id.org/ontology-platform/steel/code/coating-type> a skos:ConceptScheme ;
    rdfs:label "Coating type"@en,
        "涂镀层类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:altLabel "镀层类型"@zh ;
    skos:definition "Classifies surface layers on steel by coating material and, where it distinguishes the type, by the deposition method."@en,
        "按覆层材料区分钢材表面的金属镀层和有机涂层，并在需要时区分热浸、电沉积等成层方式。"@zh ;
    skos:prefLabel "Coating type"@en,
        "涂镀层类型"@zh .

<https://w3id.org/ontology-platform/steel/code/forging-method> a skos:ConceptScheme ;
    rdfs:label "Forging method"@en,
        "锻造方法"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-8541-2012> ;
    rdfs:comment "下沉理由：特钢锻造作业的逐件履历须能按所记锻造方法查回锻造比。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging-codes> ;
    skos:definition "Identifies the principal forging method by tooling, mode of force application or forming objective."@en,
        "按作业实际采用的工具、施力方式或成形目的标识主要锻造方法。"@zh ;
    skos:prefLabel "Forging method"@en,
        "锻造方法"@zh .

<https://w3id.org/ontology-platform/steel/code/inclusion-type> a skos:ConceptScheme ;
    rdfs:label "Inclusion morphology category"@en,
        "夹杂物形态类别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> ;
    rdfs:comment "下沉理由：疲劳敏感特钢交验分别报告各类夹杂物级别。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Groups micrographic ratings by the appearance of inclusions on a polished section. The morphology is assigned optically."@en,
        "按金相观察面上夹杂物的形态对显微评级分组，类别名称不代表逐粒作过化学鉴定。"@zh ;
    skos:prefLabel "Inclusion morphology category"@en,
        "夹杂物形态类别"@zh .

<https://w3id.org/ontology-platform/steel/code/melting-route> a skos:ConceptScheme ;
    rdfs:label "Melting route"@en,
        "冶炼路线"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特钢的实物追溯须按有无重熔及各次重熔的次序区别同一牌号的冶炼履历。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:definition "Classifies actual sequences of primary melting, secondary refining and remelting according to whether they include a consumable electrode remelt."@en,
        "按一次冶炼、炉外精炼和各道重熔的实际先后标识路线，以是否含自耗重熔分组。"@zh ;
    skos:prefLabel "Melting route"@en,
        "冶炼路线"@zh .

<https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 10561-2023" ;
    dcterms:issued "2023"^^xsd:gYear ;
    dcterms:title "Determination of content of nonmetallic inclusions in steel—Micrographic method using standard diagrams"@en,
        "钢中非金属夹杂物含量的测定 标准评级图显微检验法"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailedCNF?id=FC816D05008B62EBE05397BE0A0AD5FA> .

stl:Material a owl:Class ;
    rdfs:label "Material"@en,
        "物料"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-1-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf prov:Entity,
        stl:ManufacturingObject ;
    skos:definition "A physical entity tracked as a lot or an individual piece as it enters or leaves manufacturing operations."@en,
        "在生产履历中按批或按件追踪的物质实体，可作为工序的投入或产出。"@zh ;
    skos:prefLabel "Material"@en,
        "物料"@zh .

stl:Event a owl:Class ;
    rdfs:label "Event"@en,
        "事件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "An occurrence locatable in the production or delivery history by its actual time."@en,
        "在生产或交付履历中能够按实际发生时间定位的一次业务事实。"@zh ;
    skos:prefLabel "Event"@en,
        "事件"@zh .

<https://w3id.org/ontology-platform/steel/code/refining-method> a skos:ConceptScheme ;
    rdfs:label "Secondary refining method"@en,
        "炉外精炼方法"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:definition "Classifies treatments of tapped steel by how they act on the bath. A heat can undergo a succession of these treatments."@en,
        "按出钢后处理钢液的工艺原理区分精炼方法，同一炉次可依次接受多种处理。"@zh ;
    skos:prefLabel "Secondary refining method"@en,
        "炉外精炼方法"@zh .

<https://w3id.org/ontology-platform/steel/code/steel-class-use> a skos:ConceptScheme ;
    rdfs:label "Steel end-use class"@en,
        "钢的主要用途类别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-13304-2-2008> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Groups grades by the intended service or property that drives material selection."@en,
        "按选材时起主导作用的服役用途或性能归类钢种。"@zh ;
    skos:prefLabel "Steel end-use class"@en,
        "钢的主要用途类别"@zh ;
    skos:scopeNote "用途代码用于按选材目的检索，同一钢种可有多种用途。"@zh .

<https://w3id.org/ontology-platform/steel/code/delivery-condition> a skos:ConceptScheme ;
    rdfs:label "Delivery condition"@en,
        "交货状态"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "States the processing or thermal condition promised for the material at delivery."@en,
        "记录供方承诺交付时材料所处的加工或热处理状态。"@zh ;
    skos:prefLabel "Delivery condition"@en,
        "交货状态"@zh .

<https://w3id.org/ontology-platform/steel/code/surface-condition> a skos:ConceptScheme ;
    rdfs:label "Surface condition"@en,
        "表面状态"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies the surface finish or covering actually presented at delivery."@en,
        "描述交货表面保留的覆盖物、处理痕迹或精饰形貌。"@zh ;
    skos:prefLabel "Surface condition"@en,
        "表面状态"@zh .

stl:Equipment a owl:Class ;
    rdfs:label "Equipment"@en,
        "设备"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-1-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:ManufacturingObject ;
    skos:definition "An identifiable manufacturing resource, including a functional equipment unit or a physical device used for processing or handling."@en,
        "承担生产或搬运任务的可识别资源，包括按职能划分的设备单元及其使用的装置。"@zh ;
    skos:prefLabel "Equipment"@en,
        "设备"@zh .

stl:Observation a owl:Class ;
    rdfs:label "Observation"@en,
        "测量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf sosa:Observation,
        stl:ManufacturingRecord ;
    skos:definition "A record tying one measured item and reading to an object, measurement point and acquisition time."@en,
        "针对指定对象在特定测点和取样时点取得某一测量项读数的记录。"@zh ;
    skos:prefLabel "Observation"@en,
        "测量"@zh .

<https://w3id.org/ontology-platform/steel/code/disposition-type> a skos:ConceptScheme ;
    rdfs:label "quality disposition type"@en,
        "质量处置类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Distinguishes actions affecting release, specification, repair or further use after a quality decision."@en,
        "区分判定后对实物的流转、规格、修复或使用资格采取的决定。"@zh ;
    skos:prefLabel "quality disposition type"@en,
        "质量处置类型"@zh .

<https://w3id.org/ontology-platform/steel/code/heat-treatment-process> a skos:ConceptScheme ;
    rdfs:label "Heat treatment process"@en,
        "热处理工艺"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-12603-2005> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment-codes> ;
    skos:definition "Classifies heat treatment methods by the thermal cycle applied to the steel and its metallurgical purpose, for use on loads and runs."@en,
        "按对钢材施加的热循环及其冶金目的区分热处理方法，供装炉批和作业引用。"@zh ;
    skos:prefLabel "Heat treatment process"@en,
        "热处理工艺"@zh ;
    skos:scopeNote "主代码采用本方案的英文助记码。"@zh .

<https://w3id.org/ontology-platform/steel/code/plain-product-family> a skos:ConceptScheme ;
    rdfs:label "Commodity steel product family"@en,
        "普钢产品族"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：这些系列用于普钢大宗订单选材，其中结构钢牌号可跨型钢、焊管等交货品种。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Groups applicable grades by material series, use or finished product specification in commodity steel orders. Families may overlap."@en,
        "按普钢订货采用的材质系列、产品用途或成品交货标准归集适用牌号，产品族可以交叉。"@zh ;
    skos:prefLabel "Commodity steel product family"@en,
        "普钢产品族"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/TRANSFORM> a skos:Concept ;
    rdfs:label "Material transformation"@en,
        "物料转换"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Work that consumes or alters input material to produce separately identifiable output material."@en,
        "以一项或多项物料为投入，产生可独立识别的新物料的作业类型。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "TRANSFORM"^^stl:ProcessTypeCode ;
    skos:prefLabel "Material transformation"@en,
        "物料转换"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 7232-2023" ;
    dcterms:issued "2023"^^xsd:gYear ;
    dcterms:title "Metal heat treatment—Terminology"@en,
        "金属热处理 术语"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailedCNF?id=027A6096AEE6643EE06397BE0A0A0867> .

<https://w3id.org/ontology-platform/steel/code/ndt-method> a skos:ConceptScheme ;
    rdfs:label "Nondestructive testing method"@en,
        "无损检测方法"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies the physical principle used to obtain indications while preserving the test piece."@en,
        "按形成可观察指示的物理机制标记无损检测记录。"@zh ;
    skos:prefLabel "Nondestructive testing method"@en,
        "无损检测方法"@zh .

<https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 17505-2016" ;
    dcterms:issued "2016"^^xsd:gYear ;
    dcterms:title "Steel and steel products—General technical delivery requirements"@en,
        "钢及钢产品 交货一般技术要求"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=71F772D81302D3A7E05397BE0A0AB82A> .

<https://w3id.org/ontology-platform/steel/code/sample-type> a skos:ConceptScheme ;
    rdfs:label "sample type"@en,
        "样品类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies a physical sample by its collection stage, material or intended specimen use."@en,
        "从取样部位、物料状态或试料用途标识已取得的样品。"@zh ;
    skos:prefLabel "sample type"@en,
        "样品类型"@zh .

<https://w3id.org/ontology-platform/steel/code/defect-type> a skos:ConceptScheme ;
    rdfs:label "defect type"@en,
        "缺陷类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Classifies observed flaws and groups product-specific defects by the form of material inspected."@en,
        "按观察到的异常给缺陷分类，产品分组用于归集依赖产品形态的缺陷。"@zh ;
    skos:prefLabel "defect type"@en,
        "缺陷类型"@zh .

<https://w3id.org/ontology-platform/steel/code/test-type> a skos:ConceptScheme ;
    rdfs:label "Test type"@en,
        "试验类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10623-2008> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies the test used to establish a performance characteristic of a specimen or product."@en,
        "按试样受到的载荷或检验目的区分取得性能证据的试验。"@zh ;
    skos:prefLabel "Test type"@en,
        "试验类型"@zh .

<https://w3id.org/ontology-platform/steel/code/measurement-item> a skos:ConceptScheme ;
    rdfs:label "measurement item"@en,
        "测量项"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies the quantity represented by a field reading or test result."@en,
        "标识一次观测、在线测量或试验结果所量取的具体指标。"@zh ;
    skos:prefLabel "measurement item"@en,
        "测量项"@zh .

<https://w3id.org/ontology-platform/steel/code/special-product-family> a skos:ConceptScheme ;
    rdfs:label "Special steel product family"@en,
        "特钢产品族"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：齿轮、轴承、工模具和高温部件等订货用途与特钢及特冶材料系列交叉，需在本层表达其选材关系。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-codes> ;
    skos:definition "Groups special steel and superalloy grades by material series or component application. A grade may belong to several families."@en,
        "按材料系列或零件用途归集特钢和高温合金牌号；一个牌号可适用于多个产品族。"@zh ;
    skos:prefLabel "Special steel product family"@en,
        "特钢产品族"@zh .

stl:MaterialLot a owl:Class ;
    rdfs:label "Material lot"@en,
        "物料批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:Material ;
    skos:definition "A quantity of material tracked under one lot identity for its composition, condition and quantity on the basis of its origin or production conditions."@en,
        "在给定生产条件或共同来源下按一批管理、以该批身份追踪成分、状态和数量的物料。"@zh ;
    skos:prefLabel "Material lot"@en,
        "物料批"@zh .

<https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "IEC 62264-2:2026" ;
    dcterms:issued "2026"^^xsd:gYear ;
    dcterms:title "Enterprise-Control System Integration - Part 2: Object models and relationships for interfaces between manufacturing operations and business functions"@en,
        "企业控制系统集成 第2部分：制造运营与业务功能接口的对象模型和关系"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://webstore.iec.ch/en/publication/75127> .

<https://w3id.org/ontology-platform/steel/std/iso-6929-2013> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "ISO 6929:2013" ;
    dcterms:issued "2013"^^xsd:gYear ;
    dcterms:title "Steel products — Vocabulary"@en,
        "钢产品 词汇"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://www.iso.org/standard/52949.html> .

<https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB 1499.2-2024" ;
    dcterms:issued "2024"^^xsd:gYear ;
    dcterms:replaces <https://w3id.org/ontology-platform/steel/std/gbt-1499-2-2018> ;
    dcterms:title "Steel for the reinforcement of concrete—Part 2:Hot rolled ribbed bars"@en,
        "钢筋混凝土用钢 第2部分：热轧带肋钢筋"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=1BD5B9878E5A2FCEE06397BE0A0A10CC> .

<https://w3id.org/ontology-platform/steel/code/material-category> a skos:ConceptScheme ;
    rdfs:label "Material category"@en,
        "物料类别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Groups materials by substance or metallurgical use independently of the identifiers assigned to lots and pieces."@en,
        "按材质或冶金用途划分物料，批号和件号用于标识该类中的具体物料。"@zh ;
    skos:prefLabel "Material category"@en,
        "物料类别"@zh .

stl:MaterialPiece a owl:Class ;
    rdfs:label "Material piece"@en,
        "实物件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:Material ;
    skos:definition "An item that can be weighed or moved under a single identity throughout its life."@en,
        "具有单件身份、能够称量或搬运并一直沿用其编号的物料实体。"@zh ;
    skos:prefLabel "Material piece"@en,
        "实物件"@zh .

stl:ManufacturingRecord a owl:Class ;
    rdfs:label "Manufacturing record"@en,
        "制造记录"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:ManufacturingObject ;
    skos:definition "A record preserving a plan, an occurrence or a document for later reference in manufacturing."@en,
        "可在制造业务中留存和引用的记录，其内容可以是计划、实绩或凭证。"@zh ;
    skos:prefLabel "Manufacturing record"@en,
        "制造记录"@zh .

<https://w3id.org/ontology-platform/steel/code/product-form> a skos:ConceptScheme ;
    rdfs:label "Product form"@en,
        "产品形态"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Describes the physical form in which material is handled or specified at a given stage."@en,
        "以可识别的几何外形或中间件形态描述规格和实物。"@zh ;
    skos:prefLabel "Product form"@en,
        "产品形态"@zh .

stl:Operation a owl:Class ;
    rdfs:label "Operation"@en,
        "工序执行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf prov:Activity,
        stl:Event ;
    skos:definition "A particular execution of a shop-floor step to which its equipment and material flows can be attributed."@en,
        "现场某项工序的一次实施，投入、产出和执行设备均可归到本次作业。"@zh ;
    skos:prefLabel "Operation"@en,
        "工序执行"@zh .

stl:StandardGrade a owl:Class ;
    rdfs:label "Standard grade designation"@en,
        "标准牌号"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-221-2008> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:ManufacturingObject ;
    skos:definition "A designation scoped to the particular edition of the product standard that names it."@en,
        "在一份确定版次的产品标准内具有指定名称的牌号条目。"@zh ;
    skos:prefLabel "Standard grade designation"@en,
        "标准牌号"@zh .

<https://w3id.org/ontology-platform/steel/code/chemical-element> a skos:ConceptScheme ;
    rdfs:label "chemical element analyte"@en,
        "化学元素分析项"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies the element and, where required, the analytical fraction used for a composition mass fraction."@en,
        "确定成分质量分数对应的元素，必要时区分同一元素的测定形态。"@zh ;
    skos:prefLabel "chemical element analyte"@en,
        "化学元素分析项"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type> a skos:ConceptScheme ;
    rdfs:label "Process type"@en,
        "工序类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies the transformation or service that a route segment calls for."@en,
        "按一次生产作业对投入所做的事区分路线中的工序段。"@zh ;
    skos:prefLabel "Process type"@en,
        "工序类型"@zh .

<https://w3id.org/ontology-platform/steel/code/equipment-type> a skos:ConceptScheme ;
    rdfs:label "Equipment type"@en,
        "设备类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Classifies equipment by its role in production, inspection or handling independently of the identity of each asset."@en,
        "按设备在作业中承担的功能对生产、检验和搬运设备分组，设备编号用于识别其中的具体一台。"@zh ;
    skos:prefLabel "Equipment type"@en,
        "设备类型"@zh .

stl:StandardEdition a owl:Class ;
    rdfs:label "Standard edition"@en,
        "标准版次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf dcterms:BibliographicResource,
        stl:ManufacturingObject ;
    skos:definition "A bibliographic resource identifying the exact edition cited by an order, test or certificate."@en,
        "标识某一具体版本标准的书目资源，可供订单、证明书及试验记录精确引用。"@zh ;
    skos:prefLabel "Standard edition"@en,
        "标准版次"@zh .

<https://w3id.org/ontology-platform/steel/source/industry-practice> a dcterms:BibliographicResource ;
    rdfs:label "Industry practice"@en,
        "行业通用"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    skos:definition "Source for terms defined from common steel industry practice where no public standard can be cited."@en,
        "没有可引用的公开标准、按钢铁行业通行做法定义的来源。"@zh .

