    skos:altLabel "Si"@en,
        "Si"@zh ;
    skos:definition "Measures silicon retained after deoxidation or specified as an alloy addition."@en,
        "按元素计量硅，可用于核对脱氧后残留量或合金化要求。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
