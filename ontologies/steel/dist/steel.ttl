    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:definition "A route segment delivering metallic feed or other charge materials to a steelmaking furnace."@en,
        "把备好的金属料或辅料送入炼钢炉的工序段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "CHARGE"^^stl:ProcessTypeCode ;
    skos:prefLabel "Steel furnace charging"@en,
        "炼钢装料"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/process-type> .

<https://w3id.org/ontology-platform/steel/code/process-type/COILJOIN> a skos:Concept ;
    rdfs:label "Coil joining"@en,
        "合卷"@zh ;
