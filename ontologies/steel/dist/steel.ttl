    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/STEELMAKE> ;
    skos:definition "A primary steelmaking segment in which a charge is melted and refined in an electric arc furnace."@en,
        "以电弧炉熔炼炉料并出钢的路线工序段。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "EAF"^^stl:ProcessTypeCode ;
    skos:prefLabel "Electric arc steelmaking"@en,
        "电弧炉炼钢"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/GALV> a skos:Concept ;
    rdfs:label "Galvanizing"@en,
        "镀锌"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/COAT> ;
    skos:definition "Applying zinc or zinc alloy as a surface coating on steel."@en,
        "在钢材表面形成锌或锌合金镀层。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "GALV"^^stl:ProcessTypeCode ;
    skos:prefLabel "Galvanizing"@en,
        "镀锌"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/HMPT> a skos:Concept ;
    rdfs:label "Hot metal pretreatment"@en,
        "铁水预处理"@zh ;
