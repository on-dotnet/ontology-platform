    skos:notation "AS"^^stl:ChemicalElementCode ;
    skos:prefLabel "Arsenic"@en,
        "砷"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/B> a skos:Concept ;
    rdfs:label "Boron"@en,
        "硼"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "B"@en,
        "B"@zh ;
    skos:definition "Reports trace boron on an elemental basis with the analytical fraction identified where relevant."@en,
        "按元素质量报告钢中微量硼，必要时另记分析形态。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "B"^^stl:ChemicalElementCode ;
    skos:prefLabel "Boron"@en,
        "硼"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/C> a skos:Concept ;
    rdfs:label "carbon"@en,
        "碳"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-223-86-2009> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "C"@en,
        "C"@zh ;
    skos:definition "Quantifies carbon for grade chemistry and decarburization control."@en,
        "按碳元素计量钢样中的碳，以便核对牌号成分和脱碳控制。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "C"^^stl:ChemicalElementCode ;
    skos:prefLabel "carbon"@en,
        "碳"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/CA> a skos:Concept ;
    rdfs:label "Calcium"@en,
        "钙"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "Ca"@en,
        "Ca"@zh ;
    skos:definition "Quantifies calcium in a sample when relating treatment history to measured chemistry."@en,
        "定量处理后试样中钙元素，用于关联钙处理与成分记录。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "CA"^^stl:ChemicalElementCode ;
    skos:prefLabel "Calcium"@en,
        "钙"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/CO> a skos:Concept ;
    rdfs:label "Cobalt"@en,
        "钴"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "Co"@en,
        "Co"@zh ;
    skos:definition "Measures cobalt in cobalt-alloyed steels or in cobalt-base products."@en,
        "按元素计量合金中钴的份额，适用于钴合金化或钴基材料。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "CO"^^stl:ChemicalElementCode ;
    skos:prefLabel "Cobalt"@en,
        "钴"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/CR> a skos:Concept ;
    rdfs:label "Chromium"@en,
        "铬"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "Cr"@en,
        "Cr"@zh ;
    skos:definition "Quantifies chromium for chemistry checks on grades such as alloy structural and stainless steels."@en,
        "定量钢中铬元素，用于核对含铬结构钢、不锈钢等材料的配比。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "CR"^^stl:ChemicalElementCode ;
    skos:prefLabel "Chromium"@en,
        "铬"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/CU> a skos:Concept ;
    rdfs:label "Copper"@en,
        "铜"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "Cu"@en,
        "Cu"@zh ;
    skos:definition "Measures copper whether specified as an addition or monitored as a charge residual."@en,
        "定量有意添加的铜或由废钢等炉料带入的残余铜。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "CU"^^stl:ChemicalElementCode ;
    skos:prefLabel "Copper"@en,
        "铜"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/FE> a skos:Concept ;
    rdfs:label "Iron"@en,
        "铁"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "Fe"@en,
        "Fe"@zh ;
    skos:definition "Quantifies iron in the matrix or alloy on an elemental mass basis."@en,
        "按分析所报铁元素的质量分数表征基体或合金中的铁量。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "FE"^^stl:ChemicalElementCode ;
    skos:prefLabel "Iron"@en,
        "铁"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/H> a skos:Concept ;
