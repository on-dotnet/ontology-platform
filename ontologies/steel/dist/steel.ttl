    skos:altLabel "Als"@en,
        "acid-soluble aluminum"@en,
        "Als"@zh,
        "酸溶性铝"@zh ;
    skos:definition "Reports only the aluminium recovered in solution under the stated acid treatment."@en,
        "在规定酸处理条件下，以溶入溶液的那部分铝作为报告对象。"@zh ;
