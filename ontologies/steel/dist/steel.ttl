    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "MN"^^stl:ChemicalElementCode ;
    skos:prefLabel "manganese"@en,
        "锰"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/MO> a skos:Concept ;
    rdfs:label "Molybdenum"@en,
        "钼"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "Mo"@en,
        "Mo"@zh ;
    skos:definition "Quantifies molybdenum for composition requirements linked to hardenability or hot strength."@en,
        "表征试样中钼的质量分数，用于核对淬透性或高温性能相关的成分要求。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "MO"^^stl:ChemicalElementCode ;
    skos:prefLabel "Molybdenum"@en,
        "钼"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/N> a skos:Concept ;
    rdfs:label "nitrogen"@en,
        "氮"@zh ;
