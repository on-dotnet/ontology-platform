<https://w3id.org/ontology-platform/steel/std/iso-4529-2023> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "ISO 4529:2023" ;
    dcterms:issued "2023"^^xsd:gYear ;
    dcterms:title "Industrial furnaces and associated processing equipment — Secondary steelmaking — Machinery and equipment for treatment of liquid steel"@en,
        "工业炉及相关工艺设备 二次炼钢 钢液处理机械与设备"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://www.iso.org/standard/80050.html> .

stl:Bundle a owl:Class ;
    rdfs:label "Fixed-length delivery bundle"@en,
        "定尺交货捆"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024>,
        <https://w3id.org/ontology-platform/steel/std/gbt-2101-2017> ;
    rdfs:comment "下沉理由：普钢长材的定尺成捆交货要把单支定尺、支数和整捆计重方式关联到同一包装件。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/packing-form/BUNDLE> ;
    rdfs:subClassOf stl:Package ;
    skos:definition "An identified package of commodity steel lengths counted to one ordered cut length and transferred on an agreed mass basis."@en,
        "以捆号移交的一组定尺普钢长材，每支按同一交货长度清点，整捆按约定方式计重。"@zh ;
    skos:prefLabel "Fixed-length delivery bundle"@en,
        "定尺交货捆"@zh .

stl:Coil a owl:Class ;
    rdfs:label "Steel coil"@en,
        "钢卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:definition "An individually tracked length of flat steel strip wound for handling as a unit, at the hot mill, cold mill or a later operation."@en,
        "将一段带钢沿长度方向卷绕成可整体吊运、按件跟踪的实物，卷形可出现在热轧、冷轧及后续作业中。"@zh ;
    skos:prefLabel "Steel coil"@en,
        "钢卷"@zh .

stl:Ingot a owl:Class ;
    rdfs:label "Steel ingot"@en,
        "钢锭"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting> ;
    rdfs:subClassOf stl:SemiFinishedProduct ;
    skos:definition "A discrete body of solidified steel tracked as one ingot, with its production method identified by its generating operation."@en,
        "钢液凝固成一个可单独交接的锭体，锭的具体生产方法由产出作业记录。"@zh ;
    skos:prefLabel "Steel ingot"@en,
        "钢锭"@zh .

stl:MaterialTransformation a owl:Class ;
    rdfs:label "Material transformation"@en,
        "物料转换作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that consumes or changes input material and establishes distinct output material."@en,
        "消耗或改变投入物料并产生可区分产出物料的一次作业。"@zh ;
    skos:prefLabel "Material transformation"@en,
        "物料转换作业"@zh .

stl:RatingResult a owl:Class ;
    rdfs:label "Rating result"@en,
        "评级结果"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:InspectionResult ;
    skos:definition "A grade assigned to one or more observations on an identified scale under a stated method."@en,
        "在指定标尺和方法下对一次观察或一组观察给出的等级。"@zh ;
    skos:prefLabel "Rating result"@en,
        "评级结果"@zh .

stl:Steelmaking a owl:Class ;
    rdfs:label "Steelmaking operation"@en,
        "炼钢执行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that converts metallic feed into a heat of steel, linking the charged lots to the heat identified at tapping."@en,
        "将金属炉料冶炼成一炉钢水的作业，其取料按投入批次追踪，出钢时确立炉次身份。"@zh ;
    skos:prefLabel "Steelmaking operation"@en,
        "炼钢执行"@zh .

<https://w3id.org/ontology-platform/steel/code/bundle-mass-basis> a skos:ConceptScheme ;
    rdfs:label "Delivery bundle mass basis"@en,
        "交货捆计重方式"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:comment "下沉理由：成捆普钢长材交货可在按定尺支数理计和整捆实称之间选择，需在捆号上保留依据。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Distinguishes how the delivered mass of a fixed-length bundle is determined."@en,
        "区分普钢定尺长材整捆交接时所采用的计重依据。"@zh ;
    skos:prefLabel "Delivery bundle mass basis"@en,
        "交货捆计重方式"@zh .

<https://w3id.org/ontology-platform/steel/code/inclusion-series> a skos:ConceptScheme ;
    rdfs:label "Inclusion thickness series"@en,
        "夹杂物粗细系列"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10561-2023> ;
    rdfs:comment "下沉理由：特钢夹杂物逐类交验时须保留粗细系列，才能匹配同系列的订货要求。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Series distinguishing transverse size within a rated inclusion category."@en,
        "对同一夹杂物类别按其横向尺寸分别使用的评级系列。"@zh ;
    skos:prefLabel "Inclusion thickness series"@en,
        "夹杂物粗细系列"@zh .

<https://w3id.org/ontology-platform/steel/code/macro-defect-type> a skos:ConceptScheme ;
    rdfs:label "Rated ingot product macrodefect"@en,
        "锭材低倍受评缺陷类别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1979-2025> ;
    rdfs:comment "下沉理由：特钢锭材交验需把各项低倍缺陷的观察结果对应到规定的评级项目。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Distinguishes features graded separately on a macrostructural section from an ingot product."@en,
        "区分锭材低倍截面上需分别给出级别的组织缺陷。"@zh ;
    skos:prefLabel "Rated ingot product macrodefect"@en,
        "锭材低倍受评缺陷类别"@zh .

<https://w3id.org/ontology-platform/steel/code/measurement-method> a skos:ConceptScheme ;
    rdfs:label "measurement acquisition method"@en,
        "采集方式"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies whether the reading was obtained by an operator or acquired by the equipment."@en,
        "标识现场观测的读数经人或设备取得的方式。"@zh ;
    skos:prefLabel "measurement acquisition method"@en,
        "采集方式"@zh .

<https://w3id.org/ontology-platform/steel/code/melting-route/REMELT> a skos:Concept ;
    rdfs:label "Routes with remelting"@en,
        "含重熔路线"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting-codes> ;
    skos:definition "Groups routes with at least one consumable electrode remelting pass after primary melting."@en,
        "归集一次冶炼后又经过一道或多道自耗电极重熔的路线。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/melting-route> ;
    skos:notation "REMELT"^^stl:MeltingRouteCode ;
    skos:prefLabel "Routes with remelting"@en,
        "含重熔路线"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/melting-route> .

<https://w3id.org/ontology-platform/steel/code/ndt-acceptance-class> a skos:ConceptScheme ;
    rdfs:label "Ultrasonic acceptance class for wrought bars"@en,
        "锻轧棒材超声验收等级"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-4162-2022> ;
    rdfs:comment "下沉理由：特钢棒材逐支交验要记录指定验收级别，与通用的探伤方法和判定结论分别查询。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/inspection-codes> ;
    skos:definition "Distinguishes the acceptance classes used to evaluate indications under an identified bar test method and edition."@en,
        "按所引棒材检测方法和版次区分用来判读显示的等级。"@zh ;
    skos:prefLabel "Ultrasonic acceptance class for wrought bars"@en,
        "锻轧棒材超声验收等级"@zh .

<https://w3id.org/ontology-platform/steel/code/plain-product-family/REBAR> a skos:Concept ;
    rdfs:label "Reinforcing bar"@en,
        "钢筋"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-1-2024>,
        <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Bars ordered for concrete reinforcement by nominal diameter and reinforcing grade."@en,
        "按配筋用途、公称直径及钢筋牌号交货的产品系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/plain-product-family> ;
    skos:notation "REBAR"^^stl:PlainProductFamilyCode ;
    skos:prefLabel "Reinforcing bar"@en,
        "钢筋"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/plain-product-family> .

<https://w3id.org/ontology-platform/steel/code/rebar-lot-basis> a skos:ConceptScheme ;
    rdfs:label "Rebar lot assessment basis"@en,
        "钢筋交验批判定基准"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:comment "下沉理由：钢筋按批交验需区分公称米重偏差和抗震钢筋性能证据，这些项目取决于钢筋产品标准。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/quality-codes> ;
    skos:definition "Distinguishes kinds of product inspection evidence used to assess a reinforcing bar lot. The decision records the outcome."@en,
        "区分钢筋产品检验中用于整批判定的证据口径，判定结论另记在判定记录上。"@zh ;
    skos:prefLabel "Rebar lot assessment basis"@en,
        "钢筋交验批判定基准"@zh .

<https://w3id.org/ontology-platform/steel/code/rebar-surface> a skos:ConceptScheme ;
    rdfs:label "Rebar surface pattern"@en,
        "钢筋表面形状"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-1-2024>,
        <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:comment "下沉理由：光圆和带肋是钢筋产品交验时的分类，直接关联钢筋与混凝土的黏结特征。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Classifies the surface of concrete reinforcing bars by their external geometry."@en,
        "按混凝土配筋用钢筋的外周几何特征区分钢筋表面。"@zh ;
    skos:prefLabel "Rebar surface pattern"@en,
        "钢筋表面形状"@zh .

<https://w3id.org/ontology-platform/steel/code/share-basis> a skos:ConceptScheme ;
    rdfs:label "contribution share basis"@en,
        "份额基准"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies the physical quantity used to express how much of an output is attributed to a source."@en,
        "标识把来源对某个产出的贡献换算为份额所用的物理量。"@zh ;
    skos:prefLabel "contribution share basis"@en,
        "份额基准"@zh .

<https://w3id.org/ontology-platform/steel/code/teeming-method> a skos:ConceptScheme ;
    rdfs:label "Ingot teeming method"@en,
        "模铸浇注方式"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting-codes> ;
    skos:definition "Classifies ingot teeming by the path of the steel into the mould cavity so that the pouring method can be traced for each ingot."@en,
        "按钢流进入锭模的路径区分模铸作业，据此可查询钢锭实际采用的浇法。"@zh ;
    skos:prefLabel "Ingot teeming method"@en,
        "模铸浇注方式"@zh .

<https://w3id.org/ontology-platform/steel/code/transport-mode> a skos:ConceptScheme ;
    rdfs:label "Shipment transport mode"@en,
        "发运运输方式"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies the carrier mode for one leg of an outbound shipment."@en,
        "按一段发运实际采用的承运工具区分运输方式。"@zh ;
    skos:prefLabel "Shipment transport mode"@en,
        "发运运输方式"@zh .

<https://w3id.org/ontology-platform/steel/std/gbt-1222-2016> a stl:StandardEdition ;
    dcterms:description "废止"@zh ;
    dcterms:identifier "GB/T 1222-2016" ;
    dcterms:isReplacedBy <https://w3id.org/ontology-platform/steel/std/gbt-1222-2025> ;
    dcterms:issued "2016"^^xsd:gYear ;
    dcterms:title "Spring steels"@en,
        "弹簧钢"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=71F772D8170BD3A7E05397BE0A0AB82A> .

<https://w3id.org/ontology-platform/steel/std/gbt-20066-2006> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 20066-2006" ;
    dcterms:issued "2006"^^xsd:gYear ;
    dcterms:title "Steel and iron -- Sampling and preparation of samples for the determination of chemical composition"@en,
        "钢和铁 化学成分测定用试样的取样和制样方法"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=6jxSfPicV3E%3D&mode=p> .

<https://w3id.org/ontology-platform/steel/std/gbt-8541-2012> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 8541-2012" ;
    dcterms:issued "2012"^^xsd:gYear ;
    dcterms:title "Terminology of forging and stamping"@en,
        "锻压术语"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=enPXniyMfX0%3D&mode=p> .

stl:Forging a owl:Class ;
    rdfs:label "Forging operation"@en,
        "锻造作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-8541-2012> ;
    rdfs:comment "下沉理由：特钢锻件的制造记录须能逐次查到所用的锻造方法和锻造比。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/forging> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/process-type/FORGE> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation in which hammer blows or applied pressure plastically deform solid steel stock to produce a forged blank or forging."@en,
        "用锤击或施压使固态钢料发生塑性变形、制得锻坯或锻件的一次作业。"@zh ;
    skos:prefLabel "Forging operation"@en,
        "锻造作业"@zh .

stl:MovementEvent a owl:Class ;
    rdfs:label "Movement event"@en,
        "移动事件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1091-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:Event ;
    skos:definition "A handling event identifying when a piece was lifted, set down, loaded or dispatched."@en,
        "记录某件实物一次吊起、落位、装车或出厂动作及其发生时间的事件。"@zh ;
    skos:prefLabel "Movement event"@en,
        "移动事件"@zh ;
    skos:scopeNote "Use the latest confirmed occurrence. After a lift the crane carries the piece, after set-down its location is the actual destination, and after loading its carrier can be traced through the shipment."@en,
        "按发生时间取最近的已确认事件。吊起后实物由执行天车承载，落位后以实际落点为库位，装车后可由发运单追到运输载具。"@zh .

stl:SteelGrade a owl:Class ;
    rdfs:label "Internal steel grade"@en,
        "内部钢种"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:ManufacturingObject ;
    skos:definition "A producer's grade identity used to organize production and relate it to published designations."@en,
        "用于组织内部冶炼与生产、可以对应多个公开牌号的钢种身份。"@zh ;
    skos:prefLabel "Internal steel grade"@en,
        "内部钢种"@zh .

