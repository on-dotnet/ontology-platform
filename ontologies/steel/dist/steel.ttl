        "Mg"@zh ;
    skos:definition "Measures retained magnesium for refining and inclusion-control records."@en,
        "按元素报告钢样中残留的镁，供精炼或夹杂物控制记录使用。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "MG"^^stl:ChemicalElementCode ;
    skos:prefLabel "Magnesium"@en,
        "镁"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/MN> a skos:Concept ;
    rdfs:label "manganese"@en,
        "锰"@zh ;
