    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 5213-2019" ;
    dcterms:issued "2019"^^xsd:gYear ;
    dcterms:title "Cold rolled low carbon steel sheet and strip"@en,
        "冷轧低碳钢板及钢带"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailed?id=Lb63thr9SCE%3D&mode=p> .

stl:InspectionResult a owl:Class ;
    rdfs:label "Inspection result"@en,
        "检验结果"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A reading, rating or finding that can be cited separately from the inspection record that produced it."@en,
        "检验后可脱离原记录而单独引用的一项读数、评级或文字结论。"@zh ;
    skos:prefLabel "Inspection result"@en,
        "检验结果"@zh .

stl:Location a owl:Class ;
    rdfs:label "Location"@en,
        "位置"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    skos:definition "An identifiable place where work occurs, equipment is situated or material is stored."@en,
        "可标识作业发生处、设备所在处或物料存放处的空间对象。"@zh ;
    skos:prefLabel "Location"@en,
        "位置"@zh .

stl:Requirement a owl:Class ;
    rdfs:label "Acceptance requirement"@en,
        "验收要求"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:ManufacturingObject ;
    skos:definition "A separately referenceable condition specifying what must be assessed for acceptance."@en,
        "能独立指明适用对象、判定依据和验收条件的一项要求。"@zh ;
    skos:prefLabel "Acceptance requirement"@en,
        "验收要求"@zh .

stl:SalesOrderLine a owl:Class ;
    rdfs:label "Sales order line"@en,
        "订单行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "An individually specifiable item of demand within a sales order to which pieces can be assigned."@en,
        "销售订单中能独立约定规格并承接实物分配的一项。"@zh ;
    skos:prefLabel "Sales order line"@en,
        "订单行"@zh .

stl:SourceContribution a owl:Class ;
    rdfs:label "Source contribution"@en,
        "来源份额记录"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A record associating one output with one direct source and the evidence for its share."@en,
        "为一个产出和一个直接来源保存计量依据、份额或份额未知状态的记录。"@zh ;
    skos:prefLabel "Source contribution"@en,
        "来源份额记录"@zh .

<https://w3id.org/ontology-platform/steel/code/analysis-type> a skos:ConceptScheme ;
    rdfs:label "chemical analysis type"@en,
        "化学分析类型"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Distinguishes the material represented and the control or acceptance purpose of a chemistry result."@en,
        "区分化学分析代表的材料范围以及该结果在工艺或验收中的用途。"@zh ;
    skos:prefLabel "chemical analysis type"@en,
        "化学分析类型"@zh .

<https://w3id.org/ontology-platform/steel/code/contribution-evidence> a skos:ConceptScheme ;
    rdfs:label "contribution evidence level"@en,
        "来源证据等级"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies the support available for the size of a contribution from a known source."@en,
        "标示来源已知时对所记贡献份额具有什么依据。"@zh ;
    skos:prefLabel "contribution evidence level"@en,
        "来源证据等级"@zh .

<https://w3id.org/ontology-platform/steel/code/judgement-result> a skos:ConceptScheme ;
    rdfs:label "conformity judgement result"@en,
        "判定结果"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Records the finding against specified requirements before any separate disposition authorization."@en,
        "记录证据对规定要求的判定结论，处置授权另行关联。"@zh ;
    skos:prefLabel "conformity judgement result"@en,
        "判定结果"@zh .

<https://w3id.org/ontology-platform/steel/code/packing-form> a skos:ConceptScheme ;
    rdfs:label "Packing form"@en,
        "交货包装形式"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Identifies the handling unit in which pieces are counted and presented for shipment."@en,
        "区分哪些实物作为一个包装单元清点和搬运。"@zh ;
    skos:prefLabel "Packing form"@en,
        "交货包装形式"@zh .

<https://w3id.org/ontology-platform/steel/code/pretreatment-method> a skos:ConceptScheme ;
    rdfs:label "Hot metal pretreatment method"@en,
        "铁水预处理方法"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "Classifies hot metal pretreatment methods by the impurity targeted for removal before the steelmaking charge."@en,
        "按炼钢装料前的处理所要脱除的杂质，对铁水预处理方法分类。"@zh ;
    skos:prefLabel "Hot metal pretreatment method"@en,
        "铁水预处理方法"@zh .

<https://w3id.org/ontology-platform/steel/code/steel-class-composition> a skos:ConceptScheme ;
    rdfs:label "Steel composition class"@en,
        "钢的化学成分类别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-13304-1-2008> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Groups a steel grade according to its specified chemistry and the applicable alloying criteria."@en,
        "按规定的成分口径把一个钢种归入非合金、低合金或合金组。"@zh ;
    skos:prefLabel "Steel composition class"@en,
        "钢的化学成分类别"@zh .

<https://w3id.org/ontology-platform/steel/code/steel-class-quality> a skos:ConceptScheme ;
    rdfs:label "Steel quality class"@en,
        "钢的质量等级类别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-13304-2-2008> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Classifies grades by the demands placed on their manufacture and material quality."@en,
        "按生产控制与质量要求的严格程度归类钢种，每次判定的合格结论另记。"@zh ;
    skos:prefLabel "Steel quality class"@en,
        "钢的质量等级类别"@zh .

<https://w3id.org/ontology-platform/steel/std/gbt-1591-2018> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 1591-2018" ;
    dcterms:issued "2018"^^xsd:gYear ;
    dcterms:title "High strength low alloy structural steels"@en,
        "低合金高强度结构钢"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/search/stdPage?q=%E4%BD%8E%E5%90%88%E9%87%91%E9%AB%98%E5%BC%BA%E5%BA%A6%E7%BB%93%E6%9E%84%E9%92%A2> .

<https://w3id.org/ontology-platform/steel/std/gbt-228-1-2021> a stl:StandardEdition ;
