    skos:prefLabel "Rated ingot product macrodefect code"@en,
        "锭材低倍受评缺陷类别代码"@zh .

stl:MacroRatedDefectShape a sh:PropertyShape ;
    rdfs:comment "一个低倍缺陷级别应明确对应一个受评缺陷。"@zh ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:ratedMacroDefect ;
    sh:severity sh:Violation ;
    sh:targetClass stl:MacroDefectRating .

stl:MacroRatingExaminationShape a sh:PropertyShape ;
