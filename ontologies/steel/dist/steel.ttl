    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling-codes> ;
    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/COLDROLL> ;
    skos:definition "Descaling and reducing strip in coupled pickling and cold rolling sections."@en,
        "使带钢在相连的酸洗与冷轧段连续完成除鳞和减薄。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "PICKLECOLD"^^stl:ProcessTypeCode ;
    skos:prefLabel "Coupled pickling and cold rolling"@en,
        "酸洗冷连轧"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/PLATEROLL> a skos:Concept ;
