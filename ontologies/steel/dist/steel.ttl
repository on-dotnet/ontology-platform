    skos:broader <https://w3id.org/ontology-platform/steel/code/process-type/HOTROLL> ;
    skos:definition "Hot rolling stock through passes that develop a specified bar section."@en,
        "把热坯逐道轧成规定棒材断面。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/process-type> ;
    skos:notation "BARROLL"^^stl:ProcessTypeCode ;
    skos:prefLabel "Hot bar rolling"@en,
        "棒材热轧"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/BFCHARGE> a skos:Concept ;
