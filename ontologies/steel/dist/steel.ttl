    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the packing form scheme."@en,
        "标识“交货包装形式”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Packing form code"@en,
        "交货包装形式代码"@zh .

stl:PackingList a owl:Class ;
    rdfs:label "Packing list"@en,
        "装箱清单"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1092-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A document listing package identifiers and their members at handover."@en,
        "在交接时列明各包装编号及所装成员的文件。"@zh ;
    skos:prefLabel "Packing list"@en,
        "装箱清单"@zh .

stl:Pellet a owl:Class ;
    rdfs:label "Iron ore pellet lot"@en,
        "球团矿批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-27692-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:IronOre ;
    skos:definition "A lot of hardened balls made from fine iron-bearing feed that retain their form for handling and furnace charging."@en,
        "细粒含铁料经造球并固结后按批交接的球状矿料，颗粒在装卸与入炉时能保持形状。"@zh ;
    skos:prefLabel "Iron ore pellet lot"@en,
        "球团矿批"@zh .

stl:Pelletizing a owl:Class ;
    rdfs:label "Iron ore pelletizing"@en,
        "铁矿球团生产"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that rolls fine iron-bearing feed into green balls and hardens them to retain their form during handling and charging."@en,
        "将含铁细料滚制成生球并固结，使颗粒在运输和入炉时保持球形的作业。"@zh ;
    skos:prefLabel "Iron ore pelletizing"@en,
        "铁矿球团生产"@zh .

stl:PersonnelRoleCode a rdfs:Datatype ;
    rdfs:label "Personnel role code"@en,
        "人员角色代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the personnel role scheme."@en,
        "标识“人员角色”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Personnel role code"@en,
        "人员角色代码"@zh .

stl:PicklingAndColdRolling a owl:Class ;
    rdfs:label "Pickling and cold rolling"@en,
        "酸轧"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:ColdRolling ;
    skos:altLabel "酸轧执行"@zh ;
    skos:definition "An operation that removes scale from strip by pickling, reduces the strip by cold rolling and delivers it in coils."@en,
        "带钢经酸洗去除氧化皮后实施冷轧减薄并形成出口卷的作业。"@zh ;
    skos:prefLabel "Pickling and cold rolling"@en,
        "酸轧"@zh .

stl:Piercing a owl:Class ;
    rdfs:label "Tube billet piercing"@en,
        "管坯穿孔"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:subClassOf stl:MaterialTransformation ;
    skos:definition "An operation that opens an axial bore through a solid tube billet and produces an individually traceable hollow shell."@en,
        "使实心管坯沿轴向形成贯通内孔、得到可单独跟踪的毛管的一次作业。"@zh ;
    skos:prefLabel "Tube billet piercing"@en,
        "管坯穿孔"@zh .

stl:PigIron a owl:Class ;
    rdfs:label "Solid pig iron lot"@en,
        "固态生铁批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-718-2024>,
        <https://w3id.org/ontology-platform/steel/std/ybt-5296-2011> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A lot of pig iron received or delivered after solidification, commonly in cast pieces for storage, transport and remelting."@en,
        "铁水凝固后按同一批号接收或交付的生铁，常以铸块形态储运和配入熔炼炉。"@zh ;
    skos:prefLabel "Solid pig iron lot"@en,
        "固态生铁批"@zh .

stl:PlainGradeEditionShape a sh:PropertyShape ;
    rdfs:comment "归入普钢产品族的牌号须关联一个确定的产品标准版次，以区分跨版次的同名牌号。"@zh ;
    sh:class stl:StandardEdition ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:definedIn ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:plainProductFamily .

stl:PlainProductFamilyCode a rdfs:Datatype ;
    rdfs:label "Commodity steel product family code"@en,
        "普钢产品族代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Datatype for the primary notations in the commodity steel product family scheme."@en,
        "用于标记普钢产品族方案内主记号的字面量类型。"@zh ;
    skos:prefLabel "Commodity steel product family code"@en,
        "普钢产品族代码"@zh .

stl:PlainProductFamilySchemeShape a sh:PropertyShape ;
    rdfs:comment "牌号引用的订货产品族须属于普钢产品族方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/plain-product-family> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:plainProductFamily .

stl:Plate a owl:Class ;
    rdfs:label "Steel plate"@en,
        "中厚钢板"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:altLabel "中厚板"@zh ;
    skos:definition "A discrete flat steel piece classed as plate in its product standard, which sets the applicable thickness boundary with sheet."@en,
        "按适用产品标准归为中厚板、以单张平直实物跟踪的扁平钢材，板厚分类界限随所引标准确定。"@zh ;
    skos:prefLabel "Steel plate"@en,
        "中厚钢板"@zh .

stl:PretreatmentMethodCode a rdfs:Datatype ;
    rdfs:label "Hot metal pretreatment method code"@en,
        "铁水预处理方法代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking-codes> ;
    skos:definition "The literal datatype of primary notations in the hot metal pretreatment method scheme."@en,
        "铁水预处理方法代码表中主记号所用的字面量类型。"@zh ;
    skos:prefLabel "Hot metal pretreatment method code"@en,
        "铁水预处理方法代码"@zh .

stl:PretreatmentMethodSchemeShape a sh:PropertyShape ;
    rdfs:comment "铁水预处理作业引用的方法应属于铁水预处理方法代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/pretreatment-method> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:pretreatmentMethod .

stl:ProcessRoute a owl:Class ;
    rdfs:label "Process route"@en,
        "工艺路线"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-2-2026> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A route identifying the ordered operations and permitted branches for making a product."@en,
        "规定某种物料从投入到制成所经工序段、顺序和可选分支的可复用路线。"@zh ;
    skos:prefLabel "Process route"@en,
        "工艺路线"@zh .

stl:ProcessTypeCode a rdfs:Datatype ;
    rdfs:label "Process type code"@en,
        "工序类型代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the process type scheme."@en,
        "标识“工序类型”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Process type code"@en,
        "工序类型代码"@zh .

stl:ProductFormCode a rdfs:Datatype ;
    rdfs:label "Product form code"@en,
        "产品形态代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the product form scheme."@en,
        "标识“产品形态”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Product form code"@en,
        "产品形态代码"@zh .

stl:ProductionCampaign a owl:Class ;
    rdfs:label "Production campaign"@en,
        "生产工作期"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A record grouping successive operations under a common lining, tool set or production arrangement."@en,
        "用同一炉衬、工具组或生产安排归集连续作业的一段生产履历。"@zh ;
    skos:prefLabel "Production campaign"@en,
        "生产工作期"@zh .

stl:ProductionInterruption a owl:Class ;
    rdfs:label "Production interruption"@en,
        "生产中断事件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:Event ;
    skos:definition "A timed interruption affecting a specific execution already in progress."@en,
        "实际生产中有起止时刻、影响已开始作业的一次中断。"@zh ;
    skos:prefLabel "Production interruption"@en,
        "生产中断事件"@zh .

stl:ProtectiveAtmosphereElectroslagRemelting a owl:Class ;
    rdfs:label "Protective atmosphere electroslag remelting"@en,
        "保护气氛电渣重熔"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特冶电渣重熔记录须能区分带保护气氛的工艺变体。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/process-type/PESR> ;
    rdfs:subClassOf stl:ElectroslagRemelting ;
    skos:altLabel "PESR"@en ;
    skos:definition "An electroslag remelting pass using a controlled protective atmosphere to isolate the remelting zone from ambient air."@en,
        "在受控保护气氛下进行的电渣重熔作业，保护气体隔离周围空气与重熔区。"@zh ;
    skos:prefLabel "Protective atmosphere electroslag remelting"@en,
        "保护气氛电渣重熔"@zh .

stl:RatingComparisonCode a rdfs:Datatype ;
    rdfs:label "Rating comparison operator code"@en,
        "评级比较关系代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the rating comparison operator scheme."@en,
        "标识“评级比较关系”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Rating comparison operator code"@en,
        "评级比较关系代码"@zh .

stl:RebarDiameterShape a sh:PropertyShape ;
    rdfs:comment "钢筋公称直径一经给出，应是一个大于零的十进制毫米数。"@zh ;
    sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:minExclusive 0.0 ;
    sh:path stl:rebarNominalDiameter ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Rebar .

stl:RebarLotBasisCode a rdfs:Datatype ;
    rdfs:label "Rebar lot assessment basis code"@en,
        "钢筋交验批判定基准代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/quality-codes> ;
    skos:definition "Datatype for the primary notations in the rebar lot assessment basis scheme."@en,
        "用于标记钢筋交验批判定基准方案内主记号的字面量类型。"@zh ;
    skos:prefLabel "Rebar lot assessment basis code"@en,
        "钢筋交验批判定基准代码"@zh .

stl:RebarLotBasisSchemeShape a sh:PropertyShape ;
    rdfs:comment "钢筋交验批判定引用的基准须属于钢筋交验批判定基准方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/rebar-lot-basis> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:rebarLotAssessmentBasis .

stl:RebarLotDecisionTargetShape a sh:PropertyShape ;
    rdfs:comment "采用钢筋按批判定基准时，每个被判定对象都须是检验批。"@zh ;
    sh:class stl:InspectionLot ;
    sh:minCount 1 ;
    sh:path stl:assessedObject ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:rebarLotAssessmentBasis .

stl:RebarSurfaceCode a rdfs:Datatype ;
    rdfs:label "Rebar surface pattern code"@en,
        "钢筋表面形状代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gb-1499-1-2024>,
        <https://w3id.org/ontology-platform/steel/std/gb-1499-2-2024> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Datatype for the primary notations in the rebar surface pattern scheme."@en,
        "用于标记钢筋表面形状方案内主记号的字面量类型。"@zh ;
    skos:prefLabel "Rebar surface pattern code"@en,
        "钢筋表面形状代码"@zh .

stl:RebarSurfaceSchemeShape a sh:PropertyShape ;
    rdfs:comment "钢筋表面形状须引用钢筋表面形状方案中的代码。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/rebar-surface> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:rebarSurface .

stl:RebarSurfaceShape a sh:PropertyShape ;
    rdfs:comment "每支钢筋须有一个表面形状代码，以便区分光圆和带肋产品。"@zh ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:rebarSurface ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Rebar .

stl:RecoiledCoil a owl:Class ;
    rdfs:label "Recoiled coil"@en,
        "重卷卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:ColdRolledCoil ;
    skos:definition "A coil assigned its own piece identity after strip from existing coils is unwound and wound again."@en,
        "将原卷带钢展开后再次卷取，并在重卷出口取得独立件号的钢卷。"@zh ;
    skos:prefLabel "Recoiled coil"@en,
        "重卷卷"@zh .

stl:Recoiling a owl:Class ;
    rdfs:label "Recoiling"@en,
        "重卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:Operation ;
    skos:altLabel "重卷执行"@zh ;
    skos:definition "An operation that unwinds strip from an existing coil and winds it again into an output coil."@en,
        "将已有的带钢卷展开，再按出口卷取条件卷起以形成产出卷的作业。"@zh ;
    skos:prefLabel "Recoiling"@en,
        "重卷"@zh .

stl:RecoveredLot a owl:Class ;
    rdfs:label "Recovered lot"@en,
        "回收料批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A reusable lot recovered from an identifiable production or sorting operation."@en,
        "从已知制造或分选作业返回、可重新投用的独立物料批。"@zh ;
    skos:prefLabel "Recovered lot"@en,
        "回收料批"@zh .

stl:ReferenceBlock a owl:Class ;
    rdfs:label "Reference block"@en,
        "对比试块"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-4162-2022> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:definition "An identifiable block with known features used to establish or check examination sensitivity."@en,
        "带有已知反射体或特征、用于核对检测灵敏度的实物件。"@zh ;
    skos:prefLabel "Reference block"@en,
        "对比试块"@zh .

stl:RefiningMethodCode a rdfs:Datatype ;
    rdfs:label "Secondary refining method code"@en,
        "炉外精炼方法代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking-codes> ;
    skos:definition "Datatype of primary notations in the secondary refining method scheme."@en,
        "标识炉外精炼方法方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Secondary refining method code"@en,
        "炉外精炼方法代码"@zh .

stl:RemeltElectrodeLineageShape a sh:NodeShape ;
    rdfs:comment "每件产出锭的直接来源电极都须登记为本炉投入，每件投入电极也须出现在本炉至少一件产出锭的直接来源中。"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "本炉投入的电极与本炉产出锭登记的直接来源电极不一致。"@zh ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        SELECT DISTINCT $this WHERE {
          $this stl:inputPiece ?input ; (stl:outputPiece|^stl:producedBy) ?ingot .
          ?input a/rdfs:subClassOf* stl:Electrode .
          ?ingot a/rdfs:subClassOf* stl:RemeltedIngot ; stl:derivedFrom ?source .
          ?source a/rdfs:subClassOf* stl:Electrode .
          FILTER (NOT EXISTS { $this stl:inputPiece ?source } ||
                  NOT EXISTS {
                    $this (stl:outputPiece|^stl:producedBy) ?output .
                    ?output a/rdfs:subClassOf* stl:RemeltedIngot ; stl:derivedFrom ?input .
                  })
        }
    """ ] ;
    sh:targetClass stl:Remelting .

stl:RemeltInputElectrodeShape a sh:PropertyShape ;
    rdfs:comment "每次重熔作业的投入件中须至少登记一件实际熔入的自耗电极。"@zh ;
    sh:path stl:inputPiece ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class stl:Electrode ] ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Remelting .

stl:RemeltNumberShape a sh:PropertyShape ;
    rdfs:comment "每次重熔作业须记录一个非空的重熔炉号。"@zh ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:minLength 1 ;
    sh:path stl:remeltNumber ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Remelting .

stl:RemeltOutputShape a sh:PropertyShape ;
    rdfs:comment "每次重熔至少产出一件重熔锭，产出关系可由作业或锭记录。"@zh ;
    sh:path [ sh:alternativePath ( stl:outputPiece [ sh:inversePath stl:producedBy ] ) ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class stl:RemeltedIngot ] ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Remelting .

stl:RemeltRecordOwnerShape a sh:NodeShape ;
    rdfs:comment "承载重熔炉号或重熔道次的记录必须是重熔作业。"@zh ;
    sh:class stl:Remelting ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:remeltNumber,
        stl:remeltSequence .

stl:RemeltSequenceShape a sh:PropertyShape ;
    rdfs:comment "每次作业须用一个正整数标明它是该冶炼链上的第几次重熔，首次为一。"@zh ;
    sh:datatype xsd:positiveInteger ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:remeltSequence ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Remelting .

stl:RemeltedIngotElectrodeShape a sh:PropertyShape ;
    rdfs:comment "每件重熔锭的直接来源中至少有一件实际熔入的自耗电极。"@zh ;
    sh:path stl:derivedFrom ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class stl:Electrode ] ;
    sh:severity sh:Violation ;
    sh:targetClass stl:RemeltedIngot .

stl:RemeltedIngotRouteShape a sh:PropertyShape ;
    rdfs:comment "每件重熔锭，以及沿直接来源链可追溯到重熔锭的每件实物件，都须注明一条含重熔组下的具体冶炼路线。"@zh ;
    sh:maxCount 1 ;
    sh:path stl:meltingRoute ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:property [ sh:hasValue <https://w3id.org/ontology-platform/steel/code/melting-route/REMELT> ;
                    sh:path [ sh:oneOrMorePath skos:broader ] ] ] ;
    sh:severity sh:Violation ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        SELECT DISTINCT ?this WHERE {
          ?this a/rdfs:subClassOf* stl:MaterialPiece .
          ?this stl:derivedFrom+/a/rdfs:subClassOf* stl:RemeltedIngot .
        }
    """ ] ;
    sh:targetClass stl:RemeltedIngot .

stl:RemeltingRouteTraceShape a sh:NodeShape ;
    rdfs:comment "含重熔路线的实物件应能追到重熔锭及该锭上游的电极，受查实物本身也可以是重熔锭。"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "该重熔路线缺少相连的重熔锭与电极。"@zh ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        SELECT $this WHERE {
          FILTER NOT EXISTS {
            $this stl:derivedFrom* ?ingot .
            ?ingot rdf:type/rdfs:subClassOf* stl:RemeltedIngot ;
                   stl:derivedFrom+ ?electrode .
            ?electrode rdf:type/rdfs:subClassOf* stl:Electrode .
          }
        }
    """ ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        PREFIX route: <https://w3id.org/ontology-platform/steel/code/melting-route/>
        SELECT DISTINCT ?this WHERE {
          ?this rdf:type/rdfs:subClassOf* stl:MaterialPiece ;
                stl:meltingRoute/skos:broader+ route:REMELT .
        }
    """ ] .

stl:RetainedHeelLot a owl:Class ;
    rdfs:label "Retained steel heel lot"@en,
        "留钢批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:subClassOf stl:LiquidSteel ;
    skos:definition "Molten steel deliberately retained in the furnace at tapping and accounted for as input to a later heat."@en,
        "出钢后有意留在炉内、作为后续炉次投入继续核算的一份钢水。"@zh ;
    skos:prefLabel "Retained steel heel lot"@en,
        "留钢批"@zh .

stl:Retest a owl:Class ;
    rdfs:label "Retest record"@en,
        "复验记录"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:InspectionActivityRecord ;
    skos:definition "A record linking additional testing authorized by a retest provision to the original outcome."@en,
        "按已引用的复验条款追加试验并保留与首次结果联系的记录。"@zh ;
    skos:prefLabel "Retest record"@en,
        "复验记录"@zh .

stl:RetestRule a owl:Class ;
    rdfs:label "Retest rule"@en,
        "复验规则"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:InspectionRequirement ;
    skos:definition "A condition specifying the additional sampling or testing allowed following a particular initial outcome."@en,
        "规定首次结果出现特定情形后可增加哪些试样或试验的要求。"@zh ;
    skos:prefLabel "Retest rule"@en,
        "复验规则"@zh .

stl:SalesOrder a owl:Class ;
    rdfs:label "Sales order"@en,
        "销售订单"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A commercial document grouping a customer's order items under one order identity."@en,
        "以同一个订货凭证标识汇集客户各项需求的业务记录。"@zh ;
    skos:prefLabel "Sales order"@en,
        "销售订单"@zh .

stl:SampleIncrement a owl:Class ;
    rdfs:label "Sample increment"@en,
        "份样"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10322-1-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:Sample ;
    skos:definition "A portion taken at one point or time in a lot that can contribute to a composite sample."@en,
        "从一批物料的一个部位或在一个时刻取出、可用于制备组合样的一份材料。"@zh ;
    skos:prefLabel "Sample increment"@en,
        "份样"@zh .

stl:SampleOrientationCode a rdfs:Datatype ;
    rdfs:label "Specimen orientation code"@en,
        "试样取向代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the specimen orientation scheme."@en,
        "标识“试样取向”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Specimen orientation code"@en,
        "试样取向代码"@zh .

stl:SamplePreparation a owl:Class ;
    rdfs:label "Sample preparation"@en,
        "制样作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-2975-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation preparing sampled material to the shape or condition required for an examination."@en,
        "把取得的样品加工到某项检验所需形状或状态的作业。"@zh ;
    skos:prefLabel "Sample preparation"@en,
        "制样作业"@zh .

stl:SampleTypeCode a rdfs:Datatype ;
    rdfs:label "sample type code"@en,
        "样品类型代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the sample type scheme."@en,
        "标识“样品类型”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "sample type code"@en,
        "样品类型代码"@zh .

stl:SamplingPlan a owl:Class ;
    rdfs:label "Sampling plan"@en,
        "取样计划"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-10322-1-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:Plan ;
    skos:definition "A plan identifying lots, locations and frequency for sampling before inspection starts."@en,
        "在取样前确定待取批次、取样部位和取样频次的计划。"@zh ;
    skos:prefLabel "Sampling plan"@en,
        "取样计划"@zh .

stl:Scrap a owl:Class ;
    rdfs:label "Steel scrap lot"@en,
        "废钢批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-4223-2017> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/material-category/SCRAP> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A lot of steel offcuts, recovered steel items or other steel scrap collected and charged for remelting."@en,
        "由加工余料、回收钢件等形成，以熔炼回用为目的而收集和投用的一批金属料。"@zh ;
    skos:prefLabel "Steel scrap lot"@en,
        "废钢批"@zh .

stl:ScrapBasketCharge a owl:Class ;
    rdfs:label "Scrap basket charge"@en,
        "单篮废钢装料"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:subClassOf stl:Charging ;
    skos:definition "A single discharge of a scrap basket into a steelmaking furnace, potentially delivering scrap from several source lots."@en,
        "将一个料篮中的废钢卸入炼钢炉的一次装料，同篮可包含多个来源批次。"@zh ;
    skos:prefLabel "Scrap basket charge"@en,
        "单篮废钢装料"@zh .

stl:SeamlessTubeStockShape a sh:PropertyShape ;
    rdfs:comment "沿无缝钢管的直接来源逐段回溯，应至少找到一件制管用实心管坯、圆坯或毛管。圆坯与毛管也可按产品形态代码识别。"@zh ;
    sh:path [ sh:oneOrMorePath stl:derivedFrom ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:or ( [ sh:class stl:TubeBillet ] [ sh:class stl:RoundBillet ] [ sh:class stl:HollowShell ] [ sh:property [ sh:path ( stl:productForm [ sh:zeroOrMorePath skos:broader ] ) ;
                                sh:qualifiedMinCount 1 ;
                                sh:qualifiedValueShape [ sh:in ( <https://w3id.org/ontology-platform/steel/code/product-form/ROUNDBIL> <https://w3id.org/ontology-platform/steel/code/product-form/SHELL> ) ] ] ] ) ] ;
    sh:severity sh:Violation ;
    sh:targetClass stl:SeamlessTube .

stl:Section a owl:Class ;
    rdfs:label "Steel section"@en,
        "型钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:definition "A long steel piece with a specified profile along its length, described by features such as flanges, a web or legs."@en,
        "沿长度保持规定截面轮廓的型材实物件，其截面由翼缘、腹板、肢边等相应部位的尺寸描述。"@zh ;
    skos:prefLabel "Steel section"@en,
        "型钢"@zh .

stl:ShapeRequirement a owl:Class ;
    rdfs:label "Shape requirement"@en,
        "外形要求"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-709-2019> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:Requirement ;
    skos:definition "A condition limiting deviations in product geometry such as straightness or flatness."@en,
        "限制直线度、平直度等几何形状偏离的验收条目。"@zh ;
    skos:prefLabel "Shape requirement"@en,
        "外形要求"@zh .

stl:ShareBasisCode a rdfs:Datatype ;
    rdfs:label "contribution share basis code"@en,
        "份额基准代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the contribution share basis scheme."@en,
        "标识“份额基准”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "contribution share basis code"@en,
        "份额基准代码"@zh .

stl:Shearing a owl:Class ;
    rdfs:label "Shearing"@en,
        "剪切"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/finishing> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that separates steel between moving blades, for example to cut lengths, slit strip or trim edges."@en,
        "利用相对运动的剪刃分开钢材的作业，可按长度切断、沿纵向分条或剪除边部。"@zh ;
    skos:prefLabel "Shearing"@en,
        "剪切"@zh .

stl:Sheet a owl:Class ;
    rdfs:label "Steel sheet"@en,
        "薄钢板"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:definition "A discrete flat steel piece classed as sheet in its product standard, rolled individually or cut to length from strip."@en,
        "按适用产品标准归为薄板、以平片逐张跟踪的扁平钢材，既可单张轧成也可由带钢横切取得。"@zh ;
    skos:prefLabel "Steel sheet"@en,
        "薄钢板"@zh .

stl:Sintering a owl:Class ;
    rdfs:label "Iron ore sintering"@en,
        "铁矿烧结"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that bonds iron-bearing fines by partial melting within a bed and breaks and screens the resulting cake for furnace use."@en,
        "在含铁细料组成的料层中利用局部熔融使颗粒黏结，再将烧结饼破碎筛分为炉料的作业。"@zh ;
    skos:prefLabel "Iron ore sintering"@en,
        "铁矿烧结"@zh .

stl:Site a owl:Class ;
    rdfs:label "Site"@en,
        "厂区"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-1-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:EquipmentHierarchyNode ;
    skos:definition "A manufacturing site within whose operating boundary areas are organized."@en,
        "承载一组生产区域并有独立运营边界的制造场所。"@zh ;
    skos:prefLabel "Site"@en,
        "厂区"@zh .

stl:SizingAndReducing a owl:Class ;
    rdfs:label "Tube sizing and reducing"@en,
        "钢管定径与减径"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that passes tubular stock through roll grooves to size the outside diameter or reduce it to a target size."@en,
        "使管料通过轧辊孔型，校准其外径或将其减小到目标尺寸的一次作业。"@zh ;
    skos:prefLabel "Tube sizing and reducing"@en,
        "钢管定径与减径"@zh .

stl:SpecialGradeEditionShape a sh:PropertyShape ;
    rdfs:comment "归入特钢产品族的牌号须指向一个确定的标准版次，便于区分跨版次的同名牌号。"@zh ;
    sh:class stl:StandardEdition ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:definedIn ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:specialProductFamily .

stl:SpecialPieceHeatTraceShape a sh:NodeShape ;
    rdfs:comment "内部钢种标为特殊质量的每一实物件，均应沿直接来源回到记录了一次炉次的实物，起件本身也可直接注明炉次。"@zh ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:message "特钢实物件缺少可到达的一次冶炼炉次。"@zh ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        SELECT $this WHERE {
          FILTER NOT EXISTS {
            $this stl:derivedFrom*/stl:sourceHeat ?heat .
            ?heat rdf:type/rdfs:subClassOf* stl:Heat .
          }
        }
    """ ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """
        PREFIX stl: <https://w3id.org/ontology-platform/steel/>
        PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX quality: <https://w3id.org/ontology-platform/steel/code/steel-class-quality/>
        SELECT DISTINCT ?this WHERE {
          ?this rdf:type/rdfs:subClassOf* stl:MaterialPiece ;
                stl:steelGrade/stl:steelQualityClass quality:SPECIAL .
        }
    """ ] .

stl:SpecialProductFamilyCode a rdfs:Datatype ;
    rdfs:label "Special steel product family code"@en,
        "特钢产品族代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/products-codes> ;
    skos:definition "The datatype of primary notations in the special steel product family scheme."@en,
        "标记特钢产品族方案内代码主记号的字面量类型。"@zh ;
    skos:prefLabel "Special steel product family code"@en,
        "特钢产品族代码"@zh .

stl:SpecialProductFamilySchemeShape a sh:PropertyShape ;
    rdfs:comment "作为特钢产品族取值的代码须属于特钢产品族方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/special-product-family> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:specialProductFamily .

stl:SpecificationRevision a owl:Class ;
    rdfs:label "Specification revision"@en,
        "规格修订记录"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A record identifying which specification provisions a revision supersedes and when it takes effect."@en,
        "记载哪些规格条款从何时以新版替换旧版的一次修订。"@zh ;
    skos:prefLabel "Specification revision"@en,
        "规格修订记录"@zh .

stl:SteelClassCompositionCode a rdfs:Datatype ;
    rdfs:label "Steel composition class code"@en,
        "钢的化学成分类别代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the steel composition class scheme."@en,
        "标识“钢的化学成分类别”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Steel composition class code"@en,
        "钢的化学成分类别代码"@zh .

stl:SteelClassQualityCode a rdfs:Datatype ;
    rdfs:label "Steel quality class code"@en,
        "钢的质量等级类别代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the steel quality class scheme."@en,
        "标识“钢的质量等级类别”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Steel quality class code"@en,
        "钢的质量等级类别代码"@zh .

stl:SteelClassUseCode a rdfs:Datatype ;
    rdfs:label "Steel end-use class code"@en,
        "钢的主要用途类别代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the steel end-use class scheme."@en,
        "标识“钢的主要用途类别”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Steel end-use class code"@en,
        "钢的主要用途类别代码"@zh .

stl:SteelmakingChargeLotShape a sh:PropertyShape ;
    rdfs:comment "一项装料明细应对应一个取料批次，以便分别核算同次装料中各批的用量。"@zh ;
    sh:class stl:MaterialLot ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:allocatedLot ;
    sh:severity sh:Violation ;
    sh:targetClass stl:ChargeComponent .

stl:SteelmakingChargeOperationShape a sh:PropertyShape ;
    rdfs:comment "一项装料明细应归到一次实际作业，同批分次投入可分别登记明细。"@zh ;
    sh:class stl:Operation ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path stl:allocationOperation ;
    sh:severity sh:Violation ;
    sh:targetClass stl:ChargeComponent .

stl:SteelmakingHeatOriginShape a sh:PropertyShape ;
    rdfs:comment "炉次至少应能追溯到一次生成它的炼钢作业，可同时记录其他生成活动。"@zh ;
    sh:path prov:wasGeneratedBy ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class stl:Steelmaking ] ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Heat .

stl:SteelmakingRefiningHeatShape a sh:PropertyShape ;
    rdfs:comment "精炼实绩应标明实际处理的炉次，供按炉次还原精炼路线。"@zh ;
    sh:class stl:Heat ;
    sh:minCount 1 ;
    sh:path stl:processedHeat ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Refining .

stl:SteelmakingRefiningMethodSchemeShape a sh:PropertyShape ;
    rdfs:comment "精炼方法所引用的每个代码都应属于炉外精炼方法方案。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/refining-method> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:refiningMethod .

stl:SteelmakingRefiningMethodShape a sh:PropertyShape ;
    rdfs:comment "一次精炼实绩至少应记录一种实际采用的精炼方法。"@zh ;
    sh:minCount 1 ;
    sh:path stl:refiningMethod ;
    sh:severity sh:Violation ;
    sh:targetClass stl:Refining .

stl:SteelmakingSlag a owl:Class ;
    rdfs:label "Steelmaking slag lot"@en,
        "炼钢渣批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/material-category/SLAG> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "Slag formed in primary or secondary steelmaking and tracked as a lot through removal, collection or disposal."@en,
        "在炼钢或炉外精炼中形成的渣相物料，按出渣、收集或处置边界作为一批跟踪。"@zh ;
    skos:prefLabel "Steelmaking slag lot"@en,
        "炼钢渣批"@zh .

stl:StockIssue a owl:Class ;
    rdfs:label "Stock issue"@en,
        "出库交接事件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1091-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:Event ;
    skos:definition "An event documenting physical handover of stock out of warehouse custody."@en,
        "以实际交接为准确认库存物料离开仓库保管的事件。"@zh ;
    skos:prefLabel "Stock issue"@en,
        "出库交接事件"@zh .

stl:StockReceipt a owl:Class ;
    rdfs:label "Stock receipt"@en,
        "入库接收事件"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/wbt-1091-2018> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:Event ;
    skos:definition "An event marking confirmed receipt of a lot or piece into warehouse custody."@en,
        "以交接确认的时刻登记一批或一件物料被仓库接收的事件。"@zh ;
    skos:prefLabel "Stock receipt"@en,
        "入库接收事件"@zh .

stl:StockReservation a owl:Class ;
    rdfs:label "Stock reservation"@en,
        "库存预留"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A time-bounded allocation of available stock to an identified demand."@en,
        "为指定需求锁定一定可用库存及有效期的记录。"@zh ;
    skos:prefLabel "Stock reservation"@en,
        "库存预留"@zh .

stl:Stocktake a owl:Class ;
    rdfs:label "Stocktake"@en,
        "盘点作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-4878-2020> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation checking physical stock within a defined scope at a specified cut-off."@en,
        "在一个盘点范围和截止时点核实实际库存的作业。"@zh ;
    skos:prefLabel "Stocktake"@en,
        "盘点作业"@zh .

stl:StorageArea a owl:Class ;
    rdfs:label "Storage area"@en,
        "库区"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/ybt-4878-2020> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:subClassOf stl:Location ;
    skos:definition "A zone within a warehouse or yard that groups storage positions and the equipment assigned to serve them."@en,
        "仓库或堆场内用于组织库位和分派搬运设备的区域。"@zh ;
    skos:prefLabel "Storage area"@en,
        "库区"@zh .

stl:Straightening a owl:Class ;
    rdfs:label "Straightening"@en,
        "矫直"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/finishing> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that corrects bend, twist or lack of flatness in a steel product by applying deformation."@en,
        "对弯曲、扭转或不平的钢材施加校正变形，使其更接近规定几何形状的作业。"@zh ;
    skos:prefLabel "Straightening"@en,
        "矫直"@zh .

stl:SurfaceConditionCode a rdfs:Datatype ;
    rdfs:label "Surface condition code"@en,
        "表面状态代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the surface condition scheme."@en,
        "标识“表面状态”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Surface condition code"@en,
        "表面状态代码"@zh .

stl:SurfaceInspection a owl:Class ;
    rdfs:label "Surface inspection"@en,
        "表面检验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:InspectionActivityRecord ;
    skos:definition "An examination of a defined surface area recording the position and appearance of imperfections."@en,
        "在有界表面区域内检查外观、记录缺陷位置与形态的检验。"@zh ;
    skos:prefLabel "Surface inspection"@en,
        "表面检验"@zh .

stl:TapBlastFurnaceShape a sh:PropertyShape ;
    rdfs:comment "每个铁次应能沿执行设备及其类型找到高炉，以便追溯铁水来源。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/equipment-type/BF> ;
    sh:path ( stl:performedOn stl:equipmentType ) ;
    sh:severity sh:Violation ;
    sh:targetClass stl:BlastFurnaceTapping .

stl:TappedHotMetalMassShape a sh:PropertyShape ;
    rdfs:comment "记录出铁量时，按吨填写本铁次的非负十进制质量。"@zh ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:path stl:tappedHotMetalMass ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:tappedHotMetalMass .

stl:TechnicalAgreement a owl:Class ;
    rdfs:label "Order technical agreement"@en,
        "订货技术协议"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A versioned agreement supplementing product-standard requirements for specified orders."@en,
        "对指定订单补充产品标准要求并保留版本的双方约定。"@zh ;
    skos:prefLabel "Order technical agreement"@en,
        "订货技术协议"@zh .

stl:TeemingMethodCode a rdfs:Datatype ;
    rdfs:label "Ingot teeming method code"@en,
        "模铸浇注方式代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting-codes> ;
    skos:definition "Datatype of the primary notations used for ingot teeming methods."@en,
        "模铸浇注方式方案中各项主记号的字面量类型。"@zh ;
    skos:prefLabel "Ingot teeming method code"@en,
        "模铸浇注方式代码"@zh .

stl:TeemingMethodSchemeShape a sh:PropertyShape ;
    rdfs:comment "模铸的浇注方式应引用模铸浇注方式方案中的代码。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/teeming-method> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:teemingMethod .

stl:TensileTest a owl:Class ;
    rdfs:label "Tensile test"@en,
        "拉伸试验"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-228-1-2021> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:subClassOf stl:MechanicalTest ;
    skos:definition "A test applying axial tension to a specimen of known initial section and gauge length to obtain strength or elongation."@en,
        "对有原始截面和标距的试样施加轴向拉力并记录强度或伸长的试验。"@zh ;
    skos:prefLabel "Tensile test"@en,
        "拉伸试验"@zh .

stl:TestTypeCode a rdfs:Datatype ;
    rdfs:label "Test type code"@en,
        "试验类型代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the test type scheme."@en,
        "标识“试验类型”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Test type code"@en,
        "试验类型代码"@zh .

stl:TransportModeCode a rdfs:Datatype ;
    rdfs:label "Shipment transport mode code"@en,
        "发运运输方式代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "Datatype of primary notations in the shipment transport mode scheme."@en,
        "标识“发运运输方式”方案中主记号的字面量类型。"@zh ;
    skos:prefLabel "Shipment transport mode code"@en,
        "发运运输方式代码"@zh .

stl:TubeDimensionValueShape a sh:PropertyShape ;
    rdfs:comment "已记录的管外径和管壁厚度均应为大于零的十进制数，单位为毫米。"@zh ;
    sh:datatype xsd:decimal ;
    sh:minExclusive 0.0 ;
    sh:path [ sh:alternativePath ( stl:tubeOutsideDiameter stl:tubeWallThickness ) ] ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf stl:tubeOutsideDiameter,
        stl:tubeWallThickness .

stl:TubeRolling a owl:Class ;
    rdfs:label "Tube rolling"@en,
        "轧管"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that elongates hollow stock between rolls and changes its wall thickness and section dimensions."@en,
        "用轧辊使已有内孔的管料延伸，并改变其壁厚和截面尺寸的一次作业。"@zh ;
    skos:prefLabel "Tube rolling"@en,
        "轧管"@zh .

stl:TubeWeldingMethodShape a sh:PropertyShape ;
    rdfs:comment "每次管体焊接作业至少应记录一种实际用于接合管边的焊接方法。"@zh ;
    sh:minCount 1 ;
    sh:path stl:weldMethod ;
    sh:severity sh:Violation ;
    sh:targetClass stl:TubeWelding .

stl:VacuumArcRemelting a owl:Class ;
    rdfs:label "Vacuum arc remelting"@en,
        "真空自耗电弧重熔"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特冶路线按道次追踪真空自耗作业，同一条路线可在电渣重熔后继续真空自耗重熔。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/process-type/VAR> ;
    rdfs:subClassOf stl:Remelting ;
    skos:altLabel "VAR"@en,
        "真空自耗重熔"@zh ;
    skos:definition "A remelting pass in which an arc melts a consumable electrode under vacuum and metal entering the pool solidifies in a mould as a new ingot."@en,
        "在真空下以电弧熔化自耗电极，使落入熔池的金属在结晶器内凝固成新锭的作业。"@zh ;
    skos:prefLabel "Vacuum arc remelting"@en,
        "真空自耗电弧重熔"@zh .

stl:VacuumInductionMelting a owl:Class ;
    rdfs:label "Vacuum induction melting"@en,
        "真空感应熔炼"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:comment "下沉理由：特冶路线需区分生成一次炉次的真空感应熔炼和随后按道次记录的自耗重熔。"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/special/remelting> ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/process-type/VIM> ;
    rdfs:subClassOf stl:Steelmaking ;
    skos:altLabel "VIM"@en ;
    skos:definition "A primary steelmaking operation in which induction heating melts the charge in a vacuum furnace and its composition is adjusted."@en,
        "在真空感应炉中用感应加热熔化炉料并调成所需成分的一次冶炼作业。"@zh ;
    skos:prefLabel "Vacuum induction melting"@en,
        "真空感应熔炼"@zh .

stl:Weighing a owl:Class ;
    rdfs:label "Weighing"@en,
        "称量作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that obtains a scale reading for a specified lot or piece."@en,
        "在指定衡器上对一个批或一件实物完成称量并留下读数的作业。"@zh ;
    skos:prefLabel "Weighing"@en,
        "称量作业"@zh .

stl:WeldMethodCode a rdfs:Datatype ;
    rdfs:label "Tube seam welding method code"@en,
        "管体焊接方法代码"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking-codes> ;
    skos:definition "Datatype of the primary notations identifying tube seam welding methods."@en,
        "管体焊接方法方案中主记号所用的字面量类型。"@zh ;
    skos:prefLabel "Tube seam welding method code"@en,
        "管体焊接方法代码"@zh .

stl:WeldMethodSchemeShape a sh:PropertyShape ;
    rdfs:comment "管体焊接作业的每个方法取值都应属于管体焊接方法代码表。"@zh ;
    sh:hasValue <https://w3id.org/ontology-platform/steel/code/weld-method> ;
    sh:path skos:inScheme ;
    sh:severity sh:Violation ;
    sh:targetObjectsOf stl:weldMethod .

stl:WeldedPipe a owl:Class ;
    rdfs:label "Welded steel pipe"@en,
        "焊接钢管"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:subClassOf stl:SteelTube ;
    skos:altLabel "welded steel tube"@en,
        "焊管"@zh ;
    skos:definition "A steel tube made by forming plate or strip and welding its edges together, leaving a manufacturing seam in the wall."@en,
        "由钢板或钢带成形并焊合边缘制得的钢管，其管壁含有闭合管体的制造焊缝。"@zh ;
    skos:prefLabel "Welded steel pipe"@en,
        "焊接钢管"@zh .

stl:WireRod a owl:Class ;
    rdfs:label "Wire rod"@en,
        "线材"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:altLabel "盘条"@zh ;
    skos:definition "A hot-rolled long product of small solid section collected in successive loops, often as stock for wire drawing."@en,
        "以较小的实心断面热轧成长度连续的长材并成圈收集，常作为拉丝等后续加工的原料。"@zh ;
    skos:prefLabel "Wire rod"@en,
        "线材"@zh .

stl:WorkCenter a owl:Class ;
    rdfs:label "Work center"@en,
        "工作中心"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-1-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:EquipmentHierarchyNode ;
    skos:definition "A resource grouping within an area to which work is scheduled and within which units are assigned."@en,
        "生产区域内承接计划并调配工作单元的一组资源。"@zh ;
    skos:prefLabel "Work center"@en,
        "工作中心"@zh .

stl:accompaniedBy a owl:ObjectProperty ;
    rdfs:label "Accompanied by certificate"@en,
        "随货质量证明书"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-247-2025> ;
    rdfs:domain stl:Shipment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range stl:MillCertificate ;
    skos:definition "Identifies a mill certificate accompanying the consignment."@en,
        "指出随本次发运一同交付的质量证明书。"@zh ;
    skos:prefLabel "Accompanied by certificate"@en,
        "随货质量证明书"@zh .

stl:activeOxygen a owl:DatatypeProperty ;
    rdfs:label "Active oxygen in liquid steel"@en,
        "钢水活性氧"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Observation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the in-process active oxygen reading in liquid steel expressed in parts per million by mass."@en,
        "记录在线测氧在钢水中取得并以质量百万分数表达的活性氧读数。"@zh ;
    skos:prefLabel "Active oxygen in liquid steel"@en,
        "钢水活性氧"@zh ;
    stl:quantityKind quantitykind:MassFraction ;
    stl:unit unit:PPM .

stl:actualLength a owl:DatatypeProperty ;
    rdfs:label "Actual length"@en,
        "实测长度"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-709-2019> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range xsd:decimal ;
    skos:definition "The measured longitudinal extent of material in metres, recorded against the piece or the associated operation."@en,
        "沿材料纵向实际量得的长度，以米计，可记在实物或对应的作业实绩上。"@zh ;
    skos:prefLabel "Actual length"@en,
        "实测长度"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:M .

stl:allocatedTo a owl:ObjectProperty ;
    rdfs:label "Allocated to"@en,
        "分配订单行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:MaterialPiece ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:SalesOrderLine ;
    skos:definition "Identifies the sales order item to which a piece is allocated."@en,
        "指明当前实物分配所服务的销售订单行。"@zh ;
    skos:prefLabel "Allocated to"@en,
        "分配订单行"@zh .

stl:applicableOrderLine a owl:ObjectProperty ;
    rdfs:label "Applicable order line"@en,
        "适用订单行"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:SalesOrderLine ;
    skos:definition "Identifies an order item covered by the authorization to accept or use the material."@en,
        "限定获准按本处置接收或使用材料的订单行。"@zh ;
    skos:prefLabel "Applicable order line"@en,
        "适用订单行"@zh .

stl:applicableQuantity a owl:DatatypeProperty ;
    rdfs:label "Authorised piece count"@en,
        "适用件数"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Counts the pieces covered by the conditional acceptance authorization."@en,
        "给出在所述限制条件内获准接收的实物件数。"@zh ;
    skos:prefLabel "Authorised piece count"@en,
        "适用件数"@zh ;
    stl:quantityKind quantitykind:Count ;
    stl:unit unit:NUM .

stl:applicableStandard a owl:ObjectProperty ;
    rdfs:label "Applicable standard edition"@en,
        "适用标准版次"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-17505-2016> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:range stl:StandardEdition ;
    skos:definition "Identifies the exact standard edition governing a specification, decision or delivery."@en,
        "指明订货、判定或交付采用的标准及其确切版次。"@zh ;
    skos:prefLabel "Applicable standard edition"@en,
        "适用标准版次"@zh .

stl:approvedByRole a owl:DatatypeProperty ;
    rdfs:label "Approving role"@en,
        "批准角色"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:QualityDisposition ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:string ;
    skos:definition "Names the business role that approved the disposition."@en,
        "记录对该次处置作出批准的业务角色名称。"@zh ;
    skos:prefLabel "Approving role"@en,
        "批准角色"@zh .

stl:assignedRatingLevel a owl:ObjectProperty ;
    rdfs:label "Assigned rating level"@en,
        "实评级别"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:RatingResult ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range stl:ReferenceRatingLevel ;
    skos:definition "Identifies the reference level actually assigned to the evaluated subject in this examination."@en,
        "指出该评价对象在本次检验中实际取得的一个标尺级别。"@zh ;
    skos:prefLabel "Assigned rating level"@en,
        "实评级别"@zh .

stl:assignedUnit a owl:ObjectProperty ;
    rdfs:label "Assigned work unit"@en,
        "派工工作单元"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-3-2016> ;
    rdfs:domain stl:WorkAssignment ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range stl:WorkUnit ;
    skos:definition "Identifies the work unit allocated to a dispatched step."@en,
        "标识派工时为待执行步骤分配的工作单元。"@zh ;
    skos:prefLabel "Assigned work unit"@en,
        "派工工作单元"@zh .

stl:bookMass a owl:DatatypeProperty ;
    rdfs:label "Book stock mass"@en,
        "账面质量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:StocktakeLine ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/logistics> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives the mass recorded in inventory at the same stocktake cut-off."@en,
        "记录同一盘点截止时点库存账载的质量。"@zh ;
    skos:prefLabel "Book stock mass"@en,
        "账面质量"@zh ;
    stl:quantityKind quantitykind:Mass ;
    stl:unit unit:TONNE .

stl:carryoverSlagMass a owl:DatatypeProperty ;
    rdfs:label "Slag carryover mass"@en,
        "出钢下渣量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Tapping ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:range xsd:decimal ;
    skos:definition "Mass of furnace slag carried into the receiving ladle or ladles with the steel during a tap, in tonnes."@en,
        "出钢期间随钢流进入接收钢包的炉渣质量，以吨计。"@zh ;
    skos:prefLabel "Slag carryover mass"@en,
        "出钢下渣量"@zh ;
    stl:quantityKind quantitykind:Mass ;
    stl:unit unit:TONNE .

stl:chargePosition a owl:DatatypeProperty ;
    rdfs:label "Charge addition position"@en,
        "装料次序"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:ChargeComponent ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/steelmaking> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "The position of the recorded addition in the charging order of its operation. Lots added together can share a position."@en,
        "标明该明细所记炉料在所属作业中实际投入的先后位置，同一轮投入的料批可取相同次序。"@zh ;
    skos:prefLabel "Charge addition position"@en,
        "装料次序"@zh .

stl:coalDryAshContent a owl:DatatypeProperty ;
    rdfs:label "Dry-basis ash content of coal"@en,
        "煤的干基灰分"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-212-2008> ;
    rdfs:domain stl:Coal ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:range xsd:decimal ;
    skos:definition "The mass of residue after ashing as a percentage of the dry coal sample mass, reported for the lot on a dry basis."@en,
        "煤样灰化后的残留物质量占干煤样质量的百分数，作为该煤批的干基分析值报告。"@zh ;
    skos:prefLabel "Dry-basis ash content of coal"@en,
        "煤的干基灰分"@zh ;
    stl:quantityKind quantitykind:MassFraction ;
    stl:unit unit:PERCENT .

stl:coatingMass a owl:DatatypeProperty ;
    rdfs:label "Coating mass per area"@en,
        "单位面积镀层质量"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-1839-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range xsd:decimal ;
    skos:definition "Gives coating mass normalized to the corresponding examined surface area."@en,
        "给出受检表面上的镀层质量按对应面积归一化的值。"@zh ;
    skos:prefLabel "Coating mass per area"@en,
        "单位面积镀层质量"@zh ;
    stl:quantityKind quantitykind:MassPerArea ;
    stl:unit unit:GM-PER-M2 .

<https://w3id.org/ontology-platform/steel/code/analysis-type/HEAT> a skos:Concept ;
    rdfs:label "heat analysis"@en,
        "熔炼分析"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "The single analysis designated to represent the heat against the specified heat-analysis chemistry."@en,
        "在一个炉次上指定一次代表整炉的成分分析，用于按熔炼成分规定判定。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/analysis-type> ;
    skos:notation "HEAT"^^stl:AnalysisTypeCode ;
    skos:prefLabel "heat analysis"@en,
        "熔炼分析"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/analysis-type> .

<https://w3id.org/ontology-platform/steel/code/analysis-type/PROCESS> a skos:Concept ;
    rdfs:label "process analysis"@en,
        "过程分析"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "An analysis used to guide operating adjustments at the sampled stage."@en,
        "为判断当前冶炼进度和调整作业而进行的成分分析。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/analysis-type> ;
    skos:notation "PROCESS"^^stl:AnalysisTypeCode ;
    skos:prefLabel "process analysis"@en,
        "过程分析"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/analysis-type> .

<https://w3id.org/ontology-platform/steel/code/analysis-type/PRODUCT> a skos:Concept ;
    rdfs:label "product analysis"@en,
        "成品分析"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-222-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:definition "An analysis performed on finished product against the applicable product-analysis allowances."@en,
        "从成品取样并按成品分析口径核对交付材料成分的分析。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/analysis-type> ;
    skos:notation "PRODUCT"^^stl:AnalysisTypeCode ;
    skos:prefLabel "product analysis"@en,
        "成品分析"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/analysis-type> .

<https://w3id.org/ontology-platform/steel/code/bundle-mass-basis/ACTUAL> a skos:Concept ;
    rdfs:label "Actual mass"@en,
        "实际计重"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Settles on the weighed mass of the bundle after deducting packaging tare."@en,
        "按称量取得的整捆质量扣除包装皮重后结算。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/bundle-mass-basis> ;
    skos:notation "ACTUAL"^^stl:BundleMassBasisCode ;
    skos:prefLabel "Actual mass"@en,
        "实际计重"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/bundle-mass-basis> .

<https://w3id.org/ontology-platform/steel/code/bundle-mass-basis/THEORY> a skos:Concept ;
    rdfs:label "Theoretical mass"@en,
        "理论计重"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Determines delivered mass from nominal mass per unit length, cut length and piece count."@en,
        "按公称单位长度质量、单支定尺及实交支数计算整捆交货重量。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/bundle-mass-basis> ;
    skos:notation "THEORY"^^stl:BundleMassBasisCode ;
    skos:prefLabel "Theoretical mass"@en,
        "理论计重"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/bundle-mass-basis> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/AL> a skos:Concept ;
