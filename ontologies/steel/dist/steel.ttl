    skos:notation "ANNEAL"^^stl:ProcessTypeCode ;
    skos:prefLabel "Annealing"@en,
        "退火"@zh .

<https://w3id.org/ontology-platform/steel/code/process-type/BARROLL> a skos:Concept ;
