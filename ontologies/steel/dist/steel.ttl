    skos:inScheme <https://w3id.org/ontology-platform/steel/code/chemical-element> ;
    skos:notation "ZR"^^stl:ChemicalElementCode ;
    skos:prefLabel "Zirconium"@en,
        "锆"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/coating-type/EG> a skos:Concept ;
    rdfs:label "Electrodeposited zinc coating"@en,
        "电镀锌层"@zh ;
