    dcterms:identifier "GB/T 228.1-2021" ;
    dcterms:issued "2021"^^xsd:gYear ;
    dcterms:title "Metallic materials—Tensile testing—Part 1: Method of test at room temperature"@en,
        "金属材料 拉伸试验 第1部分:室温试验方法"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
    rdfs:seeAlso <https://std.samr.gov.cn/gb/search/gbDetailedCNF?id=D4BEFFF4EB12B241E05397BE0A0AF581> .

<https://w3id.org/ontology-platform/steel/std/gbt-2975-2018> a stl:StandardEdition ;
    dcterms:description "现行"@zh ;
    dcterms:identifier "GB/T 2975-2018" ;
    dcterms:issued "2018"^^xsd:gYear ;
    dcterms:title "Steel and steel products—Location and preparation of samples and test pieces for mechanical testing"@en,
        "钢及钢产品 力学性能试验取样位置及试样制备"@zh ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/standards> ;
