        "铌"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/NI> a skos:Concept ;
    rdfs:label "Nickel"@en,
