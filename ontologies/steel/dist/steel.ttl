stl:BlastFurnaceTapping a owl:Class ;
    rdfs:label "Blast furnace tapping"@en,
        "高炉出铁"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/ironmaking> ;
    rdfs:subClassOf stl:Operation ;
    skos:altLabel "blast furnace tap"@en,
        "铁次"@zh ;
    skos:definition "One discharge of hot metal from a blast furnace, from opening a taphole until closure, potentially into several receiving vessels."@en,
        "在一座高炉上自打开出铁口至封口的一次放铁作业，期间流出的铁水可以分装多罐。"@zh ;
    skos:prefLabel "Blast furnace tapping"@en,
        "高炉出铁"@zh .

stl:ColdRolledCoil a owl:Class ;
    rdfs:label "Cold-line coil"@en,
        "冷轧段钢卷"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:subClassOf stl:Coil ;
    skos:definition "A coil identified at the exit of cold rolling or a subsequent finishing operation, such as annealing, coating or recoiling."@en,
        "在冷轧或其后续精整工序的出口按件登记的钢卷，常见产线包括退火线、涂镀线和重卷线。"@zh ;
    skos:prefLabel "Cold-line coil"@en,
        "冷轧段钢卷"@zh .

stl:DimensionRequirement a owl:Class ;
    rdfs:label "Dimension requirement"@en,
        "尺寸要求"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-709-2019> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/specification> ;
    rdfs:subClassOf stl:Requirement ;
    skos:definition "A specification item defining a nominal dimension and its permitted deviations or limits."@en,
        "给定一种尺寸的公称值及验收偏差或极限的规格条目。"@zh ;
    skos:prefLabel "Dimension requirement"@en,
        "尺寸要求"@zh .

stl:EquipmentHierarchyNode a owl:Class ;
    rdfs:label "Equipment hierarchy node"@en,
        "设备层级节点"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iec-62264-1-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:Equipment ;
    skos:definition "A functional node in the equipment hierarchy used to locate work or group resources under a common production responsibility."@en,
        "在制造设备层级中按生产职责划定边界的功能节点，可用于定位作业或归集下属资源。"@zh ;
    skos:prefLabel "Equipment hierarchy node"@en,
        "设备层级节点"@zh .

stl:HeatTreatment a owl:Class ;
    rdfs:label "Heat treatment"@en,
        "热处理作业"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-7232-2023> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment> ;
    rdfs:subClassOf stl:Operation ;
    skos:definition "An operation that subjects solid steel to a controlled thermal cycle to obtain the intended microstructure or properties."@en,
        "使固态钢材经历受控的温度历程，以获得所需组织或性能的一次实际作业。"@zh ;
    skos:prefLabel "Heat treatment"@en,
        "热处理作业"@zh .

stl:HeatTreatmentLoad a owl:Class ;
    rdfs:label "Heat treatment furnace load"@en,
        "热处理装炉批"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/heattreatment> ;
    rdfs:subClassOf stl:MaterialLot ;
    skos:definition "A material lot comprising the individually identifiable pieces charged together into one heat treatment furnace on one occasion."@en,
        "一次装入同一台热处理炉、按该次装炉共同追踪的一批实物件，各件保留各自的身份。"@zh ;
    skos:prefLabel "Heat treatment furnace load"@en,
        "热处理装炉批"@zh ;
    skos:scopeNote "用 hasPart 列出装炉实物件，也可从实物件用 partOf 指回装炉批。"@zh .

stl:LotAllocation a owl:Class ;
    rdfs:label "Lot allocation"@en,
        "批料投用记录"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "A line allocating a stated quantity from one source lot to one execution."@en,
        "把一个投入批的一定用量分配给一次执行的明细。"@zh ;
    skos:prefLabel "Lot allocation"@en,
        "批料投用记录"@zh .

stl:RouteStep a owl:Class ;
    rdfs:label "Route step"@en,
        "路线步骤"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:subClassOf stl:ManufacturingRecord ;
    skos:definition "An occurrence of a segment in a route that can be distinguished from a later use of the same segment."@en,
        "某工艺段在一条路线中的一次占位，同段可在不同顺位重复出现。"@zh ;
    skos:prefLabel "Route step"@en,
        "路线步骤"@zh .

stl:SteelTube a owl:Class ;
    rdfs:label "Steel tube"@en,
        "钢管"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/iso-6929-2013> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/tubemaking> ;
    rdfs:subClassOf stl:MaterialPiece ;
    skos:definition "An individual steel product with a closed hollow section along its length, whose dimensions and material history can be traced by piece."@en,
        "沿长度方向具有封闭中空截面、可按件追踪尺寸和来源的钢管材。"@zh ;
    skos:prefLabel "Steel tube"@en,
        "钢管"@zh .

stl:actualEndAt a owl:DatatypeProperty ;
    rdfs:label "Actual end"@en,
        "实际结束时刻"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Event ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives the observed completion instant of an actual occurrence."@en,
        "记录一次作业或事件在现场实际结束的时点。"@zh ;
    skos:prefLabel "Actual end"@en,
        "实际结束时刻"@zh .

stl:actualStartAt a owl:DatatypeProperty ;
    rdfs:label "Actual start"@en,
        "实际开始时刻"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Event ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/manufacturing> ;
    rdfs:range xsd:dateTime ;
    skos:definition "Gives the observed start instant of an actual occurrence."@en,
        "记录一次作业或事件在现场真正开始的时点。"@zh ;
    skos:prefLabel "Actual start"@en,
        "实际开始时刻"@zh .

<https://w3id.org/ontology-platform/steel/code/equipment-type/CASTER> a skos:Concept ;
    rdfs:label "Continuous caster"@en,
        "连铸机"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/casting-codes> ;
    skos:definition "A machine that forms and supports a solidifying steel strand and withdraws it as liquid steel is supplied."@en,
        "由结晶器、拉坯与支承设备组成，可将连续供入的钢水凝固并引出为铸流。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/equipment-type> ;
    skos:notation "CASTER"^^stl:EquipmentTypeCode ;
    skos:prefLabel "Continuous caster"@en,
        "连铸机"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/equipment-type> .

<https://w3id.org/ontology-platform/steel/code/plain-product-family/CARBONSTR> a skos:Concept ;
    rdfs:label "Carbon structural steel"@en,
        "碳素结构钢"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-700-2006> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Products ordered by carbon structural steel grade for general structural use."@en,
        "供一般结构件选材，按碳素结构钢牌号订货的产品系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/plain-product-family> ;
    skos:notation "CARBONSTR"^^stl:PlainProductFamilyCode ;
    skos:prefLabel "Carbon structural steel"@en,
        "碳素结构钢"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/plain-product-family> .

<https://w3id.org/ontology-platform/steel/code/plain-product-family/WELDPIPE> a skos:Concept ;
    rdfs:label "Welded pipe"@en,
        "焊管"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-3091-2025> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/plain/products-codes> ;
    skos:definition "Commodity welded pipe ordered by service, pipe dimensions and steel grade."@en,
        "按焊接钢管的用途、管体尺寸和材料牌号订货的普钢系列。"@zh ;
    skos:inScheme <https://w3id.org/ontology-platform/steel/code/plain-product-family> ;
    skos:notation "WELDPIPE"^^stl:PlainProductFamilyCode ;
    skos:prefLabel "Welded pipe"@en,
        "焊管"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/plain-product-family> .

stl:derivedFrom a owl:ObjectProperty ;
    rdfs:label "Derived from"@en,
        "直接来源物料"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Material ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/material> ;
    rdfs:range stl:Material ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    skos:definition "Identifies one immediate source lot or piece from which the current material was split, combined or transformed."@en,
        "指向经一步分取、合并或加工形成当前物料的直接来源批或件。"@zh ;
    skos:prefLabel "Derived from"@en,
        "直接来源物料"@zh .

stl:endLength a owl:DatatypeProperty ;
    rdfs:label "End along source coil"@en,
        "母卷区段终点"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Coil ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/process/rolling> ;
    rdfs:range xsd:decimal ;
    skos:definition "Distance to the end of the interval taken for this coil, measured along the same parent strip from the same origin as the start."@en,
        "以母卷区段起点所用的同一母卷和零点为基准，沿带钢量到该区段终点的距离。"@zh ;
    skos:prefLabel "End along source coil"@en,
        "母卷区段终点"@zh ;
    stl:quantityKind quantitykind:Length ;
    stl:unit unit:M .

stl:measurementItem a owl:ObjectProperty ;
    rdfs:label "Measured item"@en,
        "测量项"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/source/industry-practice> ;
    rdfs:domain stl:Observation ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/quality> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/ontology-platform/steel/code/measurement-item> ;
    skos:definition "Identifies by code the characteristic represented by the reading."@en,
        "用代码指定这次读数代表的被测特性。"@zh ;
    skos:prefLabel "Measured item"@en,
        "测量项"@zh .

