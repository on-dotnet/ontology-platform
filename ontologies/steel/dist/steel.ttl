    skos:prefLabel "oxygen"@en,
        "氧"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/P> a skos:Concept ;
    rdfs:label "phosphorus"@en,
