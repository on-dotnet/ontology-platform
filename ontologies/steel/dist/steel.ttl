    skos:prefLabel "Nickel"@en,
        "镍"@zh ;
    skos:topConceptOf <https://w3id.org/ontology-platform/steel/code/chemical-element> .

<https://w3id.org/ontology-platform/steel/code/chemical-element/O> a skos:Concept ;
    rdfs:label "oxygen"@en,
        "氧"@zh ;
    dcterms:source <https://w3id.org/ontology-platform/steel/std/gbt-11261-2006> ;
    rdfs:isDefinedBy <https://w3id.org/ontology-platform/steel/ontology/core/codes> ;
    skos:altLabel "O"@en,
        "O"@zh ;
