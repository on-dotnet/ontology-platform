    stl:definedIn <std/gbt-5213-2019> ;
    stl:plainProductFamily <code/plain-product-family/COLDLC> ;
    dcterms:source <std/gbt-5213-2019> ; rdfs:isDefinedBy <ontology/plain/products-codes> .
<std/gbt-5213-2019/grade/DC03> a stl:StandardGrade ; skos:notation "DC03" ;
    stl:definedIn <std/gbt-5213-2019> ;
