    stl:plainProductFamily <code/plain-product-family/HSLA>, <code/plain-product-family/SECTION> ;
    dcterms:source <std/gbt-1591-2018> ; rdfs:isDefinedBy <ontology/plain/products-codes> .

<std/gb-1499-1-2024/grade/HPB300> a stl:StandardGrade ; skos:notation "HPB300" ;
