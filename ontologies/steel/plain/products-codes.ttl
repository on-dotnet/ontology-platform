    stl:plainProductFamily <code/plain-product-family/CARBONSTR>, <code/plain-product-family/SECTION>, <code/plain-product-family/WELDPIPE> ;
    dcterms:source <std/gbt-700-2006> ; rdfs:isDefinedBy <ontology/plain/products-codes> .

