@base <https://w3id.org/ontology-platform/steel/> .
@prefix stl: <https://w3id.org/ontology-platform/steel/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<ontology/plain/products-shapes> a owl:Ontology ;
    owl:versionIRI <ontology/plain/products-shapes/0.1.0> ; owl:versionInfo "0.1.0" ;
    rdfs:label "普钢产品交货约束"@zh, "Commodity steel product delivery constraints"@en ;
    rdfs:comment "核对普钢牌号的标准版次和产品族，以及钢筋的表面形状和公称直径。"@zh, "Checks the standard edition and ordering family of commodity steel grades and the surface pattern and nominal diameter of reinforcing bars."@en ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> .

stl:PlainGradeEditionShape a sh:PropertyShape ; sh:targetSubjectsOf stl:plainProductFamily ;
    sh:path stl:definedIn ; sh:minCount 1 ; sh:maxCount 1 ; sh:class stl:StandardEdition ;
    sh:severity sh:Violation ; rdfs:comment "归入普钢产品族的牌号须关联一个确定的产品标准版次，以区分跨版次的同名牌号。"@zh .

stl:PlainProductFamilySchemeShape a sh:PropertyShape ; sh:targetObjectsOf stl:plainProductFamily ;
    sh:path skos:inScheme ; sh:hasValue <code/plain-product-family> ;
    sh:severity sh:Violation ; rdfs:comment "牌号引用的订货产品族须属于普钢产品族方案。"@zh .

stl:RebarSurfaceShape a sh:PropertyShape ; sh:targetClass stl:Rebar ;
    sh:path stl:rebarSurface ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:severity sh:Violation ; rdfs:comment "每支钢筋须有一个表面形状代码，以便区分光圆和带肋产品。"@zh .

stl:RebarSurfaceSchemeShape a sh:PropertyShape ; sh:targetObjectsOf stl:rebarSurface ;
    sh:path skos:inScheme ; sh:hasValue <code/rebar-surface> ;
    sh:severity sh:Violation ; rdfs:comment "钢筋表面形状须引用钢筋表面形状方案中的代码。"@zh .

stl:RebarDiameterShape a sh:PropertyShape ; sh:targetClass stl:Rebar ;
    sh:path stl:rebarNominalDiameter ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minExclusive 0.0 ;
    sh:severity sh:Violation ; rdfs:comment "钢筋公称直径一经给出，应是一个大于零的十进制毫米数。"@zh .
