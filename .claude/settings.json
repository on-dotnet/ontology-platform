{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git grep*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr ready*)",
      "Bash(gh issue create*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(docker ps*)",
      "Bash(docker images*)",
      "Bash(docker inspect*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr status*)",
      "Bash(git worktree list*)",
      "Bash(git merge-base*)",
      "Bash(git rev-parse*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git ls-files*)",
      "PowerShell(git grep*)",
      "PowerShell(git branch*)",
      "PowerShell(git fetch*)",
      "PowerShell(git pull*)",
      "PowerShell(git switch*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git push)",
      "PowerShell(git push -u origin *)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr edit*)",
      "PowerShell(gh pr ready*)",
      "PowerShell(gh issue create*)",
      "PowerShell(gh issue view*)",
      "PowerShell(gh issue list*)",
      "PowerShell(docker ps*)",
      "PowerShell(docker images*)",
      "PowerShell(docker inspect*)",
      "PowerShell(docker compose ps*)",
      "PowerShell(docker compose logs*)",
      "PowerShell(./dev.ps1 up*)",
      "PowerShell(./dev.ps1 status*)",
      "PowerShell(./dev.ps1 logs*)",
      "PowerShell(./dev.ps1 build*)",
      "PowerShell(./dev.ps1 lock*)",
      "PowerShell(./dev.ps1 test*)",
      "PowerShell(./dev.ps1 gen-api*)",
      "PowerShell(./dev.ps1 ci*)",
      "PowerShell(gh pr diff*)",
      "PowerShell(gh pr checks*)",
      "PowerShell(gh pr status*)",
      "PowerShell(git worktree list*)",
      "PowerShell(git merge-base*)",
      "PowerShell(git rev-parse*)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *+*)",
      "Bash(*.env.local*)",
      "PowerShell(*.env.local*)",
      "Bash(*./dev.ps1 reset*)",
      "PowerShell(*./dev.ps1 reset*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose * down -v*)",
      "PowerShell(docker compose down -v*)",
      "PowerShell(docker compose * down -v*)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker volume rm*)",
      "PowerShell(docker system prune*)",
      "PowerShell(docker volume prune*)",
      "PowerShell(docker volume rm*)",
      "Read(**/.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-dev-commands.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
