{
  "schemaVersion": 1,
  "gates": {
    "policy": {
      "inputs": [
        "AGENTS.md",
        "PLANS.md",
        "docs/tasks/*",
        "docs/development/*.md",
        "docs/evidence/**/*.md",
        "docs/evidence/**/*.txt",
        "docs/evidence/G4-ENG-WORKFLOW-001/summary.json",
