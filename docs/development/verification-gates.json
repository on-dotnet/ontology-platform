      ],
      "needs": [],
      "command": [
        "pwsh",
        "-NoProfile",
        "-File",
        "scripts/verify.ps1"
      ],
      "testsRequired": false
    },
    "environment": {
      "inputs": [
        "global.json",
        "Directory.*",
        "NuGet.Config",
