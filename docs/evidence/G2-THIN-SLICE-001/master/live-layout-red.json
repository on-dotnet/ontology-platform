  "g2Styles": [
    ".g2-workspace { overflow-wrap: anywhere; gap: 20px; min-width: 0px; display: grid; }",
    ".g2-heading { justify-content: space-between; align-items: start; gap: 16px; display: flex; }",
    ".g2-heading h1 { font-size: 28px; }",
    ".g2-heading p { color: var(--muted); }",
    ".g2-row { flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; display: flex; }",
    ".g2-panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); min-width: 0px; padding: 20px; }",
    ".g2-grid { grid-template-columns: 240px minmax(260px, 1fr) minmax(260px, 1fr); align-items: start; gap: 16px; display: grid; }",
    ".g2-grid > * { min-width: 0px; }",
    ".g2-stack { gap: 14px; display: grid; }",
    ".g2-workspace label { color: var(--muted); gap: 6px; font-size: 12px; display: grid; }",
    ".g2-workspace input:not([type=\"checkbox\"]), .g2-workspace select, .g2-workspace textarea { border: 1px solid var(--border); background: var(--surface-raised); color: var(--text); width: 100%; max-width: 100%; font: inherit; border-radius: 8px; padding: 10px; }",
    ".g2-workspace textarea:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }",
    ".g2-source { gap: 12px; display: grid; }",
    ".g2-code { resize: vertical; tab-size: 2; min-height: 420px; line-height: 1.7; font-family: ui-monospace, SFMono-Regular, monospace !important; font-size: 12px !important; }",
    ".g2-notice { border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-left: 3px solid var(--amber); background: var(--amber-soft); overflow-wrap: anywhere; border-radius: 8px; padding: 12px; }",
    ".g2-notice.error { border-left-color: var(--violet); background: var(--violet-soft); }",
    ".g2-trace { overflow-wrap: anywhere; flex-wrap: wrap; gap: 8px; display: flex; }",
    ".g2-trace a { color: var(--primary); text-decoration: underline; }",
    ".g2-assets { gap: 10px; display: grid; }",
    ".g2-asset { text-align: left; border: 1px solid var(--border); background: var(--surface-raised); color: var(--text); border-radius: 10px; gap: 5px; width: 100%; padding: 14px; display: grid; }",
    ".g2-asset[aria-current=\"true\"] { border-color: var(--primary); background: var(--primary-soft); }",
    ".g2-graph { background: var(--canvas); border: 1px solid var(--border); border-radius: 10px; height: 320px; margin: 12px 0px; }",
    ".g2-node-list { gap: 8px; max-height: 260px; padding: 0px; list-style: none; display: grid; overflow: auto; }",
    ".g2-node-list li { overflow-wrap: anywhere; display: grid; }",
    ".g2-tabs { gap: 8px; display: flex; }",
    ".g2-tabs button { flex: 1 1 0%; }",
    ".g2-tabs [aria-pressed=\"true\"] { background: var(--primary-soft); border-color: var(--primary); }",
    ".g2-mobile-tabs { display: none; }",
    ".g2-detail { overflow-wrap: anywhere; gap: 12px; display: grid; }",
    ".g2-detail dt { color: var(--muted); font-size: 12px; }",
    ".g2-detail dd { margin: 0px; font-family: ui-monospace, monospace; font-size: 12px; }",
    ".g2-list { gap: 14px; display: grid; }",
    ".g2-list article { border: 1px solid var(--border); border-radius: 10px; gap: 10px; padding: 16px; display: grid; }",
    ".g2-pre { white-space: pre-wrap; overflow-wrap: anywhere; background: var(--canvas); border-radius: 8px; max-height: 360px; padding: 14px; font-size: 12px; overflow: auto; }",
    ".g2-split { grid-template-columns: minmax(240px, 1fr) minmax(260px, 2fr); align-items: start; gap: 16px; display: grid; }",
    ".g2-status { color: var(--teal); font-weight: 600; }",
    ".g2-hash { overflow-wrap: anywhere; font-family: ui-monospace, monospace; font-size: 11px; }",
    ".g2-workspace button:disabled { cursor: not-allowed; }",
    ".g2-workspace details summary { cursor: pointer; color: var(--primary); }",
    ".g2-grid { grid-template-columns: 210px minmax(240px, 1fr); }",
    ".g2-grid .g2-inspector { grid-column: 2; }",
    ".g2-heading { flex-wrap: wrap; }",
    ".g2-grid, .g2-split { grid-template-columns: minmax(0px, 1fr); }",
    ".g2-grid .g2-inspector { grid-column: auto; }",
    ".g2-heading h1 { font-size: 24px; }",
    ".g2-panel { padding: 14px; }",
    ".g2-mobile-tabs { display: flex; }",
    ".g2-mobile-hidden { display: none !important; }",
    ".g2-code { min-height: 340px; }",
    ".g2-heading .button { font-size: 12px; }",
    ".g2-workspace { gap: 14px; }"
  ],
