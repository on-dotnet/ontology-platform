        "security": [
          {
            "health": []
          }
        ]
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "OntologyPlatform.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
