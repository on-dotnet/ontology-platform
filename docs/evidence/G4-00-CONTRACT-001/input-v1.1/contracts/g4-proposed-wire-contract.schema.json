                    "type",
                    "profile"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "POSTGRESQL"
                    },
                    "profile": {
                      "type": "object",
                      "required": [
                        "host",
                        "port",
                        "database",
                        "username",
                        "sslMode",
                        "allowedSchemas"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "host": {
                          "type": "string",
                          "minLength": 1
                        },
                        "port": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535
                        },
                        "database": {
                          "type": "string",
                          "minLength": 1
                        },
                        "username": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sslMode": {
