                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "profile"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "ORACLE"
                    },
                    "profile": {
                      "type": "object",
                      "required": [
                        "host",
                        "port",
                        "serviceName",
                        "username",
                        "tls",
                        "allowedOwners"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "host": {
                          "type": "string",
                          "minLength": 1
                        },
                        "port": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535
                        },
                        "serviceName": {
                          "type": "string",
                          "minLength": 1
                        },
                        "username": {
                          "type": "string",
                          "minLength": 1
                        },
                        "tls": {
                          "type": "boolean"
                        },
                        "allowedOwners": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "profile"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "DORIS"
                    },
                    "profile": {
                      "type": "object",
                      "required": [
                        "feHost",
                        "queryPort",
                        "catalog",
                        "database",
                        "username",
                        "tls"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "feHost": {
                          "type": "string",
                          "minLength": 1
                        },
                        "queryPort": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535
                        },
                        "catalog": {
                          "type": "string",
                          "minLength": 1
                        },
                        "database": {
                          "type": "string",
                          "minLength": 1
                        },
                        "username": {
                          "type": "string",
                          "minLength": 1
                        },
                        "tls": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "profile"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "TDENGINE"
                    },
                    "profile": {
                      "type": "object",
                      "required": [
                        "wsUrl",
                        "database",
                        "timePrecision",
                        "timeZone"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "wsUrl": {
                          "type": "string",
                          "pattern": "^wss?://"
                        },
                        "database": {
                          "type": "string",
                          "minLength": 1
                        },
                        "timePrecision": {
                          "enum": [
                            "MILLISECOND",
                            "MICROSECOND",
                            "NANOSECOND",
                            "UNKNOWN"
                          ]
                        },
                        "timeZone": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "profile"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "WEB_API"
                    },
                    "profile": {
                      "type": "object",
                      "required": [
                        "baseOrigin",
                        "operationId",
                        "method",
                        "approvedPath",
                        "authentication",
                        "pagination",
                        "hostPolicyRef"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "baseOrigin": {
                          "type": "string",
                          "pattern": "^https://"
                        },
                        "operationId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "method": {
                          "const": "GET"
                        },
                        "approvedPath": {
                          "type": "string",
                          "pattern": "^/"
                        },
                        "authentication": {
                          "enum": [
                            "NONE",
                            "API_KEY_REF",
                            "OAUTH_CLIENT_CREDENTIALS_REF"
                          ]
                        },
                        "pagination": {
                          "enum": [
                            "NONE",
                            "PAGE",
                            "OFFSET",
                            "CURSOR",
                            "LINK"
                          ]
                        },
                        "hostPolicyRef": {
