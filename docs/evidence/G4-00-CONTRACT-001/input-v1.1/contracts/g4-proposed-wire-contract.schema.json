{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontology-platform:design:g4-wire-contract:1.1",
  "title": "G4 DESIGN-ONLY wire contract V1.1 (G2 frozen DTOs unchanged)",
  "description": "V1.1 fixes user review CR-01..04. Each schemaKind identifies a distinct proposed wire contract. This is not G2 DTO/OpenAPI, not implemented, not RDF ontology source.",
