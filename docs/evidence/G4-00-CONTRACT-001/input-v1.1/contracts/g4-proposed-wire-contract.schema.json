                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              ]
            },
            "secretRef": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "Single credential source; null only when Web API authentication is NONE"
            },
            "command": {
              "type": "object",
              "required": [
                "commandId",
                "idempotencyKey",
                "expectedRevision",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "commandId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "idempotencyKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "expectedRevision": {
                  "const": 0
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "config": {
                    "properties": {
                      "type": {
                        "const": "WEB_API"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  }
                },
                "required": [
                  "config"
                ]
              },
              "then": {
                "if": {
                  "properties": {
                    "config": {
                      "properties": {
                        "profile": {
                          "properties": {
                            "authentication": {
                              "const": "NONE"
                            }
                          },
                          "required": [
                            "authentication"
                          ]
                        }
                      },
                      "required": [
                        "profile"
                      ]
                    }
                  },
                  "required": [
                    "config"
                  ]
                },
                "then": {
                  "properties": {
                    "secretRef": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "secretRef": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "secretRef": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
