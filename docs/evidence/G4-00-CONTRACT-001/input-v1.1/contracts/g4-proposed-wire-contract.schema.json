  "required": [
    "schemaKind",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaKind": {
      "enum": [
        "ConnectionCreateRequest",
        "MappingDraft",
        "SemanticQuery",
        "G4QueryResultV1",
        "MappingListPage",
        "MappingProposalView",
        "MappingReleaseView",
        "MappingRevisionDiffView",
        "MappingAssessmentView"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
