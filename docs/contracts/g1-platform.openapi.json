{
  "openapi": "3.1.0",
  "info": {
    "title": "OntologyPlatform G1 Platform Contract",
    "version": "1.0.0",
    "description": "Master冻结的实现/客户端契约，实际服务导出后核对语义，不冒充已实现。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/platform/me": {
      "get": {
        "operationId": "getPlatformMe",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "实际授权成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformIdentity"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          },
          "403": {
            "description": "角色或作用域不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          },
          "503": {
            "description": "真实依赖或可靠审计不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/resources": {
      "get": {
        "operationId": "listPlatformResources",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "实际授权成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformResourceList"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          },
          "403": {
            "description": "角色或作用域不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          },
          "503": {
            "description": "真实依赖或可靠审计不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "siteId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/platform/resources/{id}": {
      "get": {
        "operationId": "getPlatformResource",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "实际授权成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformResource"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          },
          "403": {
            "description": "角色或作用域不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          },
          "503": {
            "description": "真实依赖或可靠审计不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/platform/audit": {
      "get": {
        "operationId": "listPlatformAudit",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "实际授权成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlatformAuditEntry"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          },
          "403": {
            "description": "角色或作用域不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          },
          "503": {
            "description": "真实依赖或可靠审计不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
    "/auth/csrf": {
      "get": {
        "operationId": "getCsrfToken",
        "responses": {
          "200": {
            "description": "只回传内置CSRF请求令牌",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "get": {
        "operationId": "login",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "/"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "标准OIDC挑战"
          },
          "400": {
            "description": "本地返回地址非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "注销服务器会话及OIDC重定向"
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          },
          "403": {
            "description": "CSRF拒绝",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": ".OntologyPlatform.Session"
      }
    },
    "schemas": {
      "PlatformScope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organizationId",
          "siteId"
        ],
        "properties": {
          "organizationId": {
            "type": "string",
            "description": "组织范围标识。"
          },
          "siteId": {
            "type": "string",
            "description": "厂区范围标识。"
          }
        }
      },
      "PlatformIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjectId",
          "displayName",
          "roles",
          "scopes"
        ],
        "properties": {
          "subjectId": {
            "type": "string",
            "description": "身份提供者验证通过的主体标识。"
          },
          "displayName": {
            "type": "string",
            "description": "界面显示名，不承载秘密声明。"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "服务器认可的平台角色集合。"
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlatformScope"
            },
            "description": "服务器认可的组织与厂区范围。"
          }
        }
      },
      "PlatformResource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "organizationId",
          "siteId",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "资源稳定标识。"
          },
          "name": {
            "type": "string",
            "description": "资源中文显示名称。"
          },
          "organizationId": {
            "type": "string",
            "description": "资源所属组织。"
          },
          "siteId": {
            "type": "string",
            "description": "资源所属厂区。"
          },
          "status": {
            "type": "string",
            "description": "明确说明资源为开发合成样例的状态。"
          }
        }
      },
      "PlatformResourceList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "auditId",
          "traceId"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlatformResource"
            },
            "description": "本次真正获准读取的资源。"
          },
          "auditId": {
            "type": "string",
            "description": "已经提交的PG访问审计标识。"
          },
          "traceId": {
            "type": "string",
            "description": "当前请求的分布式跟踪标识。"
          }
        }
      },
      "PlatformAuditEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "occurredAtUtc",
          "actor",
          "action",
          "resource",
          "outcome",
          "traceId",
          "correlationId",
          "organizationId",
          "siteId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "不可变审计事件标识。"
          },
          "occurredAtUtc": {
            "type": "string",
            "format": "date-time",
            "description": "审计发生的UTC时间。"
          },
          "actor": {
            "type": "string",
            "description": "服务端解析的主体或anonymous标识。"
          },
          "action": {
            "type": "string",
            "description": "固定语义的审计操作代码。"
          },
          "resource": {
            "type": "string",
            "description": "被访问的平台资源标识或受控路径。"
          },
          "outcome": {
            "type": "string",
            "description": "允许、拒绝或失败的固定结果代码。"
          },
          "traceId": {
            "type": "string",
            "description": "与运行日志和Trace关联的标识。"
          },
          "correlationId": {
            "type": "string",
            "description": "经过格式验证的请求关联标识。"
          },
          "organizationId": {
            "type": [
              "string",
              "null"
            ],
            "description": "事件适用的组织范围，匿名时可空。"
          },
          "siteId": {
            "type": [
              "string",
              "null"
            ],
            "description": "事件适用的厂区范围，匿名时可空。"
          }
        }
      },
      "CsrfResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestToken"
        ],
        "properties": {
          "requestToken": {
            "type": "string",
            "description": "同源写请求需要回传的CSRF请求值。"
          }
        }
      },
      "PlatformProblem": {
        "type": "object",
        "required": [
          "status",
          "title",
          "code",
          "traceId",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
