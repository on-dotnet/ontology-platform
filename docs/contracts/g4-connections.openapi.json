                "schema": {
                  "$ref": "#/components/schemas/CatalogSnapshotListPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalogs/{snapshotId}": {
      "get": {
        "tags": [
          "Connections"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogSnapshotView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogDiscoveryJobView": {
        "required": [
          "jobId",
          "connectionId",
          "configRevision",
          "status",
          "createdAtUtc",
          "completedAtUtc",
          "snapshotId",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "任务标识。"
          },
          "connectionId": {
            "type": "string",
            "description": "来源连接。"
          },
          "configRevision": {
            "type": "integer",
            "description": "请求配置修订。",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "description": "持久任务状态。"
          },
          "createdAtUtc": {
            "type": "string",
            "description": "创建时间。",
            "format": "date-time"
          },
          "completedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "description": "终态时间。",
            "format": "date-time"
          },
          "snapshotId": {
            "type": [
              "null",
              "string"
            ],
            "description": "产生的快照标识。"
          },
          "traceId": {
            "type": "string",
            "description": "脱敏关联标识。"
          }
        },
        "additionalProperties": false,
        "description": "可恢复且可取消的持久发现任务。"
      },
      "CatalogField": {
        "required": [
          "name",
          "nativeType",
          "nullable",
          "ordinal",
          "precision",
          "scale"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "列名称。"
          },
          "nativeType": {
            "type": "string",
            "description": "保真原生类型。"
          },
          "nullable": {
            "type": "boolean",
            "description": "是否允许空值。"
          },
          "ordinal": {
            "type": "integer",
            "description": "列序号。",
            "format": "int32"
          },
          "precision": {
            "type": [
              "null",
              "integer"
            ],
            "description": "原生精度。",
            "format": "int32"
          },
          "scale": {
            "type": [
              "null",
              "integer"
            ],
            "description": "原生小数位。",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "原生列类型与精度元数据，不包含业务行。"
      },
      "CatalogObject": {
        "required": [
          "schema",
          "name",
          "kind",
          "fields"
        ],
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema名称。"
          },
          "name": {
            "type": "string",
            "description": "对象名称。"
          },
          "kind": {
            "type": "string",
            "description": "TABLE或VIEW。"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogField"
            },
            "description": "可见字段集合。"
          }
        },
        "additionalProperties": false,
        "description": "源角色和允许Schema交集内的可见对象。"
      },
      "CatalogSnapshotListPage": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogSnapshotView"
            },
            "description": "当前页面。"
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ],
            "description": "下一页不透明游标。"
          }
        },
        "additionalProperties": false,
        "description": "授权过滤后的目录历史分页。"
      },
      "CatalogSnapshotView": {
        "required": [
          "snapshotId",
          "connectionId",
          "configRevision",
          "secretVersion",
          "scope",
          "schemaFingerprint",
          "capturedAtUtc",
          "status",
          "objects"
        ],
        "type": "object",
        "properties": {
          "snapshotId": {
            "type": "string",
            "description": "快照标识。"
          },
          "connectionId": {
            "type": "string",
            "description": "来源连接标识。"
          },
          "configRevision": {
            "type": "integer",
            "description": "捕获时配置修订。",
            "format": "int64"
          },
          "secretVersion": {
            "type": "integer",
            "description": "捕获时凭据版本。",
            "format": "int64"
          },
          "scope": {
            "description": "捕获范围。",
            "$ref": "#/components/schemas/ResourceScope"
          },
          "schemaFingerprint": {
            "type": "string",
            "description": "排序规范化内容SHA256。"
          },
          "capturedAtUtc": {
            "type": "string",
            "description": "捕获时间。",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "description": "READY或PARTIAL或STALE。"
          },
          "objects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogObject"
            },
            "description": "授权可见元数据。"
          }
        },
        "additionalProperties": false,
        "description": "不可变目录快照及当前过期状态投影。"
      },
      "CommandContext": {
        "required": [
          "commandId",
          "idempotencyKey",
          "expectedRevision",
          "reason"
        ],
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "description": "本次命令标识。"
          },
          "idempotencyKey": {
            "type": "string",
            "description": "同范围与操作内唯一的幂等键。"
          },
          "expectedRevision": {
            "type": "integer",
            "description": "期望修订；创建时为零。",
            "format": "int64"
          },
          "reason": {
            "type": "string",
            "description": "仅存业务审计的操作理由，不写普通日志。"
          }
        },
        "additionalProperties": false,
        "description": "用于明确修订与幂等语义的受控命令上下文。"
      },
      "ConnectionConfig": {
        "required": [
          "type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/ConnectionConfigPgConnectionConfig"
          },
          {
            "$ref": "#/components/schemas/ConnectionConfigOracleConnectionConfig"
          },
          {
            "$ref": "#/components/schemas/ConnectionConfigDorisConnectionConfig"
          },
          {
            "$ref": "#/components/schemas/ConnectionConfigTdengineConnectionConfig"
          },
          {
            "$ref": "#/components/schemas/ConnectionConfigWebApiConnectionConfig"
          }
        ],
        "description": "五类连接配置的唯一判别联合，M1仅PostgreSQL具备运行能力。",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "POSTGRESQL": "#/components/schemas/ConnectionConfigPgConnectionConfig",
            "ORACLE": "#/components/schemas/ConnectionConfigOracleConnectionConfig",
            "DORIS": "#/components/schemas/ConnectionConfigDorisConnectionConfig",
            "TDENGINE": "#/components/schemas/ConnectionConfigTdengineConnectionConfig",
            "WEB_API": "#/components/schemas/ConnectionConfigWebApiConnectionConfig"
          }
        }
      },
      "ConnectionConfigDorisConnectionConfig": {
        "required": [
          "profile",
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "DORIS"
            ],
            "type": "string"
          },
          "profile": {
            "description": "当前类型唯一的连接参数。",
            "$ref": "#/components/schemas/DorisConnectionProfile"
          }
        },
        "additionalProperties": false,
        "description": "Doris类型化配置分支，禁止夹带连接串或身份字段。"
      },
      "ConnectionConfigOracleConnectionConfig": {
        "required": [
          "profile",
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "ORACLE"
            ],
            "type": "string"
          },
          "profile": {
            "description": "当前类型唯一的连接参数。",
            "$ref": "#/components/schemas/OracleConnectionProfile"
          }
        },
        "additionalProperties": false,
        "description": "Oracle类型化配置分支，禁止夹带连接串或身份字段。"
      },
      "ConnectionConfigPgConnectionConfig": {
        "required": [
          "profile",
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "POSTGRESQL"
            ],
            "type": "string"
          },
          "profile": {
            "description": "当前类型唯一的连接参数。",
            "$ref": "#/components/schemas/PgConnectionProfile"
          }
        },
        "additionalProperties": false,
        "description": "Pg类型化配置分支，禁止夹带连接串或身份字段。"
      },
      "ConnectionConfigTdengineConnectionConfig": {
        "required": [
          "profile",
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "TDENGINE"
            ],
            "type": "string"
          },
          "profile": {
            "description": "当前类型唯一的连接参数。",
            "$ref": "#/components/schemas/TdengineConnectionProfile"
          }
        },
        "additionalProperties": false,
        "description": "Tdengine类型化配置分支，禁止夹带连接串或身份字段。"
      },
      "ConnectionConfigWebApiConnectionConfig": {
        "required": [
          "profile",
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "WEB_API"
            ],
            "type": "string"
          },
          "profile": {
            "description": "当前类型唯一的连接参数。",
            "$ref": "#/components/schemas/WebApiConnectionProfile"
          }
        },
        "additionalProperties": false,
        "description": "WebApi类型化配置分支，禁止夹带连接串或身份字段。"
      },
      "ConnectionCreateRequest": {
        "required": [
          "displayName",
          "scopeSelection",
          "config",
          "secretRef",
          "command"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "连接显示名称。"
          },
          "scopeSelection": {
            "description": "客户端申请的组织厂区子集。",
            "$ref": "#/components/schemas/ResourceScope"
          },
          "config": {
            "description": "唯一类型化配置。",
            "$ref": "#/components/schemas/ConnectionConfig"
          },
          "secretRef": {
            "type": [
              "null",
              "string"
            ],
            "description": "仅专用密钥入口签发的引用。"
          },
          "command": {
            "description": "创建修订为零的命令。",
            "$ref": "#/components/schemas/CommandContext"
          }
        },
        "additionalProperties": false,
        "description": "创建草稿，禁止自动启用。"
      },
      "ConnectionDraftProbeRequest": {
        "required": [
          "scopeSelection",
          "config",
          "secretRef",
          "command"
        ],
        "type": "object",
        "properties": {
          "scopeSelection": {
            "description": "探测所选授权范围。",
            "$ref": "#/components/schemas/ResourceScope"
          },
          "config": {
            "description": "待测试的唯一配置。",
            "$ref": "#/components/schemas/ConnectionConfig"
          },
          "secretRef": {
            "type": "string",
            "description": "未绑定且有效的秘密引用。"
          },
          "command": {
            "description": "探测幂等命令。",
            "$ref": "#/components/schemas/CommandContext"
          }
        },
        "additionalProperties": false,
        "description": "未保存草稿的真实只读探测请求。"
      },
      "ConnectionListPage": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionView"
            },
            "description": "当前页面。"
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ],
            "description": "下一页不透明游标。"
          }
        },
        "additionalProperties": false,
        "description": "授权过滤后的有界连接分页。"
      },
      "ConnectionMutationCommand": {
        "required": [
          "command"
        ],
        "type": "object",
        "properties": {
          "command": {
            "description": "包含幂等键与当前修订的命令。",
            "$ref": "#/components/schemas/CommandContext"
          }
        },
        "additionalProperties": false,
        "description": "连接与发现任务的版本化变更命令。"
      },
      "ConnectionPatchRequest": {
        "required": [
          "command"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "新的显示名称。"
          },
          "scopeSelection": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "新的授权范围子集。",
                "$ref": "#/components/schemas/ResourceScope"
              }
            ]
          },
          "config": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "新的类型化配置。",
                "$ref": "#/components/schemas/ConnectionConfig"
              }
            ]
          },
          "command": {
            "description": "包含正修订的编辑命令。",
            "$ref": "#/components/schemas/CommandContext"
          }
        },
        "additionalProperties": false,
        "description": "CAS编辑非秘密配置，成功后旧Probe失效。"
      },
      "ConnectionProbeStage": {
        "required": [
          "name",
          "status",
          "durationMs",
          "diagnosticCode"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "NETWORK或TLS或AUTH或READ_ONLY或METADATA。"
          },
          "status": {
            "type": "string",
            "description": "PASS或FAIL或NOT_VERIFIED或NOT_RUN。"
          },
          "durationMs": {
            "type": "integer",
            "description": "阶段实际耗时毫秒。",
            "format": "int64"
          },
          "diagnosticCode": {
            "type": [
              "null",
