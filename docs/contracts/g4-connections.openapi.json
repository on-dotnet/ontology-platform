              "schema": {
                "$ref": "#/components/schemas/ConnectionRotateSecretRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connections/{id}/test": {
      "post": {
