        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionMutationCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogDiscoveryJobView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connections/{id}/discoveries/{jobId}": {
