#################################################################

###  urn:ontology-platform:vocabulary:externalId
op:externalId rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string .


###  urn:ontology-platform:vocabulary:organizationId
op:organizationId rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:string .


###  urn:ontology-platform:vocabulary:siteId
op:siteId rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:string .


###  urn:ontology-platform:vocabulary:synthetic
op:synthetic rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:boolean .


###  urn:ontology-platform:vocabulary:weight
op:weight rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:decimal .


