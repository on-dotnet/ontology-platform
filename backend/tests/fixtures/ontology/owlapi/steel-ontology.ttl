###  urn:synthetic:metals:castIn
ex:castIn rdf:type owl:ObjectProperty ;
          rdfs:domain ex:Heat ;
          rdfs:range ex:CastingSequence ;
          rdfs:label "对应浇次"@zh .


###  urn:synthetic:metals:producesCoil
ex:producesCoil rdf:type owl:ObjectProperty ;
                rdfs:domain ex:RollingEvent ;
                rdfs:range ex:Coil ;
                rdfs:label "产出钢卷"@zh .


###  urn:synthetic:metals:producesSlab
ex:producesSlab rdf:type owl:ObjectProperty ;
                rdfs:domain ex:CastingSequence ;
                rdfs:range ex:Slab ;
                rdfs:label "产出板坯"@zh .


###  urn:synthetic:metals:rolledIn
ex:rolledIn rdf:type owl:ObjectProperty ;
            rdfs:domain ex:Slab ;
            rdfs:range ex:RollingEvent ;
            rdfs:label "参与轧制"@zh .


#################################################################
