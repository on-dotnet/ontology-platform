<https://example.org/ontology/ontology-cb4989> rdf:type owl:Ontology ;
                                                dcterms:created "2026-11-23T12:54:14+00:00"^^xsd:dateTime ;
                                                rdfs:label "钢铁冶金" ;
                                                owl:versionInfo "1" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#class
sh:class rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#datatype
sh:datatype rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#maxCount
sh:maxCount rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#minCount
sh:minCount rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#path
sh:path rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#property
sh:property rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#targetClass
sh:targetClass rdf:type owl:AnnotationProperty .


###  https://w3id.org/ontology-platform/vocab#unit
op:unit rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://example.org/ontology/ontology-cb4989#assignsSteelGrade
ontology-cb4989:assignsSteelGrade rdf:type owl:ObjectProperty ;
                                  rdfs:domain ontology-cb4989:SteelGradeReassignment ;
                                  rdfs:range ontology-cb4989:SteelGrade ;
                                  rdfs:label "Reassigned steel grade"@en ,
                                             "改判后钢种"@zh ;
                                  skos:definition "一次完成的改判操作为该炉次重新判定的钢种。"@zh .


###  https://example.org/ontology/ontology-cb4989#belongsToContinuousCastingMachine
ontology-cb4989:belongsToContinuousCastingMachine rdf:type owl:ObjectProperty ;
                                                  rdfs:domain ontology-cb4989:LadleTurret ;
                                                  rdfs:range ontology-cb4989:ContinuousCastingMachine ;
                                                  rdfs:label "Turret's continuous casting machine"@en ,
                                                             "回转台所属连铸机"@zh ;
                                                  skos:definition "配置该钢包回转台的连铸机。"@zh .


###  https://example.org/ontology/ontology-cb4989#hasCharging
ontology-cb4989:hasCharging rdf:type owl:ObjectProperty ;
                            rdfs:domain ontology-cb4989:Heat ;
                            rdfs:range ontology-cb4989:Charging ;
                            rdfs:label "Heat charging"@en ,
                                       "炉次装料"@zh ;
                            skos:definition "为该炉次向转炉装入铁水和废钢的装料工序。"@zh .


###  https://example.org/ontology/ontology-cb4989#hasConverterBlowing
ontology-cb4989:hasConverterBlowing rdf:type owl:ObjectProperty ;
                                    rdfs:domain ontology-cb4989:Heat ;
                                    rdfs:range ontology-cb4989:ConverterBlowing ;
                                    rdfs:label "Heat blowing"@en ,
                                               "炉次吹炼"@zh ;
                                    skos:definition "该炉次在转炉中进行的吹炼工序。"@zh .


###  https://example.org/ontology/ontology-cb4989#hasEndpointMeasurementAndSampling
ontology-cb4989:hasEndpointMeasurementAndSampling rdf:type owl:ObjectProperty ;
                                                  rdfs:domain ontology-cb4989:ConverterBlowing ;
                                                  rdfs:range ontology-cb4989:BlowingEndpointMeasurementAndSampling ;
                                                  rdfs:label "Endpoint measurement and sampling"@en ,
                                                             "终点测温取样"@zh ;
                                                  skos:definition "在该吹炼工序终点进行的测温取样操作。"@zh .


###  https://example.org/ontology/ontology-cb4989#hasLadleFurnaceDestination
ontology-cb4989:hasLadleFurnaceDestination rdf:type owl:ObjectProperty ;
                                           rdfs:domain ontology-cb4989:LadleTransfer ;
                                           rdfs:range ontology-cb4989:LadleFurnace ;
                                           rdfs:label "Destination ladle furnace"@en ,
                                                      "吊运目的精炼炉"@zh ;
                                           skos:definition "出钢后吊运所到达的 LF 精炼炉。"@zh .


###  https://example.org/ontology/ontology-cb4989#hasLadleTurretDestination
ontology-cb4989:hasLadleTurretDestination rdf:type owl:ObjectProperty ;
                                          rdfs:domain ontology-cb4989:LadleTransfer ;
                                          rdfs:range ontology-cb4989:LadleTurret ;
                                          rdfs:label "Destination ladle turret"@en ,
                                                     "吊运目的钢包回转台"@zh ;
                                          skos:definition "精炼后赴连铸吊运所到达的钢包回转台。"@zh .


###  https://example.org/ontology/ontology-cb4989#hasRefiningTreatment
ontology-cb4989:hasRefiningTreatment rdf:type owl:ObjectProperty ;
                                     rdfs:domain ontology-cb4989:Heat ;
                                     rdfs:range ontology-cb4989:RefiningTreatment ;
                                     rdfs:label "Heat refining treatment"@en ,
                                                "炉次精炼处理"@zh ;
                                     skos:definition "该炉次在规程所述正常流程中接受的一次 LF 钢包精炼。"@zh .


###  https://example.org/ontology/ontology-cb4989#hasReturnToFurnaceTreatment
ontology-cb4989:hasReturnToFurnaceTreatment rdf:type owl:ObjectProperty ;
                                            rdfs:domain ontology-cb4989:Heat ;
                                            rdfs:range ontology-cb4989:ReturnToFurnaceTreatment ;
                                            rdfs:label "Heat return-to-furnace treatment"@en ,
                                                       "炉次回炉处置"@zh ;
                                            skos:definition "化学成分不合格时，将该炉次送回炉内处理的处置。"@zh .


###  https://example.org/ontology/ontology-cb4989#hasSteelGradeReassignment
ontology-cb4989:hasSteelGradeReassignment rdf:type owl:ObjectProperty ;
                                          rdfs:domain ontology-cb4989:Heat ;
                                          rdfs:range ontology-cb4989:SteelGradeReassignment ;
                                          rdfs:label "Heat grade reassignment"@en ,
                                                     "炉次改判处置"@zh ;
                                          skos:definition "化学成分不合格时，对该炉次重新判定钢种的处置。"@zh .


###  https://example.org/ontology/ontology-cb4989#hasTapping
ontology-cb4989:hasTapping rdf:type owl:ObjectProperty ;
                           rdfs:domain ontology-cb4989:Heat ;
                           rdfs:range ontology-cb4989:Tapping ;
                           rdfs:label "Heat tapping"@en ,
                                      "炉次出钢"@zh ;
                           skos:definition "将该炉次钢水倒入钢包、完成转炉冶炼的出钢工序。"@zh .


###  https://example.org/ontology/ontology-cb4989#hasTargetSteelGrade
ontology-cb4989:hasTargetSteelGrade rdf:type owl:ObjectProperty ;
                                    rdfs:domain ontology-cb4989:Heat ;
                                    rdfs:range ontology-cb4989:SteelGrade ;
                                    rdfs:label "Target steel grade"@en ,
                                               "生产钢种"@zh ;
                                    skos:definition "炉次按其生产计划冶炼的钢种。"@zh .


###  https://example.org/ontology/ontology-cb4989#isAssessedAgainstSteelGrade
ontology-cb4989:isAssessedAgainstSteelGrade rdf:type owl:ObjectProperty ;
                                            rdfs:domain ontology-cb4989:FinalSteelSample ;
                                            rdfs:range ontology-cb4989:SteelGrade ;
                                            rdfs:label "Steel grade for sample assessment"@en ,
                                                       "成品样判定依据钢种"@zh ;
                                            skos:definition "成品样化学成分判定所依据的炉次生产钢种。"@zh .


###  https://example.org/ontology/ontology-cb4989#isCarriedInLadle
ontology-cb4989:isCarriedInLadle rdf:type owl:ObjectProperty ;
                                 rdfs:domain ontology-cb4989:MoltenSteel ;
                                 rdfs:range ontology-cb4989:Ladle ;
                                 rdfs:label "Molten steel carrying ladle"@en ,
                                            "钢水承装钢包"@zh ;
                                 skos:definition "承装该炉次出钢钢水并将其送往精炼炉的钢包。"@zh .


###  https://example.org/ontology/ontology-cb4989#isControlledBySteelGrade
ontology-cb4989:isControlledBySteelGrade rdf:type owl:ObjectProperty ;
                                         rdfs:domain ontology-cb4989:ConverterBlowing ;
                                         rdfs:range ontology-cb4989:SteelGrade ;
                                         rdfs:label "Steel grade governing blowing"@en ,
                                                    "吹炼控制依据钢种"@zh ;
                                         skos:definition "为吹炼终点碳含量控制提供要求的钢种。"@zh .


###  https://example.org/ontology/ontology-cb4989#isFollowedByCastingTransfer
ontology-cb4989:isFollowedByCastingTransfer rdf:type owl:ObjectProperty ;
                                            rdfs:domain ontology-cb4989:RefiningTreatment ;
                                            rdfs:range ontology-cb4989:LadleTransfer ;
                                            rdfs:label "Post-refining transfer to casting"@en ,
                                                       "精炼后赴连铸吊运"@zh ;
                                            skos:definition "精炼结束后，将允许送连铸的炉次的钢包吊运至钢包回转台的操作。"@zh .


###  https://example.org/ontology/ontology-cb4989#isFollowedByRefiningTransfer
ontology-cb4989:isFollowedByRefiningTransfer rdf:type owl:ObjectProperty ;
                                             rdfs:domain ontology-cb4989:Tapping ;
                                             rdfs:range ontology-cb4989:LadleTransfer ;
                                             rdfs:label "Post-tapping transfer to refining"@en ,
                                                        "出钢后赴精炼吊运"@zh ;
                                             skos:definition "出钢后将承装钢水的钢包吊运至 LF 精炼炉的操作。"@zh .


###  https://example.org/ontology/ontology-cb4989#isPerformedInLadleFurnace
ontology-cb4989:isPerformedInLadleFurnace rdf:type owl:ObjectProperty ;
                                          rdfs:domain ontology-cb4989:RefiningTreatment ;
                                          rdfs:range ontology-cb4989:LadleFurnace ;
                                          rdfs:label "Treatment ladle furnace"@en ,
                                                     "处理所在精炼炉"@zh ;
                                          skos:definition "实施该次精炼处理的 LF 精炼炉。"@zh .


###  https://example.org/ontology/ontology-cb4989#isSmeltedInConverter
ontology-cb4989:isSmeltedInConverter rdf:type owl:ObjectProperty ;
                                     rdfs:domain ontology-cb4989:Heat ;
                                     rdfs:range ontology-cb4989:Converter ;
                                     rdfs:label "Smelting converter"@en ,
                                                "冶炼转炉"@zh ;
                                     skos:definition "完成该炉次从装料到出钢的顶底复吹转炉。"@zh .


###  https://example.org/ontology/ontology-cb4989#producesFinalSteelSample
ontology-cb4989:producesFinalSteelSample rdf:type owl:ObjectProperty ;
                                         rdfs:domain ontology-cb4989:RefiningTreatment ;
                                         rdfs:range ontology-cb4989:FinalSteelSample ;
                                         rdfs:label "Refining final steel sample"@en ,
                                                    "精炼成品样"@zh ;
                                         skos:definition "该次精炼结束时取得、用于化学成分判定的成品样。"@zh .


###  https://example.org/ontology/ontology-cb4989#tapsMoltenSteel
ontology-cb4989:tapsMoltenSteel rdf:type owl:ObjectProperty ;
                                rdfs:domain ontology-cb4989:Tapping ;
                                rdfs:range ontology-cb4989:MoltenSteel ;
                                rdfs:label "Tapped molten steel"@en ,
                                           "出钢钢水"@zh ;
                                skos:definition "该次出钢从转炉倒入钢包的钢水，按炉次计为一批。"@zh .


###  https://example.org/ontology/ontology-cb4989#transfersLadle
ontology-cb4989:transfersLadle rdf:type owl:ObjectProperty ;
                               rdfs:domain ontology-cb4989:LadleTransfer ;
                               rdfs:range ontology-cb4989:Ladle ;
                               rdfs:label "Transferred ladle"@en ,
                                          "吊运钢包"@zh ;
                               skos:definition "该次吊运中承装钢水并被移动的钢包。"@zh .


###  https://example.org/ontology/ontology-cb4989#usesTappingLadle
ontology-cb4989:usesTappingLadle rdf:type owl:ObjectProperty ;
                                 rdfs:domain ontology-cb4989:Tapping ;
                                 rdfs:range ontology-cb4989:Ladle ;
                                 rdfs:label "Tapping ladle"@en ,
                                            "出钢所用钢包"@zh ;
                                 skos:definition "接收该次出钢钢水并在出钢后登记包号的钢包。"@zh .


#################################################################
#    Data properties
#################################################################

###  https://example.org/ontology/ontology-cb4989#arrivalTemperature
ontology-cb4989:arrivalTemperature rdf:type owl:DatatypeProperty ;
                                   rdfs:domain ontology-cb4989:RefiningTreatment ;
                                   rdfs:range xsd:decimal ;
                                   rdfs:label "Refining arrival temperature"@en ,
                                              "进站温度"@zh ;
                                   skos:definition "该次精炼处理记录的进站温度。"@zh .


###  https://example.org/ontology/ontology-cb4989#carbonMassFraction
ontology-cb4989:carbonMassFraction rdf:type owl:DatatypeProperty ;
                                   rdfs:domain ontology-cb4989:FinalSteelSample ;
                                   rdfs:range xsd:decimal ;
                                   rdfs:label "Sample carbon mass fraction"@en ,
                                              "样品碳质量分数"@zh ;
                                   skos:definition "成品样中碳的质量分数，用于与适用钢种的碳限值比较。"@zh ;
                                   op:unit "%" .


###  https://example.org/ontology/ontology-cb4989#departureTemperature
ontology-cb4989:departureTemperature rdf:type owl:DatatypeProperty ;
                                     rdfs:domain ontology-cb4989:RefiningTreatment ;
                                     rdfs:range xsd:decimal ;
                                     rdfs:label "Refining departure temperature"@en ,
                                                "出站温度"@zh ;
                                     skos:definition "该次精炼处理记录的出站温度。"@zh .


###  https://example.org/ontology/ontology-cb4989#endpointCarbonContent
ontology-cb4989:endpointCarbonContent rdf:type owl:DatatypeProperty ;
                                      rdfs:domain ontology-cb4989:BlowingEndpointMeasurementAndSampling ;
                                      rdfs:range xsd:decimal ;
                                      rdfs:label "Endpoint carbon content"@en ,
                                                 "终点碳含量"@zh ;
                                      skos:definition "吹炼终点测温取样后记录的碳含量。"@zh .


###  https://example.org/ontology/ontology-cb4989#endpointTemperature
ontology-cb4989:endpointTemperature rdf:type owl:DatatypeProperty ;
                                    rdfs:domain ontology-cb4989:BlowingEndpointMeasurementAndSampling ;
                                    rdfs:range xsd:decimal ;
                                    rdfs:label "Endpoint temperature"@en ,
                                               "终点温度"@zh ;
                                    skos:definition "吹炼终点测温取样后记录的温度。"@zh .


###  https://example.org/ontology/ontology-cb4989#gradeDesignation
ontology-cb4989:gradeDesignation rdf:type owl:DatatypeProperty ;
                                 rdfs:domain ontology-cb4989:SteelGrade ;
                                 rdfs:range xsd:string ;
                                 rdfs:label "Steel grade designation"@en ,
                                            "钢种牌号"@zh ;
                                 skos:definition "表示钢种的牌号，例如 Q235B。"@zh .


###  https://example.org/ontology/ontology-cb4989#heatNumber
ontology-cb4989:heatNumber rdf:type owl:DatatypeProperty ;
                           rdfs:domain ontology-cb4989:Heat ;
                           rdfs:range xsd:string ;
                           rdfs:label "Heat number"@en ,
                                      "炉号"@zh ;
                           skos:definition "由年份、转炉编号和流水号组成的炉次唯一标识。"@zh .


###  https://example.org/ontology/ontology-cb4989#hotMetalRatio
ontology-cb4989:hotMetalRatio rdf:type owl:DatatypeProperty ;
                              rdfs:domain ontology-cb4989:Charging ;
                              rdfs:range xsd:decimal ;
                              rdfs:label "Hot metal ratio"@en ,
                                         "铁水比"@zh ;
                              skos:definition "该炉次装料的铁水比例，规程要求不低于 85%。"@zh ;
                              op:unit "%" .


###  https://example.org/ontology/ontology-cb4989#ladleNumber
ontology-cb4989:ladleNumber rdf:type owl:DatatypeProperty ;
                            rdfs:domain ontology-cb4989:Ladle ;
                            rdfs:range xsd:string ;
                            rdfs:label "Ladle number"@en ,
                                       "包号"@zh ;
                            skos:definition "识别钢包并在出钢后登记的编号。"@zh .


###  https://example.org/ontology/ontology-cb4989#manganeseMassFraction
ontology-cb4989:manganeseMassFraction rdf:type owl:DatatypeProperty ;
                                      rdfs:domain ontology-cb4989:FinalSteelSample ;
                                      rdfs:range xsd:decimal ;
                                      rdfs:label "Sample manganese mass fraction"@en ,
                                                 "样品锰质量分数"@zh ;
                                      skos:definition "成品样中锰的质量分数，用于与适用钢种的锰限值比较。"@zh ;
                                      op:unit "%" .


###  https://example.org/ontology/ontology-cb4989#maxFinalCarbonMassFraction
ontology-cb4989:maxFinalCarbonMassFraction rdf:type owl:DatatypeProperty ;
                                           rdfs:domain ontology-cb4989:SteelGrade ;
                                           rdfs:range xsd:decimal ;
                                           rdfs:label "Maximum final carbon mass fraction"@en ,
                                                      "成品碳质量分数上限"@zh ;
                                           skos:definition "钢种规定的成品碳质量分数允许上限；Q235B 为 0.20%。"@zh ;
                                           op:unit "%" .


###  https://example.org/ontology/ontology-cb4989#maxFinalManganeseMassFraction
ontology-cb4989:maxFinalManganeseMassFraction rdf:type owl:DatatypeProperty ;
                                              rdfs:domain ontology-cb4989:SteelGrade ;
                                              rdfs:range xsd:decimal ;
                                              rdfs:label "Maximum final manganese mass fraction"@en ,
                                                         "成品锰质量分数上限"@zh ;
                                              skos:definition "钢种规定的成品锰质量分数允许上限；Q235B 为 1.40%。"@zh ;
                                              op:unit "%" .


###  https://example.org/ontology/ontology-cb4989#maxFinalPhosphorusMassFraction
ontology-cb4989:maxFinalPhosphorusMassFraction rdf:type owl:DatatypeProperty ;
                                               rdfs:domain ontology-cb4989:SteelGrade ;
                                               rdfs:range xsd:decimal ;
                                               rdfs:label "Maximum final phosphorus mass fraction"@en ,
                                                          "成品磷质量分数上限"@zh ;
                                               skos:definition "钢种规定的成品磷质量分数允许上限；Q235B 为 0.045%。"@zh ;
                                               op:unit "%" .


###  https://example.org/ontology/ontology-cb4989#maxFinalSiliconMassFraction
ontology-cb4989:maxFinalSiliconMassFraction rdf:type owl:DatatypeProperty ;
                                            rdfs:domain ontology-cb4989:SteelGrade ;
                                            rdfs:range xsd:decimal ;
                                            rdfs:label "Maximum final silicon mass fraction"@en ,
                                                       "成品硅质量分数上限"@zh ;
                                            skos:definition "钢种规定的成品硅质量分数允许上限；Q235B 为 0.35%。"@zh ;
                                            op:unit "%" .


###  https://example.org/ontology/ontology-cb4989#maxFinalSulfurMassFraction
ontology-cb4989:maxFinalSulfurMassFraction rdf:type owl:DatatypeProperty ;
                                           rdfs:domain ontology-cb4989:SteelGrade ;
                                           rdfs:range xsd:decimal ;
                                           rdfs:label "Maximum final sulfur mass fraction"@en ,
                                                      "成品硫质量分数上限"@zh ;
                                           skos:definition "钢种规定的成品硫质量分数允许上限；Q235B 为 0.045%。"@zh ;
                                           op:unit "%" .


###  https://example.org/ontology/ontology-cb4989#maxTargetTappingTemperature
ontology-cb4989:maxTargetTappingTemperature rdf:type owl:DatatypeProperty ;
                                            rdfs:domain ontology-cb4989:SteelGrade ;
                                            rdfs:range xsd:decimal ;
                                            rdfs:label "Maximum target tapping temperature"@en ,
                                                       "目标出钢温度上限"@zh ;
                                            skos:definition "钢种规定的目标出钢温度区间的上端值；Q235B 为 1670 ℃。"@zh ;
                                            op:unit "℃" .


###  https://example.org/ontology/ontology-cb4989#minTargetTappingTemperature
ontology-cb4989:minTargetTappingTemperature rdf:type owl:DatatypeProperty ;
                                            rdfs:domain ontology-cb4989:SteelGrade ;
                                            rdfs:range xsd:decimal ;
                                            rdfs:label "Minimum target tapping temperature"@en ,
                                                       "目标出钢温度下限"@zh ;
                                            skos:definition "钢种规定的目标出钢温度区间的下端值；Q235B 为 1650 ℃。"@zh ;
                                            op:unit "℃" .


###  https://example.org/ontology/ontology-cb4989#nominalConverterCapacity
ontology-cb4989:nominalConverterCapacity rdf:type owl:DatatypeProperty ;
                                         rdfs:domain ontology-cb4989:Converter ;
                                         rdfs:range xsd:decimal ;
                                         rdfs:label "Nominal converter capacity"@en ,
                                                    "转炉公称吨位"@zh ;
                                         skos:definition "标示转炉规格的吨位；本规程适用的转炉规格为 120 吨。"@zh ;
                                         op:unit "t" .


###  https://example.org/ontology/ontology-cb4989#phosphorusMassFraction
ontology-cb4989:phosphorusMassFraction rdf:type owl:DatatypeProperty ;
                                       rdfs:domain ontology-cb4989:FinalSteelSample ;
                                       rdfs:range xsd:decimal ;
                                       rdfs:label "Sample phosphorus mass fraction"@en ,
                                                  "样品磷质量分数"@zh ;
                                       skos:definition "成品样中磷的质量分数，用于与适用钢种的磷限值比较。"@zh ;
                                       op:unit "%" .


###  https://example.org/ontology/ontology-cb4989#plannedTappingMass
ontology-cb4989:plannedTappingMass rdf:type owl:DatatypeProperty ;
                                   rdfs:domain ontology-cb4989:Heat ;
                                   rdfs:range xsd:decimal ;
                                   rdfs:label "Planned tapping mass"@en ,
                                              "计划出钢量"@zh ;
                                   skos:definition "装料前为该炉次登记的计划出钢重量。"@zh ;
                                   op:unit "t" .


###  https://example.org/ontology/ontology-cb4989#refiningDuration
ontology-cb4989:refiningDuration rdf:type owl:DatatypeProperty ;
                                 rdfs:domain ontology-cb4989:RefiningTreatment ;
