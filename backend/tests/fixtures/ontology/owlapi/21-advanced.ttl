@prefix : <urn:synthetic:m5:ontology#> .
@prefix ex: <urn:synthetic:m5:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <urn:synthetic:m5:ontology> .

<urn:synthetic:m5:ontology> rdf:type owl:Ontology ;
                             owl:imports <https://example.invalid/never-load> .

#################################################################
#    Object Properties
#################################################################

###  urn:synthetic:m5:chain
ex:chain rdf:type owl:ObjectProperty ;
         owl:propertyChainAxiom ( ex:p
                                  ex:q
                                ) .


###  urn:synthetic:m5:p
ex:p rdf:type owl:ObjectProperty ,
              owl:FunctionalProperty ,
              owl:InverseFunctionalProperty ,
              owl:SymmetricProperty ,
              owl:AsymmetricProperty ,
              owl:TransitiveProperty ,
              owl:ReflexiveProperty ,
              owl:IrreflexiveProperty .


###  urn:synthetic:m5:q
ex:q rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  urn:synthetic:m5:count
ex:count rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  urn:synthetic:m5:A
ex:A rdf:type owl:Class ;
     rdfs:subClassOf [ rdf:type owl:Restriction ;
                       owl:onProperty ex:p ;
                       owl:someValuesFrom ex:B
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty ex:p ;
                       owl:allValuesFrom ex:B
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty ex:p ;
                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty ex:p ;
                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass ex:B
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty ex:p ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass ex:B
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty ex:p ;
                       owl:cardinality "2"^^xsd:nonNegativeInteger
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty ex:p ;
                       owl:maxCardinality "5"^^xsd:nonNegativeInteger
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty ex:count ;
                       owl:hasValue 001
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty ex:count ;
                       owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                       owl:onDataRange xsd:integer
                     ] ;
     owl:hasKey ( ex:p
                  ex:count
                ) .


###  urn:synthetic:m5:And
ex:And rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( ex:A
                                                  ex:B
                                                ) ;
                             rdf:type owl:Class
                           ] .


###  urn:synthetic:m5:B
ex:B rdf:type owl:Class ;
     rdfs:label "乙类"@zh .


###  urn:synthetic:m5:Not
ex:Not rdf:type owl:Class ;
       owl:equivalentClass [ rdf:type owl:Class ;
                             owl:complementOf ex:B
                           ] .


###  urn:synthetic:m5:Or
ex:Or rdf:type owl:Class ;
      owl:equivalentClass [ rdf:type owl:Class ;
                            owl:unionOf ( ex:A
                                          ex:B
                                        )
                          ] .


#################################################################
#    Individuals
#################################################################

###  urn:synthetic:m5:i
ex:i rdf:type owl:NamedIndividual ;
     owl:sameAs ex:j ;
     owl:differentFrom ex:k .


###  urn:synthetic:m5:j

###  urn:synthetic:m5:j
ex:j rdf:type owl:NamedIndividual .


###  urn:synthetic:m5:k
ex:k rdf:type owl:NamedIndividual .


