# Test values for the throwaway stack that `./dev.ps1 e2e` starts (op-tmp-e2e-* containers on
# their own network, removed afterwards). They exist only there: the api creates this admin from
# OP_ADMIN_* at startup, the database lives in tmpfs. Never reuse them for the dev stack.
E2E_USERNAME=e2e-admin
E2E_PASSWORD=e2e-only-password-0001
E2E_POSTGRES_PASSWORD=e2e-only-postgres
E2E_SECRET_KEY=e2e-only-secret-key-not-used-anywhere-else
