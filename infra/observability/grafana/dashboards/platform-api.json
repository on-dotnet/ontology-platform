  "panels": [
    {
      "id": 1,
      "title": "按状态类别请求速率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(platform_requests_total{service_name=\"ontology-platform-api\"}[1m]))",
          "query": "sum by (status_class) (rate(platform_requests_total{service_name=\"ontology-platform-api\"}[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "platform-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "HTTP P95耗时",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"ontology-platform-api\"}[2m])))",
          "query": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"ontology-platform-api\"}[2m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "platform-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {}
    },
