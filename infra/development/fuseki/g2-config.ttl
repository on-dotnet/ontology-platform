@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix ja: <http://jena.hpl.hp.com/2005/11/Assembler#> .
@prefix tdb2: <http://jena.apache.org/2016/tdb#> .

# 同一批准Jena进程：有界临时校验与独占正式版本图分开。
[] a fuseki:Server ; fuseki:services ( <#validation> <#ontology> ) .
<#validation> a fuseki:Service ; fuseki:name "validation" ; fuseki:dataset <#memory> ;
 fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "query" ] ;
 fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data" ] ;
 fuseki:endpoint [ fuseki:operation fuseki:shacl ; fuseki:name "shacl" ] .
<#memory> a ja:MemoryDataset .
<#ontology> a fuseki:Service ; fuseki:name "ontology" ; fuseki:dataset <#persistent> ;
 fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "query" ] ;
 fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data" ] ;
 fuseki:endpoint [ fuseki:operation fuseki:shacl ; fuseki:name "shacl" ] .
<#persistent> a tdb2:DatasetTDB2 ; tdb2:location "/fuseki/databases/ontology" .
