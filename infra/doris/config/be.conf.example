# 仅6GiB容器的合成配置草案；不得设置SKIP_CHECK_ULIMIT。
JAVA_HOME=/usr/lib/jvm/java
JAVA_OPTS_FOR_JDK_17="-Dfile.encoding=UTF-8 -Xms128m -Xmx512m -XX:MaxDirectMemorySize=128m -XX:MaxMetaspaceSize=256m -XX:ActiveProcessorCount=2 -XX:-CriticalJNINatives -XX:+IgnoreUnrecognizedVMOptions"
# 显式绝对值，避免按VM物理内存计算百分比；余量用于线程、JVM及非堆。
mem_limit = 3G
be_port = 9060
webserver_port = 8040
heartbeat_service_port = 9050
brpc_port = 8060
storage_root_path = /opt/apache-doris/be/storage
sys_log_level = INFO
sys_log_roll_num = 2
AWS_EC2_METADATA_DISABLED=true

# 固定4.0.8默认brpc线程256，超出本机极小夹具需要；限制各常驻池。
brpc_num_threads = 4
be_service_threads = 8
doris_scanner_thread_pool_thread_num = 8
doris_scanner_min_thread_pool_thread_num = 2
doris_max_remote_scanner_thread_pool_thread_num = 8
doris_remote_scanner_thread_pool_thread_num = 4
pipeline_executor_size = 2
blocking_pipeline_executor_size = 2
brpc_heavy_work_pool_threads = 4
brpc_light_work_pool_threads = 4
brpc_arrow_flight_work_pool_threads = 2
send_batch_thread_pool_thread_num = 4
fragment_mgr_async_work_pool_thread_num_min = 2
fragment_mgr_async_work_pool_thread_num_max = 16
file_cache_downloader_thread_num_min = 2
file_cache_downloader_thread_num_max = 4
num_buffered_reader_prefetch_thread_pool_min_thread = 2
num_buffered_reader_prefetch_thread_pool_max_thread = 4
segment_prefetch_thread_pool_thread_num_min = 2
segment_prefetch_thread_pool_thread_num_max = 4
num_s3_file_upload_thread_pool_min_thread = 1
num_s3_file_upload_thread_pool_max_thread = 2
min_nonblock_close_thread_num = 1
max_nonblock_close_thread_num = 2
max_routine_load_thread_pool_size = 4
group_commit_insert_threads = 2
group_commit_relay_wal_threads = 2
flush_thread_num_per_store = 2
high_priority_flush_thread_num_per_store = 2
max_flush_thread_num_per_cpu = 2
