@prefix inspection: <https://w3id.org/ontology-platform/steel/code/inspection-document-type/> .
@prefix move: <https://w3id.org/ontology-platform/steel/code/movement-event-type/> .
@prefix defectCode: <https://w3id.org/ontology-platform/steel/code/defect-type/> .

@prefix annealedCoil: <urn:synthetic:steel-industry:annealedcoil/> .
@prefix annealing: <urn:synthetic:steel-industry:annealing/> .
@prefix castSequence: <urn:synthetic:steel-industry:castsequence/> .
@prefix chemicalAnalysis: <urn:synthetic:steel-industry:chemicalanalysis/> .
@prefix coilSplitting: <urn:synthetic:steel-industry:coilsplitting/> .
@prefix coatingTest: <urn:synthetic:steel-industry:coatingtest/> .
