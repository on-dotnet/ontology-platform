    stl:unitType unitType:CAL ;
    stl:unitNumber "1"^^xsd:positiveInteger .

equipment:CGL1 a stl:Equipment ;
    op:synthetic true ;
    dct:identifier "CGL1" ;
    stl:unitType unitType:CGL ;
    stl:unitNumber "1"^^xsd:positiveInteger .

equipment:RCL1 a stl:Equipment ;
    op:synthetic true ;
    dct:identifier "RCL1" ;
    stl:unitType unitType:RCL ;
    stl:unitNumber "1"^^xsd:positiveInteger .

equipment:PCK1 a stl:Equipment ;
    op:synthetic true ;
    dct:identifier "PCK1" ;
    stl:unitType unitType:PCK ;
    stl:unitNumber "1"^^xsd:positiveInteger .

measurementPoint:RH1-LADLE a stl:MeasurementPoint ;
    op:synthetic true ;
    dct:identifier "RH1-LADLE" ;
    stl:partOf equipment:RH1 .

measurementPoint:BOF2-ENDPOINT a stl:MeasurementPoint ;
    op:synthetic true ;
    dct:identifier "BOF2-ENDPOINT" ;
    stl:partOf equipment:BOF2 .

storageArea:CY1 a stl:StorageArea ;
    op:synthetic true ;
    dct:identifier "CY1" .

crane:CRCY12 a stl:Crane ;
    op:synthetic true ;
    dct:identifier "CRCY12" ;
    stl:locatedIn storageArea:CY1 ;
    stl:unitNumber "2"^^xsd:positiveInteger .

storageLocation:CY1-03121 a stl:StorageLocation ;
    op:synthetic true ;
    dct:identifier "CY1-03121" ;
    stl:locatedIn storageArea:CY1 ;
    stl:row "3"^^xsd:positiveInteger ;
    stl:column "12"^^xsd:positiveInteger ;
    stl:tier "1"^^xsd:positiveInteger .

storageLocation:CY1-05022 a stl:StorageLocation ;
    op:synthetic true ;
    dct:identifier "CY1-05022" ;
    stl:locatedIn storageArea:CY1 ;
    stl:row "5"^^xsd:positiveInteger ;
    stl:column "2"^^xsd:positiveInteger ;
    stl:tier "2"^^xsd:positiveInteger .

# Internal grades refer to public designations in a specific standard edition.

steelGrade:G1023 a stl:SteelGrade ;
    op:synthetic true ;
    dct:identifier "G1023" ;
    stl:serialNumber "1023"^^xsd:positiveInteger ;
    stl:satisfies <std/gbt-700-2006/grade/Q235B> .

steelGrade:G2051 a stl:SteelGrade ;
    op:synthetic true ;
    dct:identifier "G2051" ;
    stl:serialNumber "2051"^^xsd:positiveInteger ;
    stl:satisfies <std/gbt-5213-2019/grade/DC01>, <std/gbt-5213-2019/grade/DC04>, <std/gbt-2518-2019/grade/DX51D-Z> .

# Sales and production orders. The ledger gives dates only for order creation.
# The synthetic creation instants for those documents use the start of that date.

