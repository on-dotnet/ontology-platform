@prefix cuttingPlan: <urn:synthetic:steel-industry:cuttingplan/> .
@prefix defect: <urn:synthetic:steel-industry:defect/> .
@prefix elementResult: <urn:synthetic:steel-industry:elementresult/> .
@prefix equipment: <urn:synthetic:steel-industry:equipment/> .
@prefix fullHardCoil: <urn:synthetic:steel-industry:fullhardcoil/> .
@prefix galvanizedCoil: <urn:synthetic:steel-industry:galvanizedcoil/> .
@prefix galvanizing: <urn:synthetic:steel-industry:galvanizing/> .
@prefix heat: <urn:synthetic:steel-industry:heat/> .
@prefix heatContribution: <urn:synthetic:steel-industry:heatcontribution/> .
@prefix hotRolledCoil: <urn:synthetic:steel-industry:hotrolledcoil/> .
@prefix hotRolling: <urn:synthetic:steel-industry:hotrolling/> .
@prefix inspectionLot: <urn:synthetic:steel-industry:inspectionlot/> .
