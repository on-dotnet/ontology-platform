# Equipment, measuring points and storage addresses.

equipment:BOF1 a stl:Equipment ;
    op:synthetic true ;
    dct:identifier "BOF1" ;
    stl:unitType unitType:BOF ;
    stl:unitNumber "1"^^xsd:positiveInteger .

equipment:BOF2 a stl:Equipment ;
    op:synthetic true ;
    dct:identifier "BOF2" ;
    stl:unitType unitType:BOF ;
    stl:unitNumber "2"^^xsd:positiveInteger .

equipment:LF1 a stl:Equipment ;
    op:synthetic true ;
