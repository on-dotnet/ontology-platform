@prefix measurementPoint: <urn:synthetic:steel-industry:measurementpoint/> .
@prefix mechanicalTest: <urn:synthetic:steel-industry:mechanicaltest/> .
@prefix millCertificate: <urn:synthetic:steel-industry:millcertificate/> .
@prefix movementEvent: <urn:synthetic:steel-industry:movementevent/> .
@prefix movementOrder: <urn:synthetic:steel-industry:movementorder/> .
@prefix observation: <urn:synthetic:steel-industry:observation/> .
@prefix package: <urn:synthetic:steel-industry:package/> .
@prefix operation: <urn:synthetic:steel-industry:operation/> .
@prefix packing: <urn:synthetic:steel-industry:packing/> .
@prefix picklingAndColdRolling: <urn:synthetic:steel-industry:picklingandcoldrolling/> .
