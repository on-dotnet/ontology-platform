# Synthetic steel manufacturing records for two traceability scenarios and one ordinary release.
# Instants use UTC+08:00. Quantities use the units declared in the ontology.
@base <https://w3id.org/ontology-platform/steel/> .
@prefix stl: <https://w3id.org/ontology-platform/steel/> .
@prefix op: <urn:ontology-platform:vocabulary:> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix std: <https://w3id.org/ontology-platform/steel/std/> .

@prefix unitType: <https://w3id.org/ontology-platform/steel/code/unit-type/> .
@prefix evidence: <https://w3id.org/ontology-platform/steel/code/contribution-evidence/> .
@prefix basis: <https://w3id.org/ontology-platform/steel/code/share-basis/> .
@prefix method: <https://w3id.org/ontology-platform/steel/code/measurement-method/> .
@prefix coating: <https://w3id.org/ontology-platform/steel/code/coating-type/> .
@prefix item: <https://w3id.org/ontology-platform/steel/code/measurement-item/> .
