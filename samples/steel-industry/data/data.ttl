    stl:unitNumber "1"^^xsd:positiveInteger .

equipment:RH1 a stl:Equipment ;
    op:synthetic true ;
    dct:identifier "RH1" ;
    stl:unitType unitType:RH ;
    stl:unitNumber "1"^^xsd:positiveInteger .

equipment:CC1 a stl:Equipment ;
    op:synthetic true ;
    dct:identifier "CC1" ;
    stl:unitType unitType:CC ;
    stl:unitNumber "1"^^xsd:positiveInteger ;
    stl:strandCount "2"^^xsd:nonNegativeInteger .

equipment:HSM1 a stl:Equipment ;
    op:synthetic true ;
    dct:identifier "HSM1" ;
    stl:unitType unitType:HSM ;
    stl:unitNumber "1"^^xsd:positiveInteger .

