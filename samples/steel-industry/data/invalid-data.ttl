    stl:measuredObject <urn:synthetic:steel-industry:heat/H22600992> ;
    stl:measurementItem item:TEMP ;
    stl:measuredAtPoint <urn:synthetic:steel-industry:measurementpoint/NEG-LANCE> ;
    stl:sampledAt "2026-11-03T10:00:00+08:00"^^xsd:dateTime ;
    op:synthetic true .

# EXPECT <urn:synthetic:steel-industry:observation/NEG-TEMP-EXTRA-COUNT> <https://w3id.org/ontology-platform/steel/MeasurementItemValueShape> SPARQLConstraintComponent
<urn:synthetic:steel-industry:observation/NEG-TEMP-EXTRA-COUNT> a stl:Observation ;
    stl:measuredObject <urn:synthetic:steel-industry:heat/H22600992> ;
    stl:measurementItem item:TEMP ;
    stl:measuredAtPoint <urn:synthetic:steel-industry:measurementpoint/NEG-LANCE> ;
    stl:sampledAt "2026-11-03T10:02:00+08:00"^^xsd:dateTime ;
    stl:temperature 1610.0 ;
    stl:strandCount "2"^^xsd:nonNegativeInteger ;
    op:synthetic true .

# EXPECT <urn:synthetic:steel-industry:observation/NEG-TENSILE-EXTRA-YIELD> <https://w3id.org/ontology-platform/steel/MeasurementItemValueShape> SPARQLConstraintComponent
<urn:synthetic:steel-industry:observation/NEG-TENSILE-EXTRA-YIELD> a stl:Observation ;
    stl:measuredObject <urn:synthetic:steel-industry:coil/NEG-REVERSED-INTERVAL> ;
    stl:measurementItem item:TENSILE ;
    stl:measuredAtPoint <urn:synthetic:steel-industry:measurementpoint/NEG-TEST-BENCH> ;
    stl:sampledAt "2026-11-03T10:00:00+08:00"^^xsd:dateTime ;
    stl:tensileStrength 405.0 ;
    stl:upperYieldStrength 280.0 ;
    op:synthetic true .

<urn:synthetic:steel-industry:measurementpoint/NEG-TEST-BENCH> a stl:MeasurementPoint ;
    op:synthetic true .

# EXPECT <urn:synthetic:steel-industry:coil/NEG-REVERSED-INTERVAL> <https://w3id.org/ontology-platform/steel/SegmentBoundsShape> LessThanOrEqualsConstraintComponent
<urn:synthetic:steel-industry:coil/NEG-REVERSED-INTERVAL> a stl:Coil ;
    stl:startLength 101.0 ;
    stl:endLength 100.0 ;
    stl:createdAt "2026-11-03T10:00:00+08:00"^^xsd:dateTime ;
    stl:producedBy <urn:synthetic:steel-industry:cutting/NEG-CUT> ;
    op:synthetic true .

