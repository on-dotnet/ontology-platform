# A second, unsourced sample must still fail when the first has a heat source.
# EXPECT <urn:synthetic:steel-industry:chemicalanalysis/NEG-HEAT-MISSING-SOURCE> <https://w3id.org/ontology-platform/steel/HeatAnalysisSampleSourceShape> SPARQLConstraintComponent
<urn:synthetic:steel-industry:chemicalanalysis/NEG-HEAT-MISSING-SOURCE> a stl:ChemicalAnalysis ;
    stl:analysisType analysis:HEAT ;
    stl:testedSample <urn:synthetic:steel-industry:sample/T260009913>,
        <urn:synthetic:steel-industry:sample/T260009901> ;
    op:synthetic true .

