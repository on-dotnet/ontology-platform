stl:MeasurementMethodCodeShape a sh:NodeShape ;
    sh:targetSubjectsOf stl:measurementMethod ;
    sh:sparql [
        sh:message "The measurementMethod value must belong to the measurement-method scheme." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this stl:measurementMethod ?value .
    FILTER NOT EXISTS { ?value skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-method> }
}
"""
    ] .

stl:MeasurementItemCodeShape a sh:NodeShape ;
    sh:targetSubjectsOf stl:measurementItem ;
    sh:sparql [
        sh:message "The measurementItem value must be a concept in the measurement-item scheme." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this stl:measurementItem ?value .
    FILTER NOT EXISTS { ?value skos:inScheme <https://w3id.org/ontology-platform/steel/code/measurement-item> }
}
"""
    ] .

stl:MeasurementItemValueShape a sh:NodeShape ;
    sh:targetSubjectsOf stl:measurementItem ;
    sh:sparql [
        sh:message "Use the value property for the recorded measurement item and no other measured quantity." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this stl:measurementItem ?item .
    OPTIONAL {
        $this ?property ?value .
        FILTER (?property IN (
            stl:temperature, stl:activeOxygen, stl:tensileStrength, stl:impactEnergy,
            stl:coatingMass, stl:thickness, stl:width, stl:castingSpeed,
            stl:lowerYieldStrength, stl:upperYieldStrength, stl:elongationAfterFracture,
            stl:massFraction, stl:lowerLimit, stl:upperLimit, stl:share, stl:minimumCoatingMass,
            stl:netMass, stl:grossMass, stl:theoreticalMass,
            stl:plannedLength, stl:actualLength, stl:startLength, stl:endLength,
            stl:strandCount, stl:applicableQuantity
        ))
    }
    FILTER (!BOUND(?property) || !(
        (?item = item:TEMP && ?property = stl:temperature)
        || (?item = item:OXYACT && ?property = stl:activeOxygen)
        || (?item = item:TENSILE && ?property = stl:tensileStrength)
        || (?item = item:IMPACT && ?property = stl:impactEnergy)
        || (?item = item:COATMASS && ?property = stl:coatingMass)
        || (?item = item:THICKNESS && ?property = stl:thickness)
        || (?item = item:WIDTH && ?property = stl:width)
        || (?item = item:CASTSPEED && ?property = stl:castingSpeed)
    ))
}
"""
    ] .

