# Fixed units for numeric properties


stl:OrdinalMetadataShape a sh:NodeShape ;
    sh:targetSubjectsOf stl:unit, stl:quantityKind ;
    sh:sparql [
        sh:message "Ordinals carry neither a unit nor a quantity kind." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this rdfs:subPropertyOf*/rdfs:range xsd:positiveInteger .
}
"""
    ] .

stl:PropertyUnitShape a sh:NodeShape ;
    sh:targetSubjectsOf stl:unit ;
    sh:sparql [
        sh:message "The unit must agree with the quantity's documented storage unit, including on subproperties." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this stl:unit ?unit ; rdfs:subPropertyOf* ?property .
    FILTER (isIRI(?unit) && STRSTARTS(STR(?unit), "http://qudt.org/vocab/unit/"))
    FILTER (
        (?property IN (stl:applicableQuantity, stl:strandCount) && ?unit != unit:NUM)
        ||     (?property IN (stl:thickness, stl:width) && ?unit != unit:MilliM)
        ||     (?property IN (stl:startLength, stl:endLength, stl:plannedLength, stl:actualLength) && ?unit != unit:M)
        ||     (?property IN (stl:grossMass, stl:netMass, stl:theoreticalMass) && ?unit != unit:TONNE)
        ||     (?property IN (stl:temperature) && ?unit != unit:DEG_C)
        ||     (?property IN (stl:massFraction, stl:lowerLimit, stl:upperLimit, stl:share, stl:elongationAfterFracture) && ?unit != unit:PERCENT)
        ||     (?property IN (stl:activeOxygen) && ?unit != unit:PPM)
        ||     (?unit = unit:PPM && NOT EXISTS { $this rdfs:subPropertyOf* stl:activeOxygen })
        ||     (?property IN (stl:tensileStrength, stl:lowerYieldStrength, stl:upperYieldStrength) && ?unit != unit:MegaPA)
        ||     (?property IN (stl:impactEnergy) && ?unit != unit:J)
        ||     (?property IN (stl:coatingMass, stl:minimumCoatingMass) && ?unit != unit:GM-PER-M2)
        ||     (?property IN (stl:castingSpeed) && ?unit != unit:M-PER-MIN)
    )
}
"""
    ] .
