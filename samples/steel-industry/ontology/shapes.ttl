stl:NumericUnitShape a sh:NodeShape ;
    sh:targetSubjectsOf rdfs:range ;
    sh:sparql [
        sh:message "A quantity needs one QUDT unit. Counts use unit:NUM." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this rdfs:range ?datatype .
    FILTER (?datatype IN (xsd:decimal, xsd:nonNegativeInteger))
    FILTER (
        NOT EXISTS {
            $this stl:unit ?iri .
            FILTER (isIRI(?iri) && STRSTARTS(STR(?iri), "http://qudt.org/vocab/unit/")
                    && STRLEN(STRAFTER(STR(?iri), "http://qudt.org/vocab/unit/")) > 0
                    && (?datatype != xsd:nonNegativeInteger || ?iri = unit:NUM))
        }
        || EXISTS { $this stl:unit ?a, ?b . FILTER (!sameTerm(?a, ?b)) }
    )
}
"""
    ] .

stl:NumericQuantityKindShape a sh:NodeShape ;
    sh:targetSubjectsOf rdfs:range ;
    sh:sparql [
        sh:message "A quantity needs one QUDT quantity kind. Counts use quantitykind:Count." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this rdfs:range ?datatype .
    FILTER (?datatype IN (xsd:decimal, xsd:nonNegativeInteger))
    FILTER (
        NOT EXISTS {
            $this stl:quantityKind ?iri .
            FILTER (isIRI(?iri) && STRSTARTS(STR(?iri), "http://qudt.org/vocab/quantitykind/")
                    && STRLEN(STRAFTER(STR(?iri), "http://qudt.org/vocab/quantitykind/")) > 0
                    && (?datatype != xsd:nonNegativeInteger || ?iri = quantitykind:Count))
        }
        || EXISTS { $this stl:quantityKind ?a, ?b . FILTER (!sameTerm(?a, ?b)) }
    )
}
"""
    ] .

# Code references, chemical results and conditional release


stl:UnitTypeCodeShape a sh:NodeShape ;
    sh:targetSubjectsOf stl:unitType ;
    sh:sparql [
        sh:message "The unitType value must be a concept in the unit-type scheme." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this stl:unitType ?value .
    FILTER NOT EXISTS { ?value skos:inScheme <https://w3id.org/ontology-platform/steel/code/unit-type> }
}
"""
    ] .

stl:DispositionTypeCodeShape a sh:NodeShape ;
    sh:targetSubjectsOf stl:dispositionType ;
    sh:sparql [
        sh:message "The dispositionType value must be a concept in the disposition-type scheme." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this stl:dispositionType ?value .
    FILTER NOT EXISTS { ?value skos:inScheme <https://w3id.org/ontology-platform/steel/code/disposition-type> }
}
"""
    ] .

stl:JudgementResultCodeShape a sh:NodeShape ;
    sh:targetSubjectsOf stl:judgementResult ;
    sh:sparql [
        sh:message "The judgementResult value must be a concept in the judgement-result scheme." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this stl:judgementResult ?value .
    FILTER NOT EXISTS { ?value skos:inScheme <https://w3id.org/ontology-platform/steel/code/judgement-result> }
}
"""
    ] .

stl:HeatAnalysisLimitShape a sh:NodeShape ;
    sh:targetClass stl:Heat ;
    sh:sparql [
        sh:message "Only one distinct heat analysis may represent the heat." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT $this WHERE {
    ?analysis rdf:type/rdfs:subClassOf* stl:ChemicalAnalysis ;
        stl:analysisType analysis:HEAT ;
        stl:testedSample/stl:sampleOf $this .
}
GROUP BY $this
HAVING (COUNT(DISTINCT ?analysis) > 1)
"""
    ] .

stl:HeatAnalysisSampleSourceShape a sh:NodeShape ;
    sh:targetSubjectsOf stl:analysisType ;
    sh:sparql [
        sh:message "A heat analysis needs a tested sample. Every tested sample must come from a heat." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this stl:analysisType analysis:HEAT .
    OPTIONAL {
        $this stl:testedSample ?sample .
        OPTIONAL { ?sample stl:sampleOf ?source }
    }
    FILTER (!BOUND(?source) || NOT EXISTS { ?source rdf:type/rdfs:subClassOf* stl:Heat })
}
"""
    ] .

stl:AnalysisTypeCodeShape a sh:NodeShape ;
    sh:targetSubjectsOf stl:analysisType ;
    sh:sparql [
        sh:message "The analysisType value must be a concept in the analysis-type scheme." ;
        sh:prefixes <https://w3id.org/ontology-platform/steel/module/shapes> ;
        sh:select """
SELECT DISTINCT $this WHERE {
    $this stl:analysisType ?value .
    FILTER NOT EXISTS { ?value skos:inScheme <https://w3id.org/ontology-platform/steel/code/analysis-type> }
}
"""
    ] .

stl:SampleTypeSingleShape a sh:PropertyShape ;
    sh:targetSubjectsOf stl:sampleType ;
    sh:path stl:sampleType ;
    sh:maxCount 1 ;
    sh:message "Record at most one sample type per sample." .

