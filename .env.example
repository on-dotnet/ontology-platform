# 本机私有配置的示例。复制为仓库根目录的 .env.local（已被 Git 忽略）再填写。
# ./dev.ps1 会把 .env.local 传给 docker compose；这里的变量都是可选的，未设置时使用开发默认值。

# ---- 大模型（M1 起）----
# OpenAI API Key。为空时 AI 功能显示"不可用"，其他功能不受影响。
OP_OPENAI_API_KEY=
# 容器访问模型服务时使用的 HTTP 代理，只作用于模型调用。
# 格式：http://用户名:口令@主机:端口。口令里有 @ : / # % 等字符时需要做 URL 编码。
OP_AI_PROXY=
# 兼容 OpenAI 接口的服务地址，留空使用 OpenAI 官方地址。
OP_AI_BASE_URL=
# 模型名：日常抽取用 OP_AI_MODEL，复杂推理用 OP_AI_REASONING_MODEL。
OP_AI_MODEL=gpt-6.2-sol
OP_AI_REASONING_MODEL=gpt-6.2-astra
# 推理强度：OP_AI_EFFORT 用于术语、消解、关系阶段（默认 low），OP_AI_REASONING_EFFORT 用于类型阶段
# （默认 default，即不传、用服务端的缺省；不认这个参数的兼容服务也填 default）。
OP_AI_EFFORT=
OP_AI_REASONING_EFFORT=

# ---- 审核 ----
# single（默认）：审核人可以合并自己的修改；separate：必须由另一位审核人处理。
# OP_REVIEW_MODE=separate

# ---- 外部数据源与 MCP（M3）----
# 轮换 OP_SECRET_KEY 期间的旧值，逗号分隔；数据源口令重新加密后删掉。
# OP_SECRET_KEY_PREVIOUS=
# 外部数据源的语句超时（秒，1–120）和单条语句最多取回的行数。
# OP_QUERY_TIMEOUT_SECONDS=15
# OP_QUERY_MAX_ROWS=1000
# 允许从浏览器调用 /mcp 的来源，逗号分隔；留空表示只允许平台自己的地址。
# OP_MCP_ALLOWED_ORIGINS=

# ---- 开发栈 ----
# OP_WEB_PORT=28080
# OP_DEV_HOST=10.16.0.13
# OP_DOCKER_CONTEXT=linux013-rootless
# OP_MIRROR=on
