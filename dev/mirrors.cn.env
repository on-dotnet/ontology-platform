# 国内依赖源。./dev.ps1 默认带上本文件；设置 OP_MIRROR=off 可关闭。
OP_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 构建时把 uv.lock 副本里的 https://files.pythonhosted.org/ 换成此前缀（仓库里的 uv.lock 保持官方地址）
OP_PYPI_FILES_MIRROR=https://mirrors.aliyun.com/pypi/
OP_NPM_REGISTRY=https://registry.npmmirror.com
# owl-check 的 OWL API 工具镜像（dev/owlapi）从这里下载 Maven 依赖
OP_MAVEN_MIRROR=https://maven.aliyun.com/repository/public
